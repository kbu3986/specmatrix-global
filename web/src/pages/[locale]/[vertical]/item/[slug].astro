---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AffiliateCtaCard from "../../../../components/AffiliateCtaCard.astro";
import SafetyBanner from "../../../../components/SafetyBanner.astro";
import SpecTable from "../../../../components/SpecTable.astro";
import AdSlotReserve from "../../../../components/AdSlotReserve.astro";
import WattCheckCalc from "../../../../components/calculators/WattCheckCalc.astro";
import PureGramCalc from "../../../../components/calculators/PureGramCalc.astro";
import CycleGearCalc from "../../../../components/calculators/CycleGearCalc.astro";

import type { ActiveLocale, AnyItem, PilotVertical } from "../../../../lib/types";
import {
  getAirlines,
  getAllItems,
  getFallbackItems,
  getFxRates,
  getPrimaryVerticalHref,
  getRelatedVsForItem,
} from "../../../../lib/data";
import { getItemDerivedKpis } from "../../../../lib/derived";
import {
  ACTIVE_LOCALES,
  SITE_URL,
  VERTICAL_META,
  formatCurrency,
  getCategoryLabel,
} from "../../../../lib/i18n";

export function getStaticPaths() {
  const items = getAllItems();
  const paths: Array<{
    params: { locale: ActiveLocale; vertical: PilotVertical; slug: string };
    props: { item: AnyItem };
  }> = [];

  for (const item of items) {
    for (const locale of ACTIVE_LOCALES) {
      if (!item.available_locales.includes(locale)) continue;
      if (!item.i18n[locale]) continue;
      paths.push({
        params: {
          locale,
          vertical: item.vertical as PilotVertical,
          slug: item.slug,
        },
        props: { item },
      });
    }
  }
  return paths;
}

const locale = Astro.params.locale as ActiveLocale;
const vertical = Astro.params.vertical as PilotVertical;
const { item } = Astro.props as { item: AnyItem };

const isKo = locale === "ko";
const fx = getFxRates();
const airlines = vertical === "wattcheck" ? getAirlines() : [];
const copy = item.i18n[locale] ?? item.i18n.en;
const kpis = getItemDerivedKpis(item, fx, locale);
const relatedVs = getRelatedVsForItem(vertical, item.slug);
const peers = getFallbackItems(item, 3);
const verticalHref = getPrimaryVerticalHref(locale, vertical);
const currentPath = `/${locale}/${vertical}/item/${item.slug}`;
const availLocales = ACTIVE_LOCALES.filter((l) => item.available_locales.includes(l));

const additionalProperty: Array<{ "@type": "PropertyValue"; name: string; value: string }> = [
  { "@type": "PropertyValue", name: "Trust Score", value: `${item.audit.trust_score}/100` },
  { "@type": "PropertyValue", name: "Fact Checked At", value: item.audit.fact_checked_at },
  ...kpis.map((k) => ({
    "@type": "PropertyValue" as const,
    name: k.label,
    value: k.value,
  })),
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: copy.name,
    brand: { "@type": "Brand", name: item.brand },
    mpn: item.model_number,
    category: getCategoryLabel(item.category, locale),
    description: copy.summary,
    url: `${SITE_URL}${currentPath}`,
    additionalProperty,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name:
      vertical === "wattcheck"
        ? `${copy.name} Airline & USB-PD Simulator`
        : vertical === "puregram"
          ? `${copy.name} Active Cost & Fueling Calculator`
          : `${copy.name} Bike Compatibility & Hookless Guard`,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    url: `${SITE_URL}${currentPath}`,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: `${SITE_URL}/${locale}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: VERTICAL_META[vertical].shortName[locale],
        item: `${SITE_URL}${verticalHref}`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: copy.name,
        item: `${SITE_URL}${currentPath}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${copy.title} | SpecMatrix Global`}
  description={copy.summary}
  locale={locale}
  currentPath={currentPath}
  activeVertical={vertical}
  availableLocales={availLocales}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    <a href={`/${locale}`} class="hover:text-blue-700 hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    <span>/</span>
    <a href={verticalHref} class="hover:text-blue-700 hover:underline">
      {VERTICAL_META[vertical].shortName[locale]}
    </a>
    <span>/</span>
    <span class="font-medium text-slate-800">{copy.name}</span>
  </nav>

  <!-- Product Header & MSRP CTA -->
  <section class="grid gap-6 lg:grid-cols-12">
    <div class="space-y-4 lg:col-span-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-pass">
          Trust {item.audit.trust_score}/100 · {isKo ? "적대적 팩트체크 완료" : "Fact-Checked"}
        </span>
        <span class="badge-info font-mono">
          {item.brand} · {item.model_number}
        </span>
        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 text-xs font-medium text-slate-600">
          {getCategoryLabel(item.category, locale)}
        </span>
      </div>

      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        {copy.title}
      </h1>

      <p class="text-sm leading-relaxed text-slate-700 sm:text-base">
        {copy.summary}
      </p>

      <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-4">
        <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-blue-800">
          {isKo ? "추천 대상 (Best For)" : "BEST FOR"}
        </div>
        <p class="mt-1 text-sm font-medium text-slate-900">{copy.best_for}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-slate-500">
        <span>{isKo ? "최종 검증일:" : "Fact-checked:"} {item.audit.fact_checked_at}</span>
        <span>·</span>
        <span>IG Score {item.audit.info_gain_score}/100</span>
        <span>·</span>
        <span>{item.citations.length} {isKo ? "공식 출처" : "official citations"}</span>
      </div>
    </div>

    <div class="lg:col-span-4">
      <AffiliateCtaCard item={item} locale={locale} />
    </div>
  </section>

  <!-- Derived KPI Strip (4 Deterministic Metrics) -->
  <section class="mt-8" aria-label={isKo ? "핵심 파생 지표" : "Derived Key Performance Indicators"}>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {kpis.map((kpi) => (
        <div class="lab-card p-4">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-wide text-slate-500">
            {kpi.label}
          </div>
          <div
            class:list={[
              "kpi-value mt-1.5 font-mono text-xl font-bold",
              kpi.tone === "pass"
                ? "text-emerald-700"
                : kpi.tone === "fail"
                  ? "text-rose-700"
                  : kpi.tone === "caution"
                    ? "text-amber-700"
                    : kpi.tone === "info"
                      ? "text-blue-700"
                      : "text-slate-900",
            ]}
          >
            {kpi.value}
          </div>
          <div class="mt-1 text-xs text-slate-600">{kpi.sublabel}</div>
        </div>
      ))}
    </div>
  </section>

  <AdSlotReserve slotId={`item-top-${vertical}`} variant="banner" locale={locale} />

  <!-- Vertical Interactive Calculator Island -->
  <div class="mt-6">
    {item.vertical === "wattcheck" && (
      <WattCheckCalc item={item} airlines={airlines} locale={locale} />
    )}
    {item.vertical === "puregram" && (
      <PureGramCalc item={item} fx={fx} locale={locale} />
    )}
    {item.vertical === "cyclegear" && (
      <CycleGearCalc item={item} locale={locale} />
    )}
  </div>

  <!-- Real-World Local Gotchas -->
  <section class="mt-8 lab-card p-5" aria-labelledby="gotchas-heading">
    <h2 id="gotchas-heading" class="text-base font-bold text-slate-900">
      {isKo
        ? "구매 전 필독 — 한국 환경·실사용 함정 (Local Gotchas)"
        : "Before You Buy — Real-World Edge Cases & Local Gotchas"}
    </h2>
    <ul class="mt-3 space-y-2">
      {copy.local_gotchas.map((g) => (
        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
          <span class="mt-1 inline-block h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
          <span>{g}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Full Evidence-Anchored Specification Table -->
  <div class="mt-8">
    <SpecTable item={item} locale={locale} />
  </div>

  <!-- Mandatory Vertical Safety / Regulatory Disclaimer Banner -->
  <div class="mt-8">
    <SafetyBanner vertical={vertical} locale={locale} item={item} />
  </div>

  <!-- Official Citations -->
  <section class="mt-8 lab-card p-5" aria-labelledby="citations-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="citations-heading" class="text-base font-bold text-slate-900">
        {isKo ? "공식 원천 근거 및 검증 출처" : "Official Citations & Evidence Anchors"}
      </h2>
      <a
        href={`/${locale}/contact`}
        class="font-mono text-xs font-medium text-blue-700 hover:underline"
      >
        {isKo ? "스펙 오류 제보 →" : "Report Spec Discrepancy →"}
      </a>
    </div>
    <ul class="mt-3 divide-y divide-slate-100">
      {item.citations.map((cit) => (
        <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-xs">
          <div class="flex items-center gap-2">
            <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700">
              Tier {cit.source_tier}
            </span>
            <a
              href={cit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-blue-700 hover:underline"
            >
              {cit.label} ↗
            </a>
          </div>
          <span class="font-mono text-slate-500">
            {isKo ? "확인일" : "Verified"} {cit.verified_at}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Related VS Matchups -->
  {relatedVs.length > 0 && (
    <section class="mt-8 space-y-3" aria-labelledby="related-vs-heading">
      <h2 id="related-vs-heading" class="text-lg font-bold tracking-tight text-slate-900">
        {isKo ? "이 모델의 1:1 정밀 비교 (VS)" : "Head-to-Head VS Comparisons"}
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {relatedVs.map((vs) => (
          <a
            href={`/${locale}/${vertical}/vs/${vs.pair_slug}`}
            class="lab-card group flex items-center justify-between gap-3 p-4 transition-colors hover:border-blue-500"
          >
            <div>
              <div class="text-sm font-bold text-slate-900 group-hover:text-blue-700">
                {vs.verdict[locale].headline}
              </div>
              <div class="mt-1 font-mono text-xs text-slate-500">
                {vs.pair_slug} · IG {vs.info_gain_score}/100
              </div>
            </div>
            <span class="shrink-0 font-mono text-xs font-bold text-blue-700">VS →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Peer / Fallback Models -->
  {peers.length > 0 && (
    <section class="mt-8 space-y-3" aria-labelledby="peers-heading">
      <h2 id="peers-heading" class="text-lg font-bold tracking-tight text-slate-900">
        {isKo ? "동급·대체 추천 검증 모델" : "Comparable Verified Alternatives"}
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {peers.map((p) => {
          const pc = p.i18n[locale] ?? p.i18n.en;
          const po = isKo ? p.regional_offers.kr : p.regional_offers.us;
          return (
            <a
              href={`/${locale}/${vertical}/item/${p.slug}`}
              class="lab-card group flex flex-col justify-between p-4 transition-colors hover:border-blue-500"
            >
              <div>
                <div class="text-[11px] font-semibold text-slate-500">
                  {p.brand} · Trust {p.audit.trust_score}
                </div>
                <div class="mt-1 text-sm font-bold text-slate-900 group-hover:text-blue-700">
                  {pc.name}
                </div>
                <p class="mt-1 line-clamp-2 text-xs text-slate-600">{pc.summary}</p>
              </div>
              <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2 text-xs">
                <span class="font-mono font-semibold text-slate-700">
                  {formatCurrency(po.msrp, po.currency, locale)}
                </span>
                <span class="font-mono font-semibold text-blue-700">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
