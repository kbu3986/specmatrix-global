---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AffiliateCtaCard from "../../../../components/AffiliateCtaCard.astro";
import SafetyBanner from "../../../../components/SafetyBanner.astro";
import SpecTable from "../../../../components/SpecTable.astro";
import AdSlotReserve from "../../../../components/AdSlotReserve.astro";
import CategoryBenchmarkChart from "../../../../components/CategoryBenchmarkChart.astro";
import MobileStickyCta from "../../../../components/MobileStickyCta.astro";
import WattCheckCalc from "../../../../components/calculators/WattCheckCalc.astro";
import PureGramCalc from "../../../../components/calculators/PureGramCalc.astro";
import CycleGearCalc from "../../../../components/calculators/CycleGearCalc.astro";
import HomeTechCalc from "../../../../components/calculators/HomeTechCalc.astro";

import type { ActiveLocale, AnyItem, PilotVertical } from "../../../../lib/types";
import {
  getAirlines,
  getAllItems,
  getFallbackItems,
  getFxRates,
  getPrimaryVerticalHref,
  getRelatedVsForItem,
  getVerticalItems,
} from "../../../../lib/data";
import {
  computeHomeTechDerived,
  computePureGramDerived,
  computeWattCheckDerived,
  getItemDerivedKpis,
} from "../../../../lib/derived";
import {
  ACTIVE_LOCALES,
  VERTICAL_META,
  formatCurrency,
  formatInt,
  formatNum,
  getCategoryLabel,
  toAbsoluteUrl,
  withBase,
} from "../../../../lib/i18n";

export function getStaticPaths() {
  const items = getAllItems();
  const paths: Array<{
    params: { locale: ActiveLocale; vertical: PilotVertical; slug: string };
    props: { item: AnyItem };
  }> = [];

  for (const item of items) {
    for (const locale of ACTIVE_LOCALES) {
      if (!item.available_locales.includes(locale)) continue;
      if (!item.i18n[locale]) continue;
      paths.push({
        params: {
          locale,
          vertical: item.vertical as PilotVertical,
          slug: item.slug,
        },
        props: { item },
      });
    }
  }
  return paths;
}

const locale = Astro.params.locale as ActiveLocale;
const vertical = Astro.params.vertical as PilotVertical;
const { item } = Astro.props as { item: AnyItem };

const isKo = locale === "ko";
const fx = getFxRates();
const airlines = vertical === "wattcheck" ? getAirlines() : [];
const copy = item.i18n[locale] ?? item.i18n.en;
const kpis = getItemDerivedKpis(item, fx, locale);
const relatedVs = getRelatedVsForItem(vertical, item.slug);
const peers = getFallbackItems(item, 3);
const categoryPeers = getVerticalItems(vertical).filter((p) => p.category === item.category);
const verticalHref = getPrimaryVerticalHref(locale, vertical);
const currentPath = `/${locale}/${vertical}/item/${item.slug}`;
const availLocales = ACTIVE_LOCALES.filter((l) => item.available_locales.includes(l));
const compareLaunchHref = withBase(`/${locale}/compare#${vertical}:${item.slug}:`);
const reportHref = withBase(`/${locale}/contact?sku=${encodeURIComponent(item.slug)}&vertical=${encodeURIComponent(vertical)}`);

// Deterministic Quick Engineering Q&A (3 verified Q&As — pure HTML <details>, zero FAQPage JSON-LD spam)
interface QuickQa {
  q: string;
  a: string;
}

const KO_PG_UNIT: Record<string, string> = {
  packet: "포(패킷)",
  scoop: "스쿱",
  tablet: "정(태블릿)",
  pouch: "파우치",
  bottle: "병",
  bar: "바",
};

const KO_PG_ACTIVE: Record<string, string> = {
  carbohydrates: "탄수화물",
  electrolytes_sodium_potassium: "전해질 (나트륨+칼륨)",
  creatine_monohydrate: "크레아틴 모노하이드레이트",
  "creatine monohydrate": "크레아틴 모노하이드레이트",
};

const KO_PG_FORM: Record<string, string> = {
  hydrogel: "하이드로겔",
  isotonic: "아이소토닉",
  standard: "스탠다드",
  none: "해당 없음",
};

function formatKoSweetenerNote(listed: boolean, details: string): string {
  const low = (details || "").toLowerCase();
  if (listed) {
    const found: string[] = [];
    if (low.includes("acesulfame") || low.includes("ace-k")) found.push("아세설팜칼륨(Ace-K)");
    if (low.includes("sucralose")) found.push("수크랄로스");
    if (low.includes("sorbitol")) found.push("소르비톨");
    if (low.includes("aspartame")) found.push("아스파탐");
    if (low.includes("stevia")) found.push("스테비아");
    return found.length > 0 ? `포함 (${found.join(" · ")})` : "포함";
  }
  if (low.includes("flavored") && low.includes("sucralose")) {
    return "무향 기준 인공감미료 무첨가 (가향 제품은 수크랄로스 포함)";
  }
  if (low.includes("creapure")) return "인공감미료 무첨가 (무향 100% Creapure 단일 원료)";
  if (low.includes("creatine")) return "인공감미료 무첨가 (무향 단일 성분 크레아틴)";
  if (low.includes("alginate") || low.includes("hydrogel")) return "인공감미료 무첨가 (포도당·과당 하이드로겔)";
  if (low.includes("cane sugar")) return "인공감미료 무첨가 (사탕수수당·포도당·천연 과일 파우더)";
  if (low.includes("maltodextrin") && low.includes("fructose")) return "인공감미료 무첨가 (말토덱스트린·과당 기반)";
  if (low.includes("dextrose") && low.includes("sucrose")) return "인공감미료 무첨가 (포도당·자당 기반)";
  if (low.includes("dextrin")) return "인공감미료 무첨가 (설탕·포도당·덱스트린 기반)";
  if (low.includes("glucose") && low.includes("fructose")) return "인공감미료 무첨가 (포도당·과당 기반)";
  return "인공감미료 무첨가";
}

function buildQuickQas(): QuickQa[] {
  if (item.vertical === "wattcheck") {
    const s = item.specs;
    const d = computeWattCheckDerived(item, fx);
    const acp = item.airline_compliance_profile;
    const certs = [
      s.ul_etl_certified ? "UL/ETL" : null,
      s.ce_certified ? "CE" : null,
      s.kc_certified ? "KC" : null,
      s.pse_certified ? "PSE" : null,
      s.ccc_certified ? "CCC" : null,
    ].filter(Boolean);

    const koMolitNote = acp.carryon_allowed
      ? "국내 출발 항공편은 개별 지퍼백·단자 절연 보관, 기내 선반 보관 금지(직접 소지 또는 앞좌석 포켓 보관), 기내 충전 금지가 적용됩니다."
      : "IATA·국토부 규정상 전 세계 여객기 기내 반입 및 위탁수하물이 모두 전면 금지됩니다.";

    return [
      {
        q: isKo
          ? `${copy.name}은(는) 항공기 기내 반입 및 위탁수하물이 가능한가요?`
          : `Is the ${copy.name} allowed in airline carry-on or checked baggage?`,
        a: s.has_battery
          ? isKo
            ? `정격 ${formatNum(s.battery_energy_wh, 2)} Wh 기준 ${acp.carryon_no_approval ? "IATA 100Wh 미만 무승인 기내 반입 가능" : acp.carryon_allowed ? "100–160Wh 구간으로 항공사 사전 승인 필요" : "160Wh 초과로 항공 반입 불가"} 등급입니다. 위탁수하물은 ${acp.checked_baggage === "allowed" ? "허용" : "엄격 금지"}이며, 중국 국내선 CCC 요건 충족 여부는 ${acp.china_domestic_ccc_ok ? "충족" : "미충족(주의)"}입니다. ${koMolitNote}`
            : `Rated at ${formatNum(s.battery_energy_wh, 2)} Wh: ${acp.carryon_no_approval ? "carry-on allowed without airline pre-approval (<100 Wh IATA tier)" : acp.carryon_allowed ? "100–160 Wh tier requiring airline pre-approval" : "over 160 Wh and prohibited on passenger flights"}. Checked baggage is ${acp.checked_baggage}. China domestic CCC flight compliance: ${acp.china_domestic_ccc_ok ? "Yes" : "No"}.`
          : isKo
            ? `내장 배터리가 없는 충전기(${formatInt(s.weight_g)}g)이므로 기내 수하물과 위탁수하물 모두 리튬배터리 제한 없이 반입 가능합니다.`
            : `This unit has no internal lithium battery (${formatInt(s.weight_g)} g), so it is permitted in both carry-on and checked luggage without Wh restrictions.`,
      },
      {
        q: isKo
          ? `실가용 용량과 멀티포트 동시 충전 출력·프로토콜 스펙은 어떻게 되나요?`
          : `What are the real usable capacity, multi-port output, and charging protocols?`,
        a: isKo
          ? `최대 합산 출력 ${formatInt(s.max_total_output_w)}W, 단일 포트 최대 ${formatInt(s.max_single_port_output_w)}W(${s.ports.length}개 포트)를 지원합니다. ${d.usableWh !== null ? `변환효율 ${s.conversion_efficiency_pct ?? 82}% 반영 실가용 에너지는 약 ${formatNum(d.usableWh, 1)}Wh(아이폰 16 프로 약 ${formatNum(d.charges.iphone16pro, 1)}회 완충)입니다. ` : ""}PD 3.1 EPR: ${s.supports_pd_3_1_epr ? "지원" : "미지원"}, 삼성 45W PPS: ${s.supports_samsung_pps_45w ? "지원" : "미지원"}, 포트 추가 시 순간 단절: ${s.power_renegotiation_drop ? "발생" : "없음"}.`
          : `Supports up to ${formatInt(s.max_total_output_w)} W combined and ${formatInt(s.max_single_port_output_w)} W single-port across ${s.ports.length} ports. ${d.usableWh !== null ? `Accounting for ${s.conversion_efficiency_pct ?? 82}% conversion efficiency, real usable energy is ~${formatNum(d.usableWh, 1)} Wh (~${formatNum(d.charges.iphone16pro, 1)}× iPhone 16 Pro charges). ` : ""}PD 3.1 EPR: ${s.supports_pd_3_1_epr ? "Yes" : "No"}, Samsung 45W PPS: ${s.supports_samsung_pps_45w ? "Yes" : "No"}, renegotiation drop on plug-in: ${s.power_renegotiation_drop ? "Occurs" : "No"}.`,
      },
      {
        q: isKo
          ? `지원 입력 전압(100–240V)과 안전인증 현황은?`
          : `What input voltage range and regional safety certifications are verified?`,
        a: isKo
          ? `공식 입력 규격은 ${s.input_voltage_range}이며, 확인된 안전인증은 ${certs.length > 0 ? certs.join(", ") : "상세 스펙표 참조"}입니다.${s.japan_100v_output_limit_w !== null ? ` 일본 100V 환경에서는 최대 출력이 ${formatInt(s.japan_100v_output_limit_w)}W로 제한될 수 있습니다.` : ""}`
          : `Official input rating is ${s.input_voltage_range} with verified regional certifications: ${certs.length > 0 ? certs.join(", ") : "see specification table"}.${s.japan_100v_output_limit_w !== null ? ` Note: On 100V Japan grids, output may cap at ${formatInt(s.japan_100v_output_limit_w)} W.` : ""}`,
      },
    ];
  }

  if (item.vertical === "puregram") {
    const d = computePureGramDerived(item, fx);
    const nl = item.nutrition_label;
    const pkg = item.package_spec;
    const benchLabel = isKo
      ? item.derived_math.benchmark_label_ko
      : item.derived_math.benchmark_label_en;
    const koUnit = KO_PG_UNIT[pkg.unit_type] ?? pkg.unit_type;
    const koActive =
      KO_PG_ACTIVE[nl.active_ingredient_type] ??
      KO_PG_ACTIVE[nl.active_ingredient_type.replace(/_/g, " ")] ??
      nl.active_ingredient_type.replace(/_/g, " ");
    const koForm = KO_PG_FORM[nl.hydrogel_or_isotonic] ?? nl.hydrogel_or_isotonic;
    const koSweetener = formatKoSweetenerNote(nl.artificial_sweeteners_listed, nl.sweetener_details);

    return [
      {
        q: isKo
          ? `${copy.name}의 순수 유효성분 기준 실단가와 순도 비율은 얼마인가요?`
          : `What is the true cost per benchmark active unit and purity ratio?`,
        a: isKo
          ? `공식 MSRP 기준 ${benchLabel}당 ${formatCurrency(d.krwPerBenchmarkUnit, "KRW", "ko")}(1회분 ${formatCurrency(d.krwPerServing, "KRW", "ko")}, 총 ${formatInt(pkg.total_servings)}회분·${koUnit} 단위)입니다. 1회 제공량(${formatNum(pkg.serving_weight_g, 1)}g) 중 핵심 유효성분(${koActive})은 ${formatNum(nl.active_per_serving_g, 1)}g으로 중량비 순도 ${formatNum(item.derived_math.purity_pct, 1)}%(등급 ${item.derived_math.purity_grade})입니다.`
          : `At official MSRP benchmark, true cost is ${formatCurrency(d.usdPerBenchmarkUnit, "USD", "en")} per ${benchLabel} (${formatCurrency(d.usdPerServing, "USD", "en")}/serving across ${formatInt(pkg.total_servings)} servings). Each ${formatNum(pkg.serving_weight_g, 1)} g serving delivers ${formatNum(nl.active_per_serving_g, 1)} g pure active (${formatNum(item.derived_math.purity_pct, 1)}% purity, Grade ${item.derived_math.purity_grade}).`,
      },
      {
        q: isKo
          ? `레이스 시간당 90g 보급 시 필요 개수와 나트륨·카페인 함량은?`
          : `How many servings are needed for 90g/hr fueling, and what are sodium/caffeine levels?`,
        a: isKo
          ? `${d.servingsFor90gPerHour !== null ? `1회당 탄수화물 ${formatNum(nl.carbs_g, 1)}g 기준으로 시간당 90g 보급에 약 ${formatNum(d.servingsFor90gPerHour, 1)}개(${formatCurrency(d.raceCost90gPerHourKrw, "KRW", "ko")}/시간)가 필요합니다. ` : ""}당 비율은 ${nl.carb_ratio_glucose_to_fructose ?? "단일/해당없음"}, 제형은 ${koForm}이며 1회당 나트륨 ${formatInt(nl.sodium_mg)}mg, 카페인 ${formatInt(nl.caffeine_mg)}mg을 함유합니다.`
          : `${d.servingsFor90gPerHour !== null ? `With ${formatNum(nl.carbs_g, 1)} g carbs per serving, hitting 90 g/hr requires ~${formatNum(d.servingsFor90gPerHour, 1)} servings/hr (${formatCurrency(d.raceCost90gPerHourUsd, "USD", "en")}/hr). ` : ""}Carb ratio: ${nl.carb_ratio_glucose_to_fructose ?? "single/N/A"}, format: ${nl.hydrogel_or_isotonic}, with ${formatInt(nl.sodium_mg)} mg sodium and ${formatInt(nl.caffeine_mg)} mg caffeine per serving.`,
      },
      {
        q: isKo
          ? `안티도핑·품질 인증 및 인공감미료 포함 여부는 어떻게 되나요?`
          : `What third-party certifications and sweetener disclosures apply?`,
        a: isKo
          ? `확인된 인증은 ${item.certifications.join(", ")}이며, 영양성분표 기준 인공감미료 내역은 ${koSweetener}, Creapure 인증: ${nl.creapure_certified ? "예" : "해당없음"}입니다.`
          : `Verified certifications include ${item.certifications.join(", ")}. Printed label notes artificial sweeteners: ${nl.artificial_sweeteners_listed ? "Yes" : "None listed"} (${nl.sweetener_details}); Creapure certified: ${nl.creapure_certified ? "Yes" : "No"}.`,
      },
    ];
  }

  if (item.vertical === "cyclegear") {
    const s = item.specs;
    const cg = item.compatibility_graph;
    const sw = item.safety_warning;

    return [
      {
        q: isKo
          ? `${copy.name}의 장착 규격(BB/마운트/프리허브)과 호환 구동계는?`
          : `What mount/BB/freehub standards and drivetrains are compatible?`,
        a: isKo
          ? `장착 규격은 ${cg.bb_or_mount_standard}, 프리허브/클릿 규격은 ${cg.freehub_or_cleat_standard}입니다. 공식 확인된 호환 구동계는 ${cg.drivetrain_compatible.slice(0, 4).join(", ") || "공식 매뉴얼 참조"}입니다.`
          : `Mount/BB standard: ${cg.bb_or_mount_standard}; Freehub/cleat interface: ${cg.freehub_or_cleat_standard}. Verified compatible drivetrains: ${cg.drivetrain_compatible.slice(0, 4).join(", ") || "see official manual"}.`,
      },
      {
        q: isKo
          ? `후크리스(Hookless) 림 호환 및 규정 토크 안전 기준은 무엇인가요?`
          : `What are the hookless rim limits and torque safety requirements?`,
        a: isKo
          ? `${sw.requires_hookless_warning ? `후크리스 호환 여부: ${s.hookless_compatible ? `지원 (최대 ${formatNum(s.hookless_max_psi ?? 72.5, 1)} psi / 5.0 bar 절대 상한)` : "후크리스 비권장 — 훅드 림 전용"}. ` : ""}${sw.torque_or_install_note_ko}`
          : `${sw.requires_hookless_warning ? `Hookless status: ${s.hookless_compatible ? `Supported (ISO/ETRTO hard cap ${formatNum(s.hookless_max_psi ?? 72.5, 1)} psi / 5.0 bar)` : "Hooked rims only"}. ` : ""}${sw.torque_or_install_note_en}`,
      },
      {
        q: isKo
          ? `공식 중량과 통신 규격·헤드유닛 연동 범위는?`
          : `What are the official weight, wireless protocols, and head-unit integrations?`,
        a: isKo
          ? `공식 중량은 ${formatInt(s.weight_g)}g이며${s.claimed_accuracy_pct !== null ? ` 공칭 정확도 ±${formatNum(s.claimed_accuracy_pct, 1)}%,` : ""}${s.battery_life_hours !== null ? ` 배터리 수명 ${formatInt(s.battery_life_hours)}시간,` : ""}${s.max_trainer_watts !== null ? ` 최대 부하 ${formatInt(s.max_trainer_watts)}W,` : ""} 통신 규격은 ${s.connectivity.join(", ") || "기계식"}입니다. 검증 앱/헤드유닛: ${cg.head_unit_or_app_verified.slice(0, 4).join(", ") || "표준 호환"}.`
          : `Official weight is ${formatInt(s.weight_g)} g${s.claimed_accuracy_pct !== null ? `, claimed accuracy ±${formatNum(s.claimed_accuracy_pct, 1)}%` : ""}${s.battery_life_hours !== null ? `, battery life ${formatInt(s.battery_life_hours)} hr` : ""}${s.max_trainer_watts !== null ? `, max resistance ${formatInt(s.max_trainer_watts)} W` : ""}. Connectivity: ${s.connectivity.join(", ") || "Mechanical"}. Verified ecosystems: ${cg.head_unit_or_app_verified.slice(0, 4).join(", ") || "Standard"}.`,
      },
    ];
  }

  // HomeTech
  const s = item.specs;
  const tp = item.tco_profile;
  const d = computeHomeTechDerived(item, fx);

  return [
    {
      q: isKo
        ? `${copy.name}을(를) 3년간 가동할 때 예상 전기요금과 총소유비용(TCO)은 얼마인가요?`
        : `What is the estimated annual electricity cost and 3-year TCO for ${copy.name}?`,
      a: isKo
        ? `대기 ${formatNum(s.idle_power_w, 1)}W · 부하 ${formatNum(s.typical_load_w, 1)}W(일 ${formatNum(s.default_daily_hours_active, 1)}시간 활성) 기준 가중 평균 소비전력은 ${formatNum(d.weightedAvgW, 1)}W, 연간 ${formatNum(d.annualKwh, 1)} kWh입니다. 한전 누진 2구간(214원/kWh) 기준 연 전기요금 ${formatCurrency(d.annualElecKrw, "KRW", "ko")}, 연 소모품 ${formatCurrency(s.annual_consumables_krw, "KRW", "ko")}를 합산한 3년 TCO는 ${formatCurrency(d.tco3yrKrw, "KRW", "ko")}입니다.`
        : `At ${formatNum(s.idle_power_w, 1)} W idle and ${formatNum(s.typical_load_w, 1)} W typical load (${formatNum(s.default_daily_hours_active, 1)} hr/day active), weighted average draw is ${formatNum(d.weightedAvgW, 1)} W (${formatNum(d.annualKwh, 1)} kWh/yr). At US $0.17/kWh, electricity costs ${formatCurrency(d.annualElecUsd, "USD", "en")}/yr (DE €0.38/kWh: ${formatCurrency(d.annualElecEurDe, "EUR", "en")}/yr), yielding a 3-year TCO of ${formatCurrency(d.tco3yrUsd, "USD", "en")} including ${formatCurrency(s.annual_consumables_usd, "USD", "en")}/yr consumables.`,
    },
    {
      q: isKo
        ? `한국 220V/60Hz 전원 호환 여부(프리볼트)와 안전인증은 어떻게 되나요?`
        : `Does ${copy.name} support 100–240V dual voltage and regional safety certifications?`,
      a: isKo
        ? `입력 전압 규격은 ${s.input_voltage_range}이며 100–240V 프리볼트 지원 여부: ${s.dual_voltage_100_240v ? "지원" : "미지원(지역 전압 확인 필수)"}. 보유 인증: ${s.certifications.join(", ")}. ${tp.korea_220v_note_ko}`
        : `Input voltage rating is ${s.input_voltage_range} (100–240V dual voltage: ${s.dual_voltage_100_240v ? "Yes" : "No — verify local voltage"}). Certifications: ${s.certifications.join(", ")}. ${tp.korea_220v_note_en}`,
    },
    {
      q: isKo
        ? `작동 소음, 크기·무게 및 예상 교체 주기(수명)는?`
        : `What are the acoustic noise levels, physical dimensions, and expected service lifespan?`,
      a: isKo
        ? `본체 크기는 ${formatInt(s.dimensions_mm.l)}×${formatInt(s.dimensions_mm.w)}×${formatInt(s.dimensions_mm.h)} mm, 무게 ${formatInt(s.weight_g)}g입니다. ${s.noise_idle_dba !== null || s.noise_load_dba !== null ? `소음은 대기 ${s.noise_idle_dba !== null ? `${formatNum(s.noise_idle_dba, 1)} dBA` : "—"} / 부하 ${s.noise_load_dba !== null ? `${formatNum(s.noise_load_dba, 1)} dBA` : "—"} 수준이며 ` : ""}권장 기대 수명은 약 ${formatInt(tp.expected_lifespan_years)}년${tp.battery_or_filter_cycle_months !== null ? `(배터리·필터 교체 주기 약 ${formatInt(tp.battery_or_filter_cycle_months)}개월)` : ""}입니다.`
        : `Dimensions are ${formatInt(s.dimensions_mm.l)}×${formatInt(s.dimensions_mm.w)}×${formatInt(s.dimensions_mm.h)} mm at ${formatInt(s.weight_g)} g. ${s.noise_idle_dba !== null || s.noise_load_dba !== null ? `Noise levels are ${s.noise_idle_dba !== null ? `${formatNum(s.noise_idle_dba, 1)} dBA` : "—"} idle / ${s.noise_load_dba !== null ? `${formatNum(s.noise_load_dba, 1)} dBA` : "—"} under load, with ` : "With "}an expected hardware lifespan of ~${formatInt(tp.expected_lifespan_years)} years${tp.battery_or_filter_cycle_months !== null ? ` (battery/filter maintenance cycle ~${formatInt(tp.battery_or_filter_cycle_months)} months)` : ""}.`,
    },
  ];
}

const quickQas = buildQuickQas();

const additionalProperty: Array<{ "@type": "PropertyValue"; name: string; value: string }> = [
  { "@type": "PropertyValue", name: "Trust Score", value: `${item.audit.trust_score}/100` },
  { "@type": "PropertyValue", name: "Fact Checked At", value: item.audit.fact_checked_at },
  ...kpis.map((k) => ({
    "@type": "PropertyValue" as const,
    name: k.label,
    value: k.value,
  })),
];

const webAppName =
  vertical === "wattcheck"
    ? isKo
      ? `${copy.name} 기내반입·USB-PD 시뮬레이터`
      : `${copy.name} Airline & USB-PD Simulator`
    : vertical === "puregram"
      ? isKo
        ? `${copy.name} 유효성분 실단가·보급 계산기`
        : `${copy.name} Active Cost & Fueling Calculator`
      : vertical === "hometech"
        ? isKo
          ? `${copy.name} 3년 TCO·전기요금 계산기`
          : `${copy.name} 3-Year TCO & Power Calculator`
        : item.category === "road-tire"
          ? isKo
            ? `${copy.name} 후크리스·공기압 안전 가드`
            : `${copy.name} Hookless & Tire Pressure Guard`
          : isKo
            ? `${copy.name} 자전거 호환성 검증기`
            : `${copy.name} Bike Compatibility Checker`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: copy.name,
    image: toAbsoluteUrl(`/og/og-${vertical}.png`),
    brand: { "@type": "Brand", name: item.brand },
    mpn: item.model_number,
    category: getCategoryLabel(item.category, locale),
    description: copy.summary,
    url: toAbsoluteUrl(currentPath),
    review: {
      "@type": "Review",
      author: { "@type": "Organization", name: "SpecMatrix Global" },
      reviewRating: {
        "@type": "Rating",
        ratingValue: item.audit.trust_score,
        bestRating: 100,
        worstRating: 1,
      },
      reviewBody: copy.summary,
      datePublished: item.audit.fact_checked_at,
    },
    additionalProperty,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: webAppName,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    url: toAbsoluteUrl(currentPath),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: VERTICAL_META[vertical].shortName[locale],
        item: toAbsoluteUrl(verticalHref),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: copy.name,
        item: toAbsoluteUrl(currentPath),
      },
    ],
  },
];
---

<BaseLayout
  title={`${copy.title} | SpecMatrix Global`}
  description={copy.summary}
  locale={locale}
  currentPath={currentPath}
  activeVertical={vertical}
  availableLocales={availLocales}
  hasStickyCta={true}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-neutral-400">
    <a href={withBase(`/${locale}`)} class="hover:text-[#dafa9c] hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    <span>/</span>
    <a href={withBase(verticalHref)} class="hover:text-[#dafa9c] hover:underline">
      {VERTICAL_META[vertical].shortName[locale]}
    </a>
    <span>/</span>
    <span class="font-medium text-white">{copy.name}</span>
  </nav>

  <!-- Product Header & MSRP CTA -->
  <section class="grid gap-6 lg:grid-cols-12">
    <div class="space-y-4 lg:col-span-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-pass">
          Trust {item.audit.trust_score}/100 · {isKo ? "적대적 팩트체크 완료" : "Fact-Checked"}
        </span>
        <span class="badge-info font-mono">
          {item.brand} · {item.model_number}
        </span>
        <span class="rounded-full border border-white/15 bg-[#161616] px-2.5 py-0.5 text-xs font-medium text-neutral-300">
          {getCategoryLabel(item.category, locale)}
        </span>
      </div>

      <h1 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        {copy.title}
      </h1>

      <p class="text-sm leading-relaxed text-neutral-300 sm:text-base">
        {copy.summary}
      </p>

      <div class="rounded-lg border border-sky-700/50 bg-[#0f1f30] p-4">
        <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-sky-200">
          {isKo ? "추천 대상 (Best For)" : "BEST FOR"}
        </div>
        <p class="mt-1 text-sm font-medium text-white">{copy.best_for}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-neutral-400">
        <span>{isKo ? "최종 검증일:" : "Fact-checked:"} {item.audit.fact_checked_at}</span>
        <span>·</span>
        <span>IG Score {item.audit.info_gain_score}/100</span>
        <span>·</span>
        <span>{item.citations.length} {isKo ? "공식 출처" : "official citations"}</span>
      </div>
    </div>

    <div class="lg:col-span-4">
      <AffiliateCtaCard item={item} locale={locale} />
    </div>
  </section>

  <!-- Derived KPI Strip (4 Deterministic Metrics) -->
  <section class="mt-8" aria-label={isKo ? "핵심 파생 지표" : "Derived Key Performance Indicators"}>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {kpis.map((kpi) => (
        <div class="lab-card p-4">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-wide text-neutral-400">
            {kpi.label}
          </div>
          <div
            class:list={[
              "kpi-value mt-1.5 font-mono text-xl font-bold",
              kpi.tone === "pass"
                ? "text-emerald-300"
                : kpi.tone === "fail"
                  ? "text-rose-300"
                  : kpi.tone === "caution"
                    ? "text-amber-300"
                    : kpi.tone === "info"
                      ? "text-[#dafa9c]"
                      : "text-white",
            ]}
          >
            {kpi.value}
          </div>
          <div class="mt-1 text-xs text-neutral-400">{kpi.sublabel}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Category Percentile Benchmark SVG Chart -->
  {categoryPeers.length >= 2 && (
    <div class="mt-6">
      <CategoryBenchmarkChart item={item} peers={categoryPeers} fx={fx} locale={locale} />
    </div>
  )}

  <AdSlotReserve slotId={`item-top-${vertical}`} variant="banner" locale={locale} />

  <!-- Vertical Interactive Calculator Island -->
  <div class="mt-6">
    {item.vertical === "wattcheck" && (
      <WattCheckCalc item={item} airlines={airlines} locale={locale} />
    )}
    {item.vertical === "puregram" && (
      <PureGramCalc item={item} fx={fx} locale={locale} />
    )}
    {item.vertical === "cyclegear" && (
      <CycleGearCalc item={item} locale={locale} />
    )}
    {item.vertical === "hometech" && (
      <HomeTechCalc item={item} fx={fx} locale={locale} />
    )}
  </div>

  <!-- Real-World Local Gotchas -->
  <section class="mt-8 lab-card p-5" aria-labelledby="gotchas-heading">
    <h2 id="gotchas-heading" class="text-base font-bold text-white">
      {isKo
        ? "구매 전 필독 — 한국 환경·실사용 함정 (Local Gotchas)"
        : "Before You Buy — Real-World Edge Cases & Local Gotchas"}
    </h2>
    <ul class="mt-3 space-y-2">
      {copy.local_gotchas.map((g) => (
        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-neutral-300">
          <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-amber-400"></span>
          <span>{g}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Full Evidence-Anchored Specification Table -->
  <div class="mt-8">
    <SpecTable item={item} locale={locale} />
  </div>

  <!-- Quick Engineering Q&A (Deterministic HTML Accordion, zero FAQPage JSON-LD spam) -->
  <section class="mt-8 lab-card p-5" aria-labelledby="quick-qa-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="quick-qa-heading" class="text-base font-bold text-white">
        {isKo ? "핵심 스펙 요약 Q&A (공식 데이터 기반)" : "Quick Engineering Q&A (Verified Specs)"}
      </h2>
      <span class="font-mono text-[11px] text-neutral-400">SSOT Derived</span>
    </div>
    <div class="mt-3 divide-y divide-white/10">
      {quickQas.map((qa, idx) => (
        <details class="group py-3" open={idx === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-white hover:text-[#dafa9c]">
            <span>{qa.q}</span>
            <span class="shrink-0 font-mono text-xs text-neutral-400 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2 text-sm leading-relaxed text-neutral-300">{qa.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Mandatory Vertical Safety / Regulatory Disclaimer Banner -->
  <div class="mt-8">
    <SafetyBanner vertical={vertical} locale={locale} item={item} />
  </div>

  <!-- Official Citations -->
  <section class="mt-8 lab-card p-5" aria-labelledby="citations-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="citations-heading" class="text-base font-bold text-white">
        {isKo ? "공식 원천 근거 및 검증 출처" : "Official Citations & Evidence Anchors"}
      </h2>
      <a
        href={reportHref}
        class="font-mono text-xs font-medium text-[#dafa9c] hover:underline"
      >
        {isKo ? "스펙 오류 제보 →" : "Report Spec Discrepancy →"}
      </a>
    </div>
    <ul class="mt-3 divide-y divide-white/10">
      {item.citations.map((cit) => (
        <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-xs">
          <div class="flex items-center gap-2">
            <span class="rounded border border-white/15 bg-[#111111] px-2 py-0.5 font-mono text-[11px] font-bold text-neutral-300">
              Tier {cit.source_tier}
            </span>
            <a
              href={cit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-[#dafa9c] hover:underline"
            >
              {cit.label} ↗
            </a>
          </div>
          <span class="font-mono text-neutral-400">
            {isKo ? "확인일" : "Verified"} {cit.verified_at}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Related VS Matchups & Live Compare Launcher -->
  <section class="mt-8 space-y-3" aria-labelledby="related-vs-heading">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="related-vs-heading" class="text-lg font-bold tracking-tight text-white">
        {isKo ? "이 모델의 1:1 정밀 비교 (VS)" : "Head-to-Head VS Comparisons"}
      </h2>
      <a
        href={compareLaunchHref}
        class="inline-flex items-center gap-1.5 rounded-md bg-[#dafa9c] px-3.5 py-1.5 font-mono text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
      >
        <span>{isKo ? "원하는 모델과 자유 1:1 비교 →" : "Compare with any model →"}</span>
      </a>
    </div>

    {relatedVs.length > 0 ? (
      <div class="grid gap-3 md:grid-cols-2">
        {relatedVs.map((vs) => (
          <a
            href={withBase(`/${locale}/${vertical}/vs/${vs.pair_slug}`)}
            class="lab-card group flex min-w-0 items-center justify-between gap-3 p-4 transition-colors hover:border-white/25 hover:bg-[#1c1c1c]"
          >
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-bold text-white group-hover:text-[#dafa9c]">
                {vs.verdict[locale].headline}
              </div>
              <div class="mt-1 truncate font-mono text-xs text-neutral-400">
                {vs.pair_slug} · IG {vs.info_gain_score}/100
              </div>
            </div>
            <span class="shrink-0 font-mono text-xs font-bold text-[#dafa9c]">VS →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="lab-card flex flex-wrap items-center justify-between gap-3 p-4 text-sm text-neutral-300">
        <span>
          {isKo
            ? `${copy.name}과(와) 같은 버티컬의 모든 검증 모델을 실시간 스튜디오에서 1:1로 비교할 수 있습니다.`
            : `Compare ${copy.name} side-by-side against any verified peer in the Live Compare Workbench.`}
        </span>
        <a
          href={compareLaunchHref}
          class="shrink-0 font-mono text-xs font-bold text-[#dafa9c] hover:underline"
        >
          {isKo ? "스튜디오 열기 →" : "Open Workbench →"}
        </a>
      </div>
    )}
  </section>

  <!-- Peer / Fallback Models -->
  {peers.length > 0 && (
    <section class="mt-8 space-y-3" aria-labelledby="peers-heading">
      <h2 id="peers-heading" class="text-lg font-bold tracking-tight text-white">
        {isKo ? "동급·대체 추천 검증 모델" : "Comparable Verified Alternatives"}
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {peers.map((p) => {
          const pc = p.i18n[locale] ?? p.i18n.en;
          const po = isKo ? p.regional_offers.kr : p.regional_offers.us;
          return (
            <a
              href={withBase(`/${locale}/${vertical}/item/${p.slug}`)}
              class="lab-card group flex flex-col justify-between p-4 transition-colors hover:border-white/25 hover:bg-[#1c1c1c]"
            >
              <div>
                <div class="text-[11px] font-semibold text-neutral-400">
                  {p.brand} · Trust {p.audit.trust_score}
                </div>
                <div class="mt-1 text-sm font-bold text-white group-hover:text-[#dafa9c]">
                  {pc.name}
                </div>
                <p class="mt-1 line-clamp-2 text-xs text-neutral-400">{pc.summary}</p>
              </div>
              <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-xs">
                <span class="font-mono font-semibold text-neutral-200">
                  {formatCurrency(po.msrp, po.currency, locale)}
                </span>
                <span class="font-mono font-semibold text-[#dafa9c]">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <MobileStickyCta item={item} locale={locale} />
</BaseLayout>
