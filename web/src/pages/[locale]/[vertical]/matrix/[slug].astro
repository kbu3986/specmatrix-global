---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MatrixTable from "../../../../components/MatrixTable.astro";
import AirlinesMatrix from "../../../../components/AirlinesMatrix.astro";
import SafetyBanner from "../../../../components/SafetyBanner.astro";
import AdSlotReserve from "../../../../components/AdSlotReserve.astro";

import type { ActiveLocale, MatrixPage, PilotVertical } from "../../../../lib/types";
import {
  getAirlines,
  getAllMatrices,
  getFxRates,
  getItemsForMatrix,
  getPrimaryVerticalHref,
  getVerticalMatrices,
  getVerticalVsInsights,
} from "../../../../lib/data";
import {
  ACTIVE_LOCALES,
  VERTICAL_META,
  normalizePath,
  toAbsoluteUrl,
  withBase,
} from "../../../../lib/i18n";

export function getStaticPaths() {
  const all = getAllMatrices().filter((m) => m.archetype === "matrix");
  const paths: Array<{
    params: { locale: ActiveLocale; vertical: PilotVertical; slug: string };
    props: { matrix: MatrixPage };
  }> = [];

  for (const matrix of all) {
    for (const locale of ACTIVE_LOCALES) {
      paths.push({
        params: {
          locale,
          vertical: matrix.vertical as PilotVertical,
          slug: matrix.slug,
        },
        props: { matrix },
      });
    }
  }
  return paths;
}

const locale = Astro.params.locale as ActiveLocale;
const vertical = Astro.params.vertical as PilotVertical;
const { matrix } = Astro.props as { matrix: MatrixPage };

const isKo = locale === "ko";
const copy = matrix.i18n[locale];
const fx = getFxRates();
const items = getItemsForMatrix(matrix).filter((i) => i.available_locales.includes(locale));
const vsInsights = getVerticalVsInsights(vertical);
const siblingMatrices = getVerticalMatrices(vertical).filter((m) => m.slug !== matrix.slug);
const isAirlinesPage = vertical === "wattcheck" && matrix.slug === "airlines-30";
const airlines = isAirlinesPage ? getAirlines() : [];
const verticalHref = getPrimaryVerticalHref(locale, vertical);
const currentPath = `/${locale}/${vertical}/matrix/${matrix.slug}`;
const isPrimaryVerticalPage = normalizePath(verticalHref) === normalizePath(currentPath);

const itemListElements = isAirlinesPage
  ? airlines.slice(0, 30).map((a, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: isKo ? a.name_ko : a.name_en,
      url: toAbsoluteUrl(`${currentPath}#${a.iata_code}`),
    }))
  : items.slice(0, 30).map((item, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: item.i18n[locale]?.name ?? item.i18n.en.name,
      url: toAbsoluteUrl(`/${locale}/${vertical}/item/${item.slug}`),
    }));

const breadcrumbElements = isPrimaryVerticalPage
  ? [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: copy.title,
        item: toAbsoluteUrl(currentPath),
      },
    ]
  : [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: VERTICAL_META[vertical].shortName[locale],
        item: toAbsoluteUrl(verticalHref),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: copy.title,
        item: toAbsoluteUrl(currentPath),
      },
    ];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: copy.title,
    description: copy.subtitle,
    url: toAbsoluteUrl(currentPath),
    numberOfItems: itemListElements.length,
    itemListElement: itemListElements,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbElements,
  },
];
---

<BaseLayout
  title={`${copy.title} | SpecMatrix Global`}
  description={copy.subtitle}
  locale={locale}
  currentPath={currentPath}
  activeVertical={vertical}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-neutral-400">
    <a href={withBase(`/${locale}`)} class="hover:text-[#dafa9c] hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    {!isPrimaryVerticalPage && (
      <>
        <span>/</span>
        <a href={withBase(verticalHref)} class="hover:text-[#dafa9c] hover:underline">
          {VERTICAL_META[vertical].shortName[locale]}
        </a>
      </>
    )}
    <span>/</span>
    <span class="font-medium text-white">{copy.title}</span>
  </nav>

  <!-- Matrix Header -->
  <section class="lab-card p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`inline-block rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-semibold uppercase ${VERTICAL_META[vertical].badgeBgClass}`}>
          {VERTICAL_META[vertical].shortName[locale]} · MATRIX
        </span>
        <span class="badge-pass font-mono">
          {isAirlinesPage
            ? `${airlines.length} ${isKo ? "개 항공사 검증" : "Airlines Verified"}`
            : `${items.length} ${isKo ? "개 모델 검증" : "SKUs Verified"}`}
        </span>
      </div>
      <a
        href={withBase(`/${locale}/compare#${vertical}::`)}
        class="inline-flex items-center gap-1.5 rounded-md bg-[#dafa9c] px-3 py-1 font-mono text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
      >
        {isKo ? "1:1 실시간 비교 →" : "Live 1:1 Compare →"}
      </a>
    </div>

    <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
      {copy.title}
    </h1>
    <p class="mt-2 text-sm font-medium text-neutral-300 sm:text-base">{copy.subtitle}</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-300">{copy.intro}</p>

    <div class="mt-5 grid gap-2.5 sm:grid-cols-3">
      {copy.key_takeaways.map((tk, i) => (
        <div class="rounded-lg border border-white/10 bg-[#111111] p-3 text-xs leading-relaxed text-neutral-300">
          <span class="font-mono font-bold text-[#dafa9c]">0{i + 1}.</span> {tk}
        </div>
      ))}
    </div>
  </section>

  <AdSlotReserve slotId={`matrix-top-${vertical}`} variant="banner" locale={locale} />

  <!-- Interactive Matrix or 30-Airline Checker -->
  {isAirlinesPage ? (
    <div class="space-y-10">
      <AirlinesMatrix airlines={airlines} locale={locale} />
      {items.length > 0 && (
        <div class="space-y-3">
          <h2 class="text-lg font-bold text-white">
            {isKo
              ? "기내반입 검증 보조배터리·충전기 매트릭스"
              : "Flight-Audited Power Banks & GaN Chargers"}
          </h2>
          <MatrixTable
            vertical={vertical}
            items={items}
            vsInsights={vsInsights}
            fx={fx}
            locale={locale}
          />
        </div>
      )}
    </div>
  ) : (
    <MatrixTable
      vertical={vertical}
      items={items}
      vsInsights={vsInsights}
      fx={fx}
      locale={locale}
    />
  )}

  <!-- Methodology Note -->
  <section class="mt-8 lab-card p-5">
    <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-neutral-400">
      {isKo ? "검증 및 산출 방법론" : "Methodology Note"}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-neutral-300">{copy.methodology_note}</p>
  </section>

  <div class="mt-6">
    <SafetyBanner vertical={vertical} locale={locale} />
  </div>

  <!-- Related Matrices & VS Links -->
  {(siblingMatrices.length > 0 || vsInsights.length > 0) && (
    <section class="mt-8 grid gap-6 md:grid-cols-2">
      {siblingMatrices.length > 0 && (
        <div class="space-y-2.5">
          <h2 class="text-base font-bold text-white">
            {isKo ? "다른 매트릭스 · 호환성 허브" : "Related Matrices & Compat Guides"}
          </h2>
          <div class="space-y-2">
            {siblingMatrices.map((sm) => (
              <a
                href={withBase(`/${locale}/${vertical}/${sm.archetype}/${sm.slug}`)}
                class="lab-card group flex items-center justify-between gap-2 p-3.5 text-sm font-semibold text-neutral-200 transition-colors hover:border-white/25 hover:bg-[#1c1c1c] hover:text-[#dafa9c]"
              >
                <span>{sm.i18n[locale].title}</span>
                <span class="font-mono text-xs text-[#dafa9c]">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {vsInsights.length > 0 && (
        <div class="space-y-2.5">
          <h2 class="text-base font-bold text-white">
            {isKo ? "인기 1:1 정밀 VS 비교" : "Popular 1:1 VS Breakdowns"}
          </h2>
          <div class="space-y-2">
            {vsInsights.slice(0, 5).map((v) => (
              <a
                href={withBase(`/${locale}/${vertical}/vs/${v.pair_slug}`)}
                class="lab-card group flex min-w-0 items-center justify-between gap-2 p-3.5 text-sm font-semibold text-neutral-200 transition-colors hover:border-white/25 hover:bg-[#1c1c1c] hover:text-[#dafa9c]"
              >
                <span class="min-w-0 flex-1 truncate">{v.verdict[locale].headline}</span>
                <span class="shrink-0 font-mono text-xs text-[#dafa9c]">VS →</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  )}
</BaseLayout>
