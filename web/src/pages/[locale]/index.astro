---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlotReserve from "../../components/AdSlotReserve.astro";
import type { ActiveLocale, PilotVertical } from "../../lib/types";
import {
  getAirlines,
  getPrimaryVerticalHref,
  getVerticalItems,
  getVerticalMatrices,
  getVerticalVsInsights,
} from "../../lib/data";
import {
  ACTIVE_LOCALES,
  PILOT_VERTICALS,
  SITE_URL,
  VERTICAL_META,
  formatCurrency,
  getCategoryLabel,
  withBase,
} from "../../lib/i18n";

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as ActiveLocale;
const isKo = locale === "ko";

const airlines = getAirlines();

const verticalBlocks = PILOT_VERTICALS.map((v: PilotVertical) => {
  const items = getVerticalItems(v).filter((i) => i.available_locales.includes(locale));
  const vs = getVerticalVsInsights(v);
  const matrices = getVerticalMatrices(v);
  return {
    id: v,
    meta: VERTICAL_META[v],
    primaryHref: getPrimaryVerticalHref(locale, v),
    items,
    vs,
    matrices,
  };
});

const totalItems = verticalBlocks.reduce((acc, b) => acc + b.items.length, 0);
const totalVs = verticalBlocks.reduce((acc, b) => acc + b.vs.length, 0);
const totalMatrices = verticalBlocks.reduce((acc, b) => acc + b.matrices.length, 0);

const pageTitle = isKo
  ? "SpecMatrix Global 한국어 허브 — 4대 버티컬 실데이터 검증 매트릭스 & 계산기"
  : "SpecMatrix Global — Verified Spec Matrices, VS Comparisons & Lab Calculators";
const pageDesc = isKo
  ? "보조배터리·GaN(WattCheck), 에너지젤·보충제(PureGram), 로드사이클 장비(CycleGear), 미니PC·NAS·UPS·로봇청소기(HomeTech) 공식 스펙 교차검증 DB 및 인터랙티브 계산기."
  : "Evidence-anchored comparison matrices and deterministic calculators across WattCheck power gear, PureGram endurance nutrition, CycleGear road cycling, and HomeTech 3-year TCO.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "SpecMatrix Global",
    url: `${SITE_URL}/${locale}/`,
    inLanguage: locale,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${SITE_URL}/${locale}/tools/?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/${locale}/`,
    inLanguage: locale,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "SpecMatrix Global", item: `${SITE_URL}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: isKo ? "한국어 허브" : "English Hub",
        item: `${SITE_URL}/${locale}/`,
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
  currentPath={`/${locale}/`}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="lab-card bg-white p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge-pass">
        {isKo ? "적대적 팩트체크 95+ 통과" : "Adversarial Fact-Check 95+ Gate"}
      </span>
      <span class="badge-info font-mono">
        {isKo ? "MSRP 참고가 + 실시간 사용자 계산기" : "MSRP Benchmark + Live Calculators"}
      </span>
    </div>

    <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      {isKo
        ? "출처가 고정된 정량 스펙 DB와 결정론적 비교 매트릭스"
        : "Evidence-Anchored Spec Databases & Deterministic Comparison Matrices"}
    </h1>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">
      {isKo
        ? "모든 수치는 제조사 공식 매뉴얼·영양성분표·항공사 규정 원문에 고정되어 있으며, 실가용 Wh, 순수 유효성분 실단가, 후크리스 5 bar 안전 상한, 한전 누진제 3년 전력 TCO를 코드가 직접 검산합니다."
        : "Every figure is anchored to manufacturer manuals, Nutrition Facts panels, and official carrier baggage rules — with zero-bloat calculators for real usable Wh, active gram cost, hookless tire safety, and 3-year electricity TCO."}
    </p>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5">
        <div class="font-mono text-[11px] uppercase text-slate-500">
          {isKo ? "검증 완료 SKU" : "Verified SKUs"}
        </div>
        <div class="kpi-value mt-1 font-mono text-2xl font-bold text-slate-900">{totalItems}</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5">
        <div class="font-mono text-[11px] uppercase text-slate-500">
          {isKo ? "글로벌 항공사 규정" : "Airlines Tracked"}
        </div>
        <div class="kpi-value mt-1 font-mono text-2xl font-bold text-slate-900">{airlines.length}</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5">
        <div class="font-mono text-[11px] uppercase text-slate-500">
          {isKo ? "1:1 정밀 VS 비교" : "1:1 VS Matchups"}
        </div>
        <div class="kpi-value mt-1 font-mono text-2xl font-bold text-slate-900">{totalVs}</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5">
        <div class="font-mono text-[11px] uppercase text-slate-500">
          {isKo ? "필터·호환 매트릭스" : "Matrices & Compat"}
        </div>
        <div class="kpi-value mt-1 font-mono text-2xl font-bold text-slate-900">{totalMatrices}</div>
      </div>
    </div>
  </section>

  <!-- Prominent Interactive Lab Studios Banner -->
  <section class="mt-6 rounded-2xl border border-slate-800 bg-slate-900 p-5 text-white shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="inline-block rounded-full border border-blue-400/40 bg-blue-500/20 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider text-blue-200">
          {isKo ? "INTERACTIVE LAB STUDIOS · 무료 즉시 실행" : "INTERACTIVE LAB STUDIOS"}
        </span>
        <h2 class="mt-2 text-lg font-bold tracking-tight text-white sm:text-xl">
          {isKo
            ? "단순 조회를 넘어 — 직접 조합·시뮬레이션하는 검증 스튜디오"
            : "Go Beyond Static Specs — Interactive Engineering Studios"}
        </h2>
      </div>
      <a
        href={withBase(`/${locale}/tools/`)}
        class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 font-mono text-xs font-bold text-white transition-colors hover:bg-blue-500"
      >
        <span>{isKo ? "모든 도구 보기 →" : "Explore All Tools →"}</span>
      </a>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href={withBase(`/${locale}/compare/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-blue-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-blue-300">
            {isKo ? "자유 1:1 대결" : "ANY-VS-ANY"}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-blue-200">
            {isKo ? "실시간 1:1 비교 워크벤치" : "Live 1:1 Compare Studio"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? `${totalItems}개 모델 중 원하는 2종 자유 비교 · 가중치 승자 판정`
              : `Compare any 2 of ${totalItems} SKUs with custom weights & diff bars.`}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-blue-300">
          {isKo ? "비교 시작 →" : "Launch →"}
        </span>
      </a>

      <a
        href={withBase(`/${locale}/tools/travel-power-kit/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-sky-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-sky-300">
            {isKo ? `WATTCHECK × ${airlines.length} 항공사` : `WATTCHECK × ${airlines.length} AIRLINES`}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-sky-200">
            {isKo ? "해외여행 충전 키트 조합기" : "Travel Power Kit Builder"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? "노트북·폰 동시 출력 + 탑승 항공사 Wh/CCC 규정 자동 매칭"
              : "Match multi-device PD watts with 30-airline carry-on & CCC rules."}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-sky-300">
          {isKo ? "키트 설계 →" : "Optimize →"}
        </span>
      </a>

      <a
        href={withBase(`/${locale}/tools/fueling-planner/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-emerald-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-emerald-300">
            {isKo ? "PUREGRAM 레이스 보급" : "PUREGRAM ENDURANCE"}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-emerald-200">
            {isKo ? "마라톤·사이클 보급 플래너" : "Race Fueling Mix Planner"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? "시간당 탄수화물·나트륨·카페인 상한선·포켓 무게·비용 계산"
              : "Assemble hourly carbs, sodium & caffeine limits with live cost."}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-emerald-300">
          {isKo ? "보급 계획 →" : "Plan Mix →"}
        </span>
      </a>

      <a
        href={withBase(`/${locale}/tools/hometech-tco-studio/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-violet-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-violet-300">
            {isKo ? "HOMETECH TCO × UPS" : "HOMETECH TCO × UPS"}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-violet-200">
            {isKo ? "3년 TCO 회수기간 · UPS 런타임" : "3-Year TCO & UPS Runtime Studio"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? "24시간 대기전력 손익분기점 및 NAS·미니PC 정전 백업 시간 계산"
              : "Compare 24/7 idle electricity payback & multi-device UPS backup."}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-violet-300">
          {isKo ? "TCO 계산 →" : "Simulate →"}
        </span>
      </a>

      <a
        href={withBase(`/${locale}/tools/tire-pressure-guard/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-amber-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-amber-300">
            {isKo ? "CYCLEGEAR 후크리스 가드" : "CYCLEGEAR ETRTO TSS"}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-amber-200">
            {isKo ? "로드 타이어 공기압 · 5.0 bar 가드" : "Tire Pressure & Hookless Guard"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? "체중·림폭·노면별 앞/뒤 공기압 및 후크리스 72.5 psi 한계 검증"
              : "Front/rear bar & psi calculator with ETRTO TSS rim-width checks."}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-amber-300">
          {isKo ? "공기압 검증 →" : "Check PSI →"}
        </span>
      </a>

      <a
        href={withBase(`/${locale}/tools/`)}
        class="group flex flex-col justify-between rounded-xl border border-slate-700/80 bg-slate-800/70 p-4 transition-colors hover:border-slate-400"
      >
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-slate-300">
            {isKo ? "ALL STUDIOS & MATRICES" : "FULL TOOLBOX"}
          </div>
          <div class="mt-1 text-sm font-bold text-white group-hover:text-blue-200">
            {isKo ? "전체 검증 도구 허브" : "Interactive Lab Tools Hub"}
          </div>
          <p class="mt-1 text-xs text-slate-300">
            {isKo
              ? "4대 버티컬 전용 계산기, 30개 항공사 조회, 1:1 비교 허브 모음"
              : "Browse all 5 interactive studios, 30-airline checker & matrices."}
          </p>
        </div>
        <span class="mt-3 font-mono text-xs font-semibold text-slate-200">
          {isKo ? "허브 열기 →" : "Open Hub →"}
        </span>
      </a>
    </div>
  </section>

  <AdSlotReserve slotId="hub-top" variant="banner" locale={locale} />

  <!-- 4 Verticals Showcase -->
  <div class="space-y-10">
    {verticalBlocks.map((block) => (
      <section id={block.id} class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-3">
          <div>
            <span class={`inline-block rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-semibold uppercase ${block.meta.badgeBgClass}`}>
              {block.meta.shortName[locale]}
            </span>
            <h2 class="mt-1.5 text-xl font-bold tracking-tight text-slate-900">
              {block.meta.name[locale]}
            </h2>
            <p class="mt-1 text-sm text-slate-600">{block.meta.tagline[locale]}</p>
          </div>
          <div class="flex items-center gap-2 font-mono text-xs text-slate-500">
            <span>{block.items.length} SKUs</span>
            {block.id === "wattcheck" && (
              <>
                <span>·</span>
                <span>{airlines.length} {isKo ? "항공사" : "Airlines"}</span>
              </>
            )}
            <span>·</span>
            <span>{block.vs.length} VS</span>
          </div>
        </div>

        <!-- Matrix & Compat Shortcuts -->
        {block.matrices.length > 0 && (
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {block.matrices.map((m) => (
              <a
                href={withBase(`/${locale}/${block.id}/${m.archetype}/${m.slug}/`)}
                class="lab-card group flex flex-col justify-between p-4 transition-colors hover:border-blue-500"
              >
                <div>
                  <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-blue-700">
                    {m.archetype === "compat"
                      ? isKo
                        ? "호환성 매트릭스"
                        : "COMPAT MATRIX"
                      : isKo
                        ? "필터 랭킹 표"
                        : "FILTER MATRIX"}
                  </span>
                  <h3 class="mt-1 text-sm font-bold text-slate-900 group-hover:text-blue-700">
                    {m.i18n[locale].title}
                  </h3>
                </div>
                <span class="mt-3 font-mono text-xs font-semibold text-blue-700">
                  {isKo ? "매트릭스 열기 →" : "Open Matrix →"}
                </span>
              </a>
            ))}
          </div>
        )}

        <!-- Featured VS Matchups -->
        {block.vs.length > 0 && (
          <div class="space-y-2">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-500">
              {isKo ? "핵심 1:1 정밀 비교 (VS 시뮬레이터)" : "Featured 1:1 Head-to-Head VS"}
            </h3>
            <div class="grid gap-3 md:grid-cols-2">
              {block.vs.slice(0, 4).map((v) => (
                <a
                  href={withBase(`/${locale}/${block.id}/vs/${v.pair_slug}/`)}
                  class="lab-card group flex min-w-0 items-center justify-between gap-3 p-3.5 transition-colors hover:border-blue-500"
                >
                  <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-bold text-slate-900 group-hover:text-blue-700">
                      {v.verdict[locale].headline}
                    </div>
                    <div class="mt-0.5 truncate font-mono text-[11px] text-slate-500">
                      {v.pair_slug} · IG {v.info_gain_score}/100
                    </div>
                  </div>
                  <span class="shrink-0 font-mono text-xs font-bold text-blue-700">VS →</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Verified SKU Grid -->
        {block.items.length > 0 ? (
          <div class="space-y-2">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-500">
              {isKo ? `검증 완료 제품 프로파일 (${block.items.length}종)` : `Verified SKU Profiles (${block.items.length})`}
            </h3>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {block.items.map((item) => {
                const copy = item.i18n[locale] ?? item.i18n.en;
                const offer = isKo ? item.regional_offers.kr : item.regional_offers.us;
                return (
                  <a
                    href={withBase(`/${locale}/${block.id}/item/${item.slug}/`)}
                    class="lab-card group flex flex-col justify-between p-4 transition-colors hover:border-blue-500"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2 text-[11px]">
                        <span class="font-semibold text-slate-500">
                          {item.brand} · {getCategoryLabel(item.category, locale)}
                        </span>
                        <span class="font-mono font-semibold text-emerald-700">
                          Trust {item.audit.trust_score}
                        </span>
                      </div>
                      <h4 class="mt-1.5 text-sm font-bold text-slate-900 group-hover:text-blue-700">
                        {copy.name}
                      </h4>
                      <p class="mt-1 line-clamp-2 text-xs text-slate-600">{copy.summary}</p>
                    </div>
                    <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2.5 text-xs">
                      <span class="font-mono font-semibold text-slate-800">
                        MSRP {formatCurrency(offer.msrp, offer.currency, locale)}
                      </span>
                      <span class="font-mono font-semibold text-blue-700">
                        {isKo ? "스펙·계산기 →" : "Specs & Calc →"}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="lab-card p-5 text-sm text-slate-500">
            {isKo
              ? "해당 버티컬의 검증 JSON 데이터가 병합되면 자동으로 프로파일 카드가 표시됩니다."
              : "Verified SKUs for this vertical will appear here automatically once data files are loaded."}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
