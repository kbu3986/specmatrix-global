---
import LandingLayout from "../../layouts/LandingLayout.astro";
import type { ActiveLocale, AnyItem, PilotVertical } from "../../lib/types";
import {
  getAirlines,
  getAllItems,
  getPrimaryVerticalHref,
  getVerticalItems,
  getVerticalMatrices,
  getVerticalVsInsights,
} from "../../lib/data";
import {
  ACTIVE_LOCALES,
  PILOT_VERTICALS,
  SITE_URL,
  VERTICAL_META,
  withBase,
} from "../../lib/i18n";

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as ActiveLocale;
const isKo = locale === "ko";

const airlines = getAirlines();
const allItems = getAllItems();

const verticalBlocks = PILOT_VERTICALS.map((v: PilotVertical) => {
  const items = getVerticalItems(v).filter((i) => i.available_locales.includes(locale));
  const vs = getVerticalVsInsights(v);
  const matrices = getVerticalMatrices(v);
  return {
    id: v,
    meta: VERTICAL_META[v],
    primaryHref: getPrimaryVerticalHref(locale, v),
    items,
    vs,
    matrices,
  };
});

const wcBlock = verticalBlocks.find((b) => b.id === "wattcheck")!;
const pgBlock = verticalBlocks.find((b) => b.id === "puregram")!;
const cgBlock = verticalBlocks.find((b) => b.id === "cyclegear")!;
const htBlock = verticalBlocks.find((b) => b.id === "hometech")!;

const totalItems = verticalBlocks.reduce((acc, b) => acc + b.items.length, 0);
const totalVs = verticalBlocks.reduce((acc, b) => acc + b.vs.length, 0);
const totalMatrices = verticalBlocks.reduce((acc, b) => acc + b.matrices.length, 0);

// Pick 10 real SKUs across all 4 verticals for the #workbench app-frame window pane
function pickRows(): Array<{
  initials: string;
  tone: string;
  brand: string;
  model: string;
  status: string;
  statusClass: string;
  trust: number;
}> {
  const picked: AnyItem[] = [
    ...wcBlock.items.slice(0, 2),
    ...pgBlock.items.slice(0, 2),
    ...cgBlock.items.slice(0, 2),
    ...htBlock.items.slice(0, 2),
  ].slice(0, 8);

  const fallback = picked.length >= 8 ? picked : allItems.slice(0, 8);
  const tones = ["1", "3", "4", "2", "5"];

  return fallback.map((item, idx) => {
    const rawName = (item.i18n[locale] ?? item.i18n.en).name;
    const shortName = rawName.length > 34 ? `${rawName.slice(0, 33)}…` : rawName;
    const words = item.brand.replace(/[^A-Za-z0-9\s]/g, "").trim().split(/\s+/);
    const initials =
      words.length >= 2
        ? `${words[0][0]}${words[1][0]}`.toUpperCase()
        : item.brand.slice(0, 2).toUpperCase();
    const isQueued = idx < 2;
    return {
      initials,
      tone: tones[idx % tones.length],
      brand: item.brand,
      model: shortName,
      status: isQueued
        ? isKo ? "검산중" : "Queued"
        : isKo ? "통과" : "Verified",
      statusClass: isQueued ? "ui-win__st" : "ui-win__st is-done",
      trust: item.audit.trust_score,
    };
  });
}

const workbenchRows = pickRows();

const pipelineDiagramSpec = {
  layout: "fanin",
  alt: isKo
    ? "제조사 매뉴얼, 영양성분표, 항공사 규정 PDF, 전력 요금표가 95+ 검증 게이트를 거쳐 4대 매트릭스로 집계됩니다."
    : "Manufacturer manuals, nutrition labels, airline policy PDFs, and electricity tariffs feed the 95+ trust gate into four SpecMatrix tables.",
  sources: [
    {
      label: isKo ? "공식 매뉴얼" : "OEM manuals",
      icon: "ui:file-text",
      sub: isKo ? `${totalItems}종 데이터시트` : `${totalItems} datasheets`,
    },
    {
      label: isKo ? "영양성분표" : "Nutrition panels",
      icon: "ui:clipboard-list",
      sub: "PureGram",
    },
    {
      label: isKo ? "항공사 규정" : "Airline PDFs",
      icon: "ui:plane",
      sub: isKo ? `${airlines.length}개 항공사` : `${airlines.length} carriers`,
    },
    {
      label: isKo ? "전력 요금표" : "Power tariffs",
      icon: "ui:zap",
      sub: "US / KEPCO",
    },
  ],
  target: {
    label: isKo ? "95+ 검증" : "95+ gate",
    icon: "ui:shield-check",
  },
  then: {
    label: isKo ? "4대 매트릭스" : "4 matrices",
    icon: "ui:layers",
    meta: `${totalItems} SKUs`,
  },
};

const pageTitle = isKo
  ? "SpecMatrix: 하드웨어 구매자를 위한 정량 스펙 매트릭스와 계산기"
  : "SpecMatrix: verified spec matrices and calculators for hardware buyers";
const pageDesc = isKo
  ? "보조배터리·GaN(WattCheck), 에너지젤·보충제(PureGram), 로드사이클 장비(CycleGear), 미니PC·NAS·UPS·로봇청소기(HomeTech) 공식 스펙 교차검증 DB와 6개 계산기."
  : "Compare 72 verified products across power gear, endurance nutrition, road cycling, and HomeTech against official manuals, nutrition labels, and 30 airline policies.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "SpecMatrix Global",
    url: `${SITE_URL}/${locale}/`,
    inLanguage: locale,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${SITE_URL}/${locale}/tools/?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/${locale}/`,
    inLanguage: locale,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "SpecMatrix Global", item: `${SITE_URL}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: isKo ? "한국어 허브" : "English Hub",
        item: `${SITE_URL}/${locale}/`,
      },
    ],
  },
];
---

<LandingLayout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
  currentPath={`/${locale}/`}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <style is:inline>
      /* Hero verification window (scoped to inside .hero__window, matching hero-centred.html) */
      .hero__window {
        background:
          radial-gradient(80% 90% at 15% 10%, #d6e0e9 0 42%, transparent 72%),
          radial-gradient(75% 85% at 88% 92%, #7ea0bf 0 38%, transparent 74%),
          radial-gradient(50% 60% at 72% 18%, #e4edf4 0 30%, transparent 68%),
          linear-gradient(155deg, #c6d3df, #9eb8cf 60%, #7d9ab4);
      }
      .d-win {
        background: #ffffff; color: #16181a; border-radius: 10px; overflow: hidden;
        font: 400 14px/1.4 var(--font-text); text-align: left;
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 24px 60px -28px rgb(0 0 0 / 0.45);
      }
      .d-win--dark {
        background: #141414; color: #ffffff;
        box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1), 0 30px 70px -30px rgb(0 0 0 / 0.85);
      }
      .d-win__bar {
        display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 14px;
        border-bottom: 1px solid rgb(255 255 255 / 0.08); font-size: 13px; color: #a3a3a3;
      }
      .d-win__bar b { color: #ffffff; font-weight: 500; }
      .d-win__bar .sp { flex: 1; }
      .d-win__dots { display: flex; gap: 6px; }
      .d-win__dots i { width: 10px; height: 10px; border-radius: 50%; background: #363636; }
      .d-win__body { display: grid; grid-template-columns: 248px 1fr; min-height: 400px; }
      .inbox {
        border-right: 1px solid rgb(255 255 255 / 0.08); padding: 8px;
        display: grid; align-content: start; gap: 2px;
      }
      .inbox .q {
        height: 28px; margin-bottom: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.06);
        display: flex; align-items: center; padding: 0 10px; color: #9c9c9c; font-size: 13px;
      }
      .inbox .t {
        display: grid; grid-template-columns: 28px 1fr auto; gap: 1px 10px;
        padding: 5px 8px; border-radius: 4px; font-size: 13px;
      }
      .inbox .t.is-on { background: rgb(255 255 255 / 0.08); }
      .inbox .t i {
        grid-row: 1 / span 2; width: 28px; height: 28px; border-radius: 4px;
        display: grid; place-items: center; font: 600 12px/1 var(--font-mono);
        font-style: normal; color: #0f0f0f;
      }
      .inbox .t b { font-weight: 500; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .inbox .t time { color: #a3a3a3; font: 400 12px/1.3 var(--font-mono); font-variant-numeric: tabular-nums; }
      .inbox .t span { grid-column: 2 / -1; color: #9e9e9e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .convo { display: grid; min-width: 0; align-content: start; }
      .d-chat { display: grid; gap: 8px; align-content: start; padding: 14px 18px; font-size: 14px; }
      .d-msg { max-width: 86%; padding: 9px 13px; border-radius: 8px; line-height: 1.42; }
      .d-msg--me { justify-self: end; background: #ffffff; color: #0f0f0f; }
      .d-msg--bot { background: #222222; color: #f4f4f4; }
      .d-msg--bot small { display: inline; margin-left: 8px; font: 400 12px/1.3 var(--font-mono); color: #dafa9c; white-space: nowrap; }
      .d-tool { display: flex; align-items: center; gap: 8px; font: 400 13px/1.3 var(--font-mono); color: #a8a8a8; }
      .d-tool::before { content: ""; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #dafa9c; border-right-color: transparent; flex: none; }
      .acts { display: flex; flex-wrap: wrap; gap: 8px; }
      .acts span {
        height: 28px; padding: 0 11px; border-radius: 4px; display: inline-flex; align-items: center;
        font: 500 13px/1 var(--font-mono); background: #dafa9c; color: #0f0f0f;
      }
      .acts span + span { background: rgb(255 255 255 / 0.1); color: #ffffff; }
      @media (max-height: 820px) and (min-width: 640px) {
        .hero__window .inbox .t:nth-of-type(n+4) { display: none; }
      }
      @media (max-width: 639px) {
        .hero__window .d-win__bar .sp ~ span { display: none; }
        .d-win__body { grid-template-columns: 1fr; }
        .inbox { display: none; }
        .hero__window .d-chat { font-size: 13px; padding: 12px 14px; }
        .hero__window .d-msg--bot small, .hero__window .d-tool { display: none; }
      }

      /* #workbench app-frame recipe (verbatim from sections-library.md) */
      .app.ui {
        display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        margin-top: var(--s-6); background: var(--u-bg);
        border: 1px solid var(--u-border); border-radius: var(--u-r); box-shadow: var(--u-shadow);
      }
      .app > .app__pane { position: relative; min-width: 0; min-height: 0; overflow: hidden; }
      .app > .app__pane + .app__pane { border-left: 1px solid var(--u-line); }
      .app > .app__pane > .ui-panel { width: 100%; border: 0; border-radius: 0; box-shadow: none; }
      .app > .app__pane::after {
        content: ""; position: absolute; inset: auto 0 0 0; height: 64px;
        background: linear-gradient(transparent, var(--u-bg)); pointer-events: none;
      }
      @media (min-width: 1024px) and (max-width: 1279px) {
        .app.ui { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
      }
      @media (max-width: 1023px) {
        .app.ui { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); min-height: 440px; }
        .app > .app__pane--list { max-height: 252px; }
        .app > .app__pane--list::after { display: none; }
        .app .ui-win__side { display: none; }
        .app .ui-win__body { grid-template-columns: minmax(0, 1fr); }
        .app > .app__pane + .app__pane { border-left: 0; border-top: 1px solid var(--u-line); }
      }
      @media (max-width: 639px) {
        .app.ui { grid-template-rows: minmax(0, 1fr); min-height: 360px; }
        .app > .app__pane--list { display: none; }
        .app > .app__pane + .app__pane { border-top: 0; }
      }

      /* #verticals 2x2 cards & painterly-landscape calm fallback */
      #verticals .panel { --p-h: 300px; }
      #verticals .panel[data-fx="painterly-landscape"] {
        background:
          radial-gradient(120% 60% at 70% 118%, #6d7f46 0 40%, transparent 41%),
          radial-gradient(90% 50% at 10% 108%, #576d49 0 42%, transparent 43%),
          linear-gradient(#84accf, #c6d3df 70%, #d6e0e9);
      }
      #verticals .card > h3 a {
        display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--ink);
      }
      #verticals .card > h3 a::after {
        content: "\2192"; font-weight: 400; color: var(--accent);
        transition: transform var(--dur) var(--ease);
      }
      @media (hover: hover) and (pointer: fine) {
        #verticals .card:hover > h3 a::after { transform: translateX(3px); }
      }
      @media (min-width: 1024px) and (max-height: 820px) {
        #verticals .panel { --p-h: 224px; }
        #verticals .card { padding: 20px; }
      }
      @media (max-width: 639px) {
        #verticals .section-head { margin-bottom: var(--s-4); }
        #verticals .panel { --p-h: 156px; }
        #verticals .card { padding: 14px 16px; }
        #verticals .card > p { margin-top: 6px; }
        #verticals .stage { --fade-h: 18px; }
        #verticals .ui-check { padding-block: 5px; }
        #verticals .ui-tg { padding-block: 5px; }
        #verticals .ui-tg__sub { display: none; }
        #verticals .ui-note:nth-child(3) { display: none; }
      }

      /* #studios tabs-tour */
      #studios .tab[aria-selected="true"] {
        background: var(--action); color: var(--action-ink); border-color: var(--action);
      }
      #studios .tabs.m-has-ind .tab[aria-selected="true"] {
        background: transparent; color: var(--action-ink); border-color: transparent;
      }
      #studios .m-tab-ind { background: var(--action); }
      .studio-panels { margin-top: var(--s-5); }
      .studio-panel { display: grid; gap: var(--s-4); align-content: start; min-height: 152px; }
      .studio-panel p { color: var(--ink); font-size: var(--t-body); max-width: 48ch; }
      .studio-panel__meta { font: 400 13px/1.4 var(--font-mono); color: var(--muted); }
      .studio-stage { min-height: clamp(500px, 72svh, 648px); }
      .studio-stage > .stage {
        position: absolute; inset: 0;
        --ink: #ffffff; --muted: #a3a3a3; --card: #141414;
        --accent: #dafa9c; --accent-ink: #0f0f0f;
      }
      .studio-stage .ui {
        --u-bg: #141414; --u-surface: #1b1b1b; --u-ink: #ffffff; --u-muted: #a3a3a3;
        --u-accent: #dafa9c; --u-accent-ink: #0f0f0f;
      }
      @media (min-width: 640px) and (max-width: 1023px) {
        #studios .section-head { margin-bottom: var(--s-5); }
        .studio-panel { min-height: 0; }
        .studio-stage { --ratio: 56%; min-height: 340px; }
      }
      @media (max-width: 639px) {
        #studios .section-head { margin-bottom: var(--s-3); }
        #studios .tabs { gap: 6px; }
        #studios .grid { row-gap: var(--s-4); }
        .studio-panels { margin-top: var(--s-3); }
        .studio-panel { min-height: 0; gap: var(--s-3); }
        .studio-stage { --ratio: 62%; min-height: 204px; }
      }

      /* #workflow pinned-chapters drawn verification cards */
      #workflow .mo-pc__text > .link { margin-top: var(--s-4); }
      @media (min-width: 640px) {
        #workflow:not(.is-live) .mo-pc__steps { gap: var(--s-6); margin-top: var(--s-5); }
        #workflow:not(.is-live) .mo-pc__step { padding-top: var(--s-6); }
        #workflow:not(.is-live) .mo-pc__visual--lit { aspect-ratio: auto; min-height: clamp(240px, 37svh, 340px); padding: 28px 32px; }
      }
      @media (min-width: 640px) and (max-width: 1279px) {
        main > section#workflow[data-moment]:not(.is-live) { min-height: calc(2 * 100svh); }
      }
      @media (min-width: 1280px) {
        #workflow:not(.is-live) { height: calc(var(--h, 2) * 100svh); overflow: hidden; }
        #workflow:not(.is-live) .audit-card__row { padding: 10px 0; }
      }
      .audit-card {
        width: min(100%, 420px); background: #141414; color: #ffffff;
        border: 1px solid rgb(255 255 255 / 0.12); border-radius: var(--r-md);
        box-shadow: 0 20px 44px -22px rgb(0 0 0 / 0.65); overflow: hidden;
        font: 400 14px/1.45 var(--font-text); text-align: left;
      }
      .audit-card__head {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        padding: 12px 16px; border-bottom: 1px solid rgb(255 255 255 / 0.08);
        background: #1b1b1b;
      }
      .audit-card__title { font: 500 14px/1.3 var(--font-text); color: #ffffff; }
      .audit-card__tag {
        font: 500 13px/1 var(--font-mono); padding: 4px 8px; border-radius: 4px;
        background: #dafa9c; color: #0f0f0f;
      }
      .audit-card__rows { display: grid; padding: 6px 16px 12px; }
      .audit-card__row {
        display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
        padding: 8px 0; border-bottom: 1px solid rgb(255 255 255 / 0.08);
      }
      .audit-card__row:last-child { border-bottom: 0; }
      .audit-card__k { color: #b8b8b8; font-size: 13px; }
      .audit-card__v { color: #ffffff; font: 500 13px/1.3 var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; }
      @media (max-width: 639px) {
        main > section#workflow[data-moment]:not(.is-live) { min-height: calc(2 * 100lvh); }
        #workflow { --hm: 2; }
        #workflow:not(.is-live) .mo-pc__steps { gap: var(--s-4); margin-top: var(--s-4); }
        #workflow:not(.is-live) .mo-pc__step { padding-top: var(--s-3); }
        #workflow:not(.is-live) .mo-pc__visual--lit { min-height: 260px; aspect-ratio: auto; padding: 18px 16px; }
        #workflow:not(.is-live) .audit-card__head { padding: 10px 14px; }
        #workflow:not(.is-live) .audit-card__rows { padding: 4px 14px 10px; }
        #workflow:not(.is-live) .audit-card__row { padding: 7px 0; }
      }

      /* #pipeline responsive balance */
      @media (min-width: 640px) and (max-width: 1023px) {
        #pipeline .frame--split { --ratio: 62%; }
      }
      @media (max-width: 639px) {
        #pipeline .grid { row-gap: var(--s-4); }
        #pipeline .rows li { padding-block: 8px; }
        #pipeline .frame--split { --ratio: 64%; }
      }

      /* #faq quick-jump verified matrix panel */
      .faq-lead { margin-top: var(--s-4); }
      .faq-cta { margin-top: var(--s-5); }
      .faq-panel {
        display: grid; margin-top: var(--s-6); background: #1a1a1a;
        border: 1px solid rgb(255 255 255 / 0.12); border-radius: var(--r-md); overflow: hidden;
      }
      .faq-panel__row {
        display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 12px;
        min-height: 52px; padding: 10px 14px; color: #ffffff;
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
        transition: background var(--dur) var(--ease);
      }
      .faq-panel__row:last-child { border-bottom: 0; }
      .faq-panel__row:hover { background: rgb(255 255 255 / 0.05); }
      .faq-panel__ico { width: 24px; height: 24px; color: #dafa9c; flex: none; }
      .faq-panel__name { font: 500 14px/1.3 var(--font-text); color: #ffffff; }
      .faq-panel__n { font: 500 13px/1 var(--font-mono); color: #dafa9c; font-variant-numeric: tabular-nums; }
      @media (min-width: 1024px) {
        #faq .faq > .faq__item { padding: 40px 0; gap: 12px; }
        #faq .faq > .faq__item:first-child { padding-top: 0; }
        #faq .faq-panel { margin-top: var(--s-7); }
        #faq .faq-panel__row { min-height: 68px; padding: 16px 18px; }
      }
      @media (max-width: 639px) {
        #faq { --padb: 40px; }
        #faq .grid { row-gap: var(--s-4); }
        .faq-lead { margin-top: var(--s-2); }
        .faq-cta { margin-top: var(--s-3); }
        .faq-panel { margin-top: var(--s-3); }
        .faq-panel__row { min-height: 44px; padding: 6px 12px; }
        #faq .faq > .faq__item { padding: 6px 0; gap: 2px; }
      }
    </style>
  </Fragment>

  <!-- 1. HERO (1H, centred, gradient-mesh) -->
  <section class="hero hero--centred" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text">
        <div class="hero__c">
          <a class="pill" href="#workbench">
            <span>{isKo ? `${totalItems}종 공식 스펙 검증` : `${totalItems} verified SKUs`}</span>
            <span class="muted">{isKo ? `${airlines.length}개 항공사 규정` : `${airlines.length} airlines tracked`}</span>
          </a>
          <h1
            id="hero-h"
            aria-label={isKo ? "하드웨어 정량 스펙 비교 매트릭스" : "Spec matrices for hardware buyers"}
          >
            <span class="ly-mark" aria-hidden="true"></span>{" "}
