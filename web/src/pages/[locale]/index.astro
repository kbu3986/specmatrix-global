  <!-- 5. WORKFLOW (2H live, dealt moment: pinned-chapters) -->
  <section class="section" id="workflow" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="workflow-h">
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <h2 id="workflow-h">
          {isKo ? "제품 한 종이 통과하는 3단계 검증" : "How SpecMatrix audits each product"}
        </h2>
        <a class="link" href={withBase(`/${locale}/methodology/`)}>
          {isKo ? "검증 규칙 전체 보기" : "Read the audit rules"}
        </a>
        <ol class="mo-pc__steps">
          <li class="mo-pc__step">
            <h3>{isKo ? "2건 이상 1차 공식 원문 스펙 수집" : "Anchor specs to 2+ primary manuals"}</h3>
            <p>
              {isKo
                ? "제조사 데이터시트, 영양성분표 원문, 항공사 규정 PDF에서 최소 2건 이상의 출처 URL과 정량 수치를 기록합니다."
                : "Capture ratings from manufacturer datasheets, Nutrition Facts labels, and carrier policy PDFs with at least two primary citations."}
            </p>
            <figure
              class="mo-pc__visual mo-pc__visual--lit"
              role="img"
              aria-label={isKo ? "1단계 원문 출처 고정 카드" : "Stage 1 primary citation anchor card"}
            >
              <div class="audit-card" aria-hidden="true">
                <div class="audit-card__head">
                  <span class="audit-card__title">{isKo ? "원문 출처 고정 · Step 01" : "Source anchor · Step 01"}</span>
                  <span class="audit-card__tag">2+ URLs</span>
                </div>
                <div class="audit-card__rows">
                  <div class="audit-card__row"><span class="audit-card__k">Anker A1340 Manual</span><span class="audit-card__v">99.54 Wh · 250 W</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Maurten Label Panel</span><span class="audit-card__v">25 g carb · 1:0.8</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">ETRTO TSS Standard</span><span class="audit-card__v">5.0 bar max</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Korean Air KE Policy</span><span class="audit-card__v">MOLIT 2026</span></div>
                </div>
              </div>
            </figure>
          </li>

          <li class="mo-pc__step">
            <h3>{isKo ? "Zod 스키마 · 95점 신뢰도 게이트" : "Enforce schema and 95+ trust gates"}</h3>
            <p>
              {isKo
                ? "실가용 Wh 효율, 순수 유효성분 실단가, 후크리스 압력 상한, 24시간 대기전력을 검증 파이프라인이 자동 검산합니다."
                : "Deterministic Zod schemas verify usable Wh conversion, pure active gram cost, hookless caps, and 24/7 idle watts before scoring."}
            </p>
            <figure
              class="mo-pc__visual mo-pc__visual--lit"
              role="img"
              aria-label={isKo ? "2단계 95점 적대적 감사 게이트 카드" : "Stage 2 deterministic 95 plus trust gate card"}
            >
              <div class="audit-card" aria-hidden="true">
                <div class="audit-card__head">
                  <span class="audit-card__title">{isKo ? "자동 검산 게이트 · Step 02" : "Audit gate · Step 02"}</span>
                  <span class="audit-card__tag">Trust 95+</span>
                </div>
                <div class="audit-card__rows">
                  <div class="audit-card__row"><span class="audit-card__k">Zod v3 Schema</span><span class="audit-card__v">72 / 72 PASS</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Info Gain Gate</span><span class="audit-card__v">75+ Required</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Quarantine Rate</span><span class="audit-card__v">0.0% (&lt;15%)</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Pricing Policy</span><span class="audit-card__v">MSRP Benchmark</span></div>
                </div>
              </div>
            </figure>
          </li>

          <li class="mo-pc__step">
            <h3>
              {isKo
                ? `${totalMatrices}개 매트릭스 · 6개 계산기 배포`
                : `Build ${totalMatrices} matrices and 6 calculators`}
            </h3>
            <p>
              {isKo
                ? "통과한 JSON만으로 정적 필터 표, 1:1 VS 비교, 6개 계산기를 생성하고 Stage 6 HTML 링크·SEO 검수를 통과시킵니다."
                : "Only validated JSON compiles into static filter tables, head-to-head pages, and six calculators verified by Stage 6 QA."}
            </p>
            <figure
              class="mo-pc__visual mo-pc__visual--lit"
              role="img"
              aria-label={isKo ? "3단계 정적 빌드 및 Stage 6 QA 통과 카드" : "Stage 3 static build and Stage 6 QA pass card"}
            >
              <div class="audit-card" aria-hidden="true">
                <div class="audit-card__head">
                  <span class="audit-card__title">{isKo ? "정적 빌드 검수 · Step 03" : "Static release · Step 03"}</span>
                  <span class="audit-card__tag">0 Fails</span>
                </div>
                <div class="audit-card__rows">
                  <div class="audit-card__row"><span class="audit-card__k">Filter &amp; Compat Matrices</span><span class="audit-card__v">{totalMatrices} live</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">1:1 VS Matchups</span><span class="audit-card__v">{totalVs} pairs</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Browser Studios</span><span class="audit-card__v">6 tools</span></div>
                  <div class="audit-card__row"><span class="audit-card__k">Stage 6 Link &amp; SEO QA</span><span class="audit-card__v">PASS</span></div>
                </div>
              </div>
            </figure>
          </li>
        </ol>
      </div>
      <div class="mo-pc__visuals frame"></div>
    </div>
  </section>

  <!-- 6. PIPELINE (1H, bg-band bg-bleed, split-text-left + fanin diagram) -->
  <section class="section bg-band bg-bleed" id="pipeline" aria-labelledby="pipeline-h">
    <div class="wrap">
      <div class="grid grid--top">
        <div class="span-5 split-col">
          <h2 id="pipeline-h">
            {isKo ? "4대 1차 출처로 채우는 스펙 매트릭스" : "4 primary spec feeds in the pipeline"}
          </h2>
          <p class="t-lead">
            {isKo
              ? "제조사 매뉴얼, 영양성분표, 항공사 규정 PDF, 전력 요금표가 검증 게이트를 거쳐 4대 매트릭스로 집계됩니다."
              : "Manufacturer manuals, nutrition labels, airline policy PDFs, and regional power tariffs pass automated audits before reaching any matrix."}
          </p>
          <ul class="rows">
            <li>
              <span class="rows__name">{isKo ? "검증 완료 제품" : "Verified products"}</span>
              <span class="rows__value">{totalItems} SKUs</span>
            </li>
            <li>
              <span class="rows__name">{isKo ? "추적 항공사 규정" : "Airline policies"}</span>
              <span class="rows__value">{airlines.length} {isKo ? "항공사" : "carriers"}</span>
            </li>
            <li>
              <span class="rows__name">{isKo ? "신뢰도 통과 기준" : "Trust pass gate"}</span>
              <span class="rows__value">95+ / 100</span>
            </li>
          </ul>
          <a class="link split-col__end" href={withBase(`/${locale}/methodology/`)}>
            {isKo ? "검증 방법론 읽기" : "Read the methodology"}
          </a>
        </div>

        <div class="frame frame--split span-6 start-7">
          <div class="dg" data-diagram data-icon-base={withBase("/assets/icons/")}>
            <script type="application/json" set:html={JSON.stringify(pipelineDiagramSpec)} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ (1H, open answers, no accordion) -->
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="grid grid--top">
        <div class="span-5">
          <h2 id="faq-h">
            {isKo ? "데이터 출처와 가격 기준 FAQ" : "FAQ on spec data and pricing"}
          </h2>
          <p class="t-lead muted faq-lead">
            {isKo
              ? "MSRP 기준가, 95+ 검증, 오류 수정 절차."
              : "MSRP benchmarks, 95+ scoring, and corrections."}
          </p>
          <div class="faq-cta">
            <a class="link" href={withBase(`/${locale}/contact/`)}>
              {isKo ? "스펙 오류 제보" : "Report a correction"}
            </a>
          </div>
          <nav class="faq-panel" aria-label={isKo ? "핵심 매트릭스 바로가기" : "Direct matrix shortcuts"}>
            <a class="faq-panel__row" href={withBase(wcBlock.primaryHref)}>
              <svg class="faq-panel__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
              </svg>
              <span class="faq-panel__name">{isKo ? "WattCheck 보조배터리 표" : "WattCheck power banks"}</span>
              <span class="faq-panel__n" aria-hidden="true">&rarr;</span>
            </a>
            <a class="faq-panel__row" href={withBase(pgBlock.primaryHref)}>
              <svg class="faq-panel__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 3h6M10 3v5.4L5.2 17.6A2 2 0 0 0 7 20.5h10a2 2 0 0 0 1.8-2.9L14 8.4V3" />
              </svg>
              <span class="faq-panel__name">{isKo ? "PureGram 에너지젤 표" : "PureGram energy gels"}</span>
              <span class="faq-panel__n" aria-hidden="true">&rarr;</span>
            </a>
            <a class="faq-panel__row" href={withBase(cgBlock.primaryHref)}>
              <svg class="faq-panel__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m12 12 4-3M12 7v1" />
              </svg>
              <span class="faq-panel__name">{isKo ? "CycleGear 파워미터 표" : "CycleGear power meters"}</span>
              <span class="faq-panel__n" aria-hidden="true">&rarr;</span>
            </a>
            <a class="faq-panel__row" href={withBase(htBlock.primaryHref)}>
              <svg class="faq-panel__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="7" rx="1.5" />
                <rect x="3" y="13" width="18" height="7" rx="1.5" />
                <path d="M7 7.5h.01M7 16.5h.01" />
              </svg>
              <span class="faq-panel__name">{isKo ? "HomeTech 미니PC·NAS 표" : "HomeTech Mini PCs & NAS"}</span>
              <span class="faq-panel__n" aria-hidden="true">&rarr;</span>
            </a>
          </nav>
        </div>

        <div class="faq span-6 start-7">
          <div class="faq__item">
            <h3>{isKo ? "표기 가격은 실시간 최저가인가요?" : "Are prices live store totals?"}</h3>
            <p>
              {isKo
                ? "아니요. 공식 출고가(MSRP) 기준이며 결제가는 판매처에서 확인하세요."
                : "No. Figures show MSRP benchmarks; check retailers live."}
            </p>
          </div>
          <div class="faq__item">
            <h3>{isKo ? "신뢰도 95+ 게이트 조건은 무엇인가요?" : "What passes the 95+ gate?"}</h3>
            <p>
              {isKo
                ? "1차 공식 출처 2건 이상, Zod 스키마, 단위 검산이 필요합니다."
                : "Two primary citations, Zod schemas, and unit math."}
            </p>
          </div>
          <div class="faq__item">
            <h3>{isKo ? "제휴 링크가 SpecMatrix 순위를 바꾸나요?" : "Do affiliate links affect SpecMatrix ranks?"}</h3>
            <p>
              {isKo
                ? "아니요. 30 g 실단가·3년 전력 TCO 공식으로만 산출합니다."
                : "No. Deterministic spec formulas rank every product."}
            </p>
          </div>
          <div class="faq__item">
            <h3>{isKo ? "변경된 스펙 오류는 어디로 제보하나요?" : "How do I report a spec change?"}</h3>
            <p>
              {isKo
                ? "문의 페이지로 모델명과 공식 원문 링크를 보내 주세요."
                : "Send the model and datasheet link via contact."}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
