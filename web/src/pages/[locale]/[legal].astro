---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ActiveLocale, LegalSlug } from "../../lib/types";
import { getMonetizationConfig } from "../../lib/data";
import {
  ACTIVE_LOCALES,
  LEGAL_LABELS,
  LEGAL_SLUGS,
  SITE_URL,
  safeJsonLd,
  withBase,
} from "../../lib/i18n";

export function getStaticPaths() {
  const paths: Array<{ params: { locale: ActiveLocale; legal: LegalSlug } }> = [];
  for (const locale of ACTIVE_LOCALES) {
    for (const legal of LEGAL_SLUGS) {
      paths.push({ params: { locale, legal } });
    }
  }
  return paths;
}

const locale = Astro.params.locale as ActiveLocale;
const legal = Astro.params.legal as LegalSlug;
const isKo = locale === "ko";
const cfg = getMonetizationConfig();
const currentPath = `/${locale}/${legal}/`;

interface LegalSection {
  heading: string;
  body: string[];
}

interface LegalContent {
  title: string;
  subtitle: string;
  sections: LegalSection[];
}

