---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SafetyBanner from "../../../components/SafetyBanner.astro";
import AdSlotReserve from "../../../components/AdSlotReserve.astro";
import type { ActiveLocale, HomeTechItem } from "../../../lib/types";
import { getFxRates, getHomeTechItems, getMonetizationConfig } from "../../../lib/data";
import { buildMonetizationModel } from "../../../lib/monetization";
import {
  ACTIVE_LOCALES,
  BASE_PATH,
  formatCurrency,
  formatInt,
  formatNum,
  getCategoryLabel,
  safeJsonLd,
  toAbsoluteUrl,
  withBase,
} from "../../../lib/i18n";

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as ActiveLocale;
const isKo = locale === "ko";
const fx = getFxRates();
const cfg = getMonetizationConfig();

const krwPerUsd = Number.isFinite(fx.rates.KRW) && fx.rates.KRW > 0 ? fx.rates.KRW : 1400;
const eurPerUsd = Number.isFinite(fx.rates.EUR) && fx.rates.EUR > 0 ? fx.rates.EUR : 0.94;
const jpyPerUsd = Number.isFinite(fx.rates.JPY) && fx.rates.JPY > 0 ? fx.rates.JPY : 154;

const homeItems: HomeTechItem[] = getHomeTechItems().filter((i) =>
  i.available_locales.includes(locale)
);

const CAT_ORDER: Record<HomeTechItem["category"], number> = {
  minipc: 1,
  nas: 2,
  ups: 3,
  "robot-vacuum": 4,
};

const sortedItems = [...homeItems].sort((a, b) => {
  const oa = CAT_ORDER[a.category] ?? 9;
  const ob = CAT_ORDER[b.category] ?? 9;
  if (oa !== ob) return oa - ob;
  return a.slug.localeCompare(b.slug);
});

interface StudioHomeSku {
  slug: string;
  name: string;
  brand: string;
  category: HomeTechItem["category"];
  categoryLabel: string;
  href: string;
  usMsrp: number;
  krMsrp: number;
  idleW: number;
  typicalW: number;
  peakW: number;
  defaultHours: number;
  annualConsUsd: number;
  annualConsKrw: number;
  noiseLoadDba: number | null;
  weightG: number;
  dualVoltage: boolean;
  inputVoltageRange: string;
  korea220vNote: string;
  upsVa: number | null;
  upsWatt: number | null;
  upsWaveform: "pure-sine" | "simulated-sine" | null;
  upsRuntimeHalfMin: number | null;
  ctaButtons: Array<{
    label: string;
    storeName: string;
    url: string;
    linkMode: string;
    isPrimary: boolean;
  }>;
}

const serializedSkus: StudioHomeSku[] = sortedItems.map((item) => {
  const copy = item.i18n[locale] ?? item.i18n.en;
  const m = buildMonetizationModel(item, locale);
  const s = item.specs;
  return {
    slug: item.slug,
    name: copy.name,
    brand: item.brand,
    category: item.category,
    categoryLabel: getCategoryLabel(item.category, locale),
    href: withBase(`/${locale}/hometech/item/${item.slug}`),
    usMsrp: item.regional_offers.us.msrp,
    krMsrp: item.regional_offers.kr.msrp,
    idleW: s.idle_power_w,
    typicalW: s.typical_load_w,
    peakW: s.peak_power_w,
    defaultHours: s.default_daily_hours_active,
    annualConsUsd: s.annual_consumables_usd,
    annualConsKrw: s.annual_consumables_krw,
    noiseLoadDba: s.noise_load_dba,
    weightG: s.weight_g,
    dualVoltage: s.dual_voltage_100_240v,
    inputVoltageRange: s.input_voltage_range,
    korea220vNote: isKo ? item.tco_profile.korea_220v_note_ko : item.tco_profile.korea_220v_note_en,
    upsVa: s.ups_va_rating,
    upsWatt: s.ups_watt_rating,
    upsWaveform: s.ups_waveform,
    upsRuntimeHalfMin: s.ups_runtime_half_load_min,
    ctaButtons: m.buttons.slice(0, 2).map((b) => ({
      label: b.label,
      storeName: b.storeName,
      url: b.url,
      linkMode: b.linkMode,
      isPrimary: b.isPrimary,
    })),
  };
});

const groupedSkus: Array<{ category: string; label: string; items: StudioHomeSku[] }> = [];
for (const sku of serializedSkus) {
  let grp = groupedSkus.find((g) => g.category === sku.category);
  if (!grp) {
    grp = { category: sku.category, label: sku.categoryLabel, items: [] };
    groupedSkus.push(grp);
  }
  grp.items.push(sku);
}

const defaultA =
  serializedSkus.find((s) => s.slug === "apple-mac-mini-m4") ??
  serializedSkus.find((s) => s.category === "minipc") ??
  serializedSkus[0];
const defaultB =
  serializedSkus.find((s) => s.slug === "beelink-ser8-8745hs") ??
  serializedSkus.find((s) => s.category === defaultA?.category && s.slug !== defaultA?.slug) ??
  serializedSkus[1];

const quickPairs = [
  {
    a: "apple-mac-mini-m4",
    b: "beelink-ser8-8745hs",
    label: isKo ? "Mac mini M4 vs Beelink SER8" : "Mac mini M4 vs Beelink SER8",
  },
  {
    a: "synology-ds423-plus",
    b: "ugreen-nasync-dxp4800-plus",
    label: isKo ? "시놀로지 DS423+ vs UGREEN DXP4800+" : "Synology DS423+ vs UGREEN DXP4800+",
  },
  {
    a: "roborock-s8-maxv-ultra",
    b: "dreame-x40-ultra",
    label: isKo ? "로보락 S8 MaxV vs 드리미 X40" : "Roborock S8 MaxV vs Dreame X40",
  },
  {
    a: "apc-back-ups-bx750mi",
    b: "cyberpower-cp1500pfclcd",
    label: isKo ? "APC BX750MI vs CyberPower CP1500" : "APC BX750MI vs CyberPower CP1500",
  },
].filter(
  (p) =>
    serializedSkus.some((s) => s.slug === p.a) && serializedSkus.some((s) => s.slug === p.b)
);

const computeLoadDevices = serializedSkus.filter(
  (s) => s.category === "minipc" || s.category === "nas"
);
const upsSkus = serializedSkus.filter((s) => s.category === "ups");

const defaultSelectedLoadSlugs = new Set<string>(
  [
    computeLoadDevices.find((d) => d.slug === "synology-ds423-plus")?.slug ??
      computeLoadDevices.find((d) => d.category === "nas")?.slug,
    computeLoadDevices.find((d) => d.slug === "apple-mac-mini-m4")?.slug ??
      computeLoadDevices.find((d) => d.category === "minipc")?.slug,
  ].filter((x): x is string => Boolean(x))
);

const tariffs = [
  {
    id: "us",
    label: isKo ? "US 미국 ($0.17)" : "US Avg ($0.17)",
    rate: 0.17,
    currency: "USD" as const,
    unit: "$/kWh",
    min: 0.05,
    max: 0.6,
    step: 0.01,
  },
  {
    id: "kr1",
    label: isKo ? "KR 한전 1구간 (120원)" : "KR KEPCO T1 (₩120)",
    rate: 120,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
    min: 50,
    max: 500,
    step: 5,
  },
  {
    id: "kr2",
    label: isKo ? "KR 한전 2구간 (214원)" : "KR KEPCO T2 (₩214)",
    rate: 214,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
    min: 50,
    max: 500,
    step: 5,
  },
  {
    id: "kr3",
    label: isKo ? "KR 한전 3구간 (307원)" : "KR KEPCO T3 (₩307)",
    rate: 307,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
    min: 50,
    max: 500,
    step: 5,
  },
  {
    id: "de",
    label: isKo ? "DE 독일 (€0.38)" : "DE Germany (€0.38)",
    rate: 0.38,
    currency: "EUR" as const,
    unit: "€/kWh",
    min: 0.1,
    max: 0.7,
    step: 0.01,
  },
  {
    id: "jp",
    label: isKo ? "JP 일본 (¥31)" : "JP Japan (¥31)",
    rate: 31,
    currency: "JPY" as const,
    unit: "¥/kWh",
    min: 15,
    max: 60,
    step: 1,
  },
];

const initTariffId = isKo ? "kr2" : "us";
const initGrid: "230" | "120" = isKo ? "230" : "120";

const clientPayload = {
  locale,
  basePath: BASE_PATH,
  disclosure: cfg.compliance.disclosures[locale],
  fx: { KRW: krwPerUsd, EUR: eurPerUsd, JPY: jpyPerUsd },
  tariffs,
  initTariffId,
  initGrid,
  defaultSlugA: defaultA?.slug ?? "",
  defaultSlugB: defaultB?.slug ?? "",
  defaultLoadSlugs: Array.from(defaultSelectedLoadSlugs),
  items: serializedSkus,
};

const currentPath = `/${locale}/tools/hometech-tco-studio`;
const pageTitle = isKo
  ? "HomeTech 3년 TCO 손익분기 & 멀티기기 UPS 정전 런타임 스튜디오 | SpecMatrix Global"
  : "HomeTech 3-Year TCO Payback & Multi-Device UPS Runtime Studio | SpecMatrix Global";
const pageDesc = isKo
  ? `검증된 ${serializedSkus.length}종 미니PC·NAS·로봇청소기·UPS의 한전 누진제·미국·독일·일본 전기요금별 3년 총소유비용(TCO) 손익분기점과 120V/220V UPS 정전 런타임을 실시간 계산하세요.`
  : `Compare 3-year hardware + electricity + consumables TCO payback across ${serializedSkus.length} verified HomeTech SKUs and size multi-device NAS/MiniPC UPS outage runtime with 120V/220V safety checks.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: isKo
      ? "SpecMatrix HomeTech 3년 TCO & UPS 런타임 스튜디오"
      : "SpecMatrix HomeTech 3-Year TCO & UPS Runtime Studio",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    description: pageDesc,
    url: toAbsoluteUrl(currentPath),
    inLanguage: locale,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools",
        item: toAbsoluteUrl(`/${locale}/tools`),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: isKo ? "HomeTech TCO & UPS 스튜디오" : "HomeTech TCO & UPS Studio",
        item: toAbsoluteUrl(currentPath),
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
  currentPath={currentPath}
  activeVertical="hometech"
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-neutral-400">
    <a href={withBase(`/${locale}`)} class="hover:text-[#dafa9c] hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    <span>/</span>
    <a href={withBase(`/${locale}/tools`)} class="hover:text-[#dafa9c] hover:underline">
      {isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools"}
    </a>
    <span>/</span>
    <span class="font-medium text-white">
      {isKo ? "HomeTech 3년 TCO & UPS 스튜디오" : "HomeTech 3-Year TCO & UPS Studio"}
    </span>
  </nav>

  <!-- Studio Hero -->
  <section class="lab-card overflow-hidden border-teal-700/50">
    <div class="border-b border-white/10 bg-[#111111] px-6 py-5 text-white">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-teal-700/50 bg-[#0b2626] px-2.5 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-teal-200">
            HOMETECH TCO &amp; UPS LAB
          </span>
          <span class="font-mono text-xs text-neutral-400">
            {serializedSkus.length} {isKo ? "종 검증 홈테크 SKU" : "Verified HomeTech SKUs"} · {upsSkus.length} UPS
          </span>
        </div>
        <button
          type="button"
          id="hts-copy-link"
          class="rounded-md border border-white/15 bg-[#161616] px-3 py-1.5 font-mono text-xs font-semibold text-neutral-200 transition-colors hover:border-[#dafa9c] hover:text-[#dafa9c]"
        >
          {isKo ? "시뮬레이션 공유 링크 복사" : "Copy Shareable Studio Link"}
        </button>
      </div>

      <h1 class="mt-2.5 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        {isKo
          ? "HomeTech 3년 TCO 손익분기 & 멀티기기 UPS 정전 런타임 스튜디오"
          : "HomeTech 3-Year TCO Payback & Multi-Device UPS Outage Sizing Studio"}
      </h1>
      <p class="mt-1.5 max-w-3xl text-xs leading-relaxed text-neutral-300 sm:text-sm">
        {isKo
          ? "미니PC·NAS·로봇청소기·UPS 두 모델의 국가별 전기요금(한전 누진제·미국·독일·일본) 기준 3년 총소유비용과 손익분기 개월 수를 실시간 산출하고, 여러 대의 홈랩 장비를 묶은 120V/220V UPS 정전 런타임과 Active-PFC 파형 안전성을 검증합니다."
          : "Model side-by-side 3-year hardware, electricity, and consumables TCO with break-even payback months across global tariffs, then size multi-device NAS + Mini PC UPS runtime with 120V/220V grid-lock and Active-PFC waveform safety guards."}
      </p>

      <!-- Studio Mode Tabs -->
      <div class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label={isKo ? "스튜디오 모드" : "Studio mode"}>
        <button
          type="button"
          role="tab"
          id="hts-tab-tco"
          data-studio-tab="tco"
          aria-selected="true"
          aria-controls="hts-panel-tco"
          class="hts-tab-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-4 py-2 text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
        >
          {isKo ? "1. 1:1 3년 TCO & 손익분기 계산기" : "1. Side-by-Side 3-Year TCO Payback"}
        </button>
        <button
          type="button"
          role="tab"
          id="hts-tab-ups"
          data-studio-tab="ups"
          aria-selected="false"
          aria-controls="hts-panel-ups"
          class="hts-tab-btn rounded-md border border-white/15 bg-[#161616] px-4 py-2 text-xs font-semibold text-neutral-200 transition-colors hover:border-white/30 hover:text-white"
        >
          {isKo ? "2. 멀티기기 UPS 런타임 & 120V/220V 안전 설계" : "2. Multi-Device UPS Runtime & 120V/220V Guard"}
        </button>
      </div>
    </div>
  </section>

  <AdSlotReserve slotId="hometech-tco-top" variant="banner" locale={locale} />

  <!-- SECTION 1: Side-by-Side 3-Year TCO Payback Calculator -->
  <section id="hts-panel-tco" role="tabpanel" aria-labelledby="hts-tab-tco" class="mt-6 space-y-6">
    <div class="lab-card p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-extrabold text-white">
            {isKo ? "1:1 3년 TCO 손익분기(Payback) 비교기" : "Side-by-Side 3-Year TCO Payback Calculator"}
          </h2>
          <p class="mt-0.5 text-xs text-neutral-400">
            {isKo
              ? "저전력 모델이 초기 출고가가 더 비쌀 때 몇 개월 만에 전기요금·소모품 절감액으로 차액을 회수하는지 자동 계산합니다."
              : "See exactly how many months it takes for a lower-idle or lower-maintenance device to pay back a higher upfront purchase price."}
          </p>
        </div>
        <span class="font-mono text-[11px] text-neutral-400">
          FX: $1 = ₩{formatInt(krwPerUsd)} · €{formatNum(eurPerUsd, 2)} · ¥{formatInt(jpyPerUsd)}
        </span>
      </div>

      <!-- Dual SKU Picker -->
      <div class="mt-4 grid items-end gap-3 rounded-lg border border-white/10 bg-[#111111] p-4 md:grid-cols-11">
        <div class="md:col-span-5">
          <label for="hts-sel-a" class="flex items-center justify-between text-xs font-bold text-sky-300">
            <span>{isKo ? "모델 A (비교 기준)" : "Model A (Baseline)"}</span>
            <a id="hts-link-a" href={defaultA?.href ?? withBase(`/${locale}`)} class="font-mono text-[11px] text-[#dafa9c] hover:underline">
              {isKo ? "상세 스펙 →" : "Full Spec →"}
            </a>
          </label>
          <select
            id="hts-sel-a"
            class="mt-1.5 w-full rounded-md border border-sky-700/60 bg-[#161616] px-3 py-2.5 text-sm font-semibold text-white [color-scheme:dark] focus:border-[#dafa9c] focus:outline-none"
          >
            {groupedSkus.map((grp) => (
              <optgroup label={grp.label}>
                {grp.items.map((it) => (
                  <option value={it.slug} selected={it.slug === defaultA?.slug}>
                    {it.name} ({isKo ? formatCurrency(it.krMsrp, "KRW", "ko") : formatCurrency(it.usMsrp, "USD", "en")})
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <div class="flex justify-center md:col-span-1">
          <button
            type="button"
            id="hts-swap"
            aria-label={isKo ? "모델 A와 B 맞바꾸기" : "Swap Model A and Model B"}
            class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-white/15 bg-[#161616] font-mono text-base font-bold text-neutral-200 transition-colors hover:border-[#dafa9c] hover:text-[#dafa9c]"
          >
            ⇄
          </button>
        </div>

        <div class="md:col-span-5">
          <label for="hts-sel-b" class="flex items-center justify-between text-xs font-bold text-emerald-300">
            <span>{isKo ? "모델 B (대안 모델)" : "Model B (Alternative)"}</span>
            <a id="hts-link-b" href={defaultB?.href ?? withBase(`/${locale}`)} class="font-mono text-[11px] text-[#dafa9c] hover:underline">
              {isKo ? "상세 스펙 →" : "Full Spec →"}
            </a>
          </label>
          <select
            id="hts-sel-b"
            class="mt-1.5 w-full rounded-md border border-emerald-700/60 bg-[#161616] px-3 py-2.5 text-sm font-semibold text-white [color-scheme:dark] focus:border-[#dafa9c] focus:outline-none"
          >
            {groupedSkus.map((grp) => (
              <optgroup label={grp.label}>
                {grp.items.map((it) => (
                  <option value={it.slug} selected={it.slug === defaultB?.slug}>
                    {it.name} ({isKo ? formatCurrency(it.krMsrp, "KRW", "ko") : formatCurrency(it.usMsrp, "USD", "en")})
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      </div>

      <!-- Quick Matchups -->
      {quickPairs.length > 0 && (
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="font-mono text-[11px] font-semibold uppercase text-neutral-400">
            {isKo ? "인기 조합:" : "Quick Pairs:"}
          </span>
          {quickPairs.map((pair) => (
            <button
              type="button"
              data-q-a={pair.a}
              data-q-b={pair.b}
              class="hts-quick-pair rounded-md border border-white/15 bg-[#111111] px-3 py-1 text-xs font-medium text-neutral-200 transition-colors hover:border-[#dafa9c] hover:text-[#dafa9c]"
            >
              {pair.label}
            </button>
          ))}
        </div>
      )}

      <!-- Cross-Category Alert -->
      <div
        id="hts-cross-cat"
        role="status"
        class="mt-3 hidden items-center gap-2 rounded-lg border border-amber-700/50 bg-[#291e09] px-3.5 py-2.5 text-xs text-amber-200"
      >
        <span class="badge-caution font-mono">!</span>
        <span id="hts-cross-cat-text"></span>
      </div>

      <!-- Tariff Preset Buttons -->
      <div class="mt-5 border-t border-white/10 pt-5">
        <span class="block text-xs font-bold text-neutral-200">
          {isKo ? "국가별 전기요금 프리셋 선택" : "Electricity Tariff Preset"}
        </span>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label={isKo ? "전기요금 프리셋" : "Electricity Tariff Presets"}>
          {tariffs.map((t) => (
            <button
              type="button"
              data-tariff={t.id}
              aria-pressed={t.id === initTariffId ? "true" : "false"}
              class:list={[
                "hts-tariff-btn rounded-md border px-3 py-1.5 font-mono text-xs font-semibold transition-colors",
                t.id === initTariffId
                  ? "border-[#dafa9c] bg-[#dafa9c] text-[#0f0f0f] hover:bg-[#e6ffba]"
                  : "border-white/15 bg-[#111111] text-neutral-200 hover:border-white/30 hover:text-white",
              ]}
            >
              {t.label}
            </button>
          ))}
        </div>

        <!-- Sliders: Custom kWh Rate, Daily Active Hours, Horizon -->
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-white/10 bg-[#111111] p-3.5">
            <div class="flex items-center justify-between text-xs">
              <label for="hts-rate-slider" class="font-bold text-white">
