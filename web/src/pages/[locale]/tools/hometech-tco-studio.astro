<script>
  import { copyToClipboard } from "../../../lib/clipboard";

  (() => {
    const dataEl = document.getElementById("hts-data");
    if (!dataEl) return;

    interface TariffPreset {
      id: string;
      label: string;
      rate: number;
      currency: "USD" | "KRW" | "EUR" | "JPY";
      unit: string;
      min: number;
      max: number;
      step: number;
    }

    interface StudioSku {
      slug: string;
      name: string;
      brand: string;
      category: "minipc" | "nas" | "ups" | "robot-vacuum";
      categoryLabel: string;
      href: string;
      usMsrp: number;
      krMsrp: number;
      idleW: number;
      typicalW: number;
      peakW: number;
      defaultHours: number;
      annualConsUsd: number;
      annualConsKrw: number;
      noiseLoadDba: number | null;
      weightG: number;
      dualVoltage: boolean;
      inputVoltageRange: string;
      korea220vNote: string;
      upsVa: number | null;
      upsWatt: number | null;
      upsWaveform: "pure-sine" | "simulated-sine" | null;
      upsRuntimeHalfMin: number | null;
      ctaButtons: Array<{
        label: string;
        storeName: string;
        url: string;
        linkMode: string;
        isPrimary: boolean;
      }>;
    }

    interface HtsPayload {
      locale: string;
      basePath: string;
      disclosure: string;
      fx: { KRW: number; EUR: number; JPY: number };
      tariffs: TariffPreset[];
      initTariffId: string;
      initGrid: "230" | "120";
      defaultSlugA: string;
      defaultSlugB: string;
      defaultLoadSlugs: string[];
      items: StudioSku[];
    }

    let payload: HtsPayload;
    try {
      payload = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = payload.locale === "ko";
    const skuMap = new Map<string, StudioSku>();
    payload.items.forEach((it) => skuMap.set(it.slug, it));
    const tariffMap = new Map<string, TariffPreset>();
    payload.tariffs.forEach((t) => tariffMap.set(t.id, t));
    const upsItems = payload.items.filter((it) => it.category === "ups");

    const esc = (s: unknown): string =>
      String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const track = (name: string, params?: Record<string, unknown>) => {
      const w = window as unknown as {
        smTrack?: (ev: string, p?: Record<string, unknown>) => void;
      };
      if (typeof w.smTrack === "function") w.smTrack(name, params);
    };

    // DOM elements
    const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hts-tab-btn"));
    const panelTco = document.getElementById("hts-panel-tco");
    const panelUps = document.getElementById("hts-panel-ups");
    const copyLinkBtn = document.getElementById("hts-copy-link") as HTMLButtonElement | null;

    const selA = document.getElementById("hts-sel-a") as HTMLSelectElement | null;
    const selB = document.getElementById("hts-sel-b") as HTMLSelectElement | null;
    const swapBtn = document.getElementById("hts-swap");
    const linkA = document.getElementById("hts-link-a") as HTMLAnchorElement | null;
    const linkB = document.getElementById("hts-link-b") as HTMLAnchorElement | null;
    const quickPairBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hts-quick-pair"));
    const crossCatBox = document.getElementById("hts-cross-cat");
    const crossCatText = document.getElementById("hts-cross-cat-text");

    const tariffBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hts-tariff-btn"));
    const rateSlider = document.getElementById("hts-rate-slider") as HTMLInputElement | null;
    const rateValEl = document.getElementById("hts-rate-val");
    const rateBoundsEl = document.getElementById("hts-rate-bounds");
    const hoursSlider = document.getElementById("hts-hours-slider") as HTMLInputElement | null;
    const hoursValEl = document.getElementById("hts-hours-val");
    const yearsSlider = document.getElementById("hts-years-slider") as HTMLInputElement | null;
    const yearsValEl = document.getElementById("hts-years-val");

    const winnerNameEl = document.getElementById("hts-winner-name");
    const savingsDeltaEl = document.getElementById("hts-savings-delta");
    const paybackMonthsEl = document.getElementById("hts-payback-months");
    const paybackNoteEl = document.getElementById("hts-payback-note");
    const kwhDeltaEl = document.getElementById("hts-kwh-delta");
    const jumpCompareEl = document.getElementById("hts-jump-compare") as HTMLAnchorElement | null;
    const tcoCardsEl = document.getElementById("hts-tco-cards");

    const gridBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hts-grid-btn"));
    const extraWSlider = document.getElementById("hts-extra-w") as HTMLInputElement | null;
    const extraWValEl = document.getElementById("hts-extra-w-val");
    const pfcChk = document.getElementById("hts-require-pfc") as HTMLInputElement | null;
    const devChks = Array.from(document.querySelectorAll<HTMLInputElement>(".hts-dev-chk"));
    const typTotalEl = document.getElementById("hts-ups-typ-total");
    const peakTotalEl = document.getElementById("hts-ups-peak-total");
    const minWEl = document.getElementById("hts-ups-min-w");
    const minVaEl = document.getElementById("hts-ups-min-va");
    const upsResultsEl = document.getElementById("hts-ups-results");

    let activeTab: "tco" | "ups" = "tco";
    let activeTariffId = payload.initTariffId || (isKo ? "kr2" : "us");
    let activeGrid: "230" | "120" = payload.initGrid || (isKo ? "230" : "120");

    function getActiveTariff(): TariffPreset {
      return tariffMap.get(activeTariffId) || payload.tariffs[0];
    }

    function fmtMoney(amount: number, curr: "USD" | "KRW" | "EUR" | "JPY"): string {
      if (!Number.isFinite(amount)) return "—";
      if (curr === "KRW") {
        const n = new Intl.NumberFormat("ko-KR").format(Math.round(amount));
        return isKo ? `${n}원` : `₩${n}`;
      }
      if (curr === "JPY") {
        return `¥${new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(Math.round(amount))}`;
      }
      const sym = curr === "EUR" ? "€" : "$";
      return `${sym}${new Intl.NumberFormat("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(amount)}`;
    }

    function convertHardware(sku: StudioSku, curr: "USD" | "KRW" | "EUR" | "JPY"): number {
      if (curr === "KRW") return sku.krMsrp;
      if (curr === "USD") return sku.usMsrp;
      if (curr === "EUR") return +(sku.usMsrp * payload.fx.EUR).toFixed(2);
      return Math.round(sku.usMsrp * payload.fx.JPY);
    }

    function convertAnnualCons(sku: StudioSku, curr: "USD" | "KRW" | "EUR" | "JPY"): number {
      if (curr === "KRW") return sku.annualConsKrw;
      if (curr === "USD") return sku.annualConsUsd;
      if (curr === "EUR") return +(sku.annualConsUsd * payload.fx.EUR).toFixed(2);
      return Math.round(sku.annualConsUsd * payload.fx.JPY);
    }

    function setTab(tab: "tco" | "ups", shouldSync = false) {
      activeTab = tab;
      tabBtns.forEach((btn) => {
        const on = (btn.getAttribute("data-studio-tab") || "tco") === tab;
        btn.setAttribute("aria-selected", on ? "true" : "false");
        btn.className = on
          ? "hts-tab-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-4 py-2 text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
          : "hts-tab-btn rounded-md border border-white/15 bg-[#161616] px-4 py-2 text-xs font-semibold text-neutral-200 transition-colors hover:border-white/30 hover:text-white";
      });
      if (panelTco) panelTco.classList.toggle("hidden", tab !== "tco");
      if (panelUps) panelUps.classList.toggle("hidden", tab !== "ups");
      if (shouldSync) syncHash();
    }

    function applyTariffPreset(id: string, overrideRate?: number) {
      const preset = tariffMap.get(id) || payload.tariffs[0];
      activeTariffId = preset.id;
      tariffBtns.forEach((btn) => {
        const on = (btn.getAttribute("data-tariff") || "") === activeTariffId;
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.className = on
          ? "hts-tariff-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3 py-1.5 font-mono text-xs font-semibold text-[#0f0f0f] hover:bg-[#e6ffba] transition-colors"
          : "hts-tariff-btn rounded-md border border-white/15 bg-[#111111] px-3 py-1.5 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white transition-colors";
      });
      if (rateSlider) {
        rateSlider.min = String(preset.min);
        rateSlider.max = String(preset.max);
        rateSlider.step = String(preset.step);
        const val =
          overrideRate !== undefined && Number.isFinite(overrideRate)
            ? Math.max(preset.min, Math.min(preset.max, overrideRate))
            : preset.rate;
        rateSlider.value = String(val);
      }
      if (rateBoundsEl) {
        const mid = +((preset.min + preset.max) / 2).toFixed(preset.step < 1 ? 2 : 0);
        const f = (v: number) =>
          preset.currency === "KRW"
            ? `${v}${isKo ? "원" : "₩"}`
            : preset.currency === "JPY"
              ? `¥${v}`
              : `${preset.currency === "EUR" ? "€" : "$"}${v.toFixed(2)}`;
        rateBoundsEl.innerHTML = `<span>${esc(f(preset.min))}</span><span>${esc(f(mid))}</span><span>${esc(f(preset.max))}</span>`;
      }
    }

    function syncGridUi() {
      gridBtns.forEach((btn) => {
        const on = (btn.getAttribute("data-grid") || "230") === activeGrid;
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.className = on
          ? "hts-grid-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3 py-2 text-xs font-bold text-[#0f0f0f] hover:bg-[#e6ffba] transition-colors"
          : "hts-grid-btn rounded-md border border-white/15 bg-[#161616] px-3 py-2 text-xs font-bold text-neutral-200 hover:border-white/30 hover:text-white transition-colors";
      });
    }

    function computeTcoModel(sku: StudioSku, rate: number, hours: number, years: number, curr: "USD" | "KRW" | "EUR" | "JPY") {
      const avgW = (sku.typicalW * hours + sku.idleW * (24 - hours)) / 24;
      const annualKwh = avgW * 8.76;
      const annualElec = curr === "KRW" || curr === "JPY" ? Math.round(annualKwh * rate) : +(annualKwh * rate).toFixed(2);
      const annualCons = convertAnnualCons(sku, curr);
      const hw = convertHardware(sku, curr);
      const totalElec = annualElec * years;
      const totalCons = annualCons * years;
      const totalTco = hw + totalElec + totalCons;
      return {
        avgW,
        annualKwh,
        annualElec,
        annualCons,
        annualOp: annualElec + annualCons,
        hw,
        totalElec,
        totalCons,
        totalTco,
      };
    }

    function renderTco(shouldSync = false) {
      const skuA = skuMap.get(selA?.value || payload.defaultSlugA) || payload.items[0];
      const skuB = skuMap.get(selB?.value || payload.defaultSlugB) || payload.items[1] || payload.items[0];
      if (!skuA || !skuB) return;

      const tariff = getActiveTariff();
      const rate = Number(rateSlider?.value ?? tariff.rate) || tariff.rate;
      const hours = Math.max(0, Math.min(24, Number(hoursSlider?.value ?? 8)));
      const years = Math.max(1, Math.min(5, Math.round(Number(yearsSlider?.value ?? 3))));

      if (rateValEl) {
        rateValEl.textContent =
          tariff.currency === "KRW"
            ? `${Math.round(rate)} ${tariff.unit}`
            : tariff.currency === "JPY"
              ? `¥${Math.round(rate)}/kWh`
              : `${tariff.currency === "EUR" ? "€" : "$"}${rate.toFixed(2)}/kWh`;
      }
      if (hoursValEl) hoursValEl.textContent = `${hours.toFixed(1)} ${isKo ? "시간/일" : "hr/day"}`;
      if (yearsValEl) yearsValEl.textContent = `${years} ${isKo ? "년" : "years"}`;
      if (linkA) linkA.href = skuA.href;
      if (linkB) linkB.href = skuB.href;

      const bp = payload.basePath || "";
      if (jumpCompareEl) {
        jumpCompareEl.href = `${bp}/${payload.locale}/compare/#hometech:${skuA.slug}:${skuB.slug}`;
      }

      if (crossCatBox && crossCatText) {
        if (skuA.category !== skuB.category) {
          crossCatBox.classList.remove("hidden");
          crossCatBox.classList.add("flex");
          crossCatText.textContent = isKo
            ? `참고: 모델 A(${skuA.categoryLabel})와 모델 B(${skuB.categoryLabel})는 서로 다른 카테고리입니다. 전기요금·TCO 합산 비교는 유효하지만 용도 차이를 함께 고려하세요.`
            : `Note: Model A (${skuA.categoryLabel}) and Model B (${skuB.categoryLabel}) are from different categories. Power & TCO totals remain exact, though hardware roles differ.`;
        } else {
          crossCatBox.classList.add("hidden");
          crossCatBox.classList.remove("flex");
        }
      }

      const mA = computeTcoModel(skuA, rate, hours, years, tariff.currency);
      const mB = computeTcoModel(skuB, rate, hours, years, tariff.currency);

      const tcoDiff = Math.abs(mA.totalTco - mB.totalTco);
      const aWinsTco = mA.totalTco < mB.totalTco;
      const isTie = tcoDiff < (tariff.currency === "KRW" ? 100 : 0.5);

      if (winnerNameEl && savingsDeltaEl) {
        if (isTie) {
          winnerNameEl.textContent = isKo ? "총소유비용 사실상 동일" : "Virtual TCO Tie";
          savingsDeltaEl.textContent = `${years}${isKo ? "년 기준 격차 미미" : "-yr difference negligible"}`;
        } else {
          const wSku = aWinsTco ? skuA : skuB;
          winnerNameEl.textContent = `${aWinsTco ? "A" : "B"} · ${wSku.name}`;
          savingsDeltaEl.textContent = isKo
            ? `${years}년간 ${fmtMoney(tcoDiff, tariff.currency)} 절감`
            : `Saves ${fmtMoney(tcoDiff, tariff.currency)} over ${years} yr`;
        }
      }

      // Break-even Payback Months
      if (paybackMonthsEl && paybackNoteEl) {
        const hwDiff = mA.hw - mB.hw; // >0 means A costs more upfront
        const opSavingsPerYearForMoreExpensive =
          hwDiff > 0 ? mB.annualOp - mA.annualOp : mA.annualOp - mB.annualOp;
        const moreExpLabel = hwDiff > 0 ? `A (${skuA.name})` : `B (${skuB.name})`;
        const cheaperLabel = hwDiff > 0 ? `B (${skuB.name})` : `A (${skuA.name})`;

        if (Math.abs(hwDiff) < (tariff.currency === "KRW" ? 100 : 0.5)) {
          paybackMonthsEl.textContent = isKo ? "즉시 (0개월)" : "Month 0";
          paybackNoteEl.textContent = isKo
            ? "초기 출고가가 동일하므로 연간 전기·소모품 유지비가 낮은 모델이 첫날부터 유리합니다."
            : "Identical upfront MSRP — the lower operating-cost model wins immediately from Day 1.";
        } else if (opSavingsPerYearForMoreExpensive <= 0) {
          paybackMonthsEl.textContent = isKo ? "회수 불가" : "Never";
          paybackNoteEl.textContent = isKo
            ? `${cheaperLabel}가 초기 구매가와 연간 유지비 모두 유리해 첫날부터 우세합니다.`
            : `${cheaperLabel} costs less upfront AND costs the same or less to run — immediate Day-1 win.`;
        } else {
          const months = (Math.abs(hwDiff) / opSavingsPerYearForMoreExpensive) * 12;
          paybackMonthsEl.textContent = isKo ? `${months.toFixed(1)}개월` : `${months.toFixed(1)} mo`;
          const withinHorizon = months <= years * 12;
          paybackNoteEl.textContent = withinHorizon
            ? isKo
              ? `${moreExpLabel}의 초기 차액(${fmtMoney(Math.abs(hwDiff), tariff.currency)})을 ${years}년(${years * 12}개월) 이내 회수합니다.`
              : `${moreExpLabel} recovers its ${fmtMoney(Math.abs(hwDiff), tariff.currency)} premium inside your ${years}-yr horizon.`
            : isKo
              ? `${moreExpLabel}가 유지비는 절감하지만 ${years}년(${years * 12}개월) 내 초기 차액 회수는 어렵습니다.`
              : `${moreExpLabel} saves annually, but payback exceeds your ${years}-yr (${years * 12} mo) horizon.`;
        }
      }

      if (kwhDeltaEl) {
        const kwhDiff = Math.abs(mA.annualKwh - mB.annualKwh);
        const lowerKwhSide = mA.annualKwh <= mB.annualKwh ? "A" : "B";
        kwhDeltaEl.textContent =
          kwhDiff < 0.5
            ? isKo
              ? "전력 소비량 동일"
              : "Same energy use"
            : isKo
              ? `${lowerKwhSide}가 연 ${kwhDiff.toFixed(1)} kWh 절감`
              : `${lowerKwhSide} uses ${kwhDiff.toFixed(1)} kWh/yr less`;
      }

      if (tcoCardsEl) {
        const entries = [
          { side: "A", sku: skuA, m: mA, accent: "border-t-sky-400", badge: "text-sky-300" },
          { side: "B", sku: skuB, m: mB, accent: "border-t-emerald-400", badge: "text-emerald-300" },
        ];
        tcoCardsEl.innerHTML = entries
          .map(({ side, sku, m, accent, badge }) => {
            const hwPct = m.totalTco > 0 ? (m.hw / m.totalTco) * 100 : 100;
            const elecPct = m.totalTco > 0 ? (m.totalElec / m.totalTco) * 100 : 0;
            const consPct = Math.max(0, 100 - hwPct - elecPct);
            const cta = sku.ctaButtons[0];
            const ctaHtml = cta
              ? `<a href="${esc(cta.url)}" rel="sponsored nofollow noopener" target="_blank" data-affiliate-store="${esc(cta.storeName)}" data-affiliate-vertical="hometech" data-affiliate-sku="${esc(sku.slug)}" data-affiliate-mode="${esc(cta.linkMode)}" class="inline-flex w-full items-center justify-between rounded-md bg-[#dafa9c] px-3.5 py-2 text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"><span>${esc(cta.label)}</span><span>↗</span></a>`
              : "";
            return `
              <article class="lab-card border-t-2 ${accent} p-5">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="font-mono text-[11px] font-bold uppercase ${badge}">MODEL ${side} · ${esc(sku.categoryLabel)}</div>
                    <h3 class="mt-0.5 text-base font-extrabold text-white">
                      <a href="${esc(sku.href)}" class="hover:text-[#dafa9c] hover:underline">${esc(sku.name)}</a>
                    </h3>
                  </div>
                  <div class="text-right">
                    <div class="font-mono text-[10px] uppercase text-neutral-400">${years}${isKo ? "년 TCO" : "-Yr TCO"}</div>
                    <div class="kpi-value font-mono text-xl font-extrabold text-[#dafa9c]">${esc(fmtMoney(m.totalTco, tariff.currency))}</div>
                  </div>
                </div>

                <div class="mt-3 grid grid-cols-3 gap-2 rounded-md border border-white/10 bg-[#111111] p-2.5 text-center">
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${isKo ? "평균 W / 연 kWh" : "Avg W / kWh"}</div>
                    <div class="font-mono text-xs font-bold text-white">${m.avgW.toFixed(1)}W · ${m.annualKwh.toFixed(0)}</div>
                  </div>
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${years}${isKo ? "년 전기료" : "yr Power"}</div>
                    <div class="font-mono text-xs font-bold text-teal-300">${esc(fmtMoney(m.totalElec, tariff.currency))}</div>
                  </div>
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${years}${isKo ? "년 소모품" : "yr Maint."}</div>
                    <div class="font-mono text-xs font-bold text-amber-300">${esc(fmtMoney(m.totalCons, tariff.currency))}</div>
                  </div>
                </div>

                <div class="mt-3">
                  <div class="flex h-2.5 w-full overflow-hidden rounded-full bg-white/10">
                    <div class="h-full bg-neutral-300" style="width:${hwPct.toFixed(1)}%"></div>
                    <div class="h-full bg-teal-400" style="width:${elecPct.toFixed(1)}%"></div>
                    <div class="h-full bg-amber-400" style="width:${consPct.toFixed(1)}%"></div>
                  </div>
                  <div class="mt-1.5 flex flex-wrap justify-between font-mono text-[10px] text-neutral-400">
                    <span>${isKo ? "기기" : "HW"} ${esc(fmtMoney(m.hw, tariff.currency))} (${hwPct.toFixed(0)}%)</span>
                    <span>${isKo ? "전기" : "Elec"} ${elecPct.toFixed(0)}%</span>
                    <span>${isKo ? "소모품" : "Maint"} ${consPct.toFixed(0)}%</span>
                  </div>
                </div>

                <div class="mt-4 space-y-2 border-t border-white/10 pt-3">
                  ${ctaHtml}
                </div>
              </article>
            `;
          })
          .join("");
      }

      if (shouldSync) syncHash();
    }

    function renderUps(shouldSync = false) {
      const extraW = Math.max(0, Math.min(200, Number(extraWSlider?.value ?? 15)));
      const needPfc = Boolean(pfcChk?.checked);
      if (extraWValEl) extraWValEl.textContent = `${extraW} W`;

      let combinedTypW = extraW;
      let combinedPeakW = extraW;
      devChks.forEach((chk) => {
        const card = chk.closest(".hts-dev-card");
        const sku = skuMap.get(chk.value);
        if (chk.checked && sku) {
          combinedTypW += sku.typicalW;
          combinedPeakW += sku.peakW;
          if (card) {
            card.classList.add("border-teal-700/60", "bg-[#0b2626]");
            card.classList.remove("border-white/10", "bg-[#111111]");
          }
        } else if (card) {
          card.classList.remove("border-teal-700/60", "bg-[#0b2626]");
          card.classList.add("border-white/10", "bg-[#111111]");
        }
      });

      const minUpsW = Math.ceil(combinedPeakW * 1.4);
      const vaSteps = [600, 750, 900, 1000, 1200, 1500, 2000, 3000];
      const rawVa = Math.max(minUpsW / 0.6, combinedTypW * 2.4);
      const recVa = vaSteps.find((v) => v >= rawVa) ?? 3000;

      if (typTotalEl) typTotalEl.textContent = `${combinedTypW.toFixed(1)} W`;
      if (peakTotalEl) peakTotalEl.textContent = `${Math.round(combinedPeakW)} W`;
      if (minWEl) minWEl.textContent = `${minUpsW} W`;
      if (minVaEl) minVaEl.textContent = `${recVa} VA+`;

      if (!upsResultsEl) return;
      const bp = payload.basePath || "";
      const upsCompareHref =
        upsItems.length >= 2
          ? `${bp}/${payload.locale}/compare/#hometech:${upsItems[0].slug}:${upsItems[1].slug}`
          : `${bp}/${payload.locale}/compare/#hometech`;

      upsResultsEl.innerHTML = upsItems
        .map((u) => {
          const upsW = u.upsWatt || 400;
          const upsVa = u.upsVa || 750;
          const halfMin = u.upsRuntimeHalfMin || 8;
          const voltageStr = u.inputVoltageRange.toLowerCase();
          const is120Only = !u.dualVoltage && voltageStr.includes("120v") && !voltageStr.includes("230v");
          const is230Only = !u.dualVoltage && voltageStr.includes("230v") && !voltageStr.includes("120v");
          const gridMismatch =
            (activeGrid === "230" && is120Only) || (activeGrid === "120" && is230Only);
          const pfcViolation = needPfc && u.upsWaveform !== "pure-sine";
          const loadPct = combinedTypW > 0 ? Math.round((combinedTypW / upsW) * 100) : 0;
          const overload = combinedTypW > upsW * 0.9 || combinedPeakW > upsW;

          const runtimeMin =
            combinedTypW > 0
              ? Math.max(
                  1,
                  Math.min(240, halfMin * Math.pow((0.5 * upsW) / Math.max(combinedTypW, 10), 1.15))
                )
              : 240;
          const safeShutdownOk = runtimeMin >= 5 && !overload && !gridMismatch;

          let verdictCls = "badge-pass";
          let verdictText = isKo ? "안전 호환 (PASS)" : "COMPATIBLE (PASS)";
          if (gridMismatch) {
            verdictCls = "badge-fail";
            verdictText = isKo ? "전압 불일치 직결 금지" : "VOLTAGE GRID LOCK";
          } else if (overload) {
            verdictCls = "badge-fail";
            verdictText = isKo ? "출력 용량 초과" : "CAPACITY OVERLOAD";
          } else if (pfcViolation) {
            verdictCls = "badge-caution";
            verdictText = isKo ? "Active-PFC 파형 주의" : "ACTIVE-PFC CAUTION";
          }

          const warnings: string[] = [];
          if (gridMismatch) {
            warnings.push(
              is120Only
                ? isKo
                  ? `단일 120V 전용 북미 모델(${u.inputVoltageRange})입니다. 한국·EU 220–230V 콘센트 직결 시 즉시 파손·화재 위험이 있으므로 반드시 230V 형제 모델(CP1500EPFCLCD 등)을 선택하세요.`
                  : `Strictly 120V-only North American SKU (${u.inputVoltageRange}). NEVER plug into 220–230V mains; choose a native 230V SKU (e.g. CP1500EPFCLCD).`
                : isKo
                  ? `단일 230V 전용 모델(${u.inputVoltageRange})입니다. 북미 120V 전력망에서는 동작하지 않습니다.`
                  : `Strictly 230V-only regional SKU (${u.inputVoltageRange}) — incompatible with US/Canada 120V mains.`
            );
          }
          if (pfcViolation) {
            warnings.push(
              isKo
                ? "유사 정현파(Simulated Sine) 출력입니다. 민감한 Active-PFC 파워서플라이는 정전 전환 순간 꺼질 수 있으므로 순수 정현파 UPS를 권장합니다."
                : "Simulated/stepped sine output — sensitive Active-PFC PSUs may drop out on battery transfer. Choose Pure Sine Wave."
            );
          }
          if (overload) {
            warnings.push(
              isKo
                ? `합산 피크 부하(${Math.round(combinedPeakW)}W)가 본 UPS 정격(${upsW}W)에 근접하거나 초과합니다.`
                : `Combined peak load (${Math.round(combinedPeakW)}W) approaches or exceeds this UPS rating (${upsW}W).`
            );
          }

          const cta = u.ctaButtons[0];
          const ctaHtml = cta
            ? `<a href="${esc(cta.url)}" rel="sponsored nofollow noopener" target="_blank" data-affiliate-store="${esc(cta.storeName)}" data-affiliate-vertical="hometech" data-affiliate-sku="${esc(u.slug)}" data-affiliate-mode="${esc(cta.linkMode)}" class="inline-flex flex-1 items-center justify-center gap-1 rounded-md bg-[#dafa9c] px-3 py-2 text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"><span>${esc(cta.label)}</span><span>↗</span></a>`
            : "";

          return `
            <article class="lab-card flex flex-col justify-between p-5 ${gridMismatch || overload ? "border-rose-700/60 ring-1 ring-rose-700/40" : pfcViolation ? "border-amber-700/60" : "border-emerald-700/60"}">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="font-mono text-[11px] font-semibold text-neutral-400">${esc(u.brand)} · ${upsVa} VA / ${upsW} W</div>
                    <h4 class="mt-0.5 text-base font-extrabold text-white">
                      <a href="${esc(u.href)}" class="hover:text-[#dafa9c] hover:underline">${esc(u.name)}</a>
                    </h4>
                  </div>
                  <span class="${verdictCls}">${esc(verdictText)}</span>
                </div>

                <div class="mt-3 grid grid-cols-3 gap-2 rounded-md border border-white/10 bg-[#111111] p-2.5 text-center">
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${isKo ? "예상 정전 런타임" : "Est. Runtime"}</div>
                    <div class="kpi-value font-mono text-base font-extrabold ${safeShutdownOk ? "text-[#dafa9c]" : "text-rose-300"}">
                      ${gridMismatch ? "N/A" : `~${runtimeMin.toFixed(0)} ${isKo ? "분" : "min"}`}
                    </div>
                  </div>
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${isKo ? "실부하율" : "Load %"}</div>
                    <div class="font-mono text-sm font-bold text-white">${loadPct}%</div>
                  </div>
                  <div>
                    <div class="font-mono text-[10px] text-neutral-400">${isKo ? "출력 파형" : "Waveform"}</div>
                    <div class="font-mono text-xs font-bold ${u.upsWaveform === "pure-sine" ? "text-emerald-300" : "text-amber-300"}">
                      ${u.upsWaveform === "pure-sine" ? (isKo ? "순수 정현파" : "Pure Sine") : (isKo ? "유사 정현파" : "Simulated")}
                    </div>
                  </div>
                </div>

                ${
                  warnings.length > 0
                    ? `<div class="mt-3 space-y-1.5 rounded-md border border-rose-700/50 bg-[#2c1014] p-3 text-xs text-rose-200">${warnings
                        .map((w) => `<p class="leading-relaxed">• ${esc(w)}</p>`)
                        .join("")}</div>`
                    : `<p class="mt-3 rounded-md border border-emerald-700/50 bg-[#0d261a] p-3 text-xs leading-relaxed text-emerald-200">${
                        isKo
                          ? `예상 ~${runtimeMin.toFixed(0)}분 유지 — NAS USB HID / NUT 자동 안전모드 종료(통상 3–5분 소요)에 충분한 여유를 확보했습니다.`
                          : `Estimated ~${runtimeMin.toFixed(0)} min runtime — ample headroom for USB HID / NUT graceful NAS Safe Mode shutdown (typically 3–5 min).`
                      }</p>`
                }
                <p class="mt-2 font-mono text-[11px] text-neutral-400">${esc(u.korea220vNote)}</p>
              </div>

              <div class="mt-4 space-y-2 border-t border-white/10 pt-3">
                <div class="flex gap-2">${ctaHtml}</div>
                <div class="flex items-center justify-between text-xs">
                  <a href="${esc(u.href)}" class="font-semibold text-neutral-300 hover:text-[#dafa9c] hover:underline">
                    ${isKo ? "UPS 상세 스펙 →" : "UPS Datasheet →"}
                  </a>
                  <a href="${esc(upsCompareHref)}" class="font-mono font-semibold text-[#dafa9c] hover:underline">
                    ${isKo ? "UPS 1:1 비교 →" : "Compare UPS →"}
                  </a>
                </div>
              </div>
            </article>
          `;
        })
        .join("");

      if (shouldSync) syncHash();
    }

    function syncHash() {
      const params = new URLSearchParams();
      params.set("tab", activeTab);
      if (selA) params.set("a", selA.value);
      if (selB) params.set("b", selB.value);
      params.set("tariff", activeTariffId);
      if (rateSlider) params.set("rate", rateSlider.value);
      if (hoursSlider) params.set("hrs", hoursSlider.value);
      if (yearsSlider) params.set("yrs", yearsSlider.value);
      params.set("grid", activeGrid);
      params.set("pfc", pfcChk && pfcChk.checked ? "1" : "0");
      if (extraWSlider) params.set("extra", extraWSlider.value);
      const checkedDevs = devChks.filter((c) => c.checked).map((c) => c.value);
      params.set("devs", checkedDevs.join(","));
      try {
        window.history.replaceState(null, "", `#${params.toString()}`);
      } catch {
        // ignore
      }
    }

    function loadFromHash() {
      const raw = window.location.hash.replace(/^#/, "").trim();
      if (!raw || !raw.includes("=")) return;
      const p = new URLSearchParams(raw);
      const tab = p.get("tab");
      if (tab === "tco" || tab === "ups") setTab(tab, false);
      const a = p.get("a");
      if (a && skuMap.has(a) && selA) selA.value = a;
      const b = p.get("b");
      if (b && skuMap.has(b) && selB) selB.value = b;
      const tariff = p.get("tariff");
      const rate = p.has("rate") ? Number(p.get("rate")) : undefined;
      if (tariff && tariffMap.has(tariff)) applyTariffPreset(tariff, rate);
      const hrs = Number(p.get("hrs"));
      if (hoursSlider && Number.isFinite(hrs) && hrs >= 0 && hrs <= 24) hoursSlider.value = String(hrs);
      const yrs = Number(p.get("yrs"));
      if (yearsSlider && Number.isFinite(yrs) && yrs >= 1 && yrs <= 5) yearsSlider.value = String(yrs);
      const grid = p.get("grid");
      if (grid === "120" || grid === "230") {
        activeGrid = grid;
        syncGridUi();
      }
      if (p.has("pfc") && pfcChk) pfcChk.checked = p.get("pfc") === "1";
      const extra = Number(p.get("extra"));
      if (extraWSlider && Number.isFinite(extra) && extra >= 0 && extra <= 200) {
        extraWSlider.value = String(extra);
      }
      if (p.has("devs")) {
        const set = new Set((p.get("devs") || "").split(",").filter(Boolean));
        devChks.forEach((c) => {
          c.checked = set.has(c.value);
        });
      }
    }

    // Event bindings
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const t = btn.getAttribute("data-studio-tab") === "ups" ? "ups" : "tco";
        setTab(t, true);
        track("hometech_studio_tab", { tab: t });
      });
    });

    if (selA) selA.addEventListener("change", () => renderTco(true));
    if (selB) selB.addEventListener("change", () => renderTco(true));
    if (swapBtn && selA && selB) {
      swapBtn.addEventListener("click", () => {
        const tmp = selA.value;
        selA.value = selB.value;
        selB.value = tmp;
        renderTco(true);
      });
    }

    quickPairBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const qa = btn.getAttribute("data-q-a") || "";
        const qb = btn.getAttribute("data-q-b") || "";
        if (selA && skuMap.has(qa)) selA.value = qa;
        if (selB && skuMap.has(qb)) selB.value = qb;
        renderTco(true);
      });
    });

    tariffBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyTariffPreset(btn.getAttribute("data-tariff") || activeTariffId);
        renderTco(true);
      });
    });

    [rateSlider, hoursSlider, yearsSlider].forEach((s) => {
      if (s) s.addEventListener("input", () => renderTco(true));
    });

    gridBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeGrid = btn.getAttribute("data-grid") === "120" ? "120" : "230";
        syncGridUi();
        renderUps(true);
      });
    });

    if (extraWSlider) extraWSlider.addEventListener("input", () => renderUps(true));
    if (pfcChk) pfcChk.addEventListener("change", () => renderUps(true));
    devChks.forEach((c) => c.addEventListener("change", () => renderUps(true)));

    if (copyLinkBtn) {
      const def = isKo ? "시뮬레이션 공유 링크 복사" : "Copy Shareable Studio Link";
      const okLabel = isKo ? "링크 복사됨 ✓" : "Link Copied ✓";
      copyLinkBtn.addEventListener("click", () => {
        syncHash();
        copyToClipboard(window.location.href).then((ok) => {
          if (!ok) return;
          copyLinkBtn.textContent = okLabel;
          window.setTimeout(() => {
            copyLinkBtn.textContent = def;
          }, 1800);
        });
      });
    }

    applyTariffPreset(activeTariffId);
    loadFromHash();
    renderTco(false);
    renderUps(false);

    window.addEventListener("hashchange", () => {
      loadFromHash();
      renderTco(false);
      renderUps(false);
    });
  })();
</script>
