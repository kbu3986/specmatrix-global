---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SafetyBanner from "../../../components/SafetyBanner.astro";
import AdSlotReserve from "../../../components/AdSlotReserve.astro";
import type { ActiveLocale, CycleGearItem } from "../../../lib/types";
import { getMonetizationConfig, getVerticalItems } from "../../../lib/data";
import { buildMonetizationModel } from "../../../lib/monetization";
import {
  ACTIVE_LOCALES,
  BASE_PATH,
  formatCurrency,
  formatInt,
  safeJsonLd,
  toAbsoluteUrl,
  withBase,
} from "../../../lib/i18n";

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as ActiveLocale;
const isKo = locale === "ko";
const cfg = getMonetizationConfig();

const roadTires = getVerticalItems("cyclegear").filter(
  (item): item is CycleGearItem =>
    item.vertical === "cyclegear" &&
    item.category === "road-tire" &&
    item.available_locales.includes(locale)
);

interface TireCardData {
  slug: string;
  brand: string;
  name: string;
  summary: string;
  weightG: number;
  tireWidthMm: number;
  tpiText: string;
  compoundText: string;
  hooklessCompatible: boolean;
  hooklessMaxPsi: number;
  msrpDisplay: string;
  href: string;
  compareHref: string;
  primaryCta: {
    label: string;
    storeName: string;
    url: string;
    linkMode: string;
  } | null;
}

const tireCards: TireCardData[] = roadTires.map((tire, idx) => {
  const copy = tire.i18n[locale] ?? tire.i18n.en;
  const m = buildMonetizationModel(tire, locale);
  const kv = tire.specs.key_specs_kv;
  const tpiRow = kv.find((r) => /tpi|casing|케이싱/i.test(`${r.key_en} ${r.key_ko}`));
  const compRow = kv.find((r) => /compound|컴파운드/i.test(`${r.key_en} ${r.key_ko}`));
  const partner = roadTires[idx === 0 ? 1 : 0] ?? tire;
  const msrp = isKo ? tire.regional_offers.kr.msrp : tire.regional_offers.us.msrp;

  return {
    slug: tire.slug,
    brand: tire.brand,
    name: copy.name,
    summary: copy.summary,
    weightG: tire.specs.weight_g,
    tireWidthMm: tire.specs.tire_width_mm ?? 28,
    tpiText: tpiRow?.value ?? "Tubeless-Ready",
    compoundText: compRow?.value ?? tire.specs.mount_or_form_factor,
    hooklessCompatible: Boolean(tire.specs.hookless_compatible),
    hooklessMaxPsi: tire.specs.hookless_max_psi ?? 72.5,
    msrpDisplay: formatCurrency(msrp, isKo ? "KRW" : "USD", locale),
    href: withBase(`/${locale}/cyclegear/item/${tire.slug}`),
    compareHref: withBase(`/${locale}/compare/#cyclegear:${tire.slug}:${partner.slug}`),
    primaryCta: m.buttons[0]
      ? {
          label: m.buttons[0].label,
          storeName: m.buttons[0].storeName,
          url: m.buttons[0].url,
          linkMode: m.buttons[0].linkMode,
        }
      : null,
  };
});

const TIRE_WIDTHS = [25, 28, 30, 32] as const;
const RIM_WIDTHS = [19, 21, 23, 25] as const;
const SURFACES = [
  {
    id: "smooth",
    factor: 1.0,
    label: isKo ? "매끈한 레이스 아스팔트" : "Smooth Race Tarmac",
    shortLabel: isKo ? "매끈한 포장 (1.00×)" : "Smooth (1.00×)",
  },
  {
    id: "rough",
    factor: 0.92,
    label: isKo ? "거친 포장 · 칩실" : "Rough Asphalt / Chip-Seal",
    shortLabel: isKo ? "거친 포장 (0.92×)" : "Rough (0.92×)",
  },
  {
    id: "wet",
    factor: 0.87,
    label: isKo ? "우천 · 젖은 노면" : "Wet Road / Rain",
    shortLabel: isKo ? "우천 노면 (0.87×)" : "Wet (0.87×)",
  },
  {
    id: "cobble",
    factor: 0.81,
    label: isKo ? "코블 · 라이트 그래블" : "Cobbles / Light Gravel",
    shortLabel: isKo ? "요철·그래블 (0.81×)" : "Cobble (0.81×)",
  },
] as const;

const clientPayload = {
  locale,
  basePath: BASE_PATH,
  surfaces: SURFACES.map((s) => ({ id: s.id, factor: s.factor, label: s.label })),
};

const currentPath = `/${locale}/tools/tire-pressure-guard`;
const pageTitle = isKo
  ? "로드 타이어 공기압 & ETRTO 후크리스 5.0 bar 안전 가드 | SpecMatrix Global"
  : "Road Tire Pressure & ETRTO 5.0 Bar Hookless Safety Guard | SpecMatrix Global";
const pageDesc = isKo
  ? "라이더+자전거 시스템 총중량(50–125kg), 타이어 폭(25–32mm), 내부 림폭(19–25mm), 노면 조건으로 앞/뒤 권장 공기압(bar·psi)을 계산하고 ISO/ETRTO 후크리스 5.0 bar(72.5 psi) 안전 상한을 실시간 검증합니다."
  : "Calculate deterministic front/rear road tire pressure (bar & psi) from system weight, tire width, internal rim width, and road surface with a mandatory ISO/ETRTO 5.0 bar (72.5 psi) hookless safety guard.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: isKo
      ? "SpecMatrix 로드 타이어 공기압 & 후크리스 5.0 bar 안전 가드"
      : "SpecMatrix Road Tire Pressure & Hookless 5.0 Bar Safety Guard",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    description: pageDesc,
    url: toAbsoluteUrl(currentPath),
    inLanguage: locale,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools",
        item: toAbsoluteUrl(`/${locale}/tools`),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: isKo ? "타이어 공기압 & 후크리스 안전 가드" : "Tire Pressure & Hookless Guard",
        item: toAbsoluteUrl(currentPath),
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
  currentPath={currentPath}
  activeVertical="cyclegear"
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-slate-600">
    <a href={withBase(`/${locale}`)} class="hover:text-blue-700 hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    <span>/</span>
    <a href={withBase(`/${locale}/tools`)} class="hover:text-blue-700 hover:underline">
      {isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools"}
    </a>
    <span>/</span>
    <span class="font-medium text-slate-900">
      {isKo ? "타이어 공기압 & 후크리스 5.0 bar 안전 가드" : "Tire Pressure & Hookless 5.0 Bar Guard"}
    </span>
  </nav>

  <!-- Hero Header -->
  <section class="lab-card overflow-hidden border-rose-200/90 bg-white">
    <div class="border-b border-slate-200 bg-slate-900 px-6 py-5 text-white">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-rose-400/40 bg-rose-500/20 px-2.5 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-rose-200">
            CYCLEGEAR · ISO/ETRTO 5.0 BAR GUARD
          </span>
          <span class="font-mono text-xs text-slate-300">
            42/58% Load Split · {tireCards.length} {isKo ? "종 검증 로드 타이어" : "Verified Road Tires"}
          </span>
        </div>
        <button
          type="button"
          id="tpg-copy-link"
          class="rounded-lg border border-white/25 bg-white/10 px-3 py-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-white/20"
        >
          {isKo ? "세팅 공유 링크 복사" : "Copy Shareable Setup Link"}
        </button>
      </div>

      <h1 class="mt-2.5 text-2xl font-extrabold tracking-tight sm:text-3xl">
        {isKo
          ? "로드 타이어 최적 공기압 & ETRTO 후크리스 5.0 bar 안전 가드"
          : "Road Tire Pressure Calculator & ETRTO 5.0 Bar Hookless Safety Guard"}
      </h1>
      <p class="mt-1.5 max-w-3xl text-xs leading-relaxed text-slate-300 sm:text-sm">
        {isKo
          ? "라이더+자전거 총중량(42/58% 전후 하중 배분), 내부 림폭에 따른 실측 타이어 팽창 폭, 노면 상태를 반영해 최적 앞/뒤 공기압(bar·psi)을 산출하고 후크리스(TSS) 5.0 bar(72.5 psi) 및 28mm 최소 폭 안전 규정을 강제 검사합니다."
          : "Compute deterministic front/rear road tire pressures (bar & psi) using 42/58% load split, internal rim-width expansion, and surface damping — enforced by a hard ISO/ETRTO 5.0 bar (72.5 psi) and >=28 mm hookless safety guard."}
      </p>
    </div>

    <!-- Interactive Configuration Deck -->
    <div class="space-y-6 p-6">
      <div class="grid gap-5 lg:grid-cols-12">
        <!-- Left 7 cols: Controls -->
        <div class="space-y-4 lg:col-span-7">
          <!-- System Weight Slider -->
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <label for="tpg-weight" class="font-bold text-slate-900">
                {isKo ? "1. 라이더 + 자전거 + 장비 총중량 (System Weight)" : "1. Rider + Bike + Gear System Weight"}
              </label>
              <span id="tpg-weight-val" class="font-mono text-sm font-extrabold text-blue-700">
                78 kg (172 lb)
              </span>
            </div>
            <input
              id="tpg-weight"
              type="range"
              min="50"
              max="125"
              step="1"
              value="78"
              class="lab-slider mt-3"
            />
            <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-600">
              <span>50 kg (110 lb)</span>
              <span>85 kg (187 lb)</span>
              <span>125 kg (276 lb)</span>
            </div>
          </div>

          <!-- Tire Width & Internal Rim Width -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <span class="block text-xs font-bold text-slate-900">
                {isKo ? "2. 타이어 표기 폭 (Nominal Width)" : "2. Nominal Tire Width"}
              </span>
              <div class="mt-2.5 grid grid-cols-4 gap-1.5" role="group" aria-label={isKo ? "타이어 폭 선택" : "Tire Width"}>
                {TIRE_WIDTHS.map((w) => (
                  <button
                    type="button"
                    data-tire-w={w}
                    aria-pressed={w === 28 ? "true" : "false"}
                    class:list={[
                      "tpg-tire-btn rounded-lg border py-2 font-mono text-xs font-bold transition-colors",
                      w === 28
                        ? "border-slate-900 bg-slate-900 text-white"
                        : "border-slate-300 bg-white text-slate-700 hover:border-blue-500",
                    ]}
                  >
                    {w}mm
                  </button>
                ))}
              </div>
              <p class="mt-2 font-mono text-[11px] text-slate-600">
                {isKo ? "추정 실측 팽창폭:" : "Est. Measured Width:"}{" "}
                <strong id="tpg-measured-w" class="text-slate-900">28.8 mm</strong>
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <span class="block text-xs font-bold text-slate-900">
                {isKo ? "3. 휠셋 내부 림폭 (Internal Rim Width)" : "3. Internal Rim Width"}
              </span>
              <div class="mt-2.5 grid grid-cols-4 gap-1.5" role="group" aria-label={isKo ? "내부 림폭 선택" : "Internal Rim Width"}>
                {RIM_WIDTHS.map((rw) => (
                  <button
                    type="button"
                    data-rim-w={rw}
                    aria-pressed={rw === 21 ? "true" : "false"}
                    class:list={[
                      "tpg-rimw-btn rounded-lg border py-2 font-mono text-xs font-bold transition-colors",
                      rw === 21
                        ? "border-slate-900 bg-slate-900 text-white"
                        : "border-slate-300 bg-white text-slate-700 hover:border-blue-500",
                    ]}
                  >
                    {rw}mm
                  </button>
                ))}
              </div>
              <p class="mt-2 font-mono text-[11px] text-slate-600">
                {isKo ? "19mm 기준 +0.4mm/mm 팽창 보정" : "+0.4 mm casing stretch per +1 mm rim"}
              </p>
            </div>
          </div>

          <!-- Rim Type & Surface -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <span class="block text-xs font-bold text-slate-900">
                {isKo ? "4. 림 비드 타입 (Rim Profile)" : "4. Rim Type (Hooked vs Hookless)"}
              </span>
              <div class="mt-2.5 grid grid-cols-2 gap-2" role="group" aria-label={isKo ? "림 타입 선택" : "Rim Type"}>
                <button
                  type="button"
                  data-rim-type="hooked"
                  aria-pressed="true"
                  class="tpg-rimtype-btn rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-xs font-bold text-white transition-colors"
                >
                  {isKo ? "훅드 (Hooked)" : "Hooked"}
                </button>
                <button
                  type="button"
                  data-rim-type="hookless"
                  aria-pressed="false"
                  class="tpg-rimtype-btn rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-rose-500"
                >
                  {isKo ? "후크리스 (TSS)" : "Hookless / TSS"}
                </button>
              </div>
              <p class="mt-2 text-[11px] text-slate-600">
                {isKo
                  ? "후크리스(TSS)는 ETRTO 5.0 bar / 72.5 psi 절대 상한이 적용됩니다."
                  : "Hookless (TSS) enforces a strict ISO/ETRTO 5.0 bar (72.5 psi) ceiling."}
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <span class="block text-xs font-bold text-slate-900">
                {isKo ? "5. 주행 노면 프리셋 (Surface)" : "5. Road Surface Preset"}
              </span>
              <div class="mt-2.5 grid grid-cols-2 gap-1.5" role="group" aria-label={isKo ? "주행 노면 선택" : "Road Surface"}>
                {SURFACES.map((sf, idx) => (
                  <button
                    type="button"
                    data-surface={sf.id}
                    aria-pressed={idx === 0 ? "true" : "false"}
                    class:list={[
                      "tpg-surf-btn rounded-lg border px-2.5 py-2 text-left text-[11px] font-bold transition-colors",
                      idx === 0
                        ? "border-slate-900 bg-slate-900 text-white"
                        : "border-slate-300 bg-white text-slate-700 hover:border-blue-500",
                    ]}
                  >
                    {sf.shortLabel}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Optional User Target Gauge Verification -->
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <label for="tpg-user-bar" class="font-bold text-slate-900">
                {isKo
                  ? "6. 내 평소 주입 공기압 안전 점검 (선택 슬라이더)"
                  : "6. Verify Your Current Pump Gauge Pressure (Optional)"}
              </label>
              <span id="tpg-user-bar-val" class="font-mono font-bold text-slate-900">
                4.8 bar (69.6 psi)
              </span>
            </div>
            <input
              id="tpg-user-bar"
              type="range"
              min="3.0"
              max="7.5"
              step="0.1"
              value="4.8"
              class="lab-slider mt-2.5"
            />
            <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-600">
              <span>3.0 bar (43.5 psi)</span>
              <span class="font-bold text-rose-700">5.0 bar / 72.5 psi ETRTO Cap</span>
              <span>7.5 bar (108.8 psi)</span>
            </div>
          </div>
        </div>

        <!-- Right 5 cols: Live Front/Rear Pressure Readout & Hard Hookless Guard -->
        <div class="flex flex-col justify-between gap-4 lg:col-span-5">
          <!-- Safety Status Banner -->
          <div id="tpg-safety-banner" role="alert" class="rounded-xl border-2 border-emerald-400 bg-emerald-50 p-4">
            <div class="flex items-center justify-between gap-2">
              <span id="tpg-safety-badge" class="badge-pass font-mono">SAFE · HOOKED</span>
              <span class="font-mono text-[11px] font-semibold text-slate-600">ISO/ETRTO Guard</span>
            </div>
            <h2 id="tpg-safety-title" class="mt-2 text-sm font-extrabold text-slate-900">
              {isKo ? "안전 범위 내 공기압 세팅입니다" : "Pressure Setup Within Safe Operating Envelope"}
            </h2>
            <p id="tpg-safety-desc" class="mt-1 text-xs leading-relaxed text-slate-700"></p>
          </div>

          <!-- Front & Rear Recommendation Cards -->
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            <div class="rounded-xl border border-blue-200 bg-white p-4 shadow-xs">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] font-bold uppercase text-blue-800">
                  {isKo ? "권장 앞 타이어 (42% 하중)" : "RECOMMENDED FRONT (42% LOAD)"}
                </span>
                <span id="tpg-front-clamp" class="hidden badge-fail font-mono text-[10px]">CLAMPED 5.0 bar</span>
              </div>
              <div class="mt-1.5 flex items-baseline gap-3">
                <span id="tpg-front-bar" class="kpi-value font-mono text-3xl font-extrabold text-blue-700">4.25 bar</span>
                <span id="tpg-front-psi" class="kpi-value font-mono text-lg font-bold text-slate-700">61.7 psi</span>
              </div>
              <div id="tpg-front-meta" class="mt-1 font-mono text-[11px] text-slate-600">—</div>
            </div>

            <div class="rounded-xl border border-emerald-200 bg-white p-4 shadow-xs">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] font-bold uppercase text-emerald-800">
                  {isKo ? "권장 뒤 타이어 (58% 하중)" : "RECOMMENDED REAR (58% LOAD)"}
                </span>
                <span id="tpg-rear-clamp" class="hidden badge-fail font-mono text-[10px]">CLAMPED 5.0 bar</span>
              </div>
              <div class="mt-1.5 flex items-baseline gap-3">
                <span id="tpg-rear-bar" class="kpi-value font-mono text-3xl font-extrabold text-emerald-700">5.00 bar</span>
                <span id="tpg-rear-psi" class="kpi-value font-mono text-lg font-bold text-slate-700">72.5 psi</span>
              </div>
              <div id="tpg-rear-meta" class="mt-1 font-mono text-[11px] text-slate-600">—</div>
            </div>
          </div>

          <!-- User Target Pump Check Card -->
          <div id="tpg-gauge-card" class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-slate-900">
                {isKo ? "사용자 주입 공기압 판정" : "Your Pump Gauge Check"}
              </span>
              <span id="tpg-gauge-badge" class="badge-pass font-mono">OK</span>
            </div>
            <p id="tpg-gauge-msg" class="mt-1.5 leading-relaxed text-slate-700"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlotReserve slotId="tire-pressure-top" variant="banner" locale={locale} />

  <!-- Verified Road Tubeless Tires Directory -->
  <section class="mt-6 space-y-4" aria-labelledby="tpg-tires-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 id="tpg-tires-heading" class="text-lg font-extrabold tracking-tight text-slate-900">
          {isKo
            ? "검증된 로드 튜블리스 타이어 공식 스펙 & 후크리스 호환 현황"
            : "Verified Road Tubeless Tires — Official Weight, TPI & Hookless Specs"}
        </h2>
        <p class="text-xs text-slate-600">
          {isKo
            ? "제조사 공식 기술 문서에서 교차 검증된 무게·TPI 케이싱·후크리스 5.0 bar(72.5 psi) 승인 현황입니다."
            : "Official manufacturer weights, TPI casing construction, and ETRTO 5.0 bar (72.5 psi) hookless compatibility."}
        </p>
      </div>
      <a
        href={withBase(`/${locale}/cyclegear/matrix/gps-tires-trainers`)}
        class="font-mono text-xs font-semibold text-blue-700 hover:underline"
      >
        {isKo ? "전체 CycleGear 매트릭스 보기 →" : "Full CycleGear Matrix →"}
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {tireCards.map((tire) => (
        <article class="lab-card flex flex-col justify-between bg-white p-5 transition-colors hover:border-blue-400">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] font-bold uppercase text-slate-600">
                {tire.brand} · {tire.tireWidthMm}mm
              </span>
              <span class={tire.hooklessCompatible ? "badge-pass font-mono text-[10px]" : "badge-caution font-mono text-[10px]"}>
                {tire.hooklessCompatible
                  ? isKo
                    ? "후크리스 OK (5.0 bar)"
                    : "Hookless OK (5.0 bar)"
                  : isKo
                    ? "훅드 전용"
                    : "Hooked Only"}
              </span>
            </div>

            <h3 class="mt-2 text-base font-extrabold text-slate-900">
              <a href={tire.href} class="hover:text-blue-700 hover:underline">
                {tire.name}
              </a>
            </h3>

            <div class="mt-3 grid grid-cols-2 gap-2 rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-center">
              <div>
                <div class="font-mono text-[10px] text-slate-600">{isKo ? "공식 무게" : "Claimed Weight"}</div>
                <div class="kpi-value font-mono text-sm font-extrabold text-slate-900">
                  {formatInt(tire.weightG)} g
                </div>
              </div>
              <div>
                <div class="font-mono text-[10px] text-slate-600">MSRP</div>
                <div class="kpi-value font-mono text-sm font-extrabold text-slate-900">
                  {tire.msrpDisplay}
                </div>
              </div>
            </div>

            <dl class="mt-3 space-y-1.5 text-xs text-slate-700">
              <div>
                <dt class="font-mono text-[10px] font-bold uppercase text-slate-500">
                  {isKo ? "케이싱 (TPI)" : "Casing / TPI"}
                </dt>
                <dd class="font-medium text-slate-800">{tire.tpiText}</dd>
              </div>
              <div>
                <dt class="font-mono text-[10px] font-bold uppercase text-slate-500">
                  {isKo ? "컴파운드" : "Compound"}
                </dt>
                <dd class="text-slate-700">{tire.compoundText}</dd>
              </div>
            </dl>
          </div>

          <div class="mt-4 space-y-2 border-t border-slate-100 pt-3">
            {tire.primaryCta && (
              <a
                href={tire.primaryCta.url}
                rel="sponsored nofollow noopener"
                target="_blank"
                data-affiliate-store={tire.primaryCta.storeName}
                data-affiliate-vertical="cyclegear"
                data-affiliate-sku={tire.slug}
                data-affiliate-mode={tire.primaryCta.linkMode}
                class="inline-flex w-full items-center justify-between rounded-lg bg-blue-700 px-3.5 py-2 text-xs font-bold text-white transition-colors hover:bg-blue-800"
              >
                <span>{tire.primaryCta.label}</span>
                <span>↗</span>
              </a>
            )}
            <div class="flex items-center justify-between text-xs">
              <a href={tire.href} class="font-semibold text-slate-700 hover:text-blue-700 hover:underline">
                {isKo ? "상세 스펙 & 호환성 →" : "Full Spec & Guard →"}
              </a>
              <a href={tire.compareHref} class="font-mono font-semibold text-blue-700 hover:underline">
                {isKo ? "1:1 비교 →" : "Compare →"}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5 text-[11px] leading-relaxed text-slate-600">
      {cfg.compliance.disclosures[locale]}
    </div>
  </section>

  <!-- Safety Banner -->
  <div class="mt-8">
    <SafetyBanner vertical="cyclegear" locale={locale} />
  </div>

  <script type="application/json" id="tpg-data" set:html={safeJsonLd(clientPayload)} />
</BaseLayout>

<script>
  import { copyToClipboard } from "../../../lib/clipboard";

  (() => {
    const dataEl = document.getElementById("tpg-data");
    if (!dataEl) return;

    interface SurfaceDef {
      id: string;
      factor: number;
      label: string;
    }

    interface TpgPayload {
      locale: string;
      basePath: string;
      surfaces: SurfaceDef[];
    }

    let payload: TpgPayload;
    try {
      payload = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = payload.locale === "ko";
    const surfaceMap = new Map<string, SurfaceDef>();
    payload.surfaces.forEach((s) => surfaceMap.set(s.id, s));

    const track = (name: string, params?: Record<string, unknown>) => {
      const w = window as unknown as {
        smTrack?: (ev: string, p?: Record<string, unknown>) => void;
      };
      if (typeof w.smTrack === "function") w.smTrack(name, params);
    };

    const weightSlider = document.getElementById("tpg-weight") as HTMLInputElement | null;
    const weightValEl = document.getElementById("tpg-weight-val");
    const measuredWEl = document.getElementById("tpg-measured-w");
    const userBarSlider = document.getElementById("tpg-user-bar") as HTMLInputElement | null;
    const userBarValEl = document.getElementById("tpg-user-bar-val");

    const tireBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".tpg-tire-btn"));
    const rimWBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".tpg-rimw-btn"));
    const rimTypeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".tpg-rimtype-btn"));
    const surfBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".tpg-surf-btn"));
    const copyBtn = document.getElementById("tpg-copy-link") as HTMLButtonElement | null;

    const safetyBanner = document.getElementById("tpg-safety-banner");
    const safetyBadge = document.getElementById("tpg-safety-badge");
    const safetyTitle = document.getElementById("tpg-safety-title");
    const safetyDesc = document.getElementById("tpg-safety-desc");

    const frontBarEl = document.getElementById("tpg-front-bar");
    const frontPsiEl = document.getElementById("tpg-front-psi");
    const frontMetaEl = document.getElementById("tpg-front-meta");
    const frontClampEl = document.getElementById("tpg-front-clamp");

    const rearBarEl = document.getElementById("tpg-rear-bar");
    const rearPsiEl = document.getElementById("tpg-rear-psi");
    const rearMetaEl = document.getElementById("tpg-rear-meta");
    const rearClampEl = document.getElementById("tpg-rear-clamp");

    const gaugeCard = document.getElementById("tpg-gauge-card");
    const gaugeBadge = document.getElementById("tpg-gauge-badge");
    const gaugeMsg = document.getElementById("tpg-gauge-msg");

    let tireWidthMm = 28;
    let internalRimMm = 21;
    let rimType: "hooked" | "hookless" = "hooked";
    let surfaceId = "smooth";

    const BAR_TO_PSI = 14.5038;
    const HOOKLESS_MAX_BAR = 5.0;
    const HOOKLESS_MAX_PSI = 72.5;

    function syncButtons() {
      tireBtns.forEach((b) => {
        const on = Number(b.getAttribute("data-tire-w")) === tireWidthMm;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.className = on
          ? "tpg-tire-btn rounded-lg border border-slate-900 bg-slate-900 py-2 font-mono text-xs font-bold text-white transition-colors"
          : "tpg-tire-btn rounded-lg border border-slate-300 bg-white py-2 font-mono text-xs font-bold text-slate-700 hover:border-blue-500 transition-colors";
      });
      rimWBtns.forEach((b) => {
        const on = Number(b.getAttribute("data-rim-w")) === internalRimMm;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.className = on
          ? "tpg-rimw-btn rounded-lg border border-slate-900 bg-slate-900 py-2 font-mono text-xs font-bold text-white transition-colors"
          : "tpg-rimw-btn rounded-lg border border-slate-300 bg-white py-2 font-mono text-xs font-bold text-slate-700 hover:border-blue-500 transition-colors";
      });
      rimTypeBtns.forEach((b) => {
        const on = (b.getAttribute("data-rim-type") || "hooked") === rimType;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.className = on
          ? rimType === "hookless"
            ? "tpg-rimtype-btn rounded-lg border border-rose-700 bg-rose-700 px-3 py-2 text-xs font-bold text-white transition-colors"
            : "tpg-rimtype-btn rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-xs font-bold text-white transition-colors"
          : "tpg-rimtype-btn rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:border-rose-500 transition-colors";
      });
      surfBtns.forEach((b) => {
        const on = (b.getAttribute("data-surface") || "smooth") === surfaceId;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.className = on
          ? "tpg-surf-btn rounded-lg border border-slate-900 bg-slate-900 px-2.5 py-2 text-left text-[11px] font-bold text-white transition-colors"
          : "tpg-surf-btn rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-left text-[11px] font-bold text-slate-700 hover:border-blue-500 transition-colors";
      });
    }

    function syncHash() {
      const p = new URLSearchParams();
      if (weightSlider) p.set("wt", weightSlider.value);
      p.set("tw", String(tireWidthMm));
      p.set("rw", String(internalRimMm));
      p.set("rim", rimType);
      p.set("surf", surfaceId);
      if (userBarSlider) p.set("bar", userBarSlider.value);
      try {
        window.history.replaceState(null, "", `#${p.toString()}`);
      } catch {
        // ignore
      }
    }

    function loadFromHash() {
      const raw = window.location.hash.replace(/^#/, "").trim();
      if (!raw || !raw.includes("=")) return;
      const p = new URLSearchParams(raw);
      const wt = Number(p.get("wt"));
      if (weightSlider && Number.isFinite(wt) && wt >= 50 && wt <= 125) weightSlider.value = String(wt);
      const tw = Number(p.get("tw"));
      if ([25, 28, 30, 32].includes(tw)) tireWidthMm = tw;
      const rw = Number(p.get("rw"));
      if ([19, 21, 23, 25].includes(rw)) internalRimMm = rw;
      const rim = p.get("rim");
      if (rim === "hooked" || rim === "hookless") rimType = rim;
      const surf = p.get("surf");
      if (surf && surfaceMap.has(surf)) surfaceId = surf;
      const bar = Number(p.get("bar"));
      if (userBarSlider && Number.isFinite(bar) && bar >= 3.0 && bar <= 7.5) {
        userBarSlider.value = String(bar);
      }
      syncButtons();
    }

    function compute(shouldSync = false) {
      const systemKg = Math.max(50, Math.min(125, Number(weightSlider?.value ?? 78)));
      const systemLb = Math.round(systemKg * 2.20462);
      const userTargetBar = Math.max(3.0, Math.min(7.5, Number(userBarSlider?.value ?? 4.8)));
      const userTargetPsi = userTargetBar * BAR_TO_PSI;

      if (weightValEl) weightValEl.textContent = `${systemKg} kg (${systemLb} lb)`;
      if (userBarValEl) {
        userBarValEl.textContent = `${userTargetBar.toFixed(1)} bar (${userTargetPsi.toFixed(1)} psi)`;
      }

      // Measured width expansion from internal rim width relative to 19mm ETRTO reference
      const measuredWidthMm = +(tireWidthMm + (internalRimMm - 19) * 0.4).toFixed(1);
      if (measuredWEl) measuredWEl.textContent = `${measuredWidthMm.toFixed(1)} mm`;

      const frontLoadKg = systemKg * 0.42;
      const rearLoadKg = systemKg * 0.58;
      const surf = surfaceMap.get(surfaceId) || { id: "smooth", factor: 1.0, label: "Smooth" };
      const widthScale = Math.pow(28 / Math.max(measuredWidthMm, 22), 1.58);

      const calcWheelBar = (wheelKg: number) =>
        Math.max(2.2, Math.min(8.2, 4.85 * Math.pow(wheelKg / 39, 0.5) * widthScale * surf.factor));

      const rawFrontBar = calcWheelBar(frontLoadKg);
      const rawRearBar = calcWheelBar(rearLoadKg);

      const isHookless = rimType === "hookless";
      const widthTooNarrowHookless = isHookless && tireWidthMm < 28;
      const wideRim28Caution = isHookless && internalRimMm >= 25 && tireWidthMm <= 28;
      const frontClamped = isHookless && rawFrontBar > HOOKLESS_MAX_BAR;
      const rearClamped = isHookless && rawRearBar > HOOKLESS_MAX_BAR;
      const userOverHookless = isHookless && userTargetBar > HOOKLESS_MAX_BAR;

      const safeFrontBar = frontClamped ? HOOKLESS_MAX_BAR : rawFrontBar;
      const safeRearBar = rearClamped ? HOOKLESS_MAX_BAR : rawRearBar;
      const safeFrontPsi = frontClamped ? HOOKLESS_MAX_PSI : safeFrontBar * BAR_TO_PSI;
      const safeRearPsi = rearClamped ? HOOKLESS_MAX_PSI : safeRearBar * BAR_TO_PSI;

      if (frontBarEl) frontBarEl.textContent = `${safeFrontBar.toFixed(2)} bar`;
      if (frontPsiEl) frontPsiEl.textContent = `${safeFrontPsi.toFixed(1)} psi`;
      if (frontClampEl) frontClampEl.classList.toggle("hidden", !frontClamped);
      if (frontMetaEl) {
        frontMetaEl.textContent = frontClamped
          ? isKo
            ? `물리 계산치 ${rawFrontBar.toFixed(2)} bar → 5.00 bar 강제 제한 · 앞하중 ${frontLoadKg.toFixed(1)} kg`
            : `Uncapped ${rawFrontBar.toFixed(2)} bar → Clamped 5.00 bar · Front ${frontLoadKg.toFixed(1)} kg`
          : isKo
            ? `앞바퀴 42% (${frontLoadKg.toFixed(1)} kg) · 실측폭 ${measuredWidthMm.toFixed(1)} mm`
            : `Front 42% (${frontLoadKg.toFixed(1)} kg) · Measured ${measuredWidthMm.toFixed(1)} mm`;
      }

      if (rearBarEl) rearBarEl.textContent = `${safeRearBar.toFixed(2)} bar`;
      if (rearPsiEl) rearPsiEl.textContent = `${safeRearPsi.toFixed(1)} psi`;
      if (rearClampEl) rearClampEl.classList.toggle("hidden", !rearClamped);
      if (rearMetaEl) {
        rearMetaEl.textContent = rearClamped
          ? isKo
            ? `물리 계산치 ${rawRearBar.toFixed(2)} bar → 5.00 bar 강제 제한 · 뒤하중 ${rearLoadKg.toFixed(1)} kg`
            : `Uncapped ${rawRearBar.toFixed(2)} bar → Clamped 5.00 bar · Rear ${rearLoadKg.toFixed(1)} kg`
          : isKo
            ? `뒷바퀴 58% (${rearLoadKg.toFixed(1)} kg) · 실측폭 ${measuredWidthMm.toFixed(1)} mm`
            : `Rear 58% (${rearLoadKg.toFixed(1)} kg) · Measured ${measuredWidthMm.toFixed(1)} mm`;
      }

      // Main ETRTO Safety Verdict Banner
      if (safetyBanner && safetyBadge && safetyTitle && safetyDesc) {
        if (widthTooNarrowHookless) {
          safetyBanner.className = "rounded-xl border-2 border-rose-600 bg-rose-50 p-4";
          safetyBadge.className = "badge-fail font-mono";
          safetyBadge.textContent = isKo ? "DANGER · 후크리스 폭 위반" : "DANGER · HOOKLESS WIDTH VIOLATION";
          safetyTitle.textContent = isKo
            ? "25 mm 타이어는 후크리스(TSS) 림 사용 금지입니다!"
            : "25 mm Tires Are Prohibited on Hookless (TSS) Rims!";
          safetyDesc.textContent = isKo
            ? "최신 ISO/ETRTO 후크리스 규정 및 주요 타이어 제조사(Continental·Vittoria·Pirelli)는 28 mm 미만 로드 타이어의 후크리스 장착을 금지합니다. 최소 28–30 mm 타이어로 변경하거나 훅드(Hooked) 림을 사용하세요."
            : "ISO/ETRTO TSS rules and major manufacturers (Continental, Vittoria, Pirelli) forbid sub-28 mm tires on hookless road rims due to blow-off risk. Upgrade to >=28–30 mm tires or use a hooked rim.";
        } else if (frontClamped || rearClamped || userOverHookless) {
          safetyBanner.className = "rounded-xl border-2 border-rose-600 bg-rose-50 p-4";
          safetyBadge.className = "badge-fail font-mono";
          safetyBadge.textContent = isKo ? "DANGER · 5.0 BAR 상한 초과" : "DANGER · OVER 5.0 BAR (72.5 PSI)";
          safetyTitle.textContent = isKo
            ? "후크리스 ETRTO 5.0 bar (72.5 psi) 절대 안전 상한 초과 감지!"
            : "ETRTO 5.0 Bar (72.5 psi) Hookless Safety Ceiling Exceeded!";
          const recW = tireWidthMm < 30 ? "30–32 mm" : "32 mm";
          safetyDesc.textContent = isKo
            ? `시스템 총중량 ${systemKg} kg + ${tireWidthMm}mm 타이어 물리 계산치(앞 ${rawFrontBar.toFixed(2)} / 뒤 ${rawRearBar.toFixed(2)} bar) 또는 설정 공기압(${userTargetBar.toFixed(1)} bar)이 5.0 bar를 초과합니다. 후크리스 과압은 주행 중 타이어 이탈 사고로 직결됩니다. ${recW} 광폭 타이어로 업사이즈하거나 훅드 림으로 전환하세요.`
            : `Uncapped optimal pressure (${rawFrontBar.toFixed(2)} F / ${rawRearBar.toFixed(2)} R bar) or your gauge target (${userTargetBar.toFixed(1)} bar) exceeds the 5.0 bar (72.5 psi) hookless blow-off limit. Upsize to ${recW} tires or switch to a hooked rim.`;
        } else if (wideRim28Caution) {
          safetyBanner.className = "rounded-xl border-2 border-amber-500 bg-amber-50 p-4";
          safetyBadge.className = "badge-caution font-mono";
          safetyBadge.textContent = isKo ? "CAUTION · 25MM 광폭 후크리스" : "CAUTION · 25MM WIDE HOOKLESS";
          safetyTitle.textContent = isKo
            ? "25 mm 내부 림폭 + 28 mm 타이어: ETRTO 2024+ 승인 목록 필수 확인"
            : "25 mm Internal Hookless + 28 mm Tire: Verify Dual OEM Approval";
          safetyDesc.textContent = isKo
            ? "권장 공기압은 5.0 bar 이내지만, ETRTO 2024+ 지침은 25 mm 내부 후크리스 림에 29–30 mm 이상 타이어를 권장합니다. 28 mm 장착 전 휠·타이어 양사 공식 승인표를 반드시 교차 확인하세요."
            : "Calculated pressure is safely <=5.0 bar, but ETRTO 2024+ recommends >=29–30 mm tires on 25 mm internal hookless rims. Confirm explicit wheel + tire maker approval before riding 28 mm.";
        } else if (isHookless) {
          safetyBanner.className = "rounded-xl border-2 border-emerald-500 bg-emerald-50 p-4";
          safetyBadge.className = "badge-pass font-mono";
          safetyBadge.textContent = isKo ? "PASS · 후크리스 5.0 BAR 준수" : "PASS · HOOKLESS <=5.0 BAR";
          safetyTitle.textContent = isKo
            ? "후크리스 5.0 bar (72.5 psi) 안전 범위 내 세팅입니다"
            : "Compliant With ISO/ETRTO 5.0 Bar Hookless Safety Envelope";
          safetyDesc.textContent = isKo
            ? `앞 ${safeFrontBar.toFixed(2)} bar / 뒤 ${safeRearBar.toFixed(2)} bar 모두 5.0 bar 상한 이내이며 ${tireWidthMm}mm 타이어 폭 기준을 충족합니다. 튜블리스 실란트(30–40ml)와 휠 제조사 승인 리스트를 최종 확인하세요.`
            : `Both ${safeFrontBar.toFixed(2)} bar front and ${safeRearBar.toFixed(2)} bar rear stay safely below 5.0 bar (72.5 psi) with a >=28 mm tire. Confirm your rim's approved tire list and add 30–40 ml sealant.`;
        } else {
          safetyBanner.className = "rounded-xl border-2 border-emerald-400 bg-emerald-50 p-4";
          safetyBadge.className = "badge-pass font-mono";
          safetyBadge.textContent = isKo ? "PASS · 훅드 림 (HOOKED)" : "PASS · HOOKED RIM";
          safetyTitle.textContent = isKo
            ? "훅드 림 최적 구름저항·승차감 공기압 계산 완료"
            : "Optimal Hooked-Rim Pressure Calculated";
          safetyDesc.textContent = isKo
            ? `실측 팽창폭 ${measuredWidthMm.toFixed(1)} mm (${tireWidthMm}mm 타이어 @ ${internalRimMm}mm 림) · ${surf.label} 기준입니다. 타이어 사이드월 표기 최대 공기압(통상 6.0–6.5 bar) 이내에서 운용하세요.`
            : `Based on ${measuredWidthMm.toFixed(1)} mm measured casing (${tireWidthMm} mm tire on ${internalRimMm} mm rim) for ${surf.label}. Stay below tire sidewall max rating (typically 6.0–6.5 bar).`;
        }
      }

      // User Target Pump Pressure Check
      if (gaugeCard && gaugeBadge && gaugeMsg) {
        if (userOverHookless) {
          gaugeCard.className = "rounded-xl border border-rose-400 bg-rose-50 p-4 text-xs";
          gaugeBadge.className = "badge-fail font-mono";
          gaugeBadge.textContent = isKo ? "위험 (>5.0 bar)" : "DANGER (>5.0 bar)";
          gaugeMsg.textContent = isKo
            ? `입력한 ${userTargetBar.toFixed(1)} bar (${userTargetPsi.toFixed(1)} psi)는 후크리스 절대 상한 5.0 bar(72.5 psi)를 초과합니다. 즉시 5.0 bar 이하로 감압하세요!`
            : `Your ${userTargetBar.toFixed(1)} bar (${userTargetPsi.toFixed(1)} psi) target EXCEEDS the 5.0 bar (72.5 psi) hookless limit. Bleed pressure immediately before riding!`;
        } else {
          const deltaRear = userTargetBar - safeRearBar;
          if (Math.abs(deltaRear) <= 0.35) {
            gaugeCard.className = "rounded-xl border border-emerald-300 bg-emerald-50/70 p-4 text-xs";
            gaugeBadge.className = "badge-pass font-mono";
            gaugeBadge.textContent = isKo ? "권장치 근접" : "ON TARGET";
            gaugeMsg.textContent = isKo
              ? `${userTargetBar.toFixed(1)} bar는 권장 뒷바퀴 공기압(${safeRearBar.toFixed(2)} bar)과 오차 ±0.35 bar 이내의 이상적인 세팅입니다.`
              : `${userTargetBar.toFixed(1)} bar sits tightly within ±0.35 bar of your recommended rear pressure (${safeRearBar.toFixed(2)} bar).`;
          } else if (deltaRear > 0.35) {
            gaugeCard.className = "rounded-xl border border-amber-300 bg-amber-50 p-4 text-xs";
            gaugeBadge.className = "badge-caution font-mono";
            gaugeBadge.textContent = isKo ? "다소 과압" : "RUNNING HIGH";
            gaugeMsg.textContent = isKo
              ? `${userTargetBar.toFixed(1)} bar는 권장 뒷바퀴(${safeRearBar.toFixed(2)} bar)보다 +${deltaRear.toFixed(2)} bar 높습니다. 거친 노면에서 임피던스 손실(진동 저항)이 커질 수 있습니다.`
              : `${userTargetBar.toFixed(1)} bar is +${deltaRear.toFixed(2)} bar above recommended rear (${safeRearBar.toFixed(2)} bar), which can increase vibration impedance losses on real roads.`;
          } else {
            gaugeCard.className = "rounded-xl border border-blue-200 bg-blue-50/70 p-4 text-xs";
            gaugeBadge.className = "badge-info font-mono";
            gaugeBadge.textContent = isKo ? "저압 세팅" : "RUNNING SOFT";
            gaugeMsg.textContent = isKo
              ? `${userTargetBar.toFixed(1)} bar는 권장 뒷바퀴(${safeRearBar.toFixed(2)} bar)보다 ${Math.abs(deltaRear).toFixed(2)} bar 낮습니다. 요철 구간 림 타격(핀치)에 유의하세요.`
              : `${userTargetBar.toFixed(1)} bar is ${Math.abs(deltaRear).toFixed(2)} bar below recommended rear (${safeRearBar.toFixed(2)} bar) — watch for rim strikes on sharp potholes.`;
          }
        }
      }

      if (shouldSync) syncHash();
    }

    // Event bindings
    if (weightSlider) weightSlider.addEventListener("input", () => compute(true));
    if (userBarSlider) userBarSlider.addEventListener("input", () => compute(true));

    tireBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tireWidthMm = Number(btn.getAttribute("data-tire-w") || 28);
        syncButtons();
        compute(true);
        track("tire_pressure_guard", { tire_width_mm: tireWidthMm, rim_type: rimType });
      });
    });

    rimWBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        internalRimMm = Number(btn.getAttribute("data-rim-w") || 21);
        syncButtons();
        compute(true);
      });
    });

    rimTypeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        rimType = btn.getAttribute("data-rim-type") === "hookless" ? "hookless" : "hooked";
        syncButtons();
        compute(true);
        track("tire_pressure_guard", { rim_type: rimType, tire_width_mm: tireWidthMm });
      });
    });

    surfBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        surfaceId = btn.getAttribute("data-surface") || "smooth";
        syncButtons();
        compute(true);
      });
    });

    if (copyBtn) {
      const def = isKo ? "세팅 공유 링크 복사" : "Copy Shareable Setup Link";
      const okLabel = isKo ? "세팅 링크 복사됨 ✓" : "Setup Link Copied ✓";
      copyBtn.addEventListener("click", () => {
        syncHash();
        copyToClipboard(window.location.href).then((ok) => {
          if (!ok) return;
          copyBtn.textContent = okLabel;
          window.setTimeout(() => {
            copyBtn.textContent = def;
          }, 1800);
        });
      });
    }

    loadFromHash();
    compute(false);

    window.addEventListener("hashchange", () => {
      loadFromHash();
      compute(false);
    });
  })();
</script>
