<script>
  import { copyToClipboard } from "../../lib/clipboard";

  (() => {
    const dataEl = document.getElementById("cmp-workbench-data");
    if (!dataEl) return;

    interface OutboundBtn {
      label: string;
      storeName: string;
      url: string;
      rel: string;
      target: string;
      isPrimary: boolean;
      linkMode: string;
    }

    interface SkuData {
      slug: string;
      vertical: string;
      category: string;
      categoryLabel: string;
      brand: string;
      name: string;
      summary: string;
      bestFor: string;
      trustScore: number;
      href: string;
      msrp: number;
      msrpUsd: number;
      msrpDisplay: string;
      monetization: {
        statusLabel: string;
        statusTone: "pass" | "caution" | "fail";
        benchmarkPriceFormatted: string;
        benchmarkDate: string;
        benchmarkCaption: string;
        disclosureText: string;
        isDiscontinued: boolean;
        isPriceStale: boolean;
        buttons: OutboundBtn[];
      };
      metrics: Record<string, number | string | boolean | null>;
    }

    interface CuratedVs {
      vertical: string;
      pairSlug: string;
      slugA: string;
      slugB: string;
      headline: string;
      href: string;
      infoGainScore: number;
    }

    interface WorkbenchPayload {
      locale: string;
      currency: "KRW" | "USD";
      basePath: string;
      disclosure: string;
      verticals: Array<{ id: string; label: string; fullName: string; count: number }>;
      itemsByVertical: Record<string, SkuData[]>;
      curatedVs: CuratedVs[];
    }

    interface DiffRow {
      label: string;
      displayA: string;
      displayB: string;
      barPctA: number;
      barPctB: number;
      winner: "a" | "b" | "tie" | "neutral";
      deltaText: string;
    }

    interface DimMeta {
      id: "value" | "portability" | "performance" | "practicality";
      label: string;
      hint: string;
      defaultWeight: number;
    }

    let payload: WorkbenchPayload;
    try {
      payload = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = payload.locale === "ko";
    const currency = payload.currency || (isKo ? "KRW" : "USD");

    const track = (name: string, params?: Record<string, unknown>) => {
      const w = window as unknown as {
        smTrack?: (ev: string, p?: Record<string, unknown>) => void;
      };
      if (typeof w.smTrack === "function") w.smTrack(name, params);
    };

    const esc = (s: unknown): string =>
      String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const numVal = (v: unknown): number | null =>
      typeof v === "number" && Number.isFinite(v) ? v : null;

    const fmtInt = (v: number | null): string =>
      v === null || !Number.isFinite(v)
        ? "—"
        : new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(Math.round(v));

    const fmtNum = (v: number | null, d = 1): string =>
      v === null || !Number.isFinite(v)
        ? "—"
        : new Intl.NumberFormat("en-US", {
            minimumFractionDigits: d,
            maximumFractionDigits: d,
          }).format(v);

    const fmtCurr = (v: number | null): string => {
      if (v === null || !Number.isFinite(v)) return "—";
      if (currency === "KRW") {
        const n = new Intl.NumberFormat("ko-KR").format(Math.round(v));
        return isKo ? `${n}원` : `₩${n}`;
      }
      return `$${new Intl.NumberFormat("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(v)}`;
    };

    const clampScore = (v: number): number =>
      !Number.isFinite(v) ? 50 : Math.max(15, Math.min(100, Math.round(v)));

    function pairScores(a: number, b: number, higherBetter: boolean): [number, number] {
      if (!Number.isFinite(a) || !Number.isFinite(b)) return [50, 50];
      if (Math.abs(a - b) < 0.0001) return [80, 80];
      const maxV = Math.max(a, b, 0.0001);
      const minV = Math.min(a, b);
      if (higherBetter) {
        return [clampScore((a / maxV) * 95), clampScore((b / maxV) * 95)];
      }
      return [
        clampScore((minV / Math.max(a, 0.0001)) * 95),
        clampScore((minV / Math.max(b, 0.0001)) * 95),
      ];
    }

    function makeRow(
      label: string,
      rawA: number | null,
      rawB: number | null,
      displayA: string,
      displayB: string,
      higherBetter: boolean,
      formatDelta: (diff: number) => string,
      neutral = false,
      neutralText?: string
    ): DiffRow {
      let winner: "a" | "b" | "tie" | "neutral" = "neutral";
      let deltaText = neutral ? (neutralText || (isKo ? "목적별 상이" : "Use-case dependent")) : "—";
      let barPctA = 50;
      let barPctB = 50;
      if (rawA !== null && rawB !== null) {
        const maxVal = Math.max(Math.abs(rawA), Math.abs(rawB), 0.0001);
        barPctA = Math.max(8, Math.min(100, Math.round((Math.abs(rawA) / maxVal) * 100)));
        barPctB = Math.max(8, Math.min(100, Math.round((Math.abs(rawB) / maxVal) * 100)));
        if (!neutral) {
          const diff = rawA - rawB;
          if (Math.abs(diff) < 0.005) {
            winner = "tie";
            deltaText = isKo ? "동일" : "Tie";
          } else {
            const aWins = higherBetter ? diff > 0 : diff < 0;
            winner = aWins ? "a" : "b";
            const formatted = formatDelta(Math.abs(diff));
            deltaText = isKo
              ? aWins
                ? `A 우세 (${formatted})`
                : `B 우세 (${formatted})`
              : aWins
                ? `A leads by ${formatted}`
                : `B leads by ${formatted}`;
          }
        }
      }
      return { label, displayA, displayB, barPctA, barPctB, winner, deltaText };
    }

    function getDimensionsForVertical(vertical: string): DimMeta[] {
      if (vertical === "wattcheck") {
        return [
          {
            id: "value",
            label: isKo ? "가성비 (Wh·W당 단가)" : "Value (Cost / Wh or W)",
            hint: isKo ? "동일 출력·용량 대비 지출 최소화" : "Lower MSRP per Wh or W",
            defaultWeight: 30,
          },
          {
            id: "portability",
            label: isKo ? "휴대성·경량" : "Weight & Portability",
            hint: isKo ? "출장·여행 가방 무게 절감" : "Lighter carry weight",
            defaultWeight: 25,
          },
          {
            id: "performance",
            label: isKo ? "출력·용량 성능" : "Output & Energy Performance",
            hint: isKo ? "최대 W·PD 3.1 EPR·실가용 Wh" : "Peak W, EPR & usable Wh",
            defaultWeight: 25,
          },
          {
            id: "practicality",
            label: isKo ? "기내·인증·멀티포트 실용성" : "Flight, Certs & Practicality",
            hint: isKo ? "기내 무승인·인증·무단절·포트" : "Cabin OK, certs, seamless PD",
            defaultWeight: 20,
          },
        ];
      }
      if (vertical === "puregram") {
        return [
          {
            id: "value",
            label: isKo ? "순수 유효성분 가성비" : "Value (Cost / Pure Active)",
            hint: isKo ? "기준 단위당 실질 비용 절감" : "Lowest true cost per benchmark unit",
            defaultWeight: 35,
          },
          {
            id: "portability",
            label: isKo ? "순도·저필러 밀도" : "Purity & Concentration",
            hint: isKo ? "불필요한 부형제·중량 최소화" : "Higher active-to-serving ratio",
            defaultWeight: 20,
          },
          {
            id: "performance",
            label: isKo ? "보급 효율·배합 설계" : "Fueling & Formulation",
            hint: isKo ? "1:0.8 비율·하이드로젤·나트륨" : "Carb ratio, hydrogel, sodium",
            defaultWeight: 25,
          },
          {
            id: "practicality",
            label: isKo ? "안티도핑 인증·클린 라벨" : "Certs & Clean Label",
            hint: isKo ? "제3자 인증·무인공감미료" : "Third-party testing & clean excipients",
            defaultWeight: 20,
          },
        ];
      }
      if (vertical === "hometech") {
        return [
          {
            id: "value",
            label: isKo ? "3년 총소유비용(TCO)" : "3-Year Total Cost (TCO)",
            hint: isKo ? "출고가 + 3년 전기요금·소모품 합산" : "MSRP + 3-year power & consumables",
            defaultWeight: 35,
          },
          {
            id: "portability",
            label: isKo ? "정숙성·설치 콤팩트함" : "Noise & Footprint",
            hint: isKo ? "낮은 dBA 소음과 가벼운 설치 중량" : "Quieter dBA & compact footprint",
            defaultWeight: 20,
          },
          {
            id: "performance",
            label: isKo ? "연산·네트워크·보호 성능" : "Compute / Capacity / UPS",
            hint: isKo ? "LAN·베이·UPS 정격·흡입력" : "LAN speed, bays, UPS VA, suction",
            defaultWeight: 25,
          },
          {
            id: "practicality",
            label: isKo ? "24/7 효율·220V 호환·인증" : "24/7 Efficiency & 220V/Certs",
            hint: isKo ? "저전력 대기·프리볼트·수명" : "Low idle W, 100–240V, lifespan",
            defaultWeight: 20,
          },
        ];
      }
      return [
        {
          id: "value",
          label: isKo ? "가성비 (MSRP 기준)" : "Value (MSRP Benchmark)",
          hint: isKo ? "초기 장비 도입 비용 절감" : "Lower upfront MSRP",
          defaultWeight: 30,
        },
        {
          id: "portability",
          label: isKo ? "경량성 (g)" : "Weight Savings (g)",
          hint: isKo ? "업힐·레이스 경량화 우선" : "Lighter component mass",
          defaultWeight: 25,
        },
        {
          id: "performance",
          label: isKo ? "정밀도·배터리·성능" : "Precision & Performance",
          hint: isKo ? "오차율·좌우밸런스·배터리·부하" : "Accuracy, L/R balance, battery, watts",
          defaultWeight: 25,
        },
        {
          id: "practicality",
          label: isKo ? "호환성·생태계 확장성" : "Ecosystem Compatibility",
          hint: isKo ? "구동계·BB·헤드유닛 호환 범위" : "Drivetrain, BB, head-unit support",
          defaultWeight: 20,
        },
      ];
    }

    function computeLiveDiff(a: SkuData, b: SkuData): {
      rows: DiffRow[];
      scoresA: Record<string, number>;
      scoresB: Record<string, number>;
    } {
      const rows: DiffRow[] = [
        makeRow(
          isKo ? "MSRP 참고가" : "MSRP Reference",
          a.msrp,
          b.msrp,
          a.msrpDisplay,
          b.msrpDisplay,
          false,
          (d) => fmtCurr(d)
        ),
      ];

      const mA = a.metrics;
      const mB = b.metrics;

      if (a.vertical === "wattcheck") {
        const maxWA = numVal(mA.maxTotalW);
        const maxWB = numVal(mB.maxTotalW);
        const singleWA = numVal(mA.maxSingleW);
        const singleWB = numVal(mB.maxSingleW);
        const wtA = numVal(mA.weightG);
        const wtB = numVal(mB.weightG);
        const densA = numVal(mA.wPer100g);
        const densB = numVal(mB.wPer100g);
        const portsA = numVal(mA.portsCount);
        const portsB = numVal(mB.portsCount);

        rows.push(
          makeRow(
            isKo ? "최대 합산 출력" : "Max Total Output",
            maxWA,
            maxWB,
            `${fmtInt(maxWA)} W`,
            `${fmtInt(maxWB)} W`,
            true,
            (d) => `${fmtInt(d)} W`
          ),
          makeRow(
            isKo ? "단일 포트 최대 출력" : "Max Single-Port Output",
            singleWA,
            singleWB,
            `${fmtInt(singleWA)} W`,
            `${fmtInt(singleWB)} W`,
            true,
            (d) => `${fmtInt(d)} W`
          )
        );

        if (mA.hasBattery && mB.hasBattery) {
          const whA = numVal(mA.batteryWh);
          const whB = numVal(mB.batteryWh);
          const uWhA = numVal(mA.usableWh);
          const uWhB = numVal(mB.usableWh);
          const cWhA = numVal(mA.costPer10Wh);
          const cWhB = numVal(mB.costPer10Wh);
          rows.push(
            makeRow(
              isKo ? "정격 에너지 (Wh)" : "Rated Energy (Wh)",
              whA,
              whB,
              `${fmtNum(whA, 1)} Wh`,
              `${fmtNum(whB, 1)} Wh`,
              true,
              (d) => `${fmtNum(d, 1)} Wh`
            ),
            makeRow(
              isKo ? "실가용 에너지 (효율 반영)" : "Real Usable Energy",
              uWhA,
              uWhB,
              `${fmtNum(uWhA, 1)} Wh`,
              `${fmtNum(uWhB, 1)} Wh`,
              true,
              (d) => `${fmtNum(d, 1)} Wh`
            ),
            makeRow(
              isKo ? "10 Wh당 기준 단가" : "Cost per 10 Wh",
              cWhA,
              cWhB,
              fmtCurr(cWhA),
              fmtCurr(cWhB),
              false,
              (d) => fmtCurr(d)
            )
          );
        } else {
          const cWA = numVal(mA.costPer10W);
          const cWB = numVal(mB.costPer10W);
          rows.push(
            makeRow(
              isKo ? "10 W당 기준 단가" : "Cost per 10 W",
              cWA,
              cWB,
              fmtCurr(cWA),
              fmtCurr(cWB),
              false,
              (d) => fmtCurr(d)
            )
          );
        }

        rows.push(
          makeRow(
            isKo ? "본체 무게 (경량 우세)" : "Weight (Lighter Wins)",
            wtA,
            wtB,
            `${fmtInt(wtA)} g`,
            `${fmtInt(wtB)} g`,
            false,
            (d) => `${fmtInt(d)} g`
          ),
          makeRow(
            isKo ? "출력 밀도 (W/100g)" : "Power Density (W/100g)",
            densA,
            densB,
            `${fmtNum(densA, 1)} W/100g`,
            `${fmtNum(densB, 1)} W/100g`,
            true,
            (d) => `${fmtNum(d, 1)} W/100g`
          ),
          makeRow(
            isKo ? "출력 포트 수" : "Output Ports",
            portsA,
            portsB,
            `${fmtInt(portsA)}`,
            `${fmtInt(portsB)}`,
            true,
            (d) => `${fmtInt(d)}`
          )
        );

        const cWhLocA = numVal(mA.costPer10Wh);
        const cWhLocB = numVal(mB.costPer10Wh);
        const useWhVal = Boolean(mA.hasBattery && mB.hasBattery && cWhLocA && cWhLocB);
        const [valA, valB] = pairScores(
          useWhVal ? (cWhLocA ?? 1) : (numVal(mA.costPer10W) ?? 1),
          useWhVal ? (cWhLocB ?? 1) : (numVal(mB.costPer10W) ?? 1),
          false
        );
        const [portA, portB] = pairScores(wtA ?? 100, wtB ?? 100, false);
        const [perfA, perfB] = pairScores(
          (maxWA ?? 0) + (singleWA ?? 0) + (numVal(mA.usableWh) ?? 0),
          (maxWB ?? 0) + (singleWB ?? 0) + (numVal(mB.usableWh) ?? 0),
          true
        );
        const prac = (m: Record<string, number | string | boolean | null>) =>
          (numVal(m.certCount) ?? 0) * 12 +
          (numVal(m.portsCount) ?? 0) * 8 +
          (m.supportsEpr ? 12 : 0) +
          (m.supportsPps ? 10 : 0) +
          (!m.renegotiationDrop ? 12 : 0) +
          (m.carryonNoApproval ? 15 : 0);
        const [pracA, pracB] = pairScores(prac(mA), prac(mB), true);

        return {
          rows,
          scoresA: { value: valA, portability: portA, performance: perfA, practicality: pracA },
          scoresB: { value: valB, portability: portB, performance: perfB, practicality: pracB },
        };
      }

      if (a.vertical === "puregram") {
        const cbA = numVal(mA.costPerBench);
        const cbB = numVal(mB.costPerBench);
        const purA = numVal(mA.purityPct);
        const purB = numVal(mB.purityPct);
        const actA = numVal(mA.activePerServingG);
        const actB = numVal(mB.activePerServingG);
        const srvCostA = numVal(mA.costPerServing);
        const srvCostB = numVal(mB.costPerServing);
        const naA = numVal(mA.sodiumMg);
        const naB = numVal(mB.sodiumMg);
        const srvA = numVal(mA.totalServings);
        const srvB = numVal(mB.totalServings);
        const r90A = numVal(mA.race90gCost);
        const r90B = numVal(mB.race90gCost);

        const benchLabelA = String(mA.benchLabel || (isKo ? "기준" : "Unit"));
        const benchLabelB = String(mB.benchLabel || (isKo ? "기준" : "Unit"));
        const sameBenchUnit = a.category === b.category && benchLabelA === benchLabelB;
        const bothElectrolyte = a.category === "electrolyte" && b.category === "electrolyte";
        const bothCarbActive =
          mA.activeIngredientType === "carbohydrates" &&
          mB.activeIngredientType === "carbohydrates";

        rows.push(
          sameBenchUnit
            ? makeRow(
                isKo
                  ? `기준 단위 실단가 (${benchLabelA})`
                  : `Cost / Benchmark (${benchLabelA})`,
                cbA,
                cbB,
                fmtCurr(cbA),
                fmtCurr(cbB),
                false,
                (d) => fmtCurr(d)
              )
            : makeRow(
                isKo ? "기준 단위 실단가 (카테고리별 상이)" : "Cost / Benchmark Unit (Differs)",
                null,
                null,
                `${fmtCurr(cbA)} / ${benchLabelA}`,
                `${fmtCurr(cbB)} / ${benchLabelB}`,
                false,
                (d) => fmtCurr(d),
                true,
                isKo ? "기준 단위 상이" : "Incompatible units"
              ),
          makeRow(
            isKo ? "유효성분 순도 (%)" : "Active Purity (%)",
            purA,
            purB,
            `${fmtNum(purA, 1)}%`,
            `${fmtNum(purB, 1)}%`,
            true,
            (d) => `${fmtNum(d, 1)}%`
          ),
          makeRow(
            isKo ? "1회 제공량당 유효성분" : "Active per Serving",
            actA,
            actB,
            `${fmtNum(actA, 1)} g`,
            `${fmtNum(actB, 1)} g`,
            true,
            (d) => `${fmtNum(d, 1)} g`,
            !sameBenchUnit,
            isKo ? "성분군 상이" : "Different actives"
          ),
          makeRow(
            isKo ? "1회분 기준 단가" : "Cost per Serving",
            srvCostA,
            srvCostB,
            fmtCurr(srvCostA),
            fmtCurr(srvCostB),
            false,
            (d) => fmtCurr(d)
          ),
          makeRow(
            isKo ? "나트륨 함량 / 회" : "Sodium / Serving",
            naA,
            naB,
            `${fmtInt(naA)} mg`,
            `${fmtInt(naB)} mg`,
            bothElectrolyte,
            (d) => `${fmtInt(d)} mg`,
            !bothElectrolyte,
            isKo ? "목적별 상이" : "Use-case dependent"
          ),
          makeRow(
            isKo ? "패키지 총 서빙 수" : "Total Servings / Pack",
            srvA,
            srvB,
            `${fmtInt(srvA)}`,
            `${fmtInt(srvB)}`,
            true,
            (d) => `${fmtInt(d)}`
          )
        );
        if (bothCarbActive && r90A !== null && r90B !== null) {
          rows.push(
            makeRow(
              isKo ? "시간당 90g 레이스 보급비" : "90g/hr Race Fueling Cost",
              r90A,
              r90B,
              fmtCurr(r90A),
              fmtCurr(r90B),
              false,
              (d) => fmtCurr(d)
            )
          );
        }

        const [valA, valB] = sameBenchUnit
          ? pairScores(cbA ?? 1, cbB ?? 1, false)
          : pairScores(srvCostA ?? a.msrp, srvCostB ?? b.msrp, false);
        const [portA, portB] = pairScores(purA ?? 50, purB ?? 50, true);
        const perf = (m: Record<string, number | string | boolean | null>) =>
          (numVal(m.activePerServingG) ?? 0) * 2 +
          (m.carbRatio === "1:0.8" ? 18 : 6) +
          (m.hydrogelType === "hydrogel" ? 16 : m.hydrogelType === "isotonic" ? 12 : 4) +
          (m.creapure ? 20 : 0) +
          Math.min(20, (numVal(m.sodiumMg) ?? 0) / 50);
        const [perfA, perfB] = pairScores(perf(mA), perf(mB), true);
        const prac = (m: Record<string, number | string | boolean | null>) =>
          (numVal(m.certCount) ?? 0) * 14 +
          (m.noArtifSweet ? 16 : 0) +
          (m.noFreeAmino ? 12 : 0) +
          Math.min(20, numVal(m.totalServings) ?? 0);
        const [pracA, pracB] = pairScores(prac(mA), prac(mB), true);

        return {
          rows,
          scoresA: { value: valA, portability: portA, performance: perfA, practicality: pracA },
          scoresB: { value: valB, portability: portB, performance: perfB, practicality: pracB },
        };
      }

      if (a.vertical === "hometech") {
        const tcoA = numVal(mA.tco3yr);
        const tcoB = numVal(mB.tco3yr);
        const avgWA = numVal(mA.weightedAvgW);
        const avgWB = numVal(mB.weightedAvgW);
        const kwhA = numVal(mA.annualKwh);
        const kwhB = numVal(mB.annualKwh);
        const elecA = numVal(mA.annualElec);
        const elecB = numVal(mB.annualElec);
        const idleA = numVal(mA.idlePowerW);
        const idleB = numVal(mB.idlePowerW);
        const typA = numVal(mA.typicalLoadW);
        const typB = numVal(mB.typicalLoadW);
        const wtA = numVal(mA.weightG);
        const wtB = numVal(mB.weightG);
        const consA = numVal(mA.annualConsumables);
        const consB = numVal(mB.annualConsumables);
        const noiseLoadA = numVal(mA.noiseLoadDba);
        const noiseLoadB = numVal(mB.noiseLoadDba);
        const lanA = numVal(mA.lanSpeedGbps);
        const lanB = numVal(mB.lanSpeedGbps);
        const baysA = numVal(mA.driveBays);
        const baysB = numVal(mB.driveBays);
        const upsWA = numVal(mA.upsWattRating);
        const upsWB = numVal(mB.upsWattRating);
        const upsVaA = numVal(mA.upsVaRating);
        const upsVaB = numVal(mB.upsVaRating);
        const sucA = numVal(mA.suctionPa);
        const sucB = numVal(mB.suctionPa);

        rows.push(
          makeRow(
            isKo ? "3년 총소유비용 (3-Yr TCO)" : "3-Year TCO (HW + Power + Maint.)",
            tcoA,
            tcoB,
            fmtCurr(tcoA),
            fmtCurr(tcoB),
            false,
            (d) => fmtCurr(d)
          ),
          makeRow(
            isKo ? "가중 평균 소비전력 (낮을수록 우세)" : "Weighted Avg Power (Lower Wins)",
            avgWA,
            avgWB,
            `${fmtNum(avgWA, 1)} W`,
            `${fmtNum(avgWB, 1)} W`,
            false,
            (d) => `${fmtNum(d, 1)} W`
          ),
          makeRow(
            isKo ? "연간 전력 소비량 (kWh/yr)" : "Annual Energy Consumption",
            kwhA,
            kwhB,
            `${fmtNum(kwhA, 1)} kWh`,
            `${fmtNum(kwhB, 1)} kWh`,
            false,
            (d) => `${fmtNum(d, 1)} kWh`
          ),
          makeRow(
            isKo ? "연간 예상 전기요금 (한전 2구간)" : "Annual Electricity Cost ($0.17/kWh)",
            elecA,
            elecB,
            fmtCurr(elecA),
            fmtCurr(elecB),
            false,
            (d) => fmtCurr(d)
          ),
          makeRow(
            isKo ? "24/7 대기전력 (Idle W)" : "Idle Power Draw (W)",
            idleA,
            idleB,
            `${fmtNum(idleA, 1)} W`,
            `${fmtNum(idleB, 1)} W`,
            false,
            (d) => `${fmtNum(d, 1)} W`
          ),
          makeRow(
            isKo ? "실사용 평균 부하 전력" : "Typical Active Load",
            typA,
            typB,
            `${fmtNum(typA, 1)} W`,
            `${fmtNum(typB, 1)} W`,
            false,
            (d) => `${fmtNum(d, 1)} W`
          ),
          makeRow(
            isKo ? "본체 무게 (g)" : "Unit Weight (g)",
            wtA,
            wtB,
            `${fmtInt(wtA)} g`,
            `${fmtInt(wtB)} g`,
            false,
            (d) => `${fmtInt(d)} g`
          )
        );
        if ((consA ?? 0) > 0 || (consB ?? 0) > 0) {
          rows.push(
            makeRow(
              isKo ? "연간 소모품 유지비" : "Annual Consumables Cost",
              consA,
              consB,
              fmtCurr(consA),
              fmtCurr(consB),
              false,
              (d) => fmtCurr(d)
            )
          );
        }
        if (noiseLoadA !== null && noiseLoadB !== null) {
          rows.push(
            makeRow(
              isKo ? "부하 소음 (dBA, 낮을수록 정숙)" : "Load Noise (dBA, Quieter Wins)",
              noiseLoadA,
              noiseLoadB,
              `${fmtNum(noiseLoadA, 1)} dBA`,
              `${fmtNum(noiseLoadB, 1)} dBA`,
              false,
              (d) => `${fmtNum(d, 1)} dBA`
            )
          );
        }
        if (lanA !== null && lanB !== null) {
          rows.push(
            makeRow(
              isKo ? "유선 네트워크 대역폭" : "Wired LAN Bandwidth",
              lanA,
              lanB,
              `${fmtNum(lanA, lanA % 1 !== 0 ? 1 : 0)} GbE`,
              `${fmtNum(lanB, lanB % 1 !== 0 ? 1 : 0)} GbE`,
              true,
              (d) => `${fmtNum(d, d % 1 !== 0 ? 1 : 0)} GbE`
            )
          );
        }
        if (baysA !== null && baysB !== null) {
          rows.push(
            makeRow(
              isKo ? "스토리지 드라이브 베이" : "Storage Drive Bays",
              baysA,
              baysB,
              `${fmtInt(baysA)}-Bay`,
              `${fmtInt(baysB)}-Bay`,
              true,
              (d) => `${fmtInt(d)}`
            )
          );
        }
        if (upsWA !== null && upsWB !== null) {
          rows.push(
            makeRow(
              isKo ? "UPS 유효 출력 용량 (W)" : "UPS Real Power Capacity (W)",
              upsWA,
              upsWB,
              `${fmtInt(upsWA)} W (${fmtInt(upsVaA)} VA)`,
              `${fmtInt(upsWB)} W (${fmtInt(upsVaB)} VA)`,
              true,
              (d) => `${fmtInt(d)} W`
            )
          );
        }
        if (sucA !== null && sucB !== null) {
          rows.push(
            makeRow(
              isKo ? "최대 흡입력 (Pa)" : "Peak Suction Power (Pa)",
              sucA,
              sucB,
              `${fmtInt(sucA)} Pa`,
              `${fmtInt(sucB)} Pa`,
              true,
              (d) => `${fmtInt(d)} Pa`
            )
          );
        }

        // Aligned 1:1 with web/src/lib/derived.ts (locale-aware TCO for value)
        const [valA, valB] = pairScores(tcoA ?? a.msrp, tcoB ?? b.msrp, false);

        const footprintRaw = (m: Record<string, number | string | boolean | null>) => {
          const volL = numVal(m.volumeL) ?? 0;
          const noise = numVal(m.noiseLoadDba) ?? numVal(m.noiseIdleDba) ?? 38;
          const wt = numVal(m.weightG) ?? 1000;
          return noise * 2 + Math.min(40, volL * 2.5) + Math.min(30, wt / 400);
        };
        const [portA, portB] = pairScores(footprintRaw(mA), footprintRaw(mB), false);

        const perf = (m: Record<string, number | string | boolean | null>) => {
          const ram = numVal(m.ramGbDefault);
          const lan = numVal(m.lanSpeedGbps);
          const bays = numVal(m.driveBays);
          const upsW = numVal(m.upsWattRating);
          const upsRun = numVal(m.upsRuntimeHalfLoadMin);
          const suc = numVal(m.suctionPa);
          const bag = numVal(m.dustbagCapacityL);
          const peakW = numVal(m.peakPowerW) ?? 0;
          return (
            (ram ? Math.min(32, ram) * 1.4 : 0) +
            (lan ? lan * 8 : 0) +
            (bays ? bays * 12 : 0) +
            (upsW ? upsW / 18 : 0) +
            (m.upsWaveform === "pure-sine" ? 22 : 0) +
            (upsRun ? upsRun * 2 : 0) +
            (suc ? suc / 220 : 0) +
            (bag ? bag * 6 : 0) +
            Math.min(25, peakW / 10)
          );
        };
        const [perfA, perfB] = pairScores(perf(mA), perf(mB), true);

        const prac = (m: Record<string, number | string | boolean | null>) =>
          Math.max(5, 45 - (numVal(m.weightedAvgW) ?? 15) * 0.6) +
          (m.dualVoltage ? 22 : 0) +
          (m.alwaysOn247 ? 10 : 5) +
          (numVal(m.lifespanYears) ?? 5) * 3 +
          (numVal(m.certCount) ?? 0) * 5;
        const [pracA, pracB] = pairScores(prac(mA), prac(mB), true);

        return {
          rows,
          scoresA: { value: valA, portability: portA, performance: perfA, practicality: pracA },
          scoresB: { value: valB, portability: portB, performance: perfB, practicality: pracB },
        };
      }

      // CycleGear
      const wtA = numVal(mA.weightG);
      const wtB = numVal(mB.weightG);
      const c100A = numVal(mA.costPer100g);
      const c100B = numVal(mB.costPer100g);
      const accA = numVal(mA.accuracyPct);
      const accB = numVal(mB.accuracyPct);
      const batA = numVal(mA.batteryHours);
      const batB = numVal(mB.batteryHours);
      const trA = numVal(mA.maxTrainerWatts);
      const trB = numVal(mB.maxTrainerWatts);
      const cmpA = numVal(mA.compatBreadthScore);
      const cmpB = numVal(mB.compatBreadthScore);

      rows.push(
        makeRow(
          isKo ? "공식 중량 (경량 우세)" : "Official Weight (Lighter Wins)",
          wtA,
          wtB,
          `${fmtInt(wtA)} g`,
          `${fmtInt(wtB)} g`,
          false,
          (d) => `${fmtInt(d)} g`
        ),
        makeRow(
          isKo ? "100g당 기준 단가" : "Cost per 100g",
          c100A,
          c100B,
          fmtCurr(c100A),
          fmtCurr(c100B),
          false,
          (d) => fmtCurr(d)
        )
      );
      if (accA !== null && accB !== null) {
        rows.push(
          makeRow(
            isKo ? "공칭 정확도 오차" : "Accuracy Error (Lower Wins)",
            accA,
            accB,
            `±${fmtNum(accA, 1)}%`,
            `±${fmtNum(accB, 1)}%`,
            false,
            (d) => `${fmtNum(d, 1)}%`
          )
        );
      }
      if (batA !== null && batB !== null) {
        rows.push(
          makeRow(
            isKo ? "배터리 구동 시간" : "Battery Life",
            batA,
            batB,
            `${fmtInt(batA)} hr`,
            `${fmtInt(batB)} hr`,
            true,
            (d) => `${fmtInt(d)} hr`
          )
        );
      }
      if (trA !== null && trB !== null) {
        rows.push(
          makeRow(
            isKo ? "최대 부하 출력" : "Max Resistance Output",
            trA,
            trB,
            `${fmtInt(trA)} W`,
            `${fmtInt(trB)} W`,
            true,
            (d) => `${fmtInt(d)} W`
          )
        );
      }
      rows.push(
        makeRow(
          isKo ? "생태계 호환 지수" : "Ecosystem Compatibility",
          cmpA,
          cmpB,
          `${fmtInt(cmpA)} pts`,
          `${fmtInt(cmpB)} pts`,
          true,
          (d) => `${fmtInt(d)} pts`
        )
      );

      const [valA, valB] = pairScores(a.msrp, b.msrp, false);
      const [portA, portB] = pairScores(wtA ?? 200, wtB ?? 200, false);
      const perf = (m: Record<string, number | string | boolean | null>) =>
        (numVal(m.accuracyPct) !== null ? (3.5 - (numVal(m.accuracyPct) ?? 1.5)) * 25 : 40) +
        (m.leftRightBalance ? 18 : 0) +
        (numVal(m.batteryHours) ? Math.min(35, (numVal(m.batteryHours) ?? 0) / 3) : 0) +
        (numVal(m.maxTrainerWatts) ? (numVal(m.maxTrainerWatts) ?? 0) / 60 : 0) +
        (m.hooklessCompatible ? 15 : 0);
      const [perfA, perfB] = pairScores(perf(mA), perf(mB), true);
      const [pracA, pracB] = pairScores(cmpA ?? 5, cmpB ?? 5, true);

      return {
        rows,
        scoresA: { value: valA, portability: portA, performance: perfA, practicality: pracA },
        scoresB: { value: valB, portability: portB, performance: perfB, practicality: pracB },
      };
    }

    // DOM elements
    const vertPills = Array.from(document.querySelectorAll<HTMLButtonElement>(".cmp-vert-pill"));
    const selectA = document.getElementById("cmp-select-a") as HTMLSelectElement | null;
    const selectB = document.getElementById("cmp-select-b") as HTMLSelectElement | null;
    const swapBtn = document.getElementById("cmp-swap");
    const linkA = document.getElementById("cmp-link-a") as HTMLAnchorElement | null;
    const linkB = document.getElementById("cmp-link-b") as HTMLAnchorElement | null;
    const popularWrap = document.getElementById("cmp-popular-chips");
    const crossCatBanner = document.getElementById("cmp-cross-cat-banner");
    const crossCatMsg = document.getElementById("cmp-cross-cat-msg");
    const curatedBanner = document.getElementById("cmp-curated-banner");
    const curatedIg = document.getElementById("cmp-curated-ig");
    const curatedHeadline = document.getElementById("cmp-curated-headline");
    const curatedHref = document.getElementById("cmp-curated-href") as HTMLAnchorElement | null;

    const sliders = Array.from(document.querySelectorAll<HTMLInputElement>(".cmp-weight-slider"));
    const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".cmp-preset-btn"));
    const scoreAEl = document.getElementById("cmp-score-a");
    const scoreBEl = document.getElementById("cmp-score-b");
    const barAEl = document.getElementById("cmp-bar-a");
    const barBEl = document.getElementById("cmp-bar-b");
    const barNameAEl = document.getElementById("cmp-bar-name-a");
    const barNameBEl = document.getElementById("cmp-bar-name-b");
    const winnerBanner = document.getElementById("cmp-winner-banner");
    const winnerTag = document.getElementById("cmp-winner-tag");
    const winnerName = document.getElementById("cmp-winner-name");
    const winnerMargin = document.getElementById("cmp-winner-margin");

    const thA = document.getElementById("cmp-th-a");
    const thB = document.getElementById("cmp-th-b");
    const diffTbody = document.getElementById("cmp-diff-tbody");
    const ctaAWrap = document.getElementById("cmp-cta-a");
    const ctaBWrap = document.getElementById("cmp-cta-b");
    const copyLinkBtn = document.getElementById("cmp-copy-link") as HTMLButtonElement | null;
    const copyMdBtn = document.getElementById("cmp-copy-md") as HTMLButtonElement | null;

    const ACTIVE_PRESET_CLS =
      "cmp-preset-btn rounded border border-blue-500 bg-blue-600 px-2.5 py-1 font-mono text-[11px] font-semibold text-white transition-colors";
    const INACTIVE_PRESET_CLS =
      "cmp-preset-btn rounded border border-white/20 bg-white/10 px-2.5 py-1 font-mono text-[11px] font-semibold text-white transition-colors hover:bg-white/20";

    let activeVertical = "wattcheck";
    let slugA = "";
    let slugB = "";
    let currentDiffRows: DiffRow[] = [];
    let currentScoresA: Record<string, number> = { value: 50, portability: 50, performance: 50, practicality: 50 };
    let currentScoresB: Record<string, number> = { value: 50, portability: 50, performance: 50, practicality: 50 };
    let lastScoreA = 50;
    let lastScoreB = 50;
    let lastWinnerText = "";

    function getPresets(vertical: string): Record<string, Record<string, number>> {
      const dims = getDimensionsForVertical(vertical);
      const balanced: Record<string, number> = {};
      dims.forEach((d) => {
        balanced[d.id] = d.defaultWeight;
      });
      return {
        balanced,
        value: { value: 60, portability: 15, performance: 15, practicality: 10 },
        performance: { value: 10, portability: 15, performance: 60, practicality: 15 },
        portability: { value: 15, portability: 60, performance: 15, practicality: 10 },
      };
    }

    function syncPresetHighlight(key: string) {
      presetBtns.forEach((btn) => {
        const on = (btn.getAttribute("data-preset") || "") === key;
        btn.className = on ? ACTIVE_PRESET_CLS : INACTIVE_PRESET_CLS;
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }

    function pickBestPartner(vertical: string, targetSlug: string): string {
      const list = payload.itemsByVertical[vertical] || [];
      const curVs = payload.curatedVs.find(
        (v) => v.vertical === vertical && (v.slugA === targetSlug || v.slugB === targetSlug)
      );
      if (curVs) {
        return curVs.slugA === targetSlug ? curVs.slugB : curVs.slugA;
      }
      const target = list.find((i) => i.slug === targetSlug);
      const sameCat = target
        ? list.find((i) => i.slug !== targetSlug && i.category === target.category)
        : null;
      if (sameCat) return sameCat.slug;
      const other = list.find((i) => i.slug !== targetSlug);
      return other ? other.slug : targetSlug;
    }

    function applyVerticalUI(vertical: string) {
      const list = payload.itemsByVertical[vertical] || [];
      vertPills.forEach((pill) => {
        const v = pill.getAttribute("data-vertical") || "";
        const cnt = (payload.itemsByVertical[v] || []).length;
        const on = v === vertical;
        pill.setAttribute("aria-selected", on ? "true" : "false");
        pill.className = on
          ? "cmp-vert-pill inline-flex items-center gap-2 rounded-lg border border-slate-900 bg-slate-900 px-3.5 py-2 text-xs font-bold text-white transition-colors"
          : cnt < 2
            ? "cmp-vert-pill inline-flex cursor-not-allowed items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-2 text-xs font-bold text-slate-400"
            : "cmp-vert-pill inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-blue-500 hover:text-blue-700";
      });

      const grouped = new Map<string, { label: string; items: SkuData[] }>();
      list.forEach((it) => {
        let g = grouped.get(it.category);
        if (!g) {
          g = { label: it.categoryLabel, items: [] };
          grouped.set(it.category, g);
        }
        g.items.push(it);
      });
      const optsHtml = Array.from(grouped.values())
        .map(
          (g) =>
            `<optgroup label="${esc(g.label)}">${g.items
              .map(
                (it) =>
                  `<option value="${esc(it.slug)}">${esc(it.name)} (${esc(it.msrpDisplay)})</option>`
              )
              .join("")}</optgroup>`
        )
        .join("");
      if (selectA) selectA.innerHTML = optsHtml;
      if (selectB) selectB.innerHTML = optsHtml;

      // Update dimension labels & reset sliders to vertical balanced defaults
      const dims = getDimensionsForVertical(vertical);
      dims.forEach((dim) => {
        const lbl = document.getElementById(`cmp-lbl-${dim.id}`);
        const hint = document.getElementById(`cmp-hint-${dim.id}`);
        const slider = document.getElementById(`cmp-w-${dim.id}`) as HTMLInputElement | null;
        if (lbl) lbl.textContent = dim.label;
        if (hint) hint.textContent = dim.hint;
        if (slider) slider.value = String(dim.defaultWeight);
      });
      syncPresetHighlight("balanced");

      // Render popular matchup chips
      if (popularWrap) {
        const vsForV = payload.curatedVs.filter((v) => v.vertical === vertical).slice(0, 4);
        const chips: Array<{ a: string; b: string; label: string }> = [];
        vsForV.forEach((v) => {
          const itA = list.find((i) => i.slug === v.slugA);
          const itB = list.find((i) => i.slug === v.slugB);
          if (itA && itB) {
            chips.push({
              a: itA.slug,
              b: itB.slug,
              label: `${itA.name.split("(")[0].trim()} vs ${itB.name.split("(")[0].trim()}`,
            });
          }
        });
        if (chips.length === 0 && list.length >= 2) {
          chips.push({
            a: list[0].slug,
            b: list[1].slug,
            label: `${list[0].name.split("(")[0].trim()} vs ${list[1].name.split("(")[0].trim()}`,
          });
        }
        popularWrap.innerHTML = chips
          .map(
            (c) =>
              `<button type="button" data-pair-a="${esc(c.a)}" data-pair-b="${esc(c.b)}" class="cmp-pop-chip rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-800">${esc(c.label)}</button>`
          )
          .join("");
        popularWrap.querySelectorAll<HTMLButtonElement>(".cmp-pop-chip").forEach((chip) => {
          chip.addEventListener("click", () => {
            const pa = chip.getAttribute("data-pair-a") || "";
            const pb = chip.getAttribute("data-pair-b") || "";
            if (pa && pb) {
              slugA = pa;
              slugB = pb;
              renderComparison(true, true);
            }
          });
        });
      }
    }

    function renderCtaCard(container: HTMLElement | null, item: SkuData, side: "A" | "B") {
      if (!container) return;
      const m = item.monetization;
      const toneCls =
        m.statusTone === "pass"
          ? "badge-pass"
          : m.statusTone === "fail"
            ? "badge-fail"
            : "badge-caution";
      const sideLabel = side === "A" ? "MODEL A" : "MODEL B";
      const sideTextCls = side === "A" ? "text-blue-700" : "text-emerald-700";
      const primaryBtnCls =
        side === "A"
          ? "bg-blue-700 text-white hover:bg-blue-800"
          : "bg-emerald-700 text-white hover:bg-emerald-800";

      const btnsHtml = m.buttons
        .map(
          (btn) =>
            `<a href="${esc(btn.url)}" rel="sponsored nofollow noopener" target="_blank" data-affiliate-store="${esc(btn.storeName)}" data-affiliate-vertical="${esc(item.vertical)}" data-affiliate-sku="${esc(item.slug)}" data-affiliate-mode="${esc(btn.linkMode)}" class="inline-flex w-full items-center justify-between gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors ${btn.isPrimary ? primaryBtnCls : "border border-slate-300 bg-slate-50 text-slate-800 hover:bg-slate-100"}"><span>${esc(btn.label)}</span><span class="font-mono text-xs opacity-85">↗</span></a>`
        )
        .join("");

      container.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[11px] font-bold uppercase ${sideTextCls}">${sideLabel}</span>
              <span class="text-[11px] text-slate-500">${esc(item.brand)} · ${esc(item.categoryLabel)}</span>
            </div>
            <h3 class="mt-0.5 text-base font-bold text-slate-900">
              <a href="${esc(item.href)}" class="hover:text-blue-700 hover:underline">${esc(item.name)}</a>
            </h3>
          </div>
          <span class="${toneCls}">${esc(m.statusLabel)}</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="kpi-value font-mono text-2xl font-bold text-slate-900">${esc(m.benchmarkPriceFormatted)}</span>
          <span class="font-mono text-xs text-slate-500">(${esc(m.benchmarkDate)})</span>
        </div>
        <p class="mt-1 text-xs text-slate-600">${esc(m.benchmarkCaption)}</p>
        <p class="mt-2 rounded-md border border-slate-100 bg-slate-50 px-3 py-2 text-xs text-slate-700">
          <strong class="text-slate-900">${isKo ? "최적 용도:" : "Best for:"}</strong> ${esc(item.bestFor)}
        </p>
        <div class="mt-3 flex flex-col gap-2">${btnsHtml}</div>
        <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2.5 text-xs">
          <a href="${esc(item.href)}" class="font-semibold text-blue-700 hover:underline">
            ${isKo ? "상세 스펙 & 전용 계산기 열기 →" : "Open Full Spec & Calculator →"}
          </a>
          <span class="font-mono text-[11px] text-emerald-700">Trust ${esc(item.trustScore)}</span>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed text-slate-500">${esc(m.disclosureText || payload.disclosure)}</p>
      `;
    }

    const DIM_ORDER = ["value", "portability", "performance", "practicality"] as const;

    function getCurrentWeightsTuple(): number[] {
      return DIM_ORDER.map((dim) => {
        const el = document.getElementById(`cmp-w-${dim}`) as HTMLInputElement | null;
        const v = Number(el?.value ?? 25);
        return Number.isFinite(v) ? Math.max(0, Math.min(100, Math.round(v))) : 25;
      });
    }

    function buildShareHash(): string {
      const base = `#${activeVertical}:${slugA}:${slugB}`;
      const dims = getDimensionsForVertical(activeVertical);
      const defaults = DIM_ORDER.map(
        (id) => dims.find((d) => d.id === id)?.defaultWeight ?? 25
      );
      const cur = getCurrentWeightsTuple();
      const isDefault = cur.every((v, idx) => v === defaults[idx]);
      return isDefault ? base : `${base}:w=${cur.join(",")}`;
    }

    function syncUrlHash() {
      try {
        window.history.replaceState(null, "", buildShareHash());
      } catch {
        // ignore
      }
    }

    function updateScoresOnly(syncHash = false) {
      const list = payload.itemsByVertical[activeVertical] || [];
      const itemA = list.find((i) => i.slug === slugA);
      const itemB = list.find((i) => i.slug === slugB);
      if (!itemA || !itemB) return;

      let sumW = 0;
      const weights: Record<string, number> = {};
      sliders.forEach((s) => {
        const dim = s.getAttribute("data-dim") || "";
        const val = Number(s.value || 0);
        weights[dim] = Number.isFinite(val) ? val : 0;
        sumW += weights[dim];
      });

      const normDiv = sumW > 0 ? sumW : 1;
      let accA = 0;
      let accB = 0;
      sliders.forEach((s) => {
        const dim = s.getAttribute("data-dim") || "";
        const val = weights[dim] || 0;
        const pct = sumW > 0 ? Math.round((val / sumW) * 100) : 25;
        const wLbl = document.getElementById(`cmp-wval-${dim}`);
        const subA = document.getElementById(`cmp-sub-a-${dim}`);
        const subB = document.getElementById(`cmp-sub-b-${dim}`);
        if (wLbl) wLbl.textContent = `${pct}%`;
        const sA = currentScoresA[dim] ?? 50;
        const sB = currentScoresB[dim] ?? 50;
        if (subA) subA.textContent = `A: ${sA}/100`;
        if (subB) subB.textContent = `B: ${sB}/100`;
        accA += sA * (sumW > 0 ? val : 1);
        accB += sB * (sumW > 0 ? val : 1);
      });

      const finalA = Math.round(accA / (sumW > 0 ? normDiv : sliders.length || 1));
      const finalB = Math.round(accB / (sumW > 0 ? normDiv : sliders.length || 1));
      lastScoreA = finalA;
      lastScoreB = finalB;

      if (scoreAEl) scoreAEl.textContent = String(finalA);
      if (scoreBEl) scoreBEl.textContent = String(finalB);
      if (barAEl) barAEl.style.width = `${finalA}%`;
      if (barBEl) barBEl.style.width = `${finalB}%`;

      const diff = Math.abs(finalA - finalB);
      if (winnerBanner && winnerTag && winnerName && winnerMargin) {
        if (diff <= 1) {
          winnerBanner.className = "mt-2 rounded-lg border border-slate-300 bg-white p-3.5";
          winnerTag.className = "badge-caution";
          winnerTag.textContent = isKo ? "초접전 동점" : "DEAD HEAT / TIE";
          winnerName.textContent = isKo ? "두 모델 점수 사실상 동일" : "Virtual Tie — Pick by Ecosystem";
          winnerMargin.textContent = `A ${finalA} vs B ${finalB}`;
          lastWinnerText = isKo ? `초접전 동점 (A ${finalA} vs B ${finalB})` : `Virtual Tie (A ${finalA} vs B ${finalB})`;
        } else if (finalA > finalB) {
          winnerBanner.className = "mt-2 rounded-lg border border-blue-300 bg-blue-50 p-3.5";
          winnerTag.className = "badge-info";
          winnerTag.textContent = isKo ? "가중 승자: 모델 A" : "WEIGHTED WINNER: MODEL A";
          winnerName.textContent = itemA.name;
          winnerMargin.textContent = isKo ? `B 대비 +${diff}점 우세` : `+${diff} pts ahead of Model B`;
          lastWinnerText = `${itemA.name} (+${diff} pts)`;
        } else {
          winnerBanner.className = "mt-2 rounded-lg border border-emerald-300 bg-emerald-50 p-3.5";
          winnerTag.className = "badge-pass";
          winnerTag.textContent = isKo ? "가중 승자: 모델 B" : "WEIGHTED WINNER: MODEL B";
          winnerName.textContent = itemB.name;
          winnerMargin.textContent = isKo ? `A 대비 +${diff}점 우세` : `+${diff} pts ahead of Model A`;
          lastWinnerText = `${itemB.name} (+${diff} pts)`;
        }
      }

      // Check matching preset
      const presets = getPresets(activeVertical);
      let matched = "";
      for (const [k, p] of Object.entries(presets)) {
        if (sliders.every((s) => (weights[s.getAttribute("data-dim") || ""] ?? 0) === (p[s.getAttribute("data-dim") || ""] ?? 0))) {
          matched = k;
          break;
        }
      }
      syncPresetHighlight(matched);
      if (syncHash) syncUrlHash();
    }

    function renderComparison(syncHash: boolean, emitEvent: boolean) {
      const list = payload.itemsByVertical[activeVertical] || [];
      if (list.length < 2) return;

      let itemA = list.find((i) => i.slug === slugA) || list[0];
      let itemB = list.find((i) => i.slug === slugB);
      if (!itemB || itemB.slug === itemA.slug) {
        const partner = pickBestPartner(activeVertical, itemA.slug);
        itemB = list.find((i) => i.slug === partner) || list.find((i) => i.slug !== itemA.slug) || list[0];
      }
      slugA = itemA.slug;
      slugB = itemB.slug;

      if (selectA) selectA.value = slugA;
      if (selectB) selectB.value = slugB;
      if (linkA) linkA.setAttribute("href", itemA.href);
      if (linkB) linkB.setAttribute("href", itemB.href);
      if (barNameAEl) barNameAEl.textContent = `A · ${itemA.name}`;
      if (barNameBEl) barNameBEl.textContent = `B · ${itemB.name}`;
      if (thA) thA.textContent = `A · ${itemA.name}`;
      if (thB) thB.textContent = `B · ${itemB.name}`;

      // Cross-category safety warning
      if (crossCatBanner && crossCatMsg) {
        if (itemA.category !== itemB.category) {
          crossCatBanner.classList.remove("hidden");
          crossCatBanner.classList.add("flex");
          crossCatMsg.textContent = isKo
            ? `모델 A(${itemA.categoryLabel})와 모델 B(${itemB.categoryLabel})는 용도·측정 단위가 다른 제품군입니다. 동일 카테고리 내 정밀 비교를 원하면 드롭다운의 카테고리 그룹 내에서 선택해 주세요.`
            : `Model A (${itemA.categoryLabel}) and Model B (${itemB.categoryLabel}) belong to different product categories with distinct benchmark units. Pick models from the same category group for strict apples-to-apples scoring.`;
        } else {
          crossCatBanner.classList.add("hidden");
          crossCatBanner.classList.remove("flex");
        }
      }

      // Check Curated Editorial VS banner
      const [s1, s2] = [slugA, slugB].sort();
      const pairSlug = `${s1}-vs-${s2}`;
      const curated = payload.curatedVs.find(
        (v) => v.vertical === activeVertical && v.pairSlug === pairSlug
      );
      if (curatedBanner && curatedHeadline && curatedHref && curatedIg) {
        if (curated) {
          curatedBanner.classList.remove("hidden");
          curatedBanner.classList.add("flex");
          curatedHeadline.textContent = curated.headline;
          curatedIg.textContent = `SERP IG ${curated.infoGainScore}/100`;
          curatedHref.setAttribute("href", curated.href);
        } else {
          curatedBanner.classList.add("hidden");
          curatedBanner.classList.remove("flex");
        }
      }

      const diff = computeLiveDiff(itemA, itemB);
      currentDiffRows = diff.rows;
      currentScoresA = diff.scoresA;
      currentScoresB = diff.scoresB;

      // Render Diff Table with inline SVG dual bars
      if (diffTbody) {
        diffTbody.innerHTML = diff.rows
          .map((row) => {
            const wA = Math.round((row.barPctA / 100) * 180);
            const wB = Math.round((row.barPctB / 100) * 180);
            const cellACls =
              row.winner === "a" ? "font-bold text-blue-700 bg-blue-50/40" : "text-slate-800";
            const cellBCls =
              row.winner === "b" ? "font-bold text-emerald-700 bg-emerald-50/40" : "text-slate-800";
            const badgeCls =
              row.winner === "a"
                ? "badge-info"
                : row.winner === "b"
                  ? "badge-pass"
                  : "inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600";
            return `
              <tr>
                <th scope="row" class="font-semibold text-slate-700">${esc(row.label)}</th>
                <td class="font-mono text-[13px] ${cellACls}">${esc(row.displayA)}</td>
                <td class="font-mono text-[13px] ${cellBCls}">${esc(row.displayB)}</td>
                <td>
                  <svg viewBox="0 0 180 26" class="h-6 w-44" role="img" aria-label="${esc(row.label)}">
                    <rect x="0" y="2" width="180" height="8" rx="3" fill="#E2E8F0" />
                    <rect x="0" y="2" width="${wA}" height="8" rx="3" fill="${row.winner === "a" ? "#2563EB" : "#64748B"}" />
                    <rect x="0" y="15" width="180" height="8" rx="3" fill="#E2E8F0" />
                    <rect x="0" y="15" width="${wB}" height="8" rx="3" fill="${row.winner === "b" ? "#059669" : "#94A3B8"}" />
                  </svg>
                </td>
                <td><span class="${badgeCls}">${esc(row.deltaText)}</span></td>
              </tr>
            `;
          })
          .join("");
      }

      renderCtaCard(ctaAWrap, itemA, "A");
      renderCtaCard(ctaBWrap, itemB, "B");
      updateScoresOnly(false);

      if (syncHash) {
        syncUrlHash();
      }
      if (emitEvent) {
        track("compare_launch", { vertical: activeVertical, pair: `${s1}-vs-${s2}` });
      }
    }

    function loadFromHash(emitEvent: boolean) {
      const raw = window.location.hash.replace(/^#/, "").trim();
      let targetV =
        payload.verticals.find((v) => v.count >= 2)?.id || "wattcheck";
      let targetA = "";
      let targetB = "";
      let parsedWeights: number[] | null = null;

      if (raw && raw.includes(":")) {
        const parts = raw.split(":");
        const candV = parts[0] || "";
        if (payload.itemsByVertical[candV] && payload.itemsByVertical[candV].length >= 2) {
          targetV = candV;
          targetA = parts[1] || "";
          targetB = parts[2] || "";
          const wSeg = parts.slice(3).find((seg) => /^w=\d+,\d+,\d+,\d+$/.test(seg));
          if (wSeg) {
            parsedWeights = wSeg
              .slice(2)
              .split(",")
              .map((n) => Math.max(0, Math.min(100, Number(n))));
          }
        }
      }

      activeVertical = targetV;
      applyVerticalUI(activeVertical);

      if (parsedWeights && parsedWeights.length === 4) {
        DIM_ORDER.forEach((dim, idx) => {
          const el = document.getElementById(`cmp-w-${dim}`) as HTMLInputElement | null;
          if (el && Number.isFinite(parsedWeights![idx])) {
            el.value = String(parsedWeights![idx]);
          }
        });
      }

      const list = payload.itemsByVertical[activeVertical] || [];
      const firstVs = payload.curatedVs.find((v) => v.vertical === activeVertical);
      if (targetA && list.some((i) => i.slug === targetA)) {
        slugA = targetA;
        slugB =
          targetB && targetB !== targetA && list.some((i) => i.slug === targetB)
            ? targetB
            : pickBestPartner(activeVertical, targetA);
      } else if (firstVs) {
        slugA = firstVs.slugA;
        slugB = firstVs.slugB;
      } else if (list.length >= 2) {
        slugA = list[0].slug;
        slugB = list[1].slug;
      }

      renderComparison(Boolean(raw), emitEvent);
    }

    vertPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const v = pill.getAttribute("data-vertical") || "";
        if (!v || (payload.itemsByVertical[v] || []).length < 2) return;
        activeVertical = v;
        applyVerticalUI(activeVertical);
        const firstVs = payload.curatedVs.find((x) => x.vertical === activeVertical);
        const list = payload.itemsByVertical[activeVertical] || [];
        if (firstVs) {
          slugA = firstVs.slugA;
          slugB = firstVs.slugB;
        } else if (list.length >= 2) {
          slugA = list[0].slug;
          slugB = list[1].slug;
        }
        renderComparison(true, true);
      });
    });

    if (selectA) {
      selectA.addEventListener("change", () => {
        slugA = selectA.value;
        if (slugA === slugB) slugB = pickBestPartner(activeVertical, slugA);
        renderComparison(true, true);
      });
    }

    if (selectB) {
      selectB.addEventListener("change", () => {
        slugB = selectB.value;
        if (slugB === slugA) slugA = pickBestPartner(activeVertical, slugB);
        renderComparison(true, true);
      });
    }

    if (swapBtn) {
      swapBtn.addEventListener("click", () => {
        const tmp = slugA;
        slugA = slugB;
        slugB = tmp;
        renderComparison(true, true);
      });
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-preset") || "balanced";
        const presets = getPresets(activeVertical);
        const p = presets[key] || presets.balanced;
        sliders.forEach((s) => {
          const dim = s.getAttribute("data-dim") || "";
          if (dim in p) s.value = String(p[dim]);
        });
        updateScoresOnly(true);
        syncPresetHighlight(key);
      });
    });

    sliders.forEach((s) => s.addEventListener("input", () => updateScoresOnly(true)));

    if (copyLinkBtn) {
      const def = isKo ? "공유 링크 복사" : "Copy Share Link";
      const done = isKo ? "링크 복사됨 ✓" : "Link Copied ✓";
      copyLinkBtn.addEventListener("click", () => {
        syncUrlHash();
        copyToClipboard(window.location.href).then((ok) => {
          if (!ok) return;
          copyLinkBtn.textContent = done;
          copyLinkBtn.classList.add("border-emerald-500", "text-emerald-700", "bg-emerald-50");
          window.setTimeout(() => {
            copyLinkBtn.textContent = def;
            copyLinkBtn.classList.remove("border-emerald-500", "text-emerald-700", "bg-emerald-50");
          }, 1800);
        });
      });
    }

    if (copyMdBtn) {
      const def = isKo ? "마크다운 표 복사" : "Copy Markdown Summary Table";
      const done = isKo ? "마크다운 복사됨 ✓" : "Markdown Copied ✓";
      copyMdBtn.addEventListener("click", () => {
        const list = payload.itemsByVertical[activeVertical] || [];
        const itemA = list.find((i) => i.slug === slugA);
        const itemB = list.find((i) => i.slug === slugB);
        if (!itemA || !itemB) return;

        syncUrlHash();

        const header = `### ${itemA.name} vs ${itemB.name} (SpecMatrix Global)`;
        const verdictLine = isKo
          ? `> **가중치 시뮬레이터 판정**: ${lastWinnerText} (A ${lastScoreA}점 vs B ${lastScoreB}점)`
          : `> **Weighted Verdict**: ${lastWinnerText} (A ${lastScoreA}/100 vs B ${lastScoreB}/100)`;
        const tableLines = [
          `| ${isKo ? "지표" : "Metric"} | A · ${itemA.name} | B · ${itemB.name} | ${isKo ? "판정" : "Lead"} |`,
          `| :--- | ---: | ---: | :--- |`,
          ...currentDiffRows.map(
            (r) => `| ${r.label} | ${r.displayA} | ${r.displayB} | ${r.deltaText} |`
          ),
        ];
        const footer = isKo
          ? `출처: [SpecMatrix 실시간 1:1 비교](${window.location.href})`
          : `Source: [SpecMatrix Live 1:1 Compare](${window.location.href})`;

        copyToClipboard([header, "", verdictLine, "", ...tableLines, "", footer].join("\n")).then(
          (ok) => {
            if (!ok) return;
            copyMdBtn.textContent = done;
            copyMdBtn.classList.add("bg-emerald-700");
            window.setTimeout(() => {
              copyMdBtn.textContent = def;
              copyMdBtn.classList.remove("bg-emerald-700");
            }, 1800);
          }
        );
      });
    }

    loadFromHash(Boolean(window.location.hash));
    window.addEventListener("hashchange", () => loadFromHash(true));
  })();
</script>
