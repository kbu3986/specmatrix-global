---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlotReserve from "../../components/AdSlotReserve.astro";
import type {
  ActiveLocale,
  AnyItem,
  HomeTechItem,
  PilotVertical,
  VsInsight,
} from "../../lib/types";
import {
  getAllItems,
  getAllVsInsights,
  getFxRates,
  getMonetizationConfig,
} from "../../lib/data";
import {
  computeCycleGearDerived,
  computeHomeTechDerived,
  computePureGramDerived,
  computeWattCheckDerived,
} from "../../lib/derived";
import { buildMonetizationModel } from "../../lib/monetization";
import {
  ACTIVE_LOCALES,
  BASE_PATH,
  PILOT_VERTICALS,
  VERTICAL_META,
  formatCurrency,
  formatInt,
  getCategoryLabel,
  safeJsonLd,
  toAbsoluteUrl,
  withBase,
} from "../../lib/i18n";

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as ActiveLocale;
const isKo = locale === "ko";
const currency = isKo ? "KRW" : "USD";
const fx = getFxRates();
const cfg = getMonetizationConfig();

const allItems = getAllItems().filter((item) => item.available_locales.includes(locale));
const allVs = getAllVsInsights();

interface CompareSkuPayload {
  slug: string;
  vertical: PilotVertical;
  category: string;
  categoryLabel: string;
  brand: string;
  name: string;
  summary: string;
  bestFor: string;
  trustScore: number;
  href: string;
  msrp: number;
  msrpUsd: number;
  msrpDisplay: string;
  monetization: {
    statusLabel: string;
    statusTone: "pass" | "caution" | "fail";
    benchmarkPriceFormatted: string;
    benchmarkDate: string;
    benchmarkCaption: string;
    disclosureText: string;
    isDiscontinued: boolean;
    isPriceStale: boolean;
    buttons: Array<{
      label: string;
      storeName: string;
      url: string;
      rel: "sponsored nofollow noopener";
      target: "_blank";
      isPrimary: boolean;
      linkMode: "direct_asin" | "official_coupang" | "search_deeplink";
    }>;
  };
  metrics: Record<string, number | string | boolean | null>;
}

interface CompareVsPayload {
  vertical: PilotVertical;
  pairSlug: string;
  slugA: string;
  slugB: string;
  headline: string;
  href: string;
  infoGainScore: number;
}

function serializeItem(item: AnyItem): CompareSkuPayload {
  const copy = item.i18n[locale] ?? item.i18n.en;
  const msrp = isKo ? item.regional_offers.kr.msrp : item.regional_offers.us.msrp;
  const msrpUsd = item.regional_offers.us.msrp;
  const msrpDisplay = formatCurrency(msrp, currency, locale);
  const href = withBase(`/${locale}/${item.vertical}/item/${item.slug}`);
  const m = buildMonetizationModel(item, locale);

  let metrics: Record<string, number | string | boolean | null> = {};

  if (item.vertical === "wattcheck") {
    const d = computeWattCheckDerived(item, fx);
    const s = item.specs;
    const ac = item.airline_compliance_profile;
    metrics = {
      hasBattery: s.has_battery,
      maxTotalW: s.max_total_output_w,
      maxSingleW: s.max_single_port_output_w,
      batteryWh: s.battery_energy_wh,
      usableWh: d.usableWh,
      costPer10Wh: isKo ? d.krwPer10Wh : d.usdPer10Wh,
      costPer10WhUsd: d.usdPer10Wh,
      costPer10W: isKo ? d.krwPer10W : d.usdPer10W,
      costPer10WUsd: d.usdPer10W,
      weightG: s.weight_g,
      wPer100g: d.wPer100g,
      portsCount: s.ports.length,
      certCount: d.certCount,
      supportsEpr: s.supports_pd_3_1_epr,
      supportsPps: s.supports_samsung_pps_45w,
      renegotiationDrop: s.power_renegotiation_drop,
      carryonNoApproval: ac.carryon_no_approval,
      cccOk: ac.china_domestic_ccc_ok,
    };
  } else if (item.vertical === "puregram") {
    const d = computePureGramDerived(item, fx);
    const nl = item.nutrition_label;
    metrics = {
      activeIngredientType: nl.active_ingredient_type,
      benchLabel: isKo
        ? item.derived_math.benchmark_label_ko
        : item.derived_math.benchmark_label_en,
      costPerBench: isKo ? d.krwPerBenchmarkUnit : d.usdPerBenchmarkUnit,
      costPerBenchUsd: d.usdPerBenchmarkUnit,
      purityPct: item.derived_math.purity_pct,
      activePerServingG: nl.active_per_serving_g,
      costPerServing: isKo ? d.krwPerServing : d.usdPerServing,
      sodiumMg: nl.sodium_mg,
      caffeineMg: nl.caffeine_mg,
      totalServings: item.package_spec.total_servings,
      race90gCost: isKo ? d.raceCost90gPerHourKrw : d.raceCost90gPerHourUsd,
      carbRatio: nl.carb_ratio_glucose_to_fructose ?? "",
      hydrogelType: nl.hydrogel_or_isotonic,
      creapure: nl.creapure_certified,
      certCount: item.certifications.length,
      noArtifSweet: !nl.artificial_sweeteners_listed,
      noFreeAmino: !nl.free_form_amino_listed,
    };
  } else if (item.vertical === "hometech") {
    const ht = item as HomeTechItem;
    const d = computeHomeTechDerived(ht, fx);
    const s = ht.specs;
    const tp = ht.tco_profile;
    metrics = {
      tco3yr: isKo ? d.tco3yrKrw : d.tco3yrUsd,
      tco3yrUsd: d.tco3yrUsd,
      tco3yrKrw: d.tco3yrKrw,
      weightedAvgW: d.weightedAvgW,
      annualKwh: d.annualKwh,
      annualElec: isKo ? d.annualElecKrw : d.annualElecUsd,
      annualConsumables: isKo ? s.annual_consumables_krw : s.annual_consumables_usd,
      idlePowerW: s.idle_power_w,
      typicalLoadW: s.typical_load_w,
      peakPowerW: s.peak_power_w,
      noiseLoadDba: s.noise_load_dba,
      noiseIdleDba: s.noise_idle_dba,
      weightG: s.weight_g,
      volumeL: +((s.dimensions_mm.l * s.dimensions_mm.w * s.dimensions_mm.h) / 1_000_000).toFixed(4),
      dualVoltage: s.dual_voltage_100_240v,
      alwaysOn247: tp.always_on_24_7,
      certCount: s.certifications.length,
      ramGbDefault: s.ram_gb_default,
      lanSpeedGbps: s.lan_speed_gbps,
      driveBays: s.drive_bays,
      upsVaRating: s.ups_va_rating,
      upsWattRating: s.ups_watt_rating,
      upsWaveform: s.ups_waveform ?? "",
      upsRuntimeHalfLoadMin: s.ups_runtime_half_load_min,
      suctionPa: s.suction_pa,
      dustbagCapacityL: s.dustbag_capacity_l,
      lifespanYears: tp.expected_lifespan_years,
    };
  } else {
    const d = computeCycleGearDerived(item, fx);
    const s = item.specs;
    metrics = {
      weightG: s.weight_g,
      costPer100g: isKo ? d.krwPer100g : d.usdPer100g,
      costPer100gUsd: d.usdPer100g,
      accuracyPct: s.claimed_accuracy_pct,
      leftRightBalance: Boolean(s.left_right_balance),
      batteryHours: s.battery_life_hours,
      maxTrainerWatts: s.max_trainer_watts,
      hooklessCompatible: Boolean(s.hookless_compatible),
      compatBreadthScore: d.compatBreadthScore,
      tireWidthMm: s.tire_width_mm,
    };
  }

  return {
    slug: item.slug,
    vertical: item.vertical as PilotVertical,
    category: item.category,
    categoryLabel: getCategoryLabel(item.category, locale),
    brand: item.brand,
    name: copy.name,
    summary: copy.summary,
    bestFor: copy.best_for,
    trustScore: item.audit.trust_score,
    href,
    msrp,
    msrpUsd,
    msrpDisplay,
    monetization: {
      statusLabel: m.statusLabel,
      statusTone: m.statusTone,
      benchmarkPriceFormatted: m.benchmarkPriceFormatted,
      benchmarkDate: m.benchmarkDate,
      benchmarkCaption: m.benchmarkCaption,
      disclosureText: m.disclosureText,
      isDiscontinued: m.isDiscontinued,
      isPriceStale: m.isPriceStale,
      buttons: m.buttons,
    },
    metrics,
  };
}

const byVertical: Record<PilotVertical, CompareSkuPayload[]> = {
  wattcheck: [],
  puregram: [],
  cyclegear: [],
  hometech: [],
};

for (const item of allItems) {
  const v = item.vertical as PilotVertical;
  if (byVertical[v]) {
    byVertical[v].push(serializeItem(item));
  }
}

const curatedVsList: CompareVsPayload[] = allVs.map((v: VsInsight) => ({
  vertical: v.vertical as PilotVertical,
  pairSlug: v.pair_slug,
  slugA: v.slug_a,
  slugB: v.slug_b,
  headline: v.verdict[locale]?.headline ?? v.verdict.en.headline,
  href: withBase(`/${locale}/${v.vertical}/vs/${v.pair_slug}`),
  infoGainScore: v.info_gain_score,
}));

const totalSkus = allItems.length;
const totalPairwise = PILOT_VERTICALS.reduce((acc, v) => {
  const n = byVertical[v].length;
  return acc + (n > 1 ? Math.floor((n * (n - 1)) / 2) : 0);
}, 0);

const defaultVertical: PilotVertical =
  PILOT_VERTICALS.find((v) => byVertical[v].length >= 2) ?? "wattcheck";
const defaultItems = byVertical[defaultVertical];
const defaultVsFirst = curatedVsList.find((v) => v.vertical === defaultVertical);
const defaultItemA =
  (defaultVsFirst && defaultItems.find((i) => i.slug === defaultVsFirst.slugA)) ||
  defaultItems[0] ||
  null;
const defaultItemB =
  (defaultVsFirst && defaultItems.find((i) => i.slug === defaultVsFirst.slugB)) ||
  defaultItems.find((i) => i.slug !== defaultItemA?.slug) ||
  defaultItems[1] ||
  null;

function groupByCategory(
  list: CompareSkuPayload[]
): Array<{ category: string; label: string; items: CompareSkuPayload[] }> {
  const map = new Map<string, { category: string; label: string; items: CompareSkuPayload[] }>();
  for (const item of list) {
    let grp = map.get(item.category);
    if (!grp) {
      grp = { category: item.category, label: item.categoryLabel, items: [] };
      map.set(item.category, grp);
    }
    grp.items.push(item);
  }
  return Array.from(map.values());
}

const defaultGroupedItems = groupByCategory(defaultItems);
const statusToneClass = (tone: "pass" | "caution" | "fail"): string =>
  tone === "pass" ? "badge-pass" : tone === "fail" ? "badge-fail" : "badge-caution";

const clientPayload = {
  locale,
  currency,
  basePath: BASE_PATH,
  disclosure: cfg.compliance.disclosures[locale],
  verticals: PILOT_VERTICALS.map((v) => ({
    id: v,
    label: VERTICAL_META[v].shortName[locale],
    fullName: VERTICAL_META[v].name[locale],
    count: byVertical[v].length,
  })),
  itemsByVertical: byVertical,
  curatedVs: curatedVsList,
};

const currentPath = `/${locale}/compare`;
const pageTitle = isKo
  ? "실시간 1:1 자유 비교 워크벤치 (Any-vs-Any) | SpecMatrix Global"
  : "Any-vs-Any 1:1 Live Comparison Workbench | SpecMatrix Global";
const pageDesc = isKo
  ? `검증된 ${totalSkus}종 공식 스펙 DB에서 원하는 두 모델을 자유롭게 조합해 가중치 승자 시뮬레이션, 정량 SVG 격차표, 마크다운 요약을 0초 만에 비교하세요.`
  : `Compare any two of ${totalSkus} verified SKUs head-to-head across WattCheck, PureGram, CycleGear, and HomeTech with live priority weighting, SVG spec diffs, and shareable URLs.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: isKo
      ? "SpecMatrix 실시간 1:1 자유 비교 워크벤치"
      : "SpecMatrix Any-vs-Any 1:1 Live Comparison Workbench",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    description: pageDesc,
    url: toAbsoluteUrl(currentPath),
    inLanguage: locale,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isKo ? "홈" : "Home",
        item: toAbsoluteUrl(`/${locale}`),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools",
        item: toAbsoluteUrl(`/${locale}/tools`),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: isKo ? "실시간 1:1 비교" : "Live 1:1 Compare",
        item: toAbsoluteUrl(currentPath),
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
  currentPath={currentPath}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    <a href={withBase(`/${locale}`)} class="hover:text-blue-700 hover:underline">
      {isKo ? "홈" : "Home"}
    </a>
    <span>/</span>
    <a href={withBase(`/${locale}/tools`)} class="hover:text-blue-700 hover:underline">
      {isKo ? "인터랙티브 랩 도구" : "Interactive Lab Tools"}
    </a>
    <span>/</span>
    <span class="font-medium text-slate-800">
      {isKo ? "실시간 1:1 비교 워크벤치" : "Live 1:1 Compare Workbench"}
    </span>
  </nav>

  <!-- Hero Header -->
  <section class="lab-card bg-white p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-info font-mono">ANY-VS-ANY LIVE WORKBENCH</span>
        <span class="badge-pass font-mono">
          {totalSkus} SKUs · {formatInt(totalPairwise)}+ {isKo ? "조합 가능" : "Matchups"}
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="cmp-copy-link"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-mono text-xs font-semibold text-slate-800 transition-colors hover:border-blue-500 hover:text-blue-700"
        >
          <span>{isKo ? "공유 링크 복사" : "Copy Share Link"}</span>
        </button>
        <button
          type="button"
          id="cmp-copy-md"
          class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-slate-800"
        >
          <span>{isKo ? "마크다운 표 복사" : "Copy Markdown Summary Table"}</span>
        </button>
      </div>
    </div>

    <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
      {isKo
        ? "실시간 1:1 자유 비교 워크벤치"
        : "Any-vs-Any 1:1 Live Comparison Workbench"}
    </h1>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-600">
      {isKo
        ? "버티컬 내 어떤 두 모델이든 선택 즉시 정량 스펙 격차, SVG 비교 막대, 4축 가중치 승자 시뮬레이션, 공식 출고가(MSRP) 기준 제휴 링크를 브라우저에서 0초 만에 계산합니다. URL 해시(#)로 비교 조합을 그대로 공유할 수 있습니다."
        : "Pick any two verified models in the same vertical for instant deterministic spec diffs, inline SVG delta bars, 4-dimension priority weighting, and verified affiliate links — zero latency, 100% shareable via URL hash."}
    </p>

    <!-- Vertical Selector Pills -->
    <div class="mt-5 flex flex-wrap gap-2" id="cmp-vertical-pills" role="tablist" aria-label={isKo ? "버티컬 선택" : "Select vertical"}>
      {PILOT_VERTICALS.map((v) => {
        const count = byVertical[v].length;
        const isActive = v === defaultVertical;
        return (
          <button
            type="button"
            role="tab"
            data-vertical={v}
            aria-selected={isActive ? "true" : "false"}
            disabled={count < 2}
            class:list={[
              "cmp-vert-pill inline-flex items-center gap-2 rounded-lg border px-3.5 py-2 text-xs font-bold transition-colors",
              isActive
                ? "border-slate-900 bg-slate-900 text-white"
                : count < 2
                  ? "cursor-not-allowed border-slate-200 bg-slate-50 text-slate-400"
                  : "border-slate-300 bg-white text-slate-700 hover:border-blue-500 hover:text-blue-700",
            ]}
          >
            <span>{VERTICAL_META[v].shortName[locale]}</span>
            <span class="rounded bg-black/10 px-1.5 py-0.5 font-mono text-[10px]">
              {count}
            </span>
          </button>
        );
      })}
    </div>

    <!-- Dual Model Selector + Swap -->
    <div class="mt-5 grid items-end gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 md:grid-cols-11">
      <div class="md:col-span-5">
        <label for="cmp-select-a" class="flex items-center justify-between text-xs font-bold text-blue-800">
          <span>{isKo ? "모델 A (파랑)" : "Model A (Cobalt)"}</span>
          <a
            id="cmp-link-a"
            href={defaultItemA ? defaultItemA.href : withBase(`/${locale}`)}
            class="font-mono text-[11px] font-semibold hover:underline"
          >
            {isKo ? "상세 스펙 →" : "Full Spec →"}
          </a>
        </label>
        <select
          id="cmp-select-a"
          class="mt-1.5 w-full rounded-lg border border-blue-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:outline-none"
        >
          {defaultGroupedItems.map((grp) => (
            <optgroup label={grp.label}>
              {grp.items.map((it) => (
                <option value={it.slug} selected={it.slug === defaultItemA?.slug}>
                  {it.name} ({it.msrpDisplay})
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <div class="flex justify-center md:col-span-1">
        <button
          type="button"
          id="cmp-swap"
          aria-label={isKo ? "모델 A와 B 맞바꾸기" : "Swap Model A and Model B"}
          title={isKo ? "모델 A ↔ B 맞바꾸기" : "Swap Model A ↔ B"}
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 bg-white font-mono text-base font-bold text-slate-700 shadow-xs transition-colors hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700"
        >
          ⇄
        </button>
      </div>

      <div class="md:col-span-5">
        <label for="cmp-select-b" class="flex items-center justify-between text-xs font-bold text-emerald-800">
          <span>{isKo ? "모델 B (에메랄드)" : "Model B (Emerald)"}</span>
          <a
            id="cmp-link-b"
            href={defaultItemB ? defaultItemB.href : withBase(`/${locale}`)}
            class="font-mono text-[11px] font-semibold hover:underline"
          >
            {isKo ? "상세 스펙 →" : "Full Spec →"}
          </a>
        </label>
        <select
          id="cmp-select-b"
          class="mt-1.5 w-full rounded-lg border border-emerald-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 focus:border-emerald-600 focus:outline-none"
        >
          {defaultGroupedItems.map((grp) => (
            <optgroup label={grp.label}>
              {grp.items.map((it) => (
                <option value={it.slug} selected={it.slug === defaultItemB?.slug}>
                  {it.name} ({it.msrpDisplay})
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>
    </div>

    <!-- Cross-Category Warning Banner (dynamic) -->
    <div
      id="cmp-cross-cat-banner"
      role="status"
      class="mt-3 hidden items-start gap-2.5 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-950"
    >
      <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-200 font-mono text-[11px] font-bold text-amber-950">
        !
      </span>
      <div class="min-w-0">
        <div class="font-bold text-amber-950">
          {isKo
            ? "서로 다른 제품군(카테고리) 간 비교 중입니다"
            : "Cross-Category Comparison Active"}
        </div>
        <p id="cmp-cross-cat-msg" class="mt-0.5 leading-relaxed text-amber-900"></p>
      </div>
    </div>

    <!-- Quick Popular Matchup Chips -->
    <div class="mt-4">
      <div class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500">
        {isKo ? "인기 1:1 추천 조합 (원클릭 로드)" : "Quick Popular Matchups"}
      </div>
      <div id="cmp-popular-chips" class="mt-2 flex flex-wrap gap-2">
        {curatedVsList
          .filter((v) => v.vertical === defaultVertical)
          .slice(0, 4)
          .map((v) => {
            const itA = defaultItems.find((i) => i.slug === v.slugA);
            const itB = defaultItems.find((i) => i.slug === v.slugB);
            return (
              <button
                type="button"
                data-pair-a={v.slugA}
                data-pair-b={v.slugB}
                class="cmp-pop-chip rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-800"
              >
                {itA ? itA.name.split("(")[0].trim() : v.slugA} vs{" "}
                {itB ? itB.name.split("(")[0].trim() : v.slugB}
              </button>
            );
          })}
      </div>
    </div>

    <!-- Curated Editorial VS Banner (dynamic) -->
    <div
      id="cmp-curated-banner"
      class:list={[
        "mt-4 flex-wrap items-center justify-between gap-3 rounded-xl border border-blue-300 bg-blue-50/90 px-4 py-3",
        defaultVsFirst ? "flex" : "hidden",
      ]}
    >
      <div class="min-w-0">
        <div class="flex items-center gap-2">
