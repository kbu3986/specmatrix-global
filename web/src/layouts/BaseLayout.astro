---
import "../styles/global.css";
import GlobalSearchModal from "../components/GlobalSearchModal.astro";
import type { ActiveLocale, PilotVertical } from "../lib/types";
import { getMonetizationConfig, getPrimaryVerticalHref } from "../lib/data";
import {
  LEGAL_LABELS,
  LEGAL_SLUGS,
  PILOT_VERTICALS,
  VERTICAL_META,
  normalizePath,
  safeJsonLd,
  switchLocalePath,
  toAbsoluteUrl,
  withBase,
} from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  locale: ActiveLocale;
  currentPath: string;
  activeVertical?: PilotVertical | null;
  isRootPortal?: boolean;
  noindex?: boolean;
  availableLocales?: ActiveLocale[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  locale,
  currentPath,
  activeVertical = null,
  isRootPortal = false,
  noindex = false,
  availableLocales = ["en", "ko"],
  jsonLd = [],
} = Astro.props;

const cfg = getMonetizationConfig();
const normPath = normalizePath(currentPath);
const canonical = toAbsoluteUrl(normPath);

const enHref = isRootPortal
  ? toAbsoluteUrl("/en")
  : toAbsoluteUrl(switchLocalePath(normPath, "en"));
const koHref = isRootPortal
  ? toAbsoluteUrl("/ko")
  : toAbsoluteUrl(switchLocalePath(normPath, "ko"));
const xDefaultHref = isRootPortal ? toAbsoluteUrl("/") : enHref;

const otherLocale: ActiveLocale = locale === "en" ? "ko" : "en";
const toggleHref = withBase(
  isRootPortal ? `/${otherLocale}` : switchLocalePath(normPath, otherLocale)
);
const hasOtherLocale = isRootPortal || availableLocales.includes(otherLocale);

const verticalNav = PILOT_VERTICALS.map((v) => ({
  id: v,
  label: VERTICAL_META[v].shortName[locale],
  href: withBase(getPrimaryVerticalHref(locale, v)),
  active: activeVertical === v,
}));

const toolsHref = withBase(`/${locale}/tools`);
const compareHref = withBase(`/${locale}/compare`);
const isToolsActive = normPath === `/${locale}/tools` || normPath.startsWith(`/${locale}/tools/`);
const isCompareActive = normPath === `/${locale}/compare`;

const ogImagePath = activeVertical ? `/og/og-${activeVertical}.png` : "/og/og-default.png";
const ogImageUrl = toAbsoluteUrl(ogImagePath);

const ldList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const isKo = locale === "ko";
const ga4Id = (cfg.analytics?.ga4MeasurementId || "").trim();
const clarityId = (cfg.analytics?.clarityProjectId || "").trim();
const cfBeaconToken = (cfg.analytics?.cfBeaconToken || "").trim();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <!-- AdSense & Search Console Verification -->
    {cfg.adsenseId && (
      <>
        <meta name="google-adsense-account" content={cfg.adsenseId} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${cfg.adsenseId}`}
          crossorigin="anonymous"
        ></script>
      </>
    )}
    {cfg.verification.gsc && (
      <meta name="google-site-verification" content={cfg.verification.gsc} />
    )}
    {cfg.verification.naver && (
      <meta name="naver-site-verification" content={cfg.verification.naver} />
    )}

    <!-- Optional GA4 / Clarity / Cloudflare Web Analytics -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", ga4Id, { anonymize_ip: true });
        </script>
      </>
    )}
    <script is:inline>
      window.smTrack = function (name, params) {
        if (typeof window.gtag === "function") {
          window.gtag("event", name, params || {});
        }
      };
    </script>
    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      ></script>
    )}

    <!-- Canonical & Symmetric Hreflang -->
    <link rel="canonical" href={canonical} />
    {(isRootPortal || availableLocales.includes("en")) && (
      <link rel="alternate" hreflang="en" href={enHref} />
    )}
    {(isRootPortal || availableLocales.includes("ko")) && (
      <link rel="alternate" hreflang="ko" href={koHref} />
    )}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- OpenGraph & Twitter Large Image Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={cfg.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isKo ? "ko_KR" : "en_US"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {ldList.map((schema) => (
      <script type="application/ld+json" set:html={safeJsonLd(schema)} />
    ))}
  </head>
  <body class="bg-lab-canvas text-lab-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      {isKo ? "본문으로 바로가기" : "Skip to main content"}
    </a>

    <header class="sticky top-0 z-40 border-b border-lab-border bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:px-6">
        <div class="flex items-center gap-4 lg:gap-5">
          <a
            href={withBase(isRootPortal ? "/" : `/${locale}`)}
            class="flex shrink-0 items-center gap-2.5 text-slate-900 no-underline hover:opacity-90"
          >
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 text-xs font-bold tracking-tight text-white"
              aria-hidden="true"
            >
              SM
            </span>
            <span class="flex flex-col leading-none">
              <span class="text-sm font-bold tracking-tight text-slate-900">
                SpecMatrix
              </span>
              <span class="font-mono text-[10px] font-medium uppercase tracking-wider text-slate-500">
                Verified Spec Lab
              </span>
            </span>
          </a>

          <nav
            aria-label={isKo ? "버티컬 및 도구 내비게이션" : "Primary navigation"}
            class="hidden items-center gap-0.5 lg:flex"
          >
            {verticalNav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
                  item.active
                    ? "bg-slate-900 text-white"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
                ]}
              >
                {item.label}
              </a>
            ))}
            <span class="mx-1 h-4 w-px bg-slate-200" aria-hidden="true"></span>
            <a
              href={toolsHref}
              class:list={[
                "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
                isToolsActive
                  ? "bg-blue-700 text-white"
                  : "text-slate-700 hover:bg-blue-50 hover:text-blue-700",
              ]}
            >
              {isKo ? "도구" : "Tools"}
            </a>
            <a
              href={compareHref}
              class:list={[
                "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
                isCompareActive
                  ? "bg-blue-700 text-white"
                  : "text-slate-700 hover:bg-blue-50 hover:text-blue-700",
              ]}
            >
              {isKo ? "1:1 비교" : "Compare"}
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-open-search
            class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-blue-500 hover:bg-white hover:text-slate-900"
            aria-label={isKo ? "통합 스펙 검색 열기 (Ctrl+K)" : "Open Global Search (Cmd/Ctrl+K)"}
          >
            <svg
              class="h-3.5 w-3.5 text-slate-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <span class="hidden sm:inline">{isKo ? "검색" : "Search"}</span>
            <kbd class="rounded border border-slate-300 bg-white px-1 py-0.5 font-mono text-[10px] font-semibold text-slate-500">
              ⌘K
            </kbd>
          </button>

          {hasOtherLocale && (
            <a
              href={toggleHref}
              class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 font-mono text-xs font-semibold text-slate-800 shadow-xs transition-colors hover:border-blue-500 hover:text-blue-700"
              aria-label={isKo ? "Switch to English" : "한국어로 전환"}
            >
              <span class={locale === "en" ? "text-blue-700" : "text-slate-400"}>EN</span>
              <span class="text-slate-300">↔</span>
              <span class={locale === "ko" ? "text-blue-700" : "text-slate-400"}>KO</span>
            </a>
          )}
        </div>
      </div>

      <!-- Mobile & Tablet horizontal quick-nav -->
      <div class="border-t border-slate-100 px-4 py-2 lg:hidden">
        <nav
          aria-label={isKo ? "모바일 빠른 내비게이션" : "Mobile quick navigation"}
          class="flex items-center gap-1.5 overflow-x-auto"
        >
          {verticalNav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "shrink-0 rounded-md px-2.5 py-1 text-xs font-semibold",
                item.active
                  ? "bg-slate-900 text-white"
                  : "bg-slate-100 text-slate-700",
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={toolsHref}
            class:list={[
              "shrink-0 rounded-md px-2.5 py-1 text-xs font-semibold",
              isToolsActive
                ? "bg-blue-700 text-white"
                : "border border-blue-200 bg-blue-50 text-blue-800",
            ]}
          >
            {isKo ? "도구" : "Tools"}
          </a>
          <a
            href={compareHref}
            class:list={[
              "shrink-0 rounded-md px-2.5 py-1 text-xs font-semibold",
              isCompareActive
                ? "bg-blue-700 text-white"
                : "border border-blue-200 bg-blue-50 text-blue-800",
            ]}
          >
            {isKo ? "1:1 비교" : "Compare"}
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 focus:outline-none">
      <slot />
    </main>

    <footer class="mt-16 border-t border-lab-border bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-slate-900 font-mono text-[10px] font-bold text-white">
                SM
              </span>
              <span class="text-sm font-bold text-slate-900">SpecMatrix Global</span>
            </div>
            <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
              {isKo
                ? "제조사 공식 스펙시트·규정 문서·영양성분표에 근거한 결정론적 비교 매트릭스 및 인터랙티브 검증 도구."
                : "Evidence-anchored specification matrices and deterministic calculators verified against manufacturer manuals, nutrition labels, and aviation regulations."}
            </p>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <a
                href={toolsHref}
                class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:border-blue-400 hover:text-blue-700"
              >
                {isKo ? "인터랙티브 도구 허브 →" : "Lab Tools Hub →"}
              </a>
              <a
                href={compareHref}
                class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:border-blue-400 hover:text-blue-700"
              >
                {isKo ? "실시간 1:1 비교 →" : "Live 1:1 Compare →"}
              </a>
            </div>
          </div>

          <div>
            <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-500">
              {isKo ? "검증 매트릭스 (4대 버티컬)" : "Active Verticals"}
            </h2>
            <ul class="mt-2.5 space-y-1.5 text-sm">
              {verticalNav.map((item) => (
                <li>
                  <a href={item.href} class="text-slate-700 hover:text-blue-700 hover:underline">
                    {VERTICAL_META[item.id].name[locale]}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-500">
              {isKo ? "신뢰·정책 및 오류 제보" : "Trust, Policy & Legal"}
            </h2>
            <ul class="mt-2.5 space-y-1.5 text-sm">
              {LEGAL_SLUGS.map((slug) => (
                <li>
                  <a
                    href={withBase(`/${locale}/${slug}`)}
                    class="text-slate-700 hover:text-blue-700 hover:underline"
                  >
                    {LEGAL_LABELS[slug][locale]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-3.5 text-xs leading-relaxed text-slate-600">
          {cfg.compliance.disclosures[locale]}
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-5 text-xs text-slate-500">
          <span>© 2026 SpecMatrix Global. All rights reserved.</span>
          <span class="font-mono">
            {isKo ? "가격 기준: MSRP Reference Benchmark" : "Pricing Mode: MSRP Reference Benchmark"} · {cfg.updatedAt}
          </span>
        </div>
      </div>
    </footer>

    <GlobalSearchModal locale={locale} />

    <script is:inline>
      (function () {
        document.addEventListener("click", function (ev) {
          var target = ev.target && ev.target.closest ? ev.target.closest("a[data-affiliate-store]") : null;
          if (!target) return;
          var detail = {
            store: target.getAttribute("data-affiliate-store") || "",
            vertical: target.getAttribute("data-affiliate-vertical") || "",
            sku: target.getAttribute("data-affiliate-sku") || "",
            link_mode: target.getAttribute("data-affiliate-mode") || "",
            locale: document.documentElement.lang || "en",
          };
          if (typeof window.smTrack === "function") {
            window.smTrack("affiliate_click", detail);
          }
          if (typeof window.clarity === "function") {
            window.clarity("set", "last_affiliate_sku", detail.sku);
          }
        });
      })();
    </script>
  </body>
</html>
