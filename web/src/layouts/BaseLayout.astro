---
import "../styles/global.css";
import GlobalSearchModal from "../components/GlobalSearchModal.astro";
import type { ActiveLocale, PilotVertical } from "../lib/types";
import { getMonetizationConfig, getPrimaryVerticalHref } from "../lib/data";
import {
  LEGAL_LABELS,
  LEGAL_SLUGS,
  PILOT_VERTICALS,
  VERTICAL_META,
  normalizePath,
  safeJsonLd,
  switchLocalePath,
  toAbsoluteUrl,
  withBase,
} from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  locale: ActiveLocale;
  currentPath: string;
  activeVertical?: PilotVertical | null;
  isRootPortal?: boolean;
  noindex?: boolean;
  hasStickyCta?: boolean;
  availableLocales?: ActiveLocale[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  locale,
  currentPath,
  activeVertical = null,
  isRootPortal = false,
  noindex = false,
  hasStickyCta = false,
  availableLocales = ["en", "ko"],
  jsonLd = [],
} = Astro.props;

const cfg = getMonetizationConfig();
const normPath = normalizePath(currentPath);
const canonical = toAbsoluteUrl(normPath);

const enHref = isRootPortal
  ? toAbsoluteUrl("/en/")
  : toAbsoluteUrl(switchLocalePath(normPath, "en"));
const koHref = isRootPortal
  ? toAbsoluteUrl("/ko/")
  : toAbsoluteUrl(switchLocalePath(normPath, "ko"));
const xDefaultHref = isRootPortal ? toAbsoluteUrl("/") : enHref;

const otherLocale: ActiveLocale = locale === "en" ? "ko" : "en";
const toggleHref = withBase(
  isRootPortal ? `/${otherLocale}/` : switchLocalePath(normPath, otherLocale)
);
const hasOtherLocale = isRootPortal || availableLocales.includes(otherLocale);

const verticalNav = PILOT_VERTICALS.map((v) => ({
  id: v,
  label: VERTICAL_META[v].shortName[locale],
  href: withBase(getPrimaryVerticalHref(locale, v)),
  active: activeVertical === v,
}));

const toolsHref = withBase(`/${locale}/tools/`);
const compareHref = withBase(`/${locale}/compare/`);
const isToolsActive =
  normPath === `/${locale}/tools/` || normPath.startsWith(`/${locale}/tools/`);
const isCompareActive =
  normPath === `/${locale}/compare/` || normPath.startsWith(`/${locale}/compare/`);

const studioLinks = [
  {
    label: locale === "ko" ? "인터랙티브 도구 허브" : "Lab Tools Hub",
    href: toolsHref,
  },
  {
    label: locale === "ko" ? "실시간 1:1 비교" : "Live 1:1 Compare",
    href: compareHref,
  },
  {
    label: locale === "ko" ? "여행 전력 키트 계산기" : "Travel Power Kit",
    href: withBase(`/${locale}/tools/travel-power-kit/`),
  },
  {
    label: locale === "ko" ? "레이스 보급 플래너" : "Race Fueling Planner",
    href: withBase(`/${locale}/tools/fueling-planner/`),
  },
  {
    label: locale === "ko" ? "HomeTech 3년 TCO 스튜디오" : "HomeTech TCO Studio",
    href: withBase(`/${locale}/tools/hometech-tco-studio/`),
  },
  {
    label: locale === "ko" ? "타이어 공기압·후크리스 가드" : "Tire Pressure Guard",
    href: withBase(`/${locale}/tools/tire-pressure-guard/`),
  },
];

const ogImagePath = activeVertical ? `/og/og-${activeVertical}.png` : "/og/og-default.png";
const ogImageUrl = toAbsoluteUrl(ogImagePath);

const ldList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const isKo = locale === "ko";
const ga4Id = (cfg.analytics?.ga4MeasurementId || "").trim();
const clarityId = (cfg.analytics?.clarityProjectId || "").trim();
const cfBeaconToken = (cfg.analytics?.cfBeaconToken || "").trim();
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <!-- Dealt Typography: Instrument Sans + DM Mono (+ Noto Sans KR on ko) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wdth,wght@75..100,400..700&display=swap"
      rel="stylesheet"
    />
    {isKo && (
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    )}

    <!-- Google Consent Mode v2 (EEA / UK / CH regional default) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        wait_for_update: 500,
        region: [
          "AT", "BE", "BG", "HR", "CY", "CZ", "DK", "EE", "FI", "FR", "DE", "GR", "HU",
          "IS", "IE", "IT", "LV", "LI", "LT", "LU", "MT", "NL", "NO", "PL", "PT", "RO",
          "SK", "SI", "ES", "SE", "CH", "GB",
        ],
      });
    </script>

    <!-- AdSense & Search Console Verification -->
    {cfg.adsenseId && (
      <meta name="google-adsense-account" content={cfg.adsenseId} />
    )}
    {cfg.adsenseId && !noindex && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${cfg.adsenseId}`}
        crossorigin="anonymous"
      ></script>
    )}
    {cfg.verification.gsc && (
      <meta name="google-site-verification" content={cfg.verification.gsc} />
    )}
    {cfg.verification.naver && (
      <meta name="naver-site-verification" content={cfg.verification.naver} />
    )}

    <!-- Optional GA4 / Clarity / Cloudflare Web Analytics -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          if (typeof window.gtag !== "function") {
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
          }
          window.gtag("js", new Date());
          window.gtag("config", ga4Id, { anonymize_ip: true });
        </script>
      </>
    )}
    <script is:inline>
      window.smTrack = function (name, params) {
        if (typeof window.gtag === "function") {
          window.gtag("event", name, params || {});
        }
      };
    </script>
    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      ></script>
    )}

    <!-- Canonical & Symmetric Hreflang -->
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {(isRootPortal || availableLocales.includes("en")) && (
          <link rel="alternate" hreflang="en" href={enHref} />
        )}
        {(isRootPortal || availableLocales.includes("ko")) && (
          <link rel="alternate" hreflang="ko" href={koHref} />
        )}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </>
    )}

    <!-- OpenGraph & Twitter Large Image Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={cfg.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isKo ? "ko_KR" : "en_US"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {ldList.map((schema) => (
      <script type="application/ld+json" set:html={safeJsonLd(schema)} />
    ))}
  </head>
  <body class="bg-[#0f0f0f] text-white antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[#dafa9c] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#0f0f0f] focus:shadow-lg"
    >
      {isKo ? "본문으로 바로가기" : "Skip to main content"}
    </a>

    <header class="sticky top-0 z-40 border-b border-white/12 bg-[#0f0f0f]">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:h-[72px] lg:px-10">
        <div class="flex items-center gap-5 lg:gap-7">
          <a
            href={withBase(isRootPortal ? "/" : `/${locale}/`)}
            class="flex shrink-0 items-center gap-2 text-white no-underline transition-opacity hover:opacity-90"
          >
            <svg
              class="h-[22px] w-[22px] shrink-0 text-[#dafa9c]"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 5.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z"
              />
            </svg>
            <span class="text-[20px] font-medium tracking-[-0.025em] text-white">
              SpecMatrix
            </span>
          </a>

          <nav
            aria-label={isKo ? "버티컬 및 도구 내비게이션" : "Primary navigation"}
            class="hidden items-center gap-1 lg:flex"
          >
            {verticalNav.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "rounded px-2.5 py-1.5 text-sm font-medium transition-colors",
                  item.active
                    ? "bg-[#dafa9c] text-[#0f0f0f] font-semibold"
                    : "text-[#d8d8d8] hover:bg-white/8 hover:text-white",
                ]}
              >
                {item.label}
              </a>
            ))}
            <span class="mx-1.5 h-4 w-px bg-white/15" aria-hidden="true"></span>
            <a
              href={toolsHref}
              aria-current={isToolsActive ? "page" : undefined}
              class:list={[
                "rounded px-2.5 py-1.5 text-sm font-medium transition-colors",
                isToolsActive
                  ? "bg-[#dafa9c] text-[#0f0f0f] font-semibold"
                  : "text-[#d8d8d8] hover:bg-white/8 hover:text-white",
              ]}
            >
              {isKo ? "도구" : "Tools"}
            </a>
            <a
              href={compareHref}
              aria-current={isCompareActive ? "page" : undefined}
              class:list={[
                "rounded px-2.5 py-1.5 text-sm font-medium transition-colors",
                isCompareActive
                  ? "bg-[#dafa9c] text-[#0f0f0f] font-semibold"
                  : "text-[#d8d8d8] hover:bg-white/8 hover:text-white",
              ]}
            >
              {isKo ? "1:1 비교" : "Compare"}
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-open-search
            class="inline-flex items-center gap-2 rounded border border-white/15 bg-[#161616] px-2.5 py-1.5 text-xs font-medium text-[#d8d8d8] transition-colors hover:border-white/30 hover:bg-[#1c1c1c] hover:text-white"
            aria-label={isKo ? "통합 스펙 검색 열기 (Ctrl+K)" : "Open Global Search (Cmd/Ctrl+K)"}
          >
            <svg
              class="h-3.5 w-3.5 text-[#9a9a9a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <span class="hidden sm:inline">{isKo ? "검색" : "Search"}</span>
            <kbd class="rounded border border-white/15 bg-[#0f0f0f] px-1 py-0.5 font-mono text-[10px] font-medium text-[#9a9a9a]">
              ⌘K
            </kbd>
          </button>

          {hasOtherLocale && (
            <a
              href={toggleHref}
              class="inline-flex items-center gap-1.5 rounded border border-white/15 bg-[#161616] px-2.5 py-1.5 font-mono text-xs font-medium text-[#d8d8d8] transition-colors hover:border-[#dafa9c]/60 hover:bg-[#1c1c1c] hover:text-white"
              aria-label={isKo ? "Switch to English" : "한국어로 전환"}
            >
              <span class={locale === "en" ? "text-[#dafa9c] font-semibold" : "text-[#9a9a9a]"}>EN</span>
              <span class="text-white/25">↔</span>
              <span class={locale === "ko" ? "text-[#dafa9c] font-semibold" : "text-[#9a9a9a]"}>KO</span>
            </a>
          )}
        </div>
      </div>

      <!-- Mobile & Tablet horizontal quick-nav -->
      <div class="border-t border-white/10 bg-[#0f0f0f] px-4 py-2 sm:px-6 lg:hidden">
        <nav
          aria-label={isKo ? "모바일 빠른 내비게이션" : "Mobile quick navigation"}
          class="flex items-center gap-1.5 overflow-x-auto"
        >
          {verticalNav.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "shrink-0 rounded px-2.5 py-1 text-xs font-semibold transition-colors",
                item.active
                  ? "bg-[#dafa9c] text-[#0f0f0f]"
                  : "border border-white/12 bg-[#161616] text-[#d8d8d8] hover:border-white/25 hover:text-white",
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={toolsHref}
            aria-current={isToolsActive ? "page" : undefined}
            class:list={[
              "shrink-0 rounded px-2.5 py-1 text-xs font-semibold transition-colors",
              isToolsActive
                ? "bg-[#dafa9c] text-[#0f0f0f]"
                : "border border-[#dafa9c]/35 bg-[#1a1f14] text-[#dafa9c] hover:border-[#dafa9c]",
            ]}
          >
            {isKo ? "도구" : "Tools"}
          </a>
          <a
            href={compareHref}
            aria-current={isCompareActive ? "page" : undefined}
            class:list={[
              "shrink-0 rounded px-2.5 py-1 text-xs font-semibold transition-colors",
              isCompareActive
                ? "bg-[#dafa9c] text-[#0f0f0f]"
                : "border border-[#dafa9c]/35 bg-[#1a1f14] text-[#dafa9c] hover:border-[#dafa9c]",
            ]}
          >
            {isKo ? "1:1 비교" : "Compare"}
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-10 focus:outline-none">
      <slot />
    </main>

    <footer class="mt-16 border-t border-white/12 bg-[#0a0a0a]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-10">
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <a
              href={withBase(isRootPortal ? "/" : `/${locale}/`)}
              class="inline-flex items-center gap-2 text-white no-underline hover:opacity-90"
            >
              <svg
                class="h-5 w-5 shrink-0 text-[#dafa9c]"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 5.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z"
                />
              </svg>
              <span class="text-base font-medium tracking-[-0.02em] text-white">SpecMatrix Global</span>
            </a>
            <p class="mt-3 max-w-sm text-xs leading-relaxed text-[#9a9a9a]">
              {isKo
                ? "제조사 공식 스펙시트·규정 문서·영양성분표에 근거한 결정론적 비교 매트릭스 및 인터랙티브 검증 도구."
                : "Evidence-anchored specification matrices and deterministic calculators verified against manufacturer manuals, nutrition labels, and aviation regulations."}
            </p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs">
              <a
                href={toolsHref}
                class="rounded border border-white/15 bg-[#161616] px-3 py-1.5 font-medium text-[#d8d8d8] transition-colors hover:border-[#dafa9c]/60 hover:text-[#dafa9c]"
              >
                {isKo ? "인터랙티브 도구 허브 →" : "Lab Tools Hub →"}
              </a>
              <a
                href={compareHref}
                class="rounded bg-[#dafa9c] px-3 py-1.5 font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
              >
                {isKo ? "실시간 1:1 비교 →" : "Live 1:1 Compare →"}
              </a>
            </div>
          </div>

          <div class="lg:col-span-3">
            <h2 class="font-mono text-xs font-medium uppercase tracking-wider text-[#9a9a9a]">
              {isKo ? "검증 매트릭스 (4대 버티컬)" : "Active Verticals"}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {verticalNav.map((item) => (
                <li>
                  <a href={item.href} class="text-[#d8d8d8] transition-colors hover:text-[#dafa9c] hover:underline">
                    {VERTICAL_META[item.id].name[locale]}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-3">
            <h2 class="font-mono text-xs font-medium uppercase tracking-wider text-[#9a9a9a]">
              {isKo ? "인터랙티브 스튜디오" : "Lab Studios"}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {studioLinks.map((st) => (
                <li>
                  <a href={st.href} class="text-[#d8d8d8] transition-colors hover:text-[#dafa9c] hover:underline">
                    {st.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-2">
            <h2 class="font-mono text-xs font-medium uppercase tracking-wider text-[#9a9a9a]">
              {isKo ? "신뢰·정책" : "Trust & Policy"}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {LEGAL_SLUGS.map((slug) => (
                <li>
                  <a
                    href={withBase(`/${locale}/${slug}/`)}
                    class="text-[#d8d8d8] transition-colors hover:text-[#dafa9c] hover:underline"
                  >
                    {LEGAL_LABELS[slug][locale]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-9 rounded border border-white/12 bg-[#141414] p-4 text-xs leading-relaxed text-[#9a9a9a]">
          {cfg.compliance.disclosures[locale]}
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-white/10 pt-5 text-xs text-[#9a9a9a]">
          <span>© 2026 SpecMatrix Global. All rights reserved.</span>
          <span class="font-mono">
            {isKo ? "가격 기준: MSRP Reference Benchmark" : "Pricing Mode: MSRP Reference Benchmark"} · {cfg.updatedAt}
          </span>
        </div>
      </div>
    </footer>

    {hasStickyCta && <div class="h-16 lg:hidden" aria-hidden="true"></div>}

    <GlobalSearchModal locale={locale} />

    <script is:inline>
      (function () {
        document.addEventListener("click", function (ev) {
          var target = ev.target && ev.target.closest ? ev.target.closest("a[data-affiliate-store]") : null;
          if (!target) return;
          var detail = {
            store: target.getAttribute("data-affiliate-store") || "",
            vertical: target.getAttribute("data-affiliate-vertical") || "",
            sku: target.getAttribute("data-affiliate-sku") || "",
            link_mode: target.getAttribute("data-affiliate-mode") || "",
            locale: document.documentElement.lang || "en",
          };
          if (typeof window.smTrack === "function") {
            window.smTrack("affiliate_click", detail);
          }
          if (typeof window.clarity === "function") {
            window.clarity("set", "last_affiliate_sku", detail.sku);
          }
        });
      })();
    </script>
  </body>
</html>
