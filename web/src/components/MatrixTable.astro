---
import type {
  ActiveLocale,
  AnyItem,
  FxRates,
  PilotVertical,
  VsInsight,
} from "../lib/types";
import {
  computeCycleGearDerived,
  computeHomeTechDerived,
  computePureGramDerived,
  computeWattCheckDerived,
} from "../lib/derived";
import {
  BASE_PATH,
  formatCurrency,
  formatInt,
  formatNum,
  getCategoryLabel,
  safeJsonLd,
  withBase,
} from "../lib/i18n";

interface Props {
  vertical: PilotVertical;
  items: AnyItem[];
  vsInsights: VsInsight[];
  fx: FxRates;
  locale: ActiveLocale;
  isCompat?: boolean;
}

const { vertical, items, vsInsights, fx, locale, isCompat = false } = Astro.props;
const isKo = locale === "ko";

const brands = Array.from(new Set(items.map((i) => i.brand))).sort();
const categories = Array.from(new Set(items.map((i) => i.category))).sort();
const vsPairSet = vsInsights.map((v) => v.pair_slug);

interface RowModel {
  slug: string;
  name: string;
  brand: string;
  category: string;
  categoryLabel: string;
  href: string;
  msrp: number;
  msrpDisplay: string;
  trustScore: number;
  // Numeric sort keys (null sorts always at bottom)
  metric1: number | null;
  metric1Display: string;
  metric2: number | null;
  metric2Display: string;
  metric3: number | null;
  metric3Display: string;
  metric4: number | null;
  metric4Display: string;
  // Facet flags
  flagA: boolean;
  flagB: boolean;
  flagC: boolean;
  compatBadge: string;
  compatTone: "pass" | "caution" | "fail";
}

const rows: RowModel[] = items.map((item) => {
  const name = item.i18n[locale]?.name ?? item.i18n.en.name;
  const msrp = isKo ? item.regional_offers.kr.msrp : item.regional_offers.us.msrp;
  const msrpDisplay = formatCurrency(msrp, isKo ? "KRW" : "USD", locale);
  const href = withBase(`/${locale}/${vertical}/item/${item.slug}`);

  if (item.vertical === "wattcheck") {
    const d = computeWattCheckDerived(item, fx);
    const s = item.specs;
    const ac = item.airline_compliance_profile;
    const unitCost = s.has_battery
      ? isKo
        ? d.krwPer10Wh
        : d.usdPer10Wh
      : isKo
        ? d.krwPer10W
        : d.usdPer10W;
    return {
      slug: item.slug,
      name,
      brand: item.brand,
      category: item.category,
      categoryLabel: getCategoryLabel(item.category, locale),
      href,
      msrp,
      msrpDisplay,
      trustScore: item.audit.trust_score,
      metric1: s.has_battery && s.battery_energy_wh !== null ? s.battery_energy_wh : null,
      metric1Display: s.has_battery && s.battery_energy_wh !== null ? `${formatNum(s.battery_energy_wh, 1)} Wh` : "GaN AC",
      metric2: s.max_total_output_w,
      metric2Display: `${formatInt(s.max_total_output_w)} W`,
      metric3: s.weight_g,
      metric3Display: `${formatInt(s.weight_g)} g`,
      metric4: unitCost,
      metric4Display:
        unitCost !== null
          ? `${formatCurrency(unitCost, isKo ? "KRW" : "USD", locale)}/${s.has_battery ? "10Wh" : "10W"}`
          : "—",
      flagA: ac.carryon_no_approval,
      flagB: s.supports_pd_3_1_epr,
      flagC: s.kc_certified || s.pse_certified,
      compatBadge: ac.carryon_no_approval
        ? isKo
          ? "기내 무승인 OK"
          : "Cabin OK"
        : ac.carryon_allowed
          ? isKo
            ? "승인 필요"
            : "Approval Req"
          : isKo
            ? "반입 불가"
            : "No Flight",
      compatTone: ac.carryon_no_approval ? "pass" : ac.carryon_allowed ? "caution" : "fail",
    };
  }

  if (item.vertical === "puregram") {
    const d = computePureGramDerived(item, fx);
    const nl = item.nutrition_label;
    const unitCost = isKo ? d.krwPerBenchmarkUnit : d.usdPerBenchmarkUnit;
    return {
      slug: item.slug,
      name,
      brand: item.brand,
      category: item.category,
      categoryLabel: getCategoryLabel(item.category, locale),
      href,
      msrp,
      msrpDisplay,
      trustScore: item.audit.trust_score,
      metric1: unitCost,
      metric1Display: formatCurrency(unitCost, isKo ? "KRW" : "USD", locale),
      metric2: item.derived_math.purity_pct,
      metric2Display: `${formatNum(item.derived_math.purity_pct, 1)}%`,
      metric3: nl.active_per_serving_g,
      metric3Display: `${formatNum(nl.active_per_serving_g, 1)} g`,
      metric4: nl.sodium_mg,
      metric4Display: `${formatInt(nl.sodium_mg)} mg`,
      flagA: nl.caffeine_mg === 0,
      flagB: !nl.artificial_sweeteners_listed,
      flagC: item.certifications.some((c) => /informed|nsf|creapure/i.test(c)),
      compatBadge:
        nl.carb_ratio_glucose_to_fructose === "1:0.8"
          ? isKo
            ? "1:0.8 고탄수"
            : "1:0.8 High-Carb"
          : nl.creapure_certified
            ? "Creapure"
            : isKo
              ? `${item.derived_math.purity_grade} 등급`
              : `${item.derived_math.purity_grade} Grade`,
      compatTone: item.derived_math.purity_pct >= 65 ? "pass" : "caution",
    };
  }

  if (item.vertical === "hometech") {
    const d = computeHomeTechDerived(item, fx);
    const s = item.specs;
    const tp = item.tco_profile;
    const tco3yr = isKo ? d.tco3yrKrw : d.tco3yrUsd;
    const noiseVal = s.noise_load_dba ?? s.noise_idle_dba ?? null;
    const noiseDisp =
      s.noise_load_dba !== null
        ? `${formatNum(s.noise_load_dba, 1)} dBA`
        : s.noise_idle_dba !== null
          ? `${formatNum(s.noise_idle_dba, 1)} dBA`
          : "—";
    const weightDisp =
      s.weight_g >= 1000
        ? `${formatNum(s.weight_g / 1000, 2)} kg`
        : `${formatInt(s.weight_g)} g`;
    const isHighFeature =
      s.ups_waveform === "pure-sine" ||
      (s.lan_speed_gbps !== null && s.lan_speed_gbps >= 2.5) ||
      (s.suction_pa !== null && s.suction_pa >= 10000);
    return {
      slug: item.slug,
      name,
      brand: item.brand,
      category: item.category,
      categoryLabel: getCategoryLabel(item.category, locale),
      href,
      msrp,
      msrpDisplay,
      trustScore: item.audit.trust_score,
      metric1: tco3yr,
      metric1Display: formatCurrency(tco3yr, isKo ? "KRW" : "USD", locale),
      metric2: d.weightedAvgW,
      metric2Display: `${formatNum(d.weightedAvgW, 1)} W (${formatInt(d.annualKwh)} kWh)`,
      metric3: noiseVal,
      metric3Display: noiseDisp,
      metric4: s.weight_g,
      metric4Display: weightDisp,
      flagA: tp.always_on_24_7 || s.idle_power_w < 12,
      flagB: s.dual_voltage_100_240v,
      flagC: isHighFeature,
      compatBadge: !s.dual_voltage_100_240v
        ? isKo
          ? "전압 확인 필요"
          : "Check Voltage"
        : tp.always_on_24_7 && s.idle_power_w < 12
          ? isKo
            ? "24/7 저전력"
            : "24/7 Low-Idle"
          : s.ups_waveform === "pure-sine"
            ? isKo
              ? "순수 정현파"
              : "Pure Sine"
            : isKo
              ? "220V 검증"
              : "Dual-Volt OK",
      compatTone: !s.dual_voltage_100_240v ? "caution" : "pass",
    };
  }

  // CycleGear
  const d = computeCycleGearDerived(item, fx);
  const s = item.specs;
  return {
    slug: item.slug,
    name,
    brand: item.brand,
    category: item.category,
    categoryLabel: getCategoryLabel(item.category, locale),
    href,
    msrp,
    msrpDisplay,
    trustScore: item.audit.trust_score,
    metric1: s.weight_g,
    metric1Display: `${formatInt(s.weight_g)} g`,
    metric2: s.claimed_accuracy_pct ?? s.battery_life_hours ?? s.tire_width_mm ?? s.drivetrain_speeds ?? null,
    metric2Display:
      s.claimed_accuracy_pct !== null
        ? `±${formatNum(s.claimed_accuracy_pct, 1)}%`
        : s.battery_life_hours !== null
          ? `${formatInt(s.battery_life_hours)} hr`
          : s.tire_width_mm !== null
            ? `${formatInt(s.tire_width_mm)} mm`
            : s.drivetrain_speeds !== null
              ? `${s.drivetrain_speeds}s`
              : "—",
    metric3: d.compatBreadthScore,
    metric3Display: `${d.compatBreadthScore} pts`,
    metric4: isKo ? d.krwPer100g : d.usdPer100g,
    metric4Display: formatCurrency(isKo ? d.krwPer100g : d.usdPer100g, isKo ? "KRW" : "USD", locale),
    flagA: s.hookless_compatible === true || !item.safety_warning.requires_hookless_warning,
    flagB: s.left_right_balance === true || s.connectivity.includes("ANT+"),
    flagC: item.compatibility_graph.drivetrain_compatible.some((x) => /shimano|12/i.test(x)),
    compatBadge: item.safety_warning.requires_hookless_warning
      ? isKo
        ? "후크리스 5 bar"
        : "Hookless 5 bar"
      : isKo
        ? "호환 검증"
        : "Verified Fit",
    compatTone: item.safety_warning.requires_hookless_warning ? "caution" : "pass",
  };
});

const colHeaders =
  vertical === "wattcheck"
    ? {
        m1: isKo ? "용량 (Wh)" : "Energy (Wh)",
        m2: isKo ? "최대 출력" : "Max Output",
        m3: isKo ? "무게 (g)" : "Weight",
        m4: isKo ? "단위 기준가" : "Unit Cost",
        fA: isKo ? "기내 무승인(<100Wh)만" : "Cabin OK (<100Wh) Only",
        fB: isKo ? "PD 3.1 140W EPR" : "PD 3.1 140W EPR",
        fC: isKo ? "KC / PSE 인증" : "KC / PSE Certified",
      }
    : vertical === "puregram"
      ? {
          m1: isKo ? "기준 단위 실단가" : "Cost / Unit",
          m2: isKo ? "유효 순도 (%)" : "Purity (%)",
          m3: isKo ? "1회 유효성분" : "Active / Srv",
          m4: isKo ? "나트륨 (mg)" : "Sodium",
          fA: isKo ? "무카페인만" : "Caffeine-Free",
          fB: isKo ? "무인공감미료" : "No Artif. Sweeteners",
          fC: isKo ? "Informed Sport / Creapure" : "Informed Sport / Creapure",
        }
      : vertical === "hometech"
        ? {
            m1: isKo ? "3년 총소유비용(TCO)" : "3-Year TCO",
            m2: isKo ? "평균 W / 연 kWh" : "Avg W / Annual kWh",
            m3: isKo ? "소음 (dBA)" : "Noise (dBA)",
            m4: isKo ? "무게" : "Weight",
            fA: isKo ? "24/7 상시구동 / 저전력(<12W)" : "24/7 Always-On / Low Idle (<12W)",
            fB: isKo ? "100–240V 프리볼트" : "100–240V Dual Voltage",
            fC: isKo ? "정현파 / 2.5GbE+ / 고흡입" : "Pure Sine / 2.5GbE+ / High Suction",
          }
        : {
            m1: isKo ? "무게 (g)" : "Weight (g)",
            m2: isKo ? "핵심 스펙" : "Key Metric",
            m3: isKo ? "호환 지수" : "Compat Score",
            m4: isKo ? "100g당 기준가" : "Cost / 100g",
            fA: isKo ? "후크리스 안전 / 비대상" : "Hookless Safe / N/A",
            fB: isKo ? "ANT+ / 좌우밸런스" : "ANT+ / L-R Balance",
            fC: isKo ? "Shimano 12단 호환" : "Shimano 12s Ready",
          };

const clientPayload = {
  basePath: BASE_PATH,
  locale,
  vertical,
  vsPairs: vsPairSet,
};
---

<section class="space-y-4" aria-labelledby="matrix-table-heading">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="matrix-table-heading" class="text-lg font-bold tracking-tight text-white">
      {isCompat
        ? isKo
          ? "실시간 호환성 필터 매트릭스"
          : "Interactive Compatibility Filter Matrix"
        : isKo
          ? "무지연 다중 필터 & 정렬 비교표"
          : "Zero-Latency Multi-Facet Filter & Sort Matrix"}
    </h2>
    <span id="mx-count-label" class="font-mono text-xs font-semibold text-[#9a9a9a]">
      {rows.length} / {rows.length} {isKo ? "개 모델 표시 중" : "models shown"}
    </span>
  </div>

  <!-- Filter Controls Bar -->
  <div class="lab-card space-y-3 p-4">
    <div class="grid gap-3 md:grid-cols-12">
      <div class="md:col-span-5">
        <label for="mx-search" class="sr-only">{isKo ? "모델명 검색" : "Search models"}</label>
        <input
          id="mx-search"
          type="search"
          placeholder={isKo ? "모델명·브랜드 즉시 검색..." : "Filter by model or brand..."}
          class="w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 text-sm text-white placeholder:text-[#9a9a9a] focus:border-[#dafa9c] focus:outline-none"
        />
      </div>

      <div class="md:col-span-3">
        <label for="mx-cat" class="sr-only">{isKo ? "카테고리" : "Category"}</label>
        <select
          id="mx-cat"
          class="w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 text-sm text-white focus:border-[#dafa9c] focus:outline-none"
        >
          <option value="">{isKo ? "전체 카테고리" : "All Categories"}</option>
          {categories.map((c) => (
            <option value={c}>{getCategoryLabel(c, locale)}</option>
          ))}
        </select>
      </div>

      <div class="md:col-span-3">
        <label for="mx-brand" class="sr-only">{isKo ? "브랜드" : "Brand"}</label>
        <select
          id="mx-brand"
          class="w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 text-sm text-white focus:border-[#dafa9c] focus:outline-none"
        >
          <option value="">{isKo ? "전체 브랜드" : "All Brands"}</option>
          {brands.map((b) => (
            <option value={b}>{b}</option>
          ))}
        </select>
      </div>

      <div class="md:col-span-1 flex items-center">
        <button
          type="button"
          id="mx-reset"
          class="w-full rounded-md border border-white/15 bg-[#1a1a1a] px-2.5 py-2 text-xs font-semibold text-[#d8d8d8] transition-colors hover:border-white/30 hover:text-white"
        >
          {isKo ? "초기화" : "Reset"}
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-3 text-xs font-medium text-[#d8d8d8]">
      <div class="flex flex-wrap items-center gap-4">
        <label class="inline-flex cursor-pointer items-center gap-1.5">
          <input id="mx-flag-a" type="checkbox" class="h-4 w-4 rounded border-white/25 bg-[#111111]" />
          <span>{colHeaders.fA}</span>
        </label>
        <label class="inline-flex cursor-pointer items-center gap-1.5">
          <input id="mx-flag-b" type="checkbox" class="h-4 w-4 rounded border-white/25 bg-[#111111]" />
          <span>{colHeaders.fB}</span>
        </label>
        <label class="inline-flex cursor-pointer items-center gap-1.5">
          <input id="mx-flag-c" type="checkbox" class="h-4 w-4 rounded border-white/25 bg-[#111111]" />
          <span>{colHeaders.fC}</span>
        </label>
      </div>
      <button
        type="button"
        id="mx-copy-filter"
        class="inline-flex items-center gap-1.5 rounded border border-white/15 bg-[#111111] px-2.5 py-1 font-mono text-[11px] font-semibold text-[#d8d8d8] transition-colors hover:border-[#dafa9c] hover:text-[#dafa9c]"
      >
        <span>{isKo ? "필터 링크 복사" : "Copy Filter Link"}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Compare Picker Bar -->
  <div
    id="mx-compare-bar"
    class="hidden flex-wrap items-center justify-between gap-3 rounded-lg border border-[#dafa9c]/35 bg-[#1a1f14] px-4 py-3 text-xs"
  >
    <div class="flex flex-wrap items-center gap-2 font-medium text-white">
      <span class="badge-info">{isKo ? "1:1 비교 선택" : "Compare Tray"}</span>
      <span id="mx-compare-names"></span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a
        id="mx-compare-link"
        href={withBase(`/${locale}`)}
        class="hidden rounded-md border border-white/20 bg-[#161616] px-3 py-1.5 font-semibold text-white transition-colors hover:border-white/35 hover:bg-[#222222]"
      >
        {isKo ? "에디토리얼 1:1 VS 열기 →" : "Open Curated 1:1 VS →"}
      </a>
      <a
        id="mx-live-compare-link"
        href={withBase(`/${locale}/compare`)}
        class="hidden rounded-md bg-[#dafa9c] px-3.5 py-1.5 font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
      >
        {isKo ? "실시간 1:1 비교 워크벤치 열기 →" : "Open Live 1:1 Compare Workbench →"}
      </a>
      <span id="mx-compare-hint" class="font-mono text-[11px] text-[#dafa9c]"></span>
      <button
        type="button"
        id="mx-compare-clear"
        class="rounded border border-white/20 bg-[#111111] px-2.5 py-1 font-semibold text-[#d8d8d8] transition-colors hover:border-white/35 hover:text-white"
      >
        {isKo ? "해제" : "Clear"}
      </button>
    </div>
  </div>

  <!-- Data Table -->
  <div class="lab-table-wrap">
    <table class="lab-table" id="mx-table">
      <thead>
        <tr>
          <th class="w-10">{isKo ? "비교" : "VS"}</th>
          <th aria-sort="none" class="sticky left-0 z-10 min-w-[160px] bg-[#111111] shadow-[1px_0_0_0_rgba(255,255,255,0.12)] md:shadow-none">
            <button type="button" data-sort="name" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {isKo ? "모델명" : "Model"} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th aria-sort="none">
            <button type="button" data-sort="m1" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {colHeaders.m1} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th aria-sort="none">
            <button type="button" data-sort="m2" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {colHeaders.m2} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th aria-sort="none">
            <button type="button" data-sort="m3" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {colHeaders.m3} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th aria-sort="none">
            <button type="button" data-sort="m4" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {colHeaders.m4} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th aria-sort="none">
            <button type="button" data-sort="msrp" class="mx-sort-btn inline-flex items-center gap-1 hover:text-white">
              {isKo ? "MSRP 참고가" : "MSRP Ref."} <span class="mx-sort-ind text-[10px]">↕</span>
            </button>
          </th>
          <th>{isKo ? "판정" : "Status"}</th>
        </tr>
      </thead>
      <tbody id="mx-tbody">
        {rows.length === 0 ? (
          <tr>
            <td colspan="8" class="py-8 text-center text-sm text-[#9a9a9a]">
              {isKo
                ? "현재 릴리스 웨이브에 등록된 검증 모델이 없습니다."
                : "No verified SKUs loaded for the current release wave yet."}
            </td>
          </tr>
        ) : (
          rows.map((r) => (
            <tr
              class="mx-row"
              data-slug={r.slug}
              data-name={r.name.toLowerCase()}
              data-brand={r.brand}
              data-cat={r.category}
              data-msrp={r.msrp ?? ""}
              data-m1={r.metric1 ?? ""}
              data-m2={r.metric2 ?? ""}
              data-m3={r.metric3 ?? ""}
              data-m4={r.metric4 ?? ""}
              data-fa={r.flagA ? "1" : "0"}
              data-fb={r.flagB ? "1" : "0"}
              data-fc={r.flagC ? "1" : "0"}
            >
              <td>
                <input
                  type="checkbox"
                  class="mx-cmp-chk h-4 w-4 rounded border-white/25 bg-[#111111]"
                  data-slug={r.slug}
                  data-label={r.name}
                  aria-label={isKo ? `${r.name} 비교 선택` : `Compare ${r.name}`}
                />
              </td>
              <td class="sticky left-0 z-10 max-w-[200px] bg-[#141414] shadow-[1px_0_0_0_rgba(255,255,255,0.12)] sm:max-w-none md:shadow-none">
                <a href={r.href} class="font-semibold text-white transition-colors hover:text-[#dafa9c] hover:underline">
                  {r.name}
                </a>
                <div class="mt-0.5 flex items-center gap-2 text-[11px] text-[#9a9a9a]">
                  <span>{r.brand}</span>
                  <span>·</span>
                  <span>{r.categoryLabel}</span>
                  <span class="font-mono text-[#7ee8b7]">Trust {r.trustScore}</span>
                </div>
              </td>
              <td class="font-mono text-[13px] font-semibold text-white">{r.metric1Display}</td>
              <td class="font-mono text-[13px] text-[#d8d8d8]">{r.metric2Display}</td>
              <td class="font-mono text-[13px] text-[#d8d8d8]">{r.metric3Display}</td>
              <td class="font-mono text-[13px] text-[#d8d8d8]">{r.metric4Display}</td>
              <td class="font-mono text-[13px] text-[#d8d8d8]">{r.msrpDisplay}</td>
              <td>
                <span
                  class:list={[
                    r.compatTone === "pass"
                      ? "badge-pass"
                      : r.compatTone === "fail"
                        ? "badge-fail"
                        : "badge-caution",
                  ]}
                >
                  {r.compatBadge}
                </span>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  <script type="application/json" id="mx-config-data" set:html={safeJsonLd(clientPayload)} />
</section>

<script>
  import { copyToClipboard } from "../lib/clipboard";

  (() => {
    const cfgEl = document.getElementById("mx-config-data");
    const tbody = document.getElementById("mx-tbody");
    if (!cfgEl || !tbody) return;
    let cfg: { basePath?: string; locale: string; vertical: string; vsPairs: string[] };
    try {
      cfg = JSON.parse(cfgEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = cfg.locale === "ko";
    const vsSet = new Set<string>(cfg.vsPairs || []);
    const allRows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>(".mx-row"));
    const initialRows = [...allRows];

    const searchInput = document.getElementById("mx-search") as HTMLInputElement | null;
    const catSelect = document.getElementById("mx-cat") as HTMLSelectElement | null;
    const brandSelect = document.getElementById("mx-brand") as HTMLSelectElement | null;
    const flagA = document.getElementById("mx-flag-a") as HTMLInputElement | null;
    const flagB = document.getElementById("mx-flag-b") as HTMLInputElement | null;
    const flagC = document.getElementById("mx-flag-c") as HTMLInputElement | null;
    const resetBtn = document.getElementById("mx-reset");
    const copyFilterBtn = document.getElementById("mx-copy-filter") as HTMLButtonElement | null;
    const countLabel = document.getElementById("mx-count-label");
    const sortBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".mx-sort-btn"));

    const compareBar = document.getElementById("mx-compare-bar");
    const compareNames = document.getElementById("mx-compare-names");
    const compareLink = document.getElementById("mx-compare-link");
    const liveCompareLink = document.getElementById("mx-live-compare-link");
    const compareHint = document.getElementById("mx-compare-hint");
    const compareClear = document.getElementById("mx-compare-clear");
    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>(".mx-cmp-chk"));

    let sortKey = "";
    let sortAsc = true;
    let trackedFilter = false;
    const picked: Array<{ slug: string; label: string }> = [];

    const track = (name: string, params?: Record<string, unknown>) => {
      const w = window as unknown as {
        smTrack?: (ev: string, p?: Record<string, unknown>) => void;
      };
      if (typeof w.smTrack === "function") w.smTrack(name, params);
    };

    function markFilterUsed() {
      if (trackedFilter) return;
      trackedFilter = true;
      track("matrix_filter", { vertical: cfg.vertical });
    }

    function updateSortIndicators() {
      sortBtns.forEach((btn) => {
        const k = btn.getAttribute("data-sort") || "";
        const th = btn.closest("th");
        const ind = btn.querySelector<HTMLElement>(".mx-sort-ind");
        const isActive = Boolean(sortKey && k === sortKey);
        if (th) {
          th.setAttribute("aria-sort", isActive ? (sortAsc ? "ascending" : "descending") : "none");
        }
        if (ind) {
          ind.textContent = isActive ? (sortAsc ? "↑" : "↓") : "↕";
        }
        btn.classList.toggle("text-[#dafa9c]", isActive);
        btn.classList.toggle("font-bold", isActive);
      });
    }

    function restoreInitialOrder() {
      sortKey = "";
      sortAsc = true;
      if (tbody) {
        initialRows.forEach((tr) => tbody.appendChild(tr));
      }
      updateSortIndicators();
    }

    function parseNumericAttr(el: HTMLElement, attr: string): number | null {
      const raw = el.getAttribute(attr);
      if (raw === null) return null;
      const trimmed = raw.trim();
      if (!trimmed || trimmed.toLowerCase() === "null") return null;
      const n = Number(trimmed);
      return Number.isFinite(n) ? n : null;
    }

    function syncHashFromState() {
      const params = new URLSearchParams();
      const q = (searchInput ? searchInput.value : "").trim();
      const cat = catSelect ? catSelect.value : "";
      const brand = brandSelect ? brandSelect.value : "";
      if (q) params.set("q", q);
      if (cat) params.set("cat", cat);
      if (brand) params.set("brand", brand);
      if (flagA && flagA.checked) params.set("fa", "1");
      if (flagB && flagB.checked) params.set("fb", "1");
      if (flagC && flagC.checked) params.set("fc", "1");
      if (sortKey) params.set("sort", `${sortKey}:${sortAsc ? "asc" : "desc"}`);
      const encoded = params.toString();
      const nextUrl = encoded
        ? `#${encoded}`
        : window.location.pathname + window.location.search;
      try {
        window.history.replaceState(null, "", nextUrl);
      } catch {
        // ignore history API restriction
      }
    }

    function restoreStateFromHash() {
      const rawHash = window.location.hash.replace(/^#/, "");
      if (!rawHash) {
        if (searchInput) searchInput.value = "";
        if (catSelect) catSelect.value = "";
        if (brandSelect) brandSelect.value = "";
        if (flagA) flagA.checked = false;
        if (flagB) flagB.checked = false;
        if (flagC) flagC.checked = false;
        restoreInitialOrder();
        return;
      }
      const params = new URLSearchParams(rawHash);
      if (searchInput) searchInput.value = params.get("q") || "";
      if (catSelect) catSelect.value = params.get("cat") || "";
      if (brandSelect) brandSelect.value = params.get("brand") || "";
      if (flagA) flagA.checked = params.get("fa") === "1";
      if (flagB) flagB.checked = params.get("fb") === "1";
      if (flagC) flagC.checked = params.get("fc") === "1";

      const sortParam = params.get("sort") || "";
      const [k, dir] = sortParam.split(":");
      if (k && ["name", "m1", "m2", "m3", "m4", "msrp"].includes(k)) {
        sortKey = k;
        sortAsc = dir !== "desc";
        renderSortedRows(k, sortAsc);
      } else {
        restoreInitialOrder();
      }
    }

    function applyFilter(syncHash = true) {
      const q = (searchInput ? searchInput.value : "").trim().toLowerCase();
      const cat = catSelect ? catSelect.value : "";
      const brand = brandSelect ? brandSelect.value : "";
      const reqA = Boolean(flagA && flagA.checked);
      const reqB = Boolean(flagB && flagB.checked);
      const reqC = Boolean(flagC && flagC.checked);

      let visible = 0;
      allRows.forEach((tr) => {
        const name = tr.getAttribute("data-name") || "";
        const rBrand = tr.getAttribute("data-brand") || "";
        const rCat = tr.getAttribute("data-cat") || "";
        const ok =
          (!q || name.includes(q) || rBrand.toLowerCase().includes(q)) &&
          (!cat || rCat === cat) &&
          (!brand || rBrand === brand) &&
          (!reqA || tr.getAttribute("data-fa") === "1") &&
          (!reqB || tr.getAttribute("data-fb") === "1") &&
          (!reqC || tr.getAttribute("data-fc") === "1");
        tr.style.display = ok ? "" : "none";
        if (ok) visible += 1;
      });

      if (countLabel) {
        countLabel.textContent = `${visible} / ${allRows.length} ${isKo ? "개 모델 표시 중" : "models shown"}`;
      }
      if (syncHash) syncHashFromState();
    }

    function renderSortedRows(key: string, asc: boolean) {
      const sorted = [...initialRows].sort((a, b) => {
        if (key === "name") {
          const sa = a.getAttribute("data-name") || "";
          const sb = b.getAttribute("data-name") || "";
          return asc ? sa.localeCompare(sb) : sb.localeCompare(sa);
        }
        const na = parseNumericAttr(a, `data-${key}`);
        const nb = parseNumericAttr(b, `data-${key}`);
        if (na === null && nb === null) return 0;
        if (na === null) return 1;
        if (nb === null) return -1;
        return asc ? na - nb : nb - na;
      });

      const targetBody = tbody;
      if (!targetBody) return;
      sorted.forEach((tr) => targetBody.appendChild(tr));
      updateSortIndicators();
    }

    function applySort(key: string) {
      if (sortKey === key) {
        sortAsc = !sortAsc;
      } else {
        sortKey = key;
        sortAsc = key === "name" || key === "msrp";
      }
      renderSortedRows(key, sortAsc);
      markFilterUsed();
      syncHashFromState();
    }

    function updateCompareBar() {
      if (!compareBar || !compareNames || !compareLink || !liveCompareLink || !compareHint) return;
      if (picked.length === 0) {
        compareBar.classList.add("hidden");
        compareBar.classList.remove("flex");
        return;
      }
      compareBar.classList.remove("hidden");
      compareBar.classList.add("flex");
      compareNames.textContent = picked.map((p) => p.label).join("  vs  ");

      if (picked.length < 2) {
        compareLink.classList.add("hidden");
        liveCompareLink.classList.add("hidden");
        compareHint.textContent = isKo
          ? "비교할 모델을 1개 더 선택하세요."
          : "Select 1 more model to compare.";
        return;
      }

      const [a, b] = [picked[0].slug, picked[1].slug].sort();
      const pairSlug = `${a}-vs-${b}`;
      const bp = cfg.basePath || "";

      liveCompareLink.setAttribute(
        "href",
        `${bp}/${cfg.locale}/compare/#${cfg.vertical}:${a}:${b}`
      );
      liveCompareLink.classList.remove("hidden");

      if (vsSet.has(pairSlug)) {
        compareLink.setAttribute("href", `${bp}/${cfg.locale}/${cfg.vertical}/vs/${pairSlug}/`);
        compareLink.classList.remove("hidden");
        compareHint.textContent = "";
      } else {
        compareLink.classList.add("hidden");
        compareHint.textContent = "";
      }
    }

    [searchInput, catSelect, brandSelect, flagA, flagB, flagC].forEach((el) => {
      if (el) {
        el.addEventListener("input", () => {
          markFilterUsed();
          applyFilter(true);
        });
        el.addEventListener("change", () => {
          markFilterUsed();
          applyFilter(true);
        });
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (catSelect) catSelect.value = "";
        if (brandSelect) brandSelect.value = "";
        if (flagA) flagA.checked = false;
        if (flagB) flagB.checked = false;
        if (flagC) flagC.checked = false;
        restoreInitialOrder();
        applyFilter(true);
      });
    }

    if (copyFilterBtn) {
      const defLabel = isKo ? "필터 링크 복사" : "Copy Filter Link";
      const okLabel = isKo ? "링크 복사됨 ✓" : "Link Copied ✓";
      copyFilterBtn.addEventListener("click", () => {
        syncHashFromState();
        copyToClipboard(window.location.href).then((ok) => {
          if (!ok) return;
          copyFilterBtn.textContent = okLabel;
          copyFilterBtn.classList.add("border-[#1f5c3e]", "text-[#7ee8b7]", "bg-[#0d261a]");
          window.setTimeout(() => {
            copyFilterBtn.textContent = defLabel;
            copyFilterBtn.classList.remove("border-[#1f5c3e]", "text-[#7ee8b7]", "bg-[#0d261a]");
          }, 1800);
        });
      });
    }

    sortBtns.forEach((b) => {
      b.addEventListener("click", () => {
        const key = b.getAttribute("data-sort") || "";
        if (key) applySort(key);
      });
    });

    checkboxes.forEach((chk) => {
      chk.addEventListener("change", () => {
        const slug = chk.getAttribute("data-slug") || "";
        const label = chk.getAttribute("data-label") || slug;
        if (chk.checked) {
          if (picked.length >= 2) {
            const removed = picked.shift();
            if (removed) {
              const old = checkboxes.find((c) => c.getAttribute("data-slug") === removed.slug);
              if (old) old.checked = false;
            }
          }
          picked.push({ slug, label });
        } else {
          const idx = picked.findIndex((p) => p.slug === slug);
          if (idx >= 0) picked.splice(idx, 1);
        }
        updateCompareBar();
      });
    });

    if (compareClear) {
      compareClear.addEventListener("click", () => {
        picked.length = 0;
        checkboxes.forEach((c) => {
          c.checked = false;
        });
        updateCompareBar();
      });
    }

    restoreStateFromHash();
    applyFilter(false);
    window.addEventListener("hashchange", () => {
      restoreStateFromHash();
      applyFilter(false);
    });
  })();
</script>
