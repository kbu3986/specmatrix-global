---
import type { ActiveLocale, FxRates, PureGramItem } from "../../lib/types";
import { formatInt, safeJsonLd } from "../../lib/i18n";

interface Props {
  item: PureGramItem;
  fx: FxRates;
  locale: ActiveLocale;
}

const { item, fx, locale } = Astro.props;
const isKo = locale === "ko";
const isCarbProduct = item.nutrition_label.active_ingredient_type === "carbohydrates";
const isCreatine = item.category === "creatine";
const krwPerUsd = Number.isFinite(fx.rates.KRW) && fx.rates.KRW > 0 ? fx.rates.KRW : 1400;

const payload = {
  locale,
  slug: item.slug,
  category: item.category,
  isCarbProduct,
  isCreatine,
  usMsrp: item.regional_offers.us.msrp,
  krMsrp: item.regional_offers.kr.msrp,
  krwPerUsd,
  fxUpdatedAt: fx.updated_at,
  totalServings: item.package_spec.total_servings,
  servingWeightG: item.package_spec.serving_weight_g,
  activePerServingG: item.nutrition_label.active_per_serving_g,
  carbsG: item.nutrition_label.carbs_g,
  sodiumMg: item.nutrition_label.sodium_mg,
  potassiumMg: item.nutrition_label.potassium_mg,
  caffeineMg: item.nutrition_label.caffeine_mg,
  carbRatio: item.nutrition_label.carb_ratio_glucose_to_fructose,
  purityPct: item.derived_math.purity_pct,
  totalPureActiveG: item.derived_math.total_pure_active_g,
  benchmarkUnitG: item.derived_math.benchmark_unit_g,
  benchmarkLabel: isKo
    ? item.derived_math.benchmark_label_ko
    : item.derived_math.benchmark_label_en,
  unitType: item.package_spec.unit_type,
};
---

<section
  id="puregram-calc"
  class="lab-card overflow-hidden border-emerald-700/40"
  aria-labelledby="pg-calc-heading"
>
  <div class="border-b border-white/10 bg-[#111111] px-5 py-4 text-white">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-emerald-300">
          INTERACTIVE LABEL-MATH ENGINE
        </span>
        <h2 id="pg-calc-heading" class="mt-0.5 text-lg font-bold text-white">
          {isKo
            ? "실구매가 기반 순수 유효성분 실단가 · 레이스 보급 계산기"
            : "Live Cart Price True-Cost & Race Fueling Cost Planner"}
        </h2>
      </div>
      <span class="rounded-md border border-white/15 bg-white/5 px-2.5 py-1 font-mono text-xs text-neutral-200">
        {isKo ? item.derived_math.benchmark_label_ko : item.derived_math.benchmark_label_en}
      </span>
    </div>
  </div>

  <div class="divide-y divide-white/10 p-5">
    <!-- Part A: Live Cart Price Input -->
    <div class="pb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 class="text-sm font-bold text-white">
            {isKo ? "1. 내 장바구니 실구매가 입력 (실시간 단가 재계산)" : "1. Enter Your Live Cart / Checkout Price"}
          </h3>
          <p class="mt-0.5 text-xs text-neutral-400">
            {isKo
              ? "기본값은 제조사 공식 출고가(MSRP)입니다. 쿠팡·직구 할인 가격을 직접 입력하면 순수 유효성분 실단가가 즉시 바뀝니다."
              : "Defaults to official MSRP benchmark. Enter any store sale price to compute true cost per active unit instantly."}
          </p>
        </div>
        <div class="inline-flex overflow-hidden rounded-md border border-white/15 bg-[#111111] font-mono text-xs font-semibold">
          <button
            type="button"
            id="pg-cur-usd"
            aria-pressed={!isKo ? "true" : "false"}
            class:list={[
              "px-3 py-1.5 transition-colors",
              !isKo ? "bg-[#dafa9c] text-[#0f0f0f]" : "text-neutral-300 hover:bg-white/10 hover:text-white",
            ]}
          >
            USD ($)
          </button>
          <button
            type="button"
            id="pg-cur-krw"
            aria-pressed={isKo ? "true" : "false"}
            class:list={[
              "px-3 py-1.5 transition-colors",
              isKo ? "bg-[#dafa9c] text-[#0f0f0f]" : "text-neutral-300 hover:bg-white/10 hover:text-white",
            ]}
          >
            KRW (₩)
          </button>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-end gap-3">
        <div class="min-w-[200px] flex-1 max-w-xs">
          <label for="pg-price-input" class="block text-xs font-semibold text-neutral-300">
            {isKo ? "1팩(박스) 구매 가격" : "Pack / Box Price"}
            <span id="pg-cur-symbol" class="ml-1 font-mono text-neutral-400">
              ({isKo ? "KRW" : "USD"})
            </span>
          </label>
          <input
            id="pg-price-input"
            type="number"
            min="0.01"
            step="any"
            value={isKo ? item.regional_offers.kr.msrp : item.regional_offers.us.msrp}
            class="mt-1.5 w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 font-mono text-base font-bold text-white placeholder:text-neutral-500 focus:border-[#dafa9c] focus:outline-none"
          />
        </div>
        <button
          type="button"
          id="pg-reset-btn"
          class="rounded-md border border-white/15 bg-[#111111] px-3 py-2.5 text-xs font-semibold text-neutral-200 transition-colors hover:border-white/30 hover:text-white"
        >
          {isKo ? "MSRP 기준가 복원" : "Reset to MSRP"}
        </button>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-emerald-700/50 bg-[#0d261a] p-3.5">
          <div class="font-mono text-[11px] uppercase text-emerald-200">
            {isKo ? "기준 단위당 실단가" : "True Cost / Benchmark Unit"}
          </div>
          <div id="pg-bench-cost" class="kpi-value mt-1 font-mono text-2xl font-bold text-[#dafa9c]">
            —
          </div>
          <div class="mt-0.5 text-xs text-emerald-200/90">
            {isKo ? item.derived_math.benchmark_label_ko : item.derived_math.benchmark_label_en}
          </div>
        </div>

        <div class="rounded-lg border border-white/10 bg-[#111111] p-3.5">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "1회분(서빙) 단가" : "Cost per Serving"}
          </div>
          <div id="pg-serving-cost" class="kpi-value mt-1 font-mono text-2xl font-bold text-white">
            —
          </div>
          <div class="mt-0.5 text-xs text-neutral-400">
            {item.package_spec.total_servings} {isKo ? "회분 / 팩" : "servings / pack"}
          </div>
        </div>

        <div class="rounded-lg border border-white/10 bg-[#111111] p-3.5">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "비유효 중량 비율 (필러·수분)" : "Non-Active Weight (Carrier/Water)"}
          </div>
          <div id="pg-filler-pct" class="kpi-value mt-1 font-mono text-2xl font-bold text-white">
            {(100 - item.derived_math.purity_pct).toFixed(1)}%
          </div>
          <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-white/10">
            <div
              class="h-full rounded-full bg-emerald-400"
              style={`width:${Math.min(100, Math.max(5, item.derived_math.purity_pct))}%`}
            ></div>
          </div>
          <div class="mt-1 flex justify-between font-mono text-[10px] text-neutral-400">
            <span>{isKo ? "유효성분" : "Active"} {item.derived_math.purity_pct.toFixed(1)}%</span>
            <span>{isKo ? "수분/부형제" : "Carrier"} {(100 - item.derived_math.purity_pct).toFixed(1)}%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Part B: Race / Intake Cost Planner -->
    <div class="py-6">
      <h3 class="text-sm font-bold text-white">
        {isCarbProduct
          ? isKo
            ? "2. 마라톤·라이딩 시간당 탄수화물 보급 및 총 레이스 비용 플래너"
            : "2. Endurance Carb Target (60/90/120 g/hr) × Race Duration Cost Planner"
          : isCreatine
            ? isKo
              ? "2. 일일 섭취량 × 기간별 크레아틴 유지비 플래너"
              : "2. Daily Creatine Dose × Cycle Duration Cost Planner"
            : isKo
              ? "2. 시간당 전해질 보급 × 세션 비용 플래너"
              : "2. Hourly Electrolyte Intake × Session Cost Planner"}
      </h3>

      <div class="mt-3 grid gap-4 md:grid-cols-2">
        <div>
          <span class="block text-xs font-semibold text-neutral-300">
            {isCarbProduct
              ? isKo
                ? "시간당 탄수화물 목표 (g/hr)"
                : "Hourly Carb Intake Target (g/hr)"
              : isCreatine
                ? isKo
                  ? "일일 섭취 목표 (g/day)"
                  : "Daily Dose Target (g/day)"
                : isKo
                  ? "시간당 섭취량 (회/hr)"
                  : "Hourly Servings Target"}
          </span>
          <div id="pg-rate-btns" class="mt-2 flex gap-2">
            {isCarbProduct ? (
              <>
                <button type="button" data-rate="60" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">60 g/hr</button>
                <button type="button" data-rate="90" aria-pressed="true" class="pg-rate-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3.5 py-2 font-mono text-xs font-semibold text-[#0f0f0f] hover:bg-[#e6ffba]">90 g/hr</button>
                <button type="button" data-rate="120" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">120 g/hr</button>
              </>
            ) : isCreatine ? (
              <>
                <button type="button" data-rate="3" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">3 g/day</button>
                <button type="button" data-rate="5" aria-pressed="true" class="pg-rate-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3.5 py-2 font-mono text-xs font-semibold text-[#0f0f0f] hover:bg-[#e6ffba]">5 g/day</button>
                <button type="button" data-rate="10" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">10 g/day</button>
              </>
            ) : (
              <>
                <button type="button" data-rate="1" aria-pressed="true" class="pg-rate-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3.5 py-2 font-mono text-xs font-semibold text-[#0f0f0f] hover:bg-[#e6ffba]">1 /hr</button>
                <button type="button" data-rate="1.5" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">1.5 /hr</button>
                <button type="button" data-rate="2" aria-pressed="false" class="pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white">2 /hr</button>
              </>
            )}
          </div>
        </div>

        <div>
          <label for="pg-duration-slider" class="block text-xs font-semibold text-neutral-300">
            {isCreatine
              ? isKo
                ? "섭취 기간 (일):"
                : "Cycle Duration (days):"
              : isKo
                ? "레이스 / 훈련 시간 (1–6시간):"
                : "Race / Ride Duration (1–6 hours):"}
            <span id="pg-duration-val" class="ml-1 font-mono text-[#dafa9c]">
              {isCreatine ? "60" : "3"} {isCreatine ? (isKo ? "일" : "days") : isKo ? "시간" : "hr"}
            </span>
          </label>
          <input
            id="pg-duration-slider"
            type="range"
            min={isCreatine ? "30" : "1"}
            max={isCreatine ? "180" : "6"}
            step={isCreatine ? "30" : "0.5"}
            value={isCreatine ? "60" : "3"}
            class="lab-slider mt-3"
          />
        </div>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-white/10 bg-[#111111] p-3">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "총 필요 서빙(팩)" : "Total Servings Needed"}
          </div>
          <div id="pg-plan-packets" class="kpi-value mt-1 font-mono text-xl font-bold text-white">
            —
          </div>
          <div id="pg-plan-per-unit" class="mt-0.5 text-[11px] text-neutral-400"></div>
        </div>

        <div class="rounded-lg border border-emerald-700/50 bg-[#0d261a] p-3">
          <div class="font-mono text-[11px] uppercase text-emerald-200">
            {isKo ? "총 예상 보급 비용" : "Total Planned Cost"}
          </div>
          <div id="pg-plan-cost" class="kpi-value mt-1 font-mono text-xl font-bold text-[#dafa9c]">
            —
          </div>
          <div class="mt-0.5 text-[11px] text-emerald-200/80">
            {isKo ? "입력 가격 기준" : "Based on entered price"}
          </div>
        </div>

        <div class="rounded-lg border border-white/10 bg-[#111111] p-3">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "누적 나트륨 (Na)" : "Cumulative Sodium"}
          </div>
          <div id="pg-plan-na" class="kpi-value mt-1 font-mono text-xl font-bold text-white">
            —
          </div>
          <div class="mt-0.5 text-[11px] text-neutral-400">mg</div>
        </div>

        <div class="rounded-lg border border-white/10 bg-[#111111] p-3">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "누적 카페인" : "Cumulative Caffeine"}
          </div>
          <div id="pg-plan-caf" class="kpi-value mt-1 font-mono text-xl font-bold text-white">
            —
          </div>
          <div id="pg-plan-caf-note" class="mt-0.5 text-[11px] text-neutral-400"></div>
        </div>
      </div>

      <p id="pg-plan-ratio-note" class="mt-3 text-xs text-neutral-300"></p>
    </div>

    <!-- Part C: Domestic (KR) vs Overseas Direct Import (US USD→KRW) Break-Even Checker -->
    <details class="group pt-6" open={isKo}>
      <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2">
        <div>
          <h3 class="text-sm font-bold text-white">
            {isKo
              ? "3. 국내 구매(KR) vs 해외 직구(US USD→KRW) 손익분기 계산기"
              : "3. Optional: Korea Domestic (KRW) vs US Direct Import Break-Even Checker"}
          </h3>
          <p class="mt-0.5 text-xs text-neutral-400">
            {isKo
              ? "실시간 환율로 미국 직구 판매가(+배송비)와 국내 구매가를 나란히 비교해 팩당·기준단위당 직구 이득률을 계산합니다."
              : "Expand to compare US retail (+ international shipping) converted via live FX against Korea domestic KRW pricing."}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge-info font-mono text-[11px]">
            FX $1 = ₩{formatInt(krwPerUsd)} ({fx.updated_at})
          </span>
          <span class="font-mono text-xs font-bold text-neutral-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </div>
      </summary>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div>
          <label for="pg-us-price" class="block text-xs font-semibold text-neutral-300">
            {isKo ? "미국 판매가 (USD $)" : "US Store / Sale Price (USD $)"}
          </label>
          <input
            id="pg-us-price"
            type="number"
            min="0.01"
            step="any"
            value={item.regional_offers.us.msrp}
            class="mt-1.5 w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 font-mono text-sm font-bold text-white placeholder:text-neutral-500 focus:border-[#dafa9c] focus:outline-none"
          />
        </div>

        <div>
          <label for="pg-us-ship" class="block text-xs font-semibold text-neutral-300">
            {isKo ? "해외 배송비·배대지 (USD $)" : "Intl. Shipping / Handling (USD $)"}
          </label>
          <input
            id="pg-us-ship"
            type="number"
            min="0"
            step="any"
            value="0"
            class="mt-1.5 w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 font-mono text-sm font-bold text-white placeholder:text-neutral-500 focus:border-[#dafa9c] focus:outline-none"
          />
        </div>

        <div>
          <label for="pg-kr-price" class="block text-xs font-semibold text-neutral-300">
            {isKo ? "한국 국내 구매가 (KRW ₩)" : "Korea Domestic Price (KRW ₩)"}
          </label>
          <input
            id="pg-kr-price"
            type="number"
            min="100"
            step="any"
            value={item.regional_offers.kr.msrp}
            class="mt-1.5 w-full rounded-md border border-white/15 bg-[#111111] px-3 py-2 font-mono text-sm font-bold text-white placeholder:text-neutral-500 focus:border-[#dafa9c] focus:outline-none"
          />
        </div>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-white/10 bg-[#111111] p-3.5">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "미국 직구 원화 환산가" : "US Landed Cost (in KRW)"}
          </div>
          <div id="pg-imp-us-krw" class="kpi-value mt-1 font-mono text-xl font-bold text-white">
            —
          </div>
          <div id="pg-imp-us-bench" class="mt-0.5 font-mono text-[11px] text-neutral-400"></div>
        </div>

        <div class="rounded-lg border border-white/10 bg-[#111111] p-3.5">
          <div class="font-mono text-[11px] uppercase text-neutral-400">
            {isKo ? "국내 구매가 (KRW)" : "Domestic KR Price"}
          </div>
          <div id="pg-imp-kr-krw" class="kpi-value mt-1 font-mono text-xl font-bold text-white">
            —
          </div>
          <div id="pg-imp-kr-bench" class="mt-0.5 font-mono text-[11px] text-neutral-400"></div>
        </div>

        <div id="pg-imp-verdict-card" class="rounded-lg border border-emerald-700/50 bg-[#0d261a] p-3.5">
          <div class="font-mono text-[11px] uppercase text-emerald-200">
            {isKo ? "직구 프리미엄 / 절감률" : "Import Premium / Savings"}
          </div>
          <div id="pg-imp-pct" class="kpi-value mt-1 font-mono text-xl font-bold text-[#dafa9c]">
            —
          </div>
          <div id="pg-imp-bench-delta" class="mt-0.5 text-[11px] font-medium text-emerald-200"></div>
        </div>
      </div>

      <p id="pg-imp-summary" class="mt-3 text-xs leading-relaxed text-neutral-300"></p>
    </details>
  </div>

  <script type="application/json" id="pg-calc-data" set:html={safeJsonLd(payload)} />
</section>

<script>
  (() => {
    const dataEl = document.getElementById("pg-calc-data");
    if (!dataEl) return;

    interface PgCfg {
      locale: string;
      slug: string;
      category: string;
      isCarbProduct: boolean;
      isCreatine: boolean;
      usMsrp: number;
      krMsrp: number;
      krwPerUsd: number;
      fxUpdatedAt: string;
      totalServings: number;
      servingWeightG: number;
      activePerServingG: number;
      carbsG: number;
      sodiumMg: number;
      potassiumMg: number;
      caffeineMg: number;
      carbRatio: string | null;
      purityPct: number;
      totalPureActiveG: number;
      benchmarkUnitG: number;
      benchmarkLabel: string;
      unitType: string;
    }

    let cfg: PgCfg;
    try {
      cfg = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = cfg.locale === "ko";
    let tracked = false;
    function trackInteract() {
      if (tracked) return;
      tracked = true;
      const w = window as unknown as {
        smTrack?: (name: string, params?: Record<string, unknown>) => void;
      };
      w.smTrack?.("calculator_interact", { vertical: "puregram", sku: cfg.slug });
    }

    let currency = isKo ? "KRW" : "USD";
    let targetRate = cfg.isCarbProduct ? 90 : cfg.isCreatine ? 5 : 1;

    const btnUsd = document.getElementById("pg-cur-usd");
    const btnKrw = document.getElementById("pg-cur-krw");
    const curSym = document.getElementById("pg-cur-symbol");
    const priceInput = document.getElementById("pg-price-input") as HTMLInputElement | null;
    const resetBtn = document.getElementById("pg-reset-btn");

    const benchCostEl = document.getElementById("pg-bench-cost");
    const servingCostEl = document.getElementById("pg-serving-cost");

    const rateBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".pg-rate-btn"));
    const durSlider = document.getElementById("pg-duration-slider") as HTMLInputElement | null;
    const durValEl = document.getElementById("pg-duration-val");
    const planPacketsEl = document.getElementById("pg-plan-packets");
    const planPerUnitEl = document.getElementById("pg-plan-per-unit");
    const planCostEl = document.getElementById("pg-plan-cost");
    const planNaEl = document.getElementById("pg-plan-na");
    const planCafEl = document.getElementById("pg-plan-caf");
    const planCafNoteEl = document.getElementById("pg-plan-caf-note");
    const planRatioNoteEl = document.getElementById("pg-plan-ratio-note");

    // Part C: KR vs US Direct Import Break-Even Checker
    const usPriceInput = document.getElementById("pg-us-price") as HTMLInputElement | null;
    const usShipInput = document.getElementById("pg-us-ship") as HTMLInputElement | null;
    const krPriceInput = document.getElementById("pg-kr-price") as HTMLInputElement | null;
    const impUsKrwEl = document.getElementById("pg-imp-us-krw");
    const impUsBenchEl = document.getElementById("pg-imp-us-bench");
    const impKrKrwEl = document.getElementById("pg-imp-kr-krw");
    const impKrBenchEl = document.getElementById("pg-imp-kr-bench");
    const impVerdictCard = document.getElementById("pg-imp-verdict-card");
    const impPctEl = document.getElementById("pg-imp-pct");
    const impBenchDeltaEl = document.getElementById("pg-imp-bench-delta");
    const impSummaryEl = document.getElementById("pg-imp-summary");

    function fmtKrw(val: number): string {
      if (!Number.isFinite(val)) return "—";
      const s = new Intl.NumberFormat("ko-KR").format(Math.round(val));
      return isKo ? `${s}원` : `₩${s}`;
    }

    function recalcImportBreakEven() {
      const rawUs = Number(usPriceInput ? usPriceInput.value : cfg.usMsrp);
      const rawShip = Number(usShipInput ? usShipInput.value : 0);
      const rawKr = Number(krPriceInput ? krPriceInput.value : cfg.krMsrp);

      const usUsd = Number.isFinite(rawUs) && rawUs > 0 ? rawUs : 0;
      const shipUsd = Number.isFinite(rawShip) && rawShip >= 0 ? rawShip : 0;
      const krKrw = Number.isFinite(rawKr) && rawKr > 0 ? rawKr : 0;

      const fxRate = Number.isFinite(cfg.krwPerUsd) && cfg.krwPerUsd > 0 ? cfg.krwPerUsd : 1400;
      const totalUsUsd = usUsd + shipUsd;
      const usLandedKrw = totalUsUsd * fxRate;

      const totalActive = Number(cfg.totalPureActiveG || 0);
      const benchUnit = Number(cfg.benchmarkUnitG || 1);
      const benchUnits =
        totalActive > 0 && benchUnit > 0 ? totalActive / benchUnit : Math.max(Number(cfg.totalServings || 1), 1);

      const usBenchKrw = usLandedKrw / benchUnits;
      const krBenchKrw = krKrw / benchUnits;
      const diffKrw = krKrw - usLandedKrw; // > 0 means US direct import is cheaper
      const diffPct = usLandedKrw > 0 ? (diffKrw / usLandedKrw) * 100 : 0;
      const benchDeltaKrw = Math.abs(krBenchKrw - usBenchKrw);

      if (impUsKrwEl) impUsKrwEl.textContent = fmtKrw(usLandedKrw);
      if (impUsBenchEl) {
        impUsBenchEl.textContent = `$${totalUsUsd.toFixed(2)} · ${fmtKrw(usBenchKrw)} / ${cfg.benchmarkLabel}`;
      }
      if (impKrKrwEl) impKrKrwEl.textContent = fmtKrw(krKrw);
      if (impKrBenchEl) {
        impKrBenchEl.textContent = `${fmtKrw(krBenchKrw)} / ${cfg.benchmarkLabel}`;
      }

      if (impPctEl && impBenchDeltaEl && impSummaryEl && impVerdictCard) {
        if (diffKrw > 500) {
          impVerdictCard.className = "rounded-lg border border-sky-700/50 bg-[#0f1f30] p-3.5";
          impPctEl.className = "kpi-value mt-1 font-mono text-xl font-bold text-sky-200";
          impPctEl.textContent = isKo
            ? `직구 -${Math.abs(diffPct).toFixed(1)}% 저렴`
            : `Import Saves ${Math.abs(diffPct).toFixed(1)}%`;
          impBenchDeltaEl.className = "mt-0.5 text-[11px] font-medium text-sky-200/80";
          impBenchDeltaEl.textContent = isKo
            ? `기준단위당 ${fmtKrw(benchDeltaKrw)} 절감`
            : `Saves ${fmtKrw(benchDeltaKrw)} / ${cfg.benchmarkLabel}`;
          impSummaryEl.textContent = isKo
            ? `미국 직구 총액(${fmtKrw(usLandedKrw)})이 국내가 대비 ${fmtKrw(diffKrw)} (약 +${diffPct.toFixed(1)}% 국내 프리미엄) 저렴합니다. 단, 통관 $150(미국발 $200 목록통관) 한도 및 배송 기간을 함께 고려하세요.`
            : `US direct import (${fmtKrw(usLandedKrw)}) undercuts KR domestic pricing by ${fmtKrw(diffKrw)} (+${diffPct.toFixed(1)}% domestic premium), saving ${fmtKrw(benchDeltaKrw)} per benchmark unit.`;
        } else if (diffKrw < -500) {
          const krSavePct = usLandedKrw > 0 ? (Math.abs(diffKrw) / usLandedKrw) * 100 : 0;
          impVerdictCard.className = "rounded-lg border border-emerald-700/50 bg-[#0d261a] p-3.5";
          impPctEl.className = "kpi-value mt-1 font-mono text-xl font-bold text-[#dafa9c]";
          impPctEl.textContent = isKo
            ? `국내 구매 -${krSavePct.toFixed(1)}% 유리`
            : `KR Domestic Saves ${krSavePct.toFixed(1)}%`;
          impBenchDeltaEl.className = "mt-0.5 text-[11px] font-medium text-emerald-200";
          impBenchDeltaEl.textContent = isKo
            ? `기준단위당 ${fmtKrw(benchDeltaKrw)} 절감`
            : `Saves ${fmtKrw(benchDeltaKrw)} / ${cfg.benchmarkLabel}`;
          impSummaryEl.textContent = isKo
            ? `국내 구매(${fmtKrw(krKrw)})가 미국 직구 환산가(${fmtKrw(usLandedKrw)})보다 ${fmtKrw(Math.abs(diffKrw))} 저렴하며 즉시 배송까지 유리합니다.`
            : `KR domestic purchase (${fmtKrw(krKrw)}) beats US landed import (${fmtKrw(usLandedKrw)}) by ${fmtKrw(Math.abs(diffKrw))}, saving ${fmtKrw(benchDeltaKrw)} per benchmark unit.`;
        } else {
          impVerdictCard.className = "rounded-lg border border-white/10 bg-[#111111] p-3.5";
          impPctEl.className = "kpi-value mt-1 font-mono text-xl font-bold text-white";
          impPctEl.textContent = isKo ? "손익분기 (±0%)" : "Break-Even (±0%)";
          impBenchDeltaEl.className = "mt-0.5 text-[11px] font-medium text-neutral-400";
          impBenchDeltaEl.textContent = isKo
            ? `차이 ${fmtKrw(Math.abs(diffKrw))} 이내`
            : `Within ${fmtKrw(Math.abs(diffKrw))}`;
          impSummaryEl.textContent = isKo
            ? `국내 구매가와 해외 직구 원화 환산가가 거의 동일합니다. 배송 기간과 교환 편의를 고려하면 국내 구매가 유리합니다.`
            : `Domestic KR and US landed cost are practically equal — domestic purchase wins on shipping speed.`;
        }
      }
    }

    function fmtMoney(val: number) {
      if (!Number.isFinite(val)) return "—";
      if (currency === "KRW") {
        const s = new Intl.NumberFormat("ko-KR").format(Math.round(val));
        return isKo ? `${s}원` : `₩${s}`;
      }
      return `$${val.toFixed(2)}`;
    }

    function updateCurrencyButtons() {
      if (btnUsd && btnKrw) {
        btnUsd.setAttribute("aria-pressed", currency === "USD" ? "true" : "false");
        btnKrw.setAttribute("aria-pressed", currency === "KRW" ? "true" : "false");
        btnUsd.className =
          currency === "USD"
            ? "px-3 py-1.5 transition-colors bg-[#dafa9c] text-[#0f0f0f]"
            : "px-3 py-1.5 transition-colors text-neutral-300 hover:bg-white/10 hover:text-white";
        btnKrw.className =
          currency === "KRW"
            ? "px-3 py-1.5 transition-colors bg-[#dafa9c] text-[#0f0f0f]"
            : "px-3 py-1.5 transition-colors text-neutral-300 hover:bg-white/10 hover:text-white";
      }
      if (curSym) curSym.textContent = `(${currency})`;
    }

    function recalc() {
      const price = Number(priceInput ? priceInput.value : 0);
      const validPrice = Number.isFinite(price) && price > 0 ? price : 0;

      const totalActive = Number(cfg.totalPureActiveG || 0);
      const benchUnit = Number(cfg.benchmarkUnitG || 1);
      const benchUnitsPerPack = totalActive > 0 && benchUnit > 0 ? totalActive / benchUnit : Number(cfg.totalServings || 1);
      const costPerBench = benchUnitsPerPack > 0 ? validPrice / benchUnitsPerPack : 0;
      const costPerServing = cfg.totalServings > 0 ? validPrice / cfg.totalServings : 0;

      if (benchCostEl) benchCostEl.textContent = fmtMoney(costPerBench);
      if (servingCostEl) servingCostEl.textContent = fmtMoney(costPerServing);

      const dur = Number(durSlider ? durSlider.value : 3);
      if (durValEl) {
        durValEl.textContent = cfg.isCreatine
          ? `${dur} ${isKo ? "일" : "days"}`
          : `${dur} ${isKo ? "시간" : "hr"}`;
      }

      let servingsPerPeriod = 0;
      let totalServingsNeeded = 0;

      if (cfg.isCarbProduct && cfg.carbsG > 0) {
        servingsPerPeriod = targetRate / cfg.carbsG;
        totalServingsNeeded = servingsPerPeriod * dur;
      } else if (cfg.isCreatine && cfg.activePerServingG > 0) {
        servingsPerPeriod = targetRate / cfg.activePerServingG;
        totalServingsNeeded = servingsPerPeriod * dur;
      } else {
        servingsPerPeriod = targetRate;
        totalServingsNeeded = servingsPerPeriod * dur;
      }

      const wholePackets = Math.ceil(totalServingsNeeded);
      const totalCost = totalServingsNeeded * costPerServing;
      const totalNa = Math.round(totalServingsNeeded * Number(cfg.sodiumMg || 0));
      const totalCaf = Math.round(totalServingsNeeded * Number(cfg.caffeineMg || 0));

      if (planPacketsEl) {
        planPacketsEl.textContent = `${totalServingsNeeded.toFixed(1)} (${wholePackets} ${isKo ? "개" : "pcs"})`;
      }
      if (planPerUnitEl) {
        planPerUnitEl.textContent = cfg.isCreatine
          ? `${servingsPerPeriod.toFixed(2)} ${isKo ? "스쿱/일" : "servings/day"}`
          : `${servingsPerPeriod.toFixed(2)} ${isKo ? "개/시간" : "servings/hr"}`;
      }
      if (planCostEl) planCostEl.textContent = fmtMoney(totalCost);
      if (planNaEl) planNaEl.textContent = `${new Intl.NumberFormat("en-US").format(totalNa)}`;
      if (planCafEl) planCafEl.textContent = `${new Intl.NumberFormat("en-US").format(totalCaf)} mg`;

      if (planCafNoteEl) {
        if (totalCaf > 300) {
          planCafNoteEl.className = "mt-0.5 text-[11px] font-semibold text-amber-300";
          planCafNoteEl.textContent = isKo
            ? "주의: 300mg 초과 — 무카페인 젤과 교차 보급 권장"
            : "Notice: >300 mg — alternate with non-caf gels";
        } else if (totalCaf === 0) {
          planCafNoteEl.className = "mt-0.5 text-[11px] text-neutral-400";
          planCafNoteEl.textContent = isKo ? "무카페인" : "Caffeine-free";
        } else {
          planCafNoteEl.className = "mt-0.5 text-[11px] text-emerald-300";
          planCafNoteEl.textContent = isKo ? "일반 레이스 안전 구간" : "Moderate race range";
        }
      }

      if (planRatioNoteEl) {
        if (cfg.isCarbProduct) {
          if (targetRate >= 90 && cfg.carbRatio && cfg.carbRatio.includes("1:0.8")) {
            planRatioNoteEl.textContent = isKo
              ? `✓ 포도당:과당 ${cfg.carbRatio} 이중 수송체 비율로 시간당 90–120g 고탄수 보급 전략에 적합합니다.`
              : `✓ ${cfg.carbRatio} dual-source glucose:fructose ratio supports high-intake 90–120 g/hr fueling targets.`;
          } else if (targetRate >= 90) {
            planRatioNoteEl.textContent = isKo
              ? `참고: 본 제품의 당 비율(${cfg.carbRatio || "단일 당원"}) 기준으로 시간당 90g 이상 섭취 시 위장 적응 테스트를 권장합니다.`
              : `Note: With ratio (${cfg.carbRatio || "single-source"}), test gut tolerance in training before racing at ${targetRate} g/hr.`;
          } else {
            planRatioNoteEl.textContent = isKo
              ? `시간당 60g 목표는 단일·복합 당원 모두 안정적으로 흡수 가능한 표준 보급 구간입니다.`
              : `60 g/hr is a standard endurance baseline well-suited to single or dual-source carb formulations.`;
          }
        } else {
          planRatioNoteEl.textContent = "";
        }
      }
    }

    if (btnUsd) {
      btnUsd.addEventListener("click", () => {
        trackInteract();
        if (currency === "USD") return;
        currency = "USD";
        if (priceInput) {
          priceInput.value = usPriceInput && usPriceInput.value ? usPriceInput.value : String(cfg.usMsrp);
        }
        updateCurrencyButtons();
        recalc();
        recalcImportBreakEven();
      });
    }

    if (btnKrw) {
      btnKrw.addEventListener("click", () => {
        trackInteract();
        if (currency === "KRW") return;
        currency = "KRW";
        if (priceInput) {
          priceInput.value = krPriceInput && krPriceInput.value ? krPriceInput.value : String(cfg.krMsrp);
        }
        updateCurrencyButtons();
        recalc();
        recalcImportBreakEven();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        trackInteract();
        if (priceInput) {
          priceInput.value = String(currency === "KRW" ? cfg.krMsrp : cfg.usMsrp);
        }
        if (usPriceInput) usPriceInput.value = String(cfg.usMsrp);
        if (krPriceInput) krPriceInput.value = String(cfg.krMsrp);
        if (usShipInput) usShipInput.value = "0";
        recalc();
        recalcImportBreakEven();
      });
    }

    if (priceInput) {
      priceInput.addEventListener("input", () => {
        trackInteract();
        if (currency === "KRW" && krPriceInput) krPriceInput.value = priceInput.value;
        if (currency === "USD" && usPriceInput) usPriceInput.value = priceInput.value;
        recalc();
        recalcImportBreakEven();
      });
    }
    if (durSlider) {
      durSlider.addEventListener("input", () => {
        trackInteract();
        recalc();
      });
    }

    if (usPriceInput) {
      usPriceInput.addEventListener("input", () => {
        trackInteract();
        if (currency === "USD" && priceInput) {
          priceInput.value = usPriceInput.value;
          recalc();
        }
        recalcImportBreakEven();
      });
    }

    if (krPriceInput) {
      krPriceInput.addEventListener("input", () => {
        trackInteract();
        if (currency === "KRW" && priceInput) {
          priceInput.value = krPriceInput.value;
          recalc();
        }
        recalcImportBreakEven();
      });
    }

    if (usShipInput) {
      usShipInput.addEventListener("input", () => {
        trackInteract();
        recalcImportBreakEven();
      });
    }

    rateBtns.forEach((b) => {
      b.addEventListener("click", () => {
        trackInteract();
        targetRate = Number(b.getAttribute("data-rate") || targetRate);
        rateBtns.forEach((other) => {
          const on = other === b;
          other.setAttribute("aria-pressed", on ? "true" : "false");
          other.className = on
            ? "pg-rate-btn rounded-md border border-[#dafa9c] bg-[#dafa9c] px-3.5 py-2 font-mono text-xs font-semibold text-[#0f0f0f] hover:bg-[#e6ffba]"
            : "pg-rate-btn rounded-md border border-white/15 bg-[#111111] px-3.5 py-2 font-mono text-xs font-semibold text-neutral-200 hover:border-white/30 hover:text-white";
        });
        recalc();
      });
    });

    updateCurrencyButtons();
    recalc();
    recalcImportBreakEven();
  })();
</script>
