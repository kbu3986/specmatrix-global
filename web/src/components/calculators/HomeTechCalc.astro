---
import type { ActiveLocale, FxRates, HomeTechItem } from "../../lib/types";
import { formatCurrency, formatInt, formatNum, safeJsonLd } from "../../lib/i18n";

interface Props {
  item: HomeTechItem;
  fx: FxRates;
  locale: ActiveLocale;
}

const { item, fx, locale } = Astro.props;
const isKo = locale === "ko";
const s = item.specs;
const tp = item.tco_profile;

const krwPerUsd = Number.isFinite(fx.rates.KRW) && fx.rates.KRW > 0 ? fx.rates.KRW : 1400;
const eurPerUsd = Number.isFinite(fx.rates.EUR) && fx.rates.EUR > 0 ? fx.rates.EUR : 0.92;
const jpyPerUsd = Number.isFinite(fx.rates.JPY) && fx.rates.JPY > 0 ? fx.rates.JPY : 152;

const usMsrp = item.regional_offers.us.msrp;
const krMsrp = item.regional_offers.kr.msrp;

// Deterministic SSR initial calculations (matches client script 100%)
const defaultHours = Math.max(0, Math.min(24, Number(s.default_daily_hours_active) || 8));
const defaultYears = 3;
const defaultWeightedW = (s.typical_load_w * defaultHours + s.idle_power_w * (24 - defaultHours)) / 24;
const defaultAnnualKwh = defaultWeightedW * 8.76;

const initPresetId = isKo ? "kr2" : "us";
const initCurrency: "KRW" | "USD" = isKo ? "KRW" : "USD";
const initRate = isKo ? 214 : 0.17;
const initHardware = isKo ? krMsrp : usMsrp;
const initAnnualElec = isKo
  ? Math.round(defaultAnnualKwh * 214)
  : +(defaultAnnualKwh * 0.17).toFixed(2);
const initAnnualCons = isKo ? s.annual_consumables_krw : s.annual_consumables_usd;
const initTotalElec = isKo
  ? initAnnualElec * defaultYears
  : +(initAnnualElec * defaultYears).toFixed(2);
const initTotalCons = isKo
  ? Math.round(initAnnualCons * defaultYears)
  : +(initAnnualCons * defaultYears).toFixed(2);
const initTotalTco = isKo
  ? Math.round(initHardware + initTotalElec + initTotalCons)
  : +(initHardware + initTotalElec + initTotalCons).toFixed(2);

const initHwPct = initTotalTco > 0 ? (initHardware / initTotalTco) * 100 : 100;
const initElecPct = initTotalTco > 0 ? (initTotalElec / initTotalTco) * 100 : 0;
const initConsPct = initTotalTco > 0 ? Math.max(0, 100 - initHwPct - initElecPct) : 0;

// UPS / MiniPC+NAS / Robot-Vacuum SSR defaults
const isUps = item.category === "ups";
const isCompute = item.category === "minipc" || item.category === "nas";
const isVacuum = item.category === "robot-vacuum";

const upsWatt = s.ups_watt_rating && s.ups_watt_rating > 0 ? s.ups_watt_rating : 400;
const upsVa = s.ups_va_rating && s.ups_va_rating > 0 ? s.ups_va_rating : 750;
const upsPf = upsVa > 0 ? Math.min(1, upsWatt / upsVa) : 0.6;
const upsHalfMin = s.ups_runtime_half_load_min && s.ups_runtime_half_load_min > 0 ? s.ups_runtime_half_load_min : 8;
const upsInitLoadW = Math.max(20, Math.min(upsWatt, Math.round((upsWatt * 0.35) / 10) * 10 || 100));
const upsInitLoadPct = Math.min(100, (upsInitLoadW / upsWatt) * 100);
const upsInitRuntime = Math.max(
  1,
  Math.min(240, upsHalfMin * Math.pow((0.5 * upsWatt) / Math.max(upsInitLoadW, 1), 1.15))
);

const recMinUpsWatt = Math.ceil(s.peak_power_w * 1.4);
const standardVaClasses = [600, 750, 900, 1000, 1200, 1500, 2000, 3000];
const rawNeededVa = Math.max(recMinUpsWatt / 0.6, s.typical_load_w * 2.4);
const recUpsVaClass = standardVaClasses.find((v) => v >= rawNeededVa) ?? 3000;

const tariffs = [
  {
    id: "kr1",
    label: isKo ? "KR 한전 누진 1구간 (120원)" : "KR KEPCO Tier 1 (₩120)",
    rate: 120,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
  },
  {
    id: "kr2",
    label: isKo ? "KR 한전 누진 2구간 (214원)" : "KR KEPCO Tier 2 (₩214)",
    rate: 214,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
  },
  {
    id: "kr3",
    label: isKo ? "KR 한전 누진 3구간 (307원)" : "KR KEPCO Tier 3 (₩307)",
    rate: 307,
    currency: "KRW" as const,
    unit: isKo ? "원/kWh" : "₩/kWh",
  },
  {
    id: "us",
    label: isKo ? "US 미국 평균 ($0.17)" : "US Average ($0.17)",
    rate: 0.17,
    currency: "USD" as const,
    unit: "$/kWh",
  },
  {
    id: "de",
    label: isKo ? "DE 독일 평균 (€0.38)" : "DE Germany (€0.38)",
    rate: 0.38,
    currency: "EUR" as const,
    unit: "€/kWh",
  },
  {
    id: "jp",
    label: isKo ? "JP 일본 평균 (¥31)" : "JP Japan (¥31)",
    rate: 31,
    currency: "JPY" as const,
    unit: "¥/kWh",
  },
];

const payload = {
  locale,
  slug: item.slug,
  category: item.category,
  idleW: s.idle_power_w,
  typicalW: s.typical_load_w,
  peakW: s.peak_power_w,
  defaultHours,
  usMsrp,
  krMsrp,
  annualConsUsd: s.annual_consumables_usd,
  annualConsKrw: s.annual_consumables_krw,
  fx: {
    KRW: krwPerUsd,
    EUR: eurPerUsd,
    JPY: jpyPerUsd,
  },
  tariffs,
  initPresetId,
  ups: isUps
    ? {
        va: upsVa,
        watt: upsWatt,
        pf: +upsPf.toFixed(2),
        waveform: s.ups_waveform,
        halfLoadMin: upsHalfMin,
        initLoadW: upsInitLoadW,
      }
    : null,
  maintenanceCycleMonths: tp.battery_or_filter_cycle_months,
};
---

<section
  id="hometech-calc"
  class="lab-card overflow-hidden border-violet-200/80"
  aria-labelledby="ht-calc-heading"
>
  <div class="border-b border-slate-200 bg-slate-900 px-5 py-4 text-white">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-violet-300">
          INTERACTIVE TCO &amp; POWER SIMULATOR
        </span>
        <h2 id="ht-calc-heading" class="mt-0.5 text-lg font-bold">
          {isKo
            ? "글로벌 전기요금 · 3년 총소유비용(TCO) 및 부하 시뮬레이터"
            : "Global Electricity Rate, 3-Year TCO & Hardware Sizing Simulator"}
        </h2>
      </div>
      <span class="rounded-full bg-white/10 px-2.5 py-1 font-mono text-xs text-slate-200">
        {isUps
          ? `${formatInt(upsVa)} VA / ${formatInt(upsWatt)} W · PF ${formatNum(upsPf, 2)}`
          : isKo
            ? `유휴 ${formatNum(s.idle_power_w, 1)} W · 부하 ${formatNum(s.typical_load_w, 1)} W`
            : `${formatNum(s.idle_power_w, 1)} W idle · ${formatNum(s.typical_load_w, 1)} W load`}
      </span>
    </div>
  </div>

  <div class="divide-y divide-slate-200 p-5">
    <!-- Part 1: Global Electricity Rate & 3-Year TCO Simulator -->
    <div class="pb-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h3 class="text-sm font-bold text-slate-900">
            {isKo
              ? "1. 지역별 전기요금 프리셋 · 3년 총소유비용(TCO) 시뮬레이터"
              : "1. Global Electricity Rate & Multi-Year TCO Simulator"}
          </h3>
          <p class="mt-0.5 text-xs text-slate-600">
            {isKo
              ? "한전 누진 구간 및 해외 전기단가, 일일 활성 시간, 구매가, 보유 기간을 조절해 하드웨어·전기료·소모품 합산 TCO를 즉시 계산합니다."
              : "Switch regional tariffs, daily active hours, purchase price, and ownership horizon to model hardware + electricity + consumables TCO."}
          </p>
        </div>
        <span class="font-mono text-[11px] text-slate-500">
          FX: $1 = ₩{formatInt(krwPerUsd)} · €{formatNum(eurPerUsd, 2)} · ¥{formatInt(jpyPerUsd)}
        </span>
      </div>

      <!-- Tariff Preset Buttons -->
      <div class="mt-3">
        <span class="block text-xs font-semibold text-slate-600">
          {isKo ? "국가·요금제 프리셋 선택" : "Regional Tariff Preset"}
        </span>
        <div id="ht-tariff-btns" class="mt-2 flex flex-wrap gap-2">
          {tariffs.map((t) => (
            <button
              type="button"
              data-tariff-id={t.id}
              aria-pressed={t.id === initPresetId ? "true" : "false"}
              class:list={[
                "ht-tariff-btn rounded-lg border px-3 py-1.5 font-mono text-xs font-semibold transition-colors",
                t.id === initPresetId
                  ? "border-violet-700 bg-violet-700 text-white"
                  : "border-slate-300 bg-white text-slate-700 hover:border-violet-400",
              ]}
            >
              {t.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Numeric Inputs + Sliders -->
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="ht-rate-input" class="block text-xs font-semibold text-slate-600">
              {isKo ? "사용자 지정 전기단가" : "Custom kWh Rate"}
              <span id="ht-rate-unit" class="ml-1 font-mono text-violet-700">
                ({isKo ? "원/kWh" : "$/kWh"})
              </span>
            </label>
            <input
              id="ht-rate-input"
              type="number"
              min="0"
              step="any"
              value={initRate}
              class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm font-bold text-slate-900 focus:border-violet-600 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between gap-1">
              <label for="ht-price-input" class="block text-xs font-semibold text-slate-600">
                {isKo ? "하드웨어 구매가" : "Purchase Price"}
                <span id="ht-price-cur" class="ml-1 font-mono text-slate-500">({initCurrency})</span>
              </label>
              <button
                type="button"
                id="ht-price-reset"
                class="font-mono text-[11px] font-semibold text-violet-700 hover:underline"
              >
                {isKo ? "MSRP 복원" : "Reset MSRP"}
              </button>
            </div>
            <input
              id="ht-price-input"
              type="number"
              min="0"
              step="any"
              value={initHardware}
              class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm font-bold text-slate-900 focus:border-violet-600 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <div class="flex items-center justify-between text-xs">
              <label for="ht-hours-slider" class="font-semibold text-slate-600">
                {isKo ? "일일 활성 부하 시간" : "Daily Active Load Hours"}
              </label>
              <span id="ht-hours-val" class="font-mono font-bold text-violet-700">
                {formatNum(defaultHours, 1)} {isKo ? "시간/일" : "hr/day"}
              </span>
            </div>
            <input
              id="ht-hours-slider"
              type="range"
              min="0"
              max="24"
              step="0.5"
              value={defaultHours}
              class="lab-slider mt-3"
            />
            <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-500">
              <span>{isKo ? "0시간 (유휴)" : "0h (Idle)"}</span>
              <span>{isKo ? "12시간" : "12h"}</span>
              <span>{isKo ? "24시간 (부하)" : "24h (Load)"}</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-xs">
              <label for="ht-years-slider" class="font-semibold text-slate-600">
                {isKo ? "보유·운용 기간" : "Ownership Horizon"}
              </label>
              <span id="ht-years-val" class="font-mono font-bold text-violet-700">
                {defaultYears} {isKo ? "년" : "years"}
              </span>
            </div>
            <input
              id="ht-years-slider"
              type="range"
              min="1"
              max="5"
              step="1"
              value={defaultYears}
              class="lab-slider mt-3"
            />
            <div class="mt-1 flex justify-between font-mono text-[10px] text-slate-500">
              <span>{isKo ? "1년" : "1 yr"}</span>
              <span>{isKo ? "3년" : "3 yr"}</span>
              <span>{isKo ? "5년" : "5 yr"}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live TCO KPI Tiles -->
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
          <div class="font-mono text-[10px] uppercase text-slate-500">
            {isKo ? "가중 평균 소비전력" : "Weighted Avg Draw"}
          </div>
          <div id="ht-out-avg-w" class="kpi-value mt-1 font-mono text-xl font-bold text-slate-900">
            {formatNum(defaultWeightedW, 1)} W
          </div>
          <div class="mt-0.5 font-mono text-[11px] text-slate-500">
            {isKo
              ? `유휴 ${formatNum(s.idle_power_w, 1)}W / 부하 ${formatNum(s.typical_load_w, 1)}W`
              : `Idle ${formatNum(s.idle_power_w, 1)}W / Load ${formatNum(s.typical_load_w, 1)}W`}
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
          <div class="font-mono text-[10px] uppercase text-slate-500">
            {isKo ? "연간 전력량" : "Annual Energy"}
          </div>
          <div id="ht-out-kwh" class="kpi-value mt-1 font-mono text-xl font-bold text-slate-900">
            {formatNum(defaultAnnualKwh, 1)} kWh
          </div>
          <div class="mt-0.5 text-[11px] text-slate-500">
            {isKo ? "365일 × 24시간 기준" : "24/7 × 365 days/yr"}
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
          <div class="font-mono text-[10px] uppercase text-slate-500">
            {isKo ? "연간 전기요금" : "Annual Electricity"}
          </div>
          <div id="ht-out-elec-yr" class="kpi-value mt-1 font-mono text-xl font-bold text-violet-700">
            {formatCurrency(initAnnualElec, initCurrency, locale)}
          </div>
          <div id="ht-out-elec-total" class="mt-0.5 font-mono text-[11px] text-slate-500">
            {defaultYears}{isKo ? "년 누적 " : "yr: "}
            {formatCurrency(initTotalElec, initCurrency, locale)}
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
          <div id="ht-cons-label" class="font-mono text-[10px] uppercase text-slate-500">
            {defaultYears}{isKo ? "년 소모품·유지비" : "-Yr Consumables"}
          </div>
          <div id="ht-out-cons" class="kpi-value mt-1 font-mono text-xl font-bold text-amber-700">
            {formatCurrency(initTotalCons, initCurrency, locale)}
          </div>
          <div id="ht-out-cons-yr" class="mt-0.5 font-mono text-[11px] text-slate-500">
            {formatCurrency(initAnnualCons, initCurrency, locale)}/{isKo ? "년" : "yr"}
          </div>
        </div>

        <div class="rounded-lg border border-violet-200 bg-violet-50/80 p-3 sm:col-span-2 lg:col-span-1">
          <div id="ht-tco-label" class="font-mono text-[10px] font-bold uppercase text-violet-800">
            {defaultYears}{isKo ? "년 총소유비용 (TCO)" : "-Yr Total TCO"}
          </div>
          <div id="ht-out-tco" class="kpi-value mt-1 font-mono text-xl font-bold text-violet-950">
            {formatCurrency(initTotalTco, initCurrency, locale)}
          </div>
          <div class="mt-0.5 text-[11px] text-violet-800">
            {isKo ? "기기+전기+소모품 합계" : "HW + Power + Maint."}
          </div>
        </div>
      </div>

      <!-- Stacked Horizontal Breakdown Bar -->
      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3.5">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-slate-700">
          <span>{isKo ? "총소유비용(TCO) 구성 비중" : "Total TCO Cost Breakdown"}</span>
          <span id="ht-bar-summary" class="font-mono text-[11px] text-slate-600">
            {isKo
              ? `하드웨어 ${formatNum(initHwPct, 1)}% · 전기료 ${formatNum(initElecPct, 1)}% · 소모품 ${formatNum(initConsPct, 1)}%`
              : `Hardware ${formatNum(initHwPct, 1)}% · Electricity ${formatNum(initElecPct, 1)}% · Consumables ${formatNum(initConsPct, 1)}%`}
          </span>
        </div>
        <div class="mt-2 flex h-3.5 w-full overflow-hidden rounded-full bg-slate-200">
          <div
            id="ht-bar-hw"
            class="h-full bg-slate-800 transition-all duration-150"
            style={`width:${initHwPct.toFixed(1)}%`}
            title={isKo ? "하드웨어 구매가" : "Hardware"}
          ></div>
          <div
            id="ht-bar-elec"
            class="h-full bg-violet-600 transition-all duration-150"
            style={`width:${initElecPct.toFixed(1)}%`}
            title={isKo ? "누적 전기요금" : "Electricity"}
          ></div>
          <div
            id="ht-bar-cons"
            class="h-full bg-amber-500 transition-all duration-150"
            style={`width:${initConsPct.toFixed(1)}%`}
            title={isKo ? "소모품·유지비" : "Consumables"}
          ></div>
        </div>
        <div class="mt-2 flex flex-wrap gap-4 text-[11px] text-slate-600">
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-sm bg-slate-800"></span>
            <span id="ht-leg-hw">{isKo ? "하드웨어" : "Hardware"} ({formatNum(initHwPct, 1)}%)</span>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-sm bg-violet-600"></span>
            <span id="ht-leg-elec">{isKo ? "전기요금" : "Electricity"} ({formatNum(initElecPct, 1)}%)</span>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-sm bg-amber-500"></span>
            <span id="ht-leg-cons">{isKo ? "소모품·유지비" : "Consumables"} ({formatNum(initConsPct, 1)}%)</span>
          </span>
        </div>
      </div>

      <!-- Regional Tariff Insight Note -->
      <div
        id="ht-regional-insight"
        class="mt-3 rounded-lg border border-blue-200 bg-blue-50/70 px-3.5 py-2.5 text-xs leading-relaxed text-blue-950"
      >
        {isKo
          ? `글로벌 전기요금 비교 (${defaultYears}년 기준): 독일(€0.38/kWh)이나 한국 누진 3구간(307원/kWh) 환경에서는 미국 평균($0.17/kWh) 대비 동일 기기의 전기료 부담이 크게 증가합니다.`
          : `Regional Tariff Insight (${defaultYears}-yr horizon): Running this exact device in Germany (€0.38/kWh) or Korea KEPCO Tier 3 (₩307/kWh) costs substantially more in electricity than the US average ($0.17/kWh).`}
      </div>
    </div>

    <!-- Part 2: Category-Adaptive Engineering Module -->
    {isUps && (
      <div class="pt-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-sm font-bold text-slate-900">
              {isKo
                ? "2. UPS 연결 부하 · 백업 런타임 추정기 (Peukert 보정)"
                : "2. Interactive UPS Load & Backup Runtime Estimator (Peukert Scaling)"}
            </h3>
            <p class="mt-0.5 text-xs text-slate-600">
              {isKo
                ? "연결할 NAS·미니PC·라우터 합산 소비전력(W)을 설정해 부하율, 역률(PF), Active PFC 파형 안전성 및 정전 시 백업 시간을 확인하세요."
                : "Set your connected NAS/PC load in Watts to inspect Load %, Power Factor, Active PFC PSU safety, and Peukert-adjusted backup runtime."}
            </p>
          </div>
          <span class={s.ups_waveform === "pure-sine" ? "badge-pass" : "badge-caution"}>
            {s.ups_waveform === "pure-sine"
              ? isKo
                ? "순수 정현파 (Active PFC 안전)"
                : "Pure Sine · Active PFC PASS"
              : isKo
                ? "유사 정현파 (Active PFC 주의)"
                : "Simulated Sine · Active PFC CAUTION"}
          </span>
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          {[
            { label: isKo ? "2베이 NAS+공유기 (35W)" : "2-Bay NAS + Router (35W)", w: 35 },
            { label: isKo ? "4베이 NAS+스위치 (65W)" : "4-Bay NAS + Switch (65W)", w: 65 },
            { label: isKo ? "홈서버+NAS (140W)" : "MiniPC + NAS (140W)", w: 140 },
