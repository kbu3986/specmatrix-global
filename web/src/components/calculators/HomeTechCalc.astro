              </div>
              <div id="ht-vac-annual" class="kpi-value mt-1 font-mono text-lg font-bold text-amber-950">
                {formatCurrency(initAnnualCons, initCurrency, locale)}
              </div>
              <div class="mt-0.5 text-[11px] text-amber-800">
                {isKo ? "더스트백·필터·브러시·걸레" : "Bags, HEPA, brushes, mops"}
              </div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
              <div class="font-mono text-[10px] uppercase text-slate-500">
                {isKo ? "예상 더스트백 교체 주기" : "Est. Dustbag Interval"}
              </div>
              <div id="ht-vac-bag-days" class="kpi-value mt-1 font-mono text-lg font-bold text-slate-900">
                ~60 {isKo ? "일" : "days"}
              </div>
              <div class="mt-0.5 font-mono text-[11px] text-slate-500">
                {s.dustbag_capacity_l !== null
                  ? isKo
                    ? `${formatNum(s.dustbag_capacity_l, 1)} L 더스트백`
                    : `${formatNum(s.dustbag_capacity_l, 1)} L bag`
                  : isKo
                    ? "자동 비움 스테이션"
                    : "Auto-empty dock"}
              </div>
