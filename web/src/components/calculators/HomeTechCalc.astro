  <script type="application/json" id="ht-calc-data" set:html={safeJsonLd(payload)} />
</section>

<script>
  (() => {
    const dataEl = document.getElementById("ht-calc-data");
    if (!dataEl) return;

    interface TariffPreset {
      id: string;
      label: string;
      rate: number;
      currency: "KRW" | "USD" | "EUR" | "JPY";
      unit: string;
    }

    interface HtCfg {
      locale: string;
      slug: string;
      category: "minipc" | "nas" | "ups" | "robot-vacuum";
      idleW: number;
      typicalW: number;
      peakW: number;
      defaultHours: number;
      usMsrp: number;
      krMsrp: number;
      annualConsUsd: number;
      annualConsKrw: number;
      fx: { KRW: number; EUR: number; JPY: number };
      tariffs: TariffPreset[];
      initPresetId: string;
      ups: {
        va: number;
        watt: number;
        pf: number;
        waveform: string | null;
        halfLoadMin: number;
        initLoadW: number;
      } | null;
      maintenanceCycleMonths: number | null;
    }

    let cfg: HtCfg;
    try {
      cfg = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }

    const isKo = cfg.locale === "ko";
    let tracked = false;
    function trackInteract() {
      if (tracked) return;
      tracked = true;
      const w = window as unknown as {
        smTrack?: (name: string, params?: Record<string, unknown>) => void;
      };
      w.smTrack?.("calculator_interact", { vertical: "hometech", sku: cfg.slug });
    }

    const tariffBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".ht-tariff-btn"));
    const rateInput = document.getElementById("ht-rate-input") as HTMLInputElement | null;
    const rateUnitEl = document.getElementById("ht-rate-unit");
    const priceInput = document.getElementById("ht-price-input") as HTMLInputElement | null;
    const priceCurEl = document.getElementById("ht-price-cur");
    const priceResetBtn = document.getElementById("ht-price-reset");
    const hoursSlider = document.getElementById("ht-hours-slider") as HTMLInputElement | null;
    const hoursValEl = document.getElementById("ht-hours-val");
    const yearsSlider = document.getElementById("ht-years-slider") as HTMLInputElement | null;
    const yearsValEl = document.getElementById("ht-years-val");

    const outAvgW = document.getElementById("ht-out-avg-w");
    const outKwh = document.getElementById("ht-out-kwh");
    const outElecYr = document.getElementById("ht-out-elec-yr");
    const outElecTotal = document.getElementById("ht-out-elec-total");
    const consLabelEl = document.getElementById("ht-cons-label");
    const outCons = document.getElementById("ht-out-cons");
    const outConsYr = document.getElementById("ht-out-cons-yr");
    const tcoLabelEl = document.getElementById("ht-tco-label");
    const outTco = document.getElementById("ht-out-tco");
    const barSummaryEl = document.getElementById("ht-bar-summary");
    const barHw = document.getElementById("ht-bar-hw");
    const barElec = document.getElementById("ht-bar-elec");
    const barCons = document.getElementById("ht-bar-cons");
    const legHw = document.getElementById("ht-leg-hw");
    const legElec = document.getElementById("ht-leg-elec");
    const legCons = document.getElementById("ht-leg-cons");
    const insightEl = document.getElementById("ht-regional-insight");

    // Category-specific controls
    const upsLoadSlider = document.getElementById("ht-ups-load-slider") as HTMLInputElement | null;
    const upsLoadVal = document.getElementById("ht-ups-load-val");
    const upsRuntimeEl = document.getElementById("ht-ups-runtime");
    const upsLoadPctEl = document.getElementById("ht-ups-load-pct");
    const upsLoadBarEl = document.getElementById("ht-ups-load-bar");
    const upsPresetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".ht-ups-preset"));

    const extraLoadSlider = document.getElementById("ht-extra-load-slider") as HTMLInputElement | null;
    const extraLoadVal = document.getElementById("ht-extra-load-val");
    const recWEl = document.getElementById("ht-ups-rec-w");
    const recWSubEl = document.getElementById("ht-ups-rec-w-sub");
    const recVaEl = document.getElementById("ht-ups-rec-va");
    const recTypEl = document.getElementById("ht-ups-rec-typ");

    const vacRunsSlider = document.getElementById("ht-vac-runs-slider") as HTMLInputElement | null;
    const vacRunsVal = document.getElementById("ht-vac-runs-val");
    const vacAnnualEl = document.getElementById("ht-vac-annual");
    const vacBagDaysEl = document.getElementById("ht-vac-bag-days");

    let activeCurrency: "KRW" | "USD" | "EUR" | "JPY" = isKo ? "KRW" : "USD";
    let activePresetId = cfg.initPresetId;
    let vacMultiplier = 1;

    function getBenchmarkMsrp(cur: "KRW" | "USD" | "EUR" | "JPY"): number {
      if (cur === "KRW") return cfg.krMsrp;
      if (cur === "USD") return cfg.usMsrp;
      if (cur === "EUR") return Math.round(cfg.usMsrp * cfg.fx.EUR);
      return Math.round(cfg.usMsrp * cfg.fx.JPY);
    }

    function getAnnualConsumables(cur: "KRW" | "USD" | "EUR" | "JPY"): number {
      const base =
        cur === "KRW"
          ? cfg.annualConsKrw
          : cur === "USD"
            ? cfg.annualConsUsd
            : cur === "EUR"
              ? cfg.annualConsUsd * cfg.fx.EUR
              : cfg.annualConsUsd * cfg.fx.JPY;
      return base * vacMultiplier;
    }

    function fmtMoney(val: number, cur: "KRW" | "USD" | "EUR" | "JPY"): string {
      if (!Number.isFinite(val)) return "—";
      if (cur === "KRW") {
        const s = new Intl.NumberFormat("ko-KR").format(Math.round(val));
        return isKo ? `${s}원` : `₩${s}`;
      }
      if (cur === "JPY") {
        const s = new Intl.NumberFormat("en-US").format(Math.round(val));
        return `¥${s}`;
      }
      const s = new Intl.NumberFormat("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(val);
      return cur === "EUR" ? `€${s}` : `$${s}`;
    }

    function updatePresetButtons() {
      tariffBtns.forEach((btn) => {
        const on = btn.getAttribute("data-tariff-id") === activePresetId;
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.className = on
          ? "ht-tariff-btn rounded-lg border border-violet-700 bg-violet-700 px-3 py-1.5 font-mono text-xs font-semibold text-white transition-colors"
          : "ht-tariff-btn rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-mono text-xs font-semibold text-slate-700 hover:border-violet-400 transition-colors";
      });
    }

    function recalcTco() {
      const hours = Math.max(0, Math.min(24, Number(hoursSlider ? hoursSlider.value : cfg.defaultHours)));
      const years = Math.max(1, Math.min(5, Number(yearsSlider ? yearsSlider.value : 3)));
      const rawRate = Number(rateInput ? rateInput.value : 0);
      const rate = Number.isFinite(rawRate) && rawRate >= 0 ? rawRate : 0;
      const rawPrice = Number(priceInput ? priceInput.value : 0);
      const hwPrice = Number.isFinite(rawPrice) && rawPrice >= 0 ? rawPrice : 0;

      if (hoursValEl) hoursValEl.textContent = `${hours.toFixed(1)} ${isKo ? "시간/일" : "hr/day"}`;
      if (yearsValEl) yearsValEl.textContent = `${years} ${isKo ? "년" : years === 1 ? "year" : "years"}`;

      const weightedW = (cfg.typicalW * hours + cfg.idleW * (24 - hours)) / 24;
      const annualKwh = weightedW * 8.76;
      const isZeroDec = activeCurrency === "KRW" || activeCurrency === "JPY";
      const annualElec = isZeroDec
        ? Math.round(annualKwh * rate)
        : +(annualKwh * rate).toFixed(2);
      const totalElec = isZeroDec
        ? annualElec * years
        : +(annualElec * years).toFixed(2);

      const annualCons = getAnnualConsumables(activeCurrency);
      const totalCons = isZeroDec
        ? Math.round(annualCons * years)
        : +(annualCons * years).toFixed(2);
      const totalTco = isZeroDec
        ? Math.round(hwPrice + totalElec + totalCons)
        : +(hwPrice + totalElec + totalCons).toFixed(2);

      const hwPct = totalTco > 0 ? (hwPrice / totalTco) * 100 : 100;
      const elecPct = totalTco > 0 ? (totalElec / totalTco) * 100 : 0;
      const consPct = totalTco > 0 ? Math.max(0, 100 - hwPct - elecPct) : 0;

      if (outAvgW) outAvgW.textContent = `${weightedW.toFixed(1)} W`;
      if (outKwh) outKwh.textContent = `${annualKwh.toFixed(1)} kWh`;
      if (outElecYr) outElecYr.textContent = fmtMoney(annualElec, activeCurrency);
      if (outElecTotal) {
        outElecTotal.textContent = `${years}${isKo ? "년 누적 " : "yr: "}${fmtMoney(totalElec, activeCurrency)}`;
      }
      if (consLabelEl) consLabelEl.textContent = `${years}${isKo ? "년 소모품·유지비" : "-Yr Consumables"}`;
      if (outCons) outCons.textContent = fmtMoney(totalCons, activeCurrency);
      if (outConsYr) outConsYr.textContent = `${fmtMoney(annualCons, activeCurrency)}/${isKo ? "년" : "yr"}`;
      if (tcoLabelEl) tcoLabelEl.textContent = `${years}${isKo ? "년 총소유비용 (TCO)" : "-Yr Total TCO"}`;
      if (outTco) outTco.textContent = fmtMoney(totalTco, activeCurrency);

      if (barHw) barHw.style.width = `${hwPct.toFixed(1)}%`;
      if (barElec) barElec.style.width = `${elecPct.toFixed(1)}%`;
      if (barCons) barCons.style.width = `${consPct.toFixed(1)}%`;

      if (barSummaryEl) {
        barSummaryEl.textContent = isKo
          ? `하드웨어 ${hwPct.toFixed(1)}% · 전기료 ${elecPct.toFixed(1)}% · 소모품 ${consPct.toFixed(1)}%`
          : `Hardware ${hwPct.toFixed(1)}% · Electricity ${elecPct.toFixed(1)}% · Consumables ${consPct.toFixed(1)}%`;
      }
      if (legHw) legHw.textContent = `${isKo ? "하드웨어" : "Hardware"} (${hwPct.toFixed(1)}%)`;
      if (legElec) legElec.textContent = `${isKo ? "전기요금" : "Electricity"} (${elecPct.toFixed(1)}%)`;
      if (legCons) legCons.textContent = `${isKo ? "소모품·유지비" : "Consumables"} (${consPct.toFixed(1)}%)`;

      if (vacAnnualEl) vacAnnualEl.textContent = fmtMoney(annualCons, activeCurrency);

      // Regional insight comparing DE (€0.38/kWh) and KR Tier 3 (₩307/kWh) vs US ($0.17/kWh)
      if (insightEl) {
        const usElecTotalUsd = annualKwh * 0.17 * years;
        const deElecTotalUsd = (annualKwh * 0.38 * years) / Math.max(cfg.fx.EUR, 0.1);
        const kr3ElecTotalKrw = annualKwh * 307 * years;
        const kr3ElecTotalUsd = kr3ElecTotalKrw / Math.max(cfg.fx.KRW, 100);
        const usElecTotalKrw = usElecTotalUsd * cfg.fx.KRW;

        const deDeltaUsd = Math.max(0, deElecTotalUsd - usElecTotalUsd);
        const deDeltaPct = usElecTotalUsd > 0 ? Math.round((deDeltaUsd / usElecTotalUsd) * 100) : 0;
        const kr3DeltaKrw = kr3ElecTotalKrw - usElecTotalKrw;
        const kr3DeltaPct = usElecTotalUsd > 0 ? Math.round(((kr3ElecTotalUsd - usElecTotalUsd) / usElecTotalUsd) * 100) : 0;

        if (isKo) {
          const krSign = kr3DeltaKrw >= 0 ? "+" : "-";
          insightEl.textContent = `글로벌 전기요금 비교 (${years}년 · ${hours.toFixed(1)}시간/일 기준): 동일 기기를 미국 평균($0.17/kWh, 약 ${fmtMoney(usElecTotalKrw, "KRW")}) 대신 독일(€0.38/kWh)에서 쓰면 +${fmtMoney(deDeltaUsd * cfg.fx.KRW, "KRW")} (+${deDeltaPct}%), 한국 한전 누진 3구간(307원/kWh)에서는 ${krSign}${fmtMoney(Math.abs(kr3DeltaKrw), "KRW")} (${kr3DeltaPct >= 0 ? "+" : ""}${kr3DeltaPct}%) 차이가 발생합니다.`;
        } else {
          const krDeltaUsd = kr3ElecTotalUsd - usElecTotalUsd;
          const krSign = krDeltaUsd >= 0 ? "+" : "-";
          insightEl.textContent = `Regional Tariff Insight (${years}-yr @ ${hours.toFixed(1)}h/day): Compared to the US average ($0.17/kWh = ${fmtMoney(usElecTotalUsd, "USD")}), running this exact unit in Germany (€0.38/kWh) adds +${fmtMoney(deDeltaUsd, "USD")} (+${deDeltaPct}%) in power cost, while Korea KEPCO Tier 3 (₩307/kWh) differs by ${krSign}${fmtMoney(Math.abs(krDeltaUsd), "USD")} (${kr3DeltaPct >= 0 ? "+" : ""}${kr3DeltaPct}%).`;
        }
      }
    }

    function recalcUps() {
      if (!cfg.ups || !upsLoadSlider) return;
      const loadW = Math.max(20, Math.min(cfg.ups.watt, Number(upsLoadSlider.value) || 20));
      const pct = Math.min(100, (loadW / Math.max(cfg.ups.watt, 1)) * 100);
      const rawMin = cfg.ups.halfLoadMin * Math.pow((0.5 * cfg.ups.watt) / Math.max(loadW, 1), 1.15);
      const clampedMin = Math.max(1, Math.min(240, rawMin));

      if (upsLoadVal) {
        upsLoadVal.textContent = isKo
          ? `${loadW} W / 최대 ${cfg.ups.watt} W`
          : `${loadW} W / ${cfg.ups.watt} W max`;
      }
      if (upsRuntimeEl) {
        upsRuntimeEl.textContent = `${clampedMin >= 60 ? clampedMin.toFixed(0) : clampedMin.toFixed(1)} ${isKo ? "분" : "min"}`;
      }
      if (upsLoadPctEl) upsLoadPctEl.textContent = `${Math.round(pct)}%`;
      if (upsLoadBarEl) {
        upsLoadBarEl.style.width = `${Math.max(4, Math.min(100, pct)).toFixed(0)}%`;
        upsLoadBarEl.className =
          pct > 80
            ? "h-full rounded-full bg-rose-600 transition-all duration-150"
            : pct > 60
              ? "h-full rounded-full bg-amber-500 transition-all duration-150"
              : "h-full rounded-full bg-emerald-600 transition-all duration-150";
      }
    }

    function recalcComputeUpsSizing() {
      if (!extraLoadSlider) return;
      const extraW = Math.max(0, Math.min(150, Number(extraLoadSlider.value) || 0));
      const totalPeak = cfg.peakW + extraW;
      const totalTyp = cfg.typicalW + extraW;
      const minWatt = Math.ceil(totalPeak * 1.4);
      const vaClasses = [600, 750, 900, 1000, 1200, 1500, 2000, 3000];
      const neededVa = Math.max(minWatt / 0.6, totalTyp * 2.4);
      const vaClass = vaClasses.find((v) => v >= neededVa) ?? 3000;

      if (extraLoadVal) extraLoadVal.textContent = `${extraW} W`;
      if (recWEl) recWEl.textContent = `${minWatt} W`;
      if (recWSubEl) {
        recWSubEl.textContent = isKo
          ? `피크 ${Math.round(totalPeak)} W × 1.4 여유율`
          : `Peak ${Math.round(totalPeak)} W × 1.4 headroom`;
      }
      if (recVaEl) recVaEl.textContent = `${new Intl.NumberFormat("en-US").format(vaClass)} VA+`;
      if (recTypEl) {
        recTypEl.textContent = isKo
          ? `${totalTyp.toFixed(1)} W · 순수 정현파`
          : `${totalTyp.toFixed(1)} W · Pure Sine`;
      }
    }

    function recalcVacuum() {
      if (!vacRunsSlider) return;
      const runs = Math.max(2, Math.min(14, Number(vacRunsSlider.value) || 7));
      vacMultiplier = runs / 7;
      const estBagDays = Math.max(14, Math.min(150, Math.round(60 / vacMultiplier)));

      if (vacRunsVal) {
        vacRunsVal.textContent = `${runs} ${isKo ? "회/주" : "runs/wk"} (${vacMultiplier.toFixed(2)}×)`;
      }
      if (vacBagDaysEl) vacBagDaysEl.textContent = `~${estBagDays} ${isKo ? "일" : "days"}`;
      recalcTco();
    }

    tariffBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        trackInteract();
        const tid = btn.getAttribute("data-tariff-id") || "";
        const preset = cfg.tariffs.find((t) => t.id === tid);
        if (!preset) return;
        const currencyChanged = preset.currency !== activeCurrency;
        activePresetId = preset.id;
        activeCurrency = preset.currency;
        if (rateInput) rateInput.value = String(preset.rate);
        if (rateUnitEl) rateUnitEl.textContent = `(${preset.unit})`;
        if (priceCurEl) priceCurEl.textContent = `(${preset.currency})`;
        if (currencyChanged && priceInput) {
          priceInput.value = String(getBenchmarkMsrp(activeCurrency));
        }
        updatePresetButtons();
        recalcTco();
      });
    });

    if (rateInput) {
      rateInput.addEventListener("input", () => {
        trackInteract();
        activePresetId = "custom";
        updatePresetButtons();
        recalcTco();
      });
    }

    if (priceInput) {
      priceInput.addEventListener("input", () => {
        trackInteract();
        recalcTco();
      });
    }

    if (priceResetBtn) {
      priceResetBtn.addEventListener("click", () => {
        trackInteract();
        if (priceInput) priceInput.value = String(getBenchmarkMsrp(activeCurrency));
        recalcTco();
      });
    }

    if (hoursSlider) {
      hoursSlider.addEventListener("input", () => {
        trackInteract();
        recalcTco();
      });
    }

    if (yearsSlider) {
      yearsSlider.addEventListener("input", () => {
        trackInteract();
        recalcTco();
      });
    }

    if (upsLoadSlider) {
      upsLoadSlider.addEventListener("input", () => {
        trackInteract();
        recalcUps();
      });
    }

    upsPresetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        trackInteract();
        const w = Number(btn.getAttribute("data-ups-preset") || 50);
        if (upsLoadSlider) {
          upsLoadSlider.value = String(w);
          recalcUps();
        }
      });
    });

    if (extraLoadSlider) {
      extraLoadSlider.addEventListener("input", () => {
        trackInteract();
        recalcComputeUpsSizing();
      });
    }

    if (vacRunsSlider) {
      vacRunsSlider.addEventListener("input", () => {
        trackInteract();
        recalcVacuum();
      });
    }

    function syncAll() {
      updatePresetButtons();
      recalcVacuum();
      recalcTco();
      recalcUps();
      recalcComputeUpsSizing();
    }

    syncAll();
    window.addEventListener("pageshow", syncAll);
  })();
</script>
