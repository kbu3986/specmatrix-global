---
import type { ActiveLocale, AnyItem } from "../lib/types";
import { buildMonetizationModel } from "../lib/monetization";

interface Props {
  item: AnyItem;
  locale: ActiveLocale;
}

const { item, locale } = Astro.props;
const isKo = locale === "ko";
const m = buildMonetizationModel(item, locale);
const primaryBtn = m.buttons.find((b) => b.isPrimary) ?? m.buttons[0] ?? null;
const copy = item.i18n[locale] ?? item.i18n.en;
---

{primaryBtn && (
  <>
    <!-- Mobile safe spacing so fixed bar never overlaps footer controls -->
    <div class="h-16 lg:hidden" aria-hidden="true"></div>

    <aside
      id="mobile-sticky-cta"
      data-sku={item.slug}
      class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-slate-200 bg-white/95 px-4 py-2.5 shadow-lg backdrop-blur transition-transform duration-200 will-change-transform lg:hidden"
      aria-label={isKo ? "빠른 실시간 가격 확인" : "Quick live price check"}
    >
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-2.5">
        <div class="min-w-0 flex-1">
          <div class="truncate text-xs font-bold text-slate-900">
            {copy.name}
          </div>
          <div class="flex items-center gap-1.5 font-mono text-xs">
            <span class="kpi-value font-bold text-slate-900">{m.benchmarkPriceFormatted}</span>
            <span class="text-[10px] text-slate-500">
              {isKo ? "MSRP 참고가" : "MSRP ref."}
            </span>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
          <a
            href={primaryBtn.url}
            rel={primaryBtn.rel}
            target={primaryBtn.target}
            data-affiliate-store={primaryBtn.storeName}
            data-affiliate-vertical={item.vertical}
            data-affiliate-sku={item.slug}
            data-affiliate-mode={primaryBtn.linkMode}
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-700 px-3.5 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-blue-800"
          >
            <span>
              {isKo
                ? primaryBtn.storeName.includes("Coupang")
                  ? "쿠팡 최저가"
                  : "최저가 확인"
                : "Check Price"}
            </span>
            <span class="font-mono text-[11px]" aria-hidden="true">↗</span>
          </a>

          <button
            type="button"
            id="mobile-sticky-cta-dismiss"
            aria-label={isKo ? "하단 가격 바 닫기" : "Dismiss sticky price bar"}
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 font-mono text-base leading-none text-slate-500 hover:bg-slate-100 hover:text-slate-800"
          >
            ×
          </button>
        </div>
      </div>
    </aside>

    <script>
      (() => {
        const bar = document.getElementById("mobile-sticky-cta");
        const closeBtn = document.getElementById("mobile-sticky-cta-dismiss");
        if (!bar) return;

        const storageKey = `sm_sticky_dismissed_${bar.getAttribute("data-sku") || "page"}`;
        let dismissed = false;
        try {
          dismissed = window.sessionStorage.getItem(storageKey) === "1";
        } catch {
          dismissed = false;
        }
        if (dismissed) {
          bar.classList.add("hidden");
          return;
        }

        let visible = false;
        function onScroll() {
          if (dismissed || !bar) return;
          const shouldShow = window.scrollY > 280;
          if (shouldShow === visible) return;
          visible = shouldShow;
          if (visible) {
            bar.classList.remove("translate-y-full");
            bar.classList.add("translate-y-0");
          } else {
            bar.classList.add("translate-y-full");
            bar.classList.remove("translate-y-0");
          }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        if (closeBtn) {
          closeBtn.addEventListener("click", () => {
            dismissed = true;
            bar.classList.add("translate-y-full");
            bar.classList.remove("translate-y-0");
            try {
              window.sessionStorage.setItem(storageKey, "1");
            } catch {
              // ignore storage restriction
            }
          });
        }
      })();
    </script>
  </>
)}
