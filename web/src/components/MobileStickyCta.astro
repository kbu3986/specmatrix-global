---
import type { ActiveLocale, AnyItem } from "../lib/types";
import { buildMonetizationModel } from "../lib/monetization";

interface Props {
  item: AnyItem;
  locale: ActiveLocale;
}

const { item, locale } = Astro.props;
const isKo = locale === "ko";
const m = buildMonetizationModel(item, locale);
const primaryBtn = m.buttons.find((b) => b.isPrimary) ?? m.buttons[0] ?? null;
const copy = item.i18n[locale] ?? item.i18n.en;
---

{primaryBtn && (
  <>
    <aside
      id="mobile-sticky-cta"
      data-sku={item.slug}
      aria-hidden="true"
      inert
      class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-white/15 bg-[#111111] px-4 py-2.5 shadow-2xl transition-transform duration-200 will-change-transform lg:hidden"
      aria-label={isKo ? "빠른 실시간 가격 확인" : "Quick live price check"}
    >
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-2.5">
        <div class="min-w-0 flex-1">
          <div class="truncate text-xs font-bold text-white">
            {copy.name}
          </div>
          <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs">
            <span class="kpi-value font-bold text-[#dafa9c]">{m.benchmarkPriceFormatted}</span>
            <span class="text-[10px] text-[#9a9a9a]">
              {isKo ? "MSRP 참고가 · 제휴 링크" : "MSRP ref. · Affiliate"}
            </span>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
          <a
            href={primaryBtn.url}
            rel={primaryBtn.rel}
            target={primaryBtn.target}
            data-affiliate-store={primaryBtn.storeName}
            data-affiliate-vertical={item.vertical}
            data-affiliate-sku={item.slug}
            data-affiliate-mode={primaryBtn.linkMode}
            class="inline-flex items-center gap-1.5 rounded-md bg-[#dafa9c] px-3.5 py-2 text-xs font-semibold text-[#0f0f0f] transition-colors hover:bg-[#e6ffba]"
          >
            <span>
              {isKo
                ? primaryBtn.storeName.includes("Coupang")
                  ? "쿠팡 실시간가 확인"
                  : "실시간가 확인"
                : "Check Price"}
            </span>
            <span class="font-mono text-[11px]" aria-hidden="true">↗</span>
          </a>

          <button
            type="button"
            id="mobile-sticky-cta-dismiss"
            aria-label={isKo ? "하단 가격 바 닫기" : "Dismiss sticky price bar"}
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/15 bg-[#1a1a1a] font-mono text-base leading-none text-[#d8d8d8] transition-colors hover:border-white/30 hover:text-white"
          >
            ×
          </button>
        </div>
      </div>
    </aside>

    <script>
      (() => {
        const bar = document.getElementById("mobile-sticky-cta") as (HTMLElement & { inert?: boolean }) | null;
        const closeBtn = document.getElementById("mobile-sticky-cta-dismiss");
        if (!bar) return;

        function setHiddenState(hidden: boolean) {
          if (!bar) return;
          if (hidden) {
            bar.classList.add("translate-y-full");
            bar.classList.remove("translate-y-0");
            bar.inert = true;
            bar.setAttribute("inert", "");
            bar.setAttribute("aria-hidden", "true");
          } else {
            bar.classList.remove("translate-y-full");
            bar.classList.add("translate-y-0");
            bar.inert = false;
            bar.removeAttribute("inert");
            bar.removeAttribute("aria-hidden");
          }
        }

        const storageKey = `sm_sticky_dismissed_${bar.getAttribute("data-sku") || "page"}`;
        let dismissed = false;
        try {
          dismissed = window.sessionStorage.getItem(storageKey) === "1";
        } catch {
          dismissed = false;
        }
        if (dismissed) {
          setHiddenState(true);
          bar.classList.add("hidden");
          return;
        }

        let visible = false;
        setHiddenState(true);

        function onScroll() {
          if (dismissed || !bar) return;
          const shouldShow = window.scrollY > 280;
          if (shouldShow === visible) return;
          visible = shouldShow;
          setHiddenState(!visible);
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        if (closeBtn) {
          closeBtn.addEventListener("click", () => {
            dismissed = true;
            visible = false;
            setHiddenState(true);
            try {
              window.sessionStorage.setItem(storageKey, "1");
            } catch {
              // ignore storage restriction
            }
          });
        }
      })();
    </script>
  </>
)}
