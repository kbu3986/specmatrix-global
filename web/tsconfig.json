{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@schemas/*": ["../schemas/*"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "../schemas/ssot-types.ts"],
  "exclude": ["dist", "node_modules"]
}
